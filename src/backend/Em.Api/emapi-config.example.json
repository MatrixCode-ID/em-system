{
  // Copy to ..\.artefacts\em-system\config\emapi-config.json next to the repo. Do not commit real values.
  "database": {
    "provider": "MicrosoftSqlServer",
    "connectionString": "Server=localhost,1433;Database=Em;User ID=em;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True",
    "extra": {}
  },
  "admin": {
    "initialPassword": "CHANGE_ME"
  },
  // Public key only (RSA Base64 DER PKCS#1). Leave empty on a public server.
  "debugTokens": [],
  "http": {
    "requestTimeoutSeconds": 30,
    "actionRateLimit": 300,
    "proxy": { "trusted": [], "trustAny": false, "hopLimit": null }
  },
  "session": {
    "tokenRetentionHours": 720
  },
  "storage": {
    "taskCachePath": "./data/tasks",
    "nuPakPath": "./data/nuget",
    "nuPakMaxPackageMb": 250,
    "binaryPath": "./data/binary"
  },
  // Optional modules; one that is not mentioned is off. Can be overridden by EM_MODULE_<NAME>=true|false (e.g. EM_MODULE_TEST).
  "modules": {
    "test": false
  }
}
