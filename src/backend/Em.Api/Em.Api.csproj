<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\compose.dcproj</DockerComposeProjectPath>
    <DockerfileContext>..\..\..</DockerfileContext>
    <DockerDevelopmentMode>Regular</DockerDevelopmentMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Em.Api.Core\Em.Api.Core.csproj" />
    <ProjectReference Include="..\..\modules\Em.Test\Em.Test.Api\Em.Test.Api.csproj" />
  </ItemGroup>
  <!-- emapi-config.json lives outside the repository in $(ArtefactsPath)config\. It is copied to the build
       output only, never published. The example beside Program.cs is documentation, not configuration. -->
  <ItemGroup>
    <None Include="$(ArtefactsPath)config\emapi-config.json" Link="emapi-config.json" Visible="false"
          Condition="Exists('$(ArtefactsPath)config\emapi-config.json')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Update="emapi-config.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
