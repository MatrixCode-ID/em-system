<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- See doc/engine/build.md#xml-docs -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Em</RootNamespace>
        <Description>Core API services and data access for Em System.</Description>
        <Title>Em System API core</Title>
        <PackageTags>em-system;api;aspnetcore;data-access</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <ProjectReference Include="..\..\shared\Em.Libs\Em.Libs.csproj"/>
        <ProjectReference Include="..\Em.Api.Core.Analyzers\Em.Api.Core.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="..\Em.Api.Core.Analyzers\bin\$(Configuration)\netstandard2.0\Em.Api.Core.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MailKit" Version="4.17.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10"/>
        <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.12"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3"/>
        <PackageReference Include="NuGet.Versioning" Version="7.0.0"/>
        <PackageReference Include="Dapper" Version="2.1.66"/>
        <PackageReference Include="PDFsharp" Version="6.2.4"/>
        <PackageReference Include="MySqlConnector" Version="2.6.2"/>
        <PackageReference Include="Npgsql" Version="10.0.3"/>
        <PackageReference Include="EFCore.BulkExtensions" Version="10.0.1"/>
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0"/>
        <!-- Registry deploy to Docker servers: SSH transport and compose file parsing (both MIT). -->
        <PackageReference Include="SSH.NET" Version="2026.0.0"/>
        <PackageReference Include="YamlDotNet" Version="18.1.0"/>

    </ItemGroup>

    <ItemGroup>
        <!-- Log store scripts used by Log Manager > Prepare; the files in doc/sqlscript are the single source. -->
        <EmbeddedResource Include="..\..\..\doc\sqlscript\mssql\tables\071-log-store.sql" LogicalName="Em.Log.Store.mssql.sql" Link="Api\Log\Scripts\071-log-store.mssql.sql"/>
        <EmbeddedResource Include="..\..\..\doc\sqlscript\mysql\tables\071-log-store.sql" LogicalName="Em.Log.Store.mysql.sql" Link="Api\Log\Scripts\071-log-store.mysql.sql"/>
        <EmbeddedResource Include="..\..\..\doc\sqlscript\postgresql\tables\071-log-store.sql" LogicalName="Em.Log.Store.postgresql.sql" Link="Api\Log\Scripts\071-log-store.postgresql.sql"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Em.Api.Core.IntegrationTests"/>
        <InternalsVisibleTo Include="Em.Api.Core.Tests"/>
    </ItemGroup>

</Project>
