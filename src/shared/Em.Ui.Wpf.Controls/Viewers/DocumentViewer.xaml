<UserControl x:Class="Em.Ui.Wpf.Controls.DocumentViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Em.Ui.Wpf.Controls"
             xmlns:core="clr-namespace:Em.Ui.Wpf.Controls;assembly=Em.Ui.Wpf.Core"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200">
   <UserControl.DataContext>
      <local:DocumentViewerVm />
   </UserControl.DataContext>

   <UserControl.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
   </UserControl.Resources>

   <Grid>
      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
         </Grid.RowDefinitions>

         <!-- ==== tool strip ==== -->
         <DockPanel Grid.Row="0" Margin="22,12,22,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
               <Button Style="{StaticResource rowActionButtonStyle}"
                       ToolTip="Reload document"
                       Command="{Binding Commands[RefreshCommand]}">
                  <fa:FontAwesome Icon="Solid_ArrowsRotate" />
               </Button>
               <Button Margin="10,0,0,0"
                       Style="{StaticResource compactOutlinedButtonStyle}"
                       Command="{Binding Commands[SaveAsCommand]}">
                  <StackPanel Orientation="Horizontal">
                     <fa:FontAwesome Icon="Solid_Download" Style="{StaticResource buttonIconStyle}" />
                     <TextBlock Text="Save as" VerticalAlignment="Center" />
                  </StackPanel>
               </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
               <fa:FontAwesome Icon="Solid_FileExcel" FontSize="16" Opacity="0.7" VerticalAlignment="Center"
                               Visibility="{Binding IsSheet, Converter={StaticResource boolToVisibility}}" />
               <fa:FontAwesome Icon="Solid_FileWord" FontSize="16" Opacity="0.7" VerticalAlignment="Center"
                               Visibility="{Binding IsWriter, Converter={StaticResource boolToVisibility}}" />
               <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                          TextTrimming="CharacterEllipsis" Text="{Binding FileName}" />
               <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource secondaryCellStyle}"
                          Text="Read only" />
               <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource secondaryCellStyle}"
                          Text="{Binding WarningCaption}" ToolTip="{Binding WarningDetails}"
                          Visibility="{Binding HasWarnings, Converter={StaticResource boolToVisibility}}" />
            </StackPanel>
         </DockPanel>

         <!-- ==== editor ==== -->
         <Border Grid.Row="1" Margin="22,0,22,22" Style="{StaticResource cardStyle}">
            <Grid>
               <ContentControl x:Name="EditorHost" Focusable="False"
                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

               <StackPanel VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="40"
                           IsHitTestVisible="False"
                           Visibility="{Binding HasError, Converter={StaticResource boolToVisibility}}">
                  <fa:FontAwesome Icon="Solid_FileCircleExclamation"
                                  FontSize="34"
                                  Opacity="0.35"
                                  HorizontalAlignment="Center" />
                  <TextBlock Text="The document could not be opened"
                             Margin="0,14,0,0"
                             FontSize="15"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding ErrorMessage}"
                             Margin="0,4,0,0"
                             MaxWidth="560"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             Style="{StaticResource fieldHelpStyle}"
                             HorizontalAlignment="Center" />
               </StackPanel>
            </Grid>
         </Border>
      </Grid>

      <core:WaitOverlay IsWaiting="{Binding InWaiting}" Caption="{Binding WaiterText}" />
   </Grid>
</UserControl>
