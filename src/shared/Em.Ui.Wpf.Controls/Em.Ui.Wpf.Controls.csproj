<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <!-- See doc/engine/build.md#xml-docs -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Em.Ui.Wpf.Controls</RootNamespace>
        <Description>WPF controls for Em System: the MatrixGrid data grid, the MatrixSheet spreadsheet editor, the MatrixWriter word-processing editor, value editors and print preview.</Description>
        <Title>Em System WPF controls</Title>
        <PackageTags>em-system;wpf;datagrid;spreadsheet;word-processing;print-preview</PackageTags>
    </PropertyGroup>

    <!-- The code under Grid, Editors, Editing, Menus, Printing, Sheet, Writer and Themes is synced from MatrixGrid;
         see doc/engine/engine-documents.md#sync. Only the files listed as owned in scripts/sync-matrixgrid/map.json
         are edited here. -->

    <ItemGroup>
        <ProjectReference Include="..\Em.Libs\Em.Libs.csproj" />
        <ProjectReference Include="..\Em.Ui.Core\Em.Ui.Core.csproj" />
        <ProjectReference Include="..\Em.Ui.Wpf.Core\Em.Ui.Wpf.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Themes\Fonts\*.ttf" />
        <!-- The WPF font provider loads the bundled document font through a pack URI into this assembly. -->
        <Resource Include="..\Em.Libs\Documents\Assets\NotoSans-Regular.ttf" Link="Documents\Assets\NotoSans-Regular.ttf" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
        <None Include="..\..\..\licenses\*" Pack="true" PackagePath="licenses/" Visible="false" />
    </ItemGroup>

</Project>
