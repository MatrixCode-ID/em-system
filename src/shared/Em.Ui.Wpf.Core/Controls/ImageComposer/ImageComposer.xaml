<UserControl x:Class="Em.Ui.Wpf.Controls.ImageComposer"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Em.Ui.Wpf.Controls"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Focusable="True" PreviewKeyDown="OnKeyDown" GotKeyboardFocus="OnFocus">
   <UserControl.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/>
         </ResourceDictionary.MergedDictionaries>
         <BooleanToVisibilityConverter x:Key="visibility"/>
         <local:ComposerChoiceConverter x:Key="choice"/>
         <Style x:Key="icon" TargetType="Button" BasedOn="{StaticResource flatIconButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
         </Style>
         <Style x:Key="toggle" TargetType="ToggleButton" BasedOn="{StaticResource flatIconButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
               <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Background" Value="{DynamicResource surfaceStrongBrush}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource themeAccentBrush}"/>
                  <Setter Property="BorderThickness" Value="2"/>
               </Trigger>
            </Style.Triggers>
         </Style>
         <Style x:Key="divider" TargetType="Border">
            <Setter Property="Width" Value="1"/><Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,0,14,0"/>
            <Setter Property="Background" Value="{DynamicResource outlineBrush}"/>
         </Style>
         <DataTemplate DataType="{x:Type local:ComposerImageItem}">
            <local:ComposerItemPresenter Item="{Binding}" Width="{Binding DataContext.CanvasWidthMm, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         Height="{Binding DataContext.CanvasHeightMm, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
         </DataTemplate>
         <DataTemplate DataType="{x:Type local:ComposerArrowItem}">
            <local:ComposerItemPresenter Item="{Binding}" Width="{Binding DataContext.CanvasWidthMm, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         Height="{Binding DataContext.CanvasHeightMm, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
         </DataTemplate>
      </ResourceDictionary>
   </UserControl.Resources>
   <Grid DataContext="{Binding Composer, ElementName=Root}" Background="{DynamicResource themeWindowBackgroundBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel Margin="8,8,0,8" Visibility="{Binding ShowToolbar, ElementName=Root, Converter={StaticResource visibility}}">
         <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="{Binding ActualWidth, ElementName=Workspace}">
            <StackPanel Orientation="Horizontal">
               <Button Style="{StaticResource icon}" ToolTip="Insert images" Command="{Binding Commands[InsertCommand]}"><fa:FontAwesome Icon="Solid_Image"/></Button>
               <Button Style="{StaticResource icon}" ToolTip="Paste (Ctrl+V)" Command="{Binding Commands[PasteCommand]}"><fa:FontAwesome Icon="Solid_Paste"/></Button>
               <Border Style="{StaticResource divider}"/>
               <Button Style="{StaticResource icon}" ToolTip="Delete selected item" Command="{Binding Commands[DeleteCommand]}"><fa:FontAwesome Icon="Solid_TrashCan"/></Button>
               <Button Style="{StaticResource icon}" ToolTip="Bring to front" Command="{Binding Commands[BringToFrontCommand]}"><fa:FontAwesome Icon="Solid_AnglesUp"/></Button>
               <Button Style="{StaticResource icon}" ToolTip="Send to back" Command="{Binding Commands[SendToBackCommand]}"><fa:FontAwesome Icon="Solid_AnglesDown"/></Button>
               <Button Style="{StaticResource icon}" ToolTip="Fit image to canvas" Command="{Binding Commands[FitCommand]}"><fa:FontAwesome Icon="Solid_Expand"/></Button>
               <Button Style="{StaticResource icon}" ToolTip="Crop selected image permanently" Command="{Binding Commands[CropCommand]}"><fa:FontAwesome Icon="Solid_CropSimple"/></Button>
               <StackPanel Orientation="Horizontal" Visibility="{Binding IsCropping, Converter={StaticResource visibility}}">
                  <Button Style="{StaticResource icon}" ToolTip="Apply permanent crop" Command="{Binding Commands[ApplyCropCommand]}"><fa:FontAwesome Icon="Solid_Check"/></Button>
                  <Button Style="{StaticResource icon}" ToolTip="Cancel crop (Esc)" Command="{Binding Commands[CancelCropCommand]}"><fa:FontAwesome Icon="Solid_Xmark"/></Button>
               </StackPanel>
               <Border Style="{StaticResource divider}"/>
               <ToggleButton Style="{StaticResource toggle}" ToolTip="Draw arrow" IsChecked="{Binding IsArrowTool, Mode=OneWay}" Command="{Binding Commands[ArrowToolCommand]}"><fa:FontAwesome Icon="Solid_ArrowRightLong"/></ToggleButton>
               <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEdit}">
                  <RadioButton Style="{StaticResource toggle}" ToolTip="Red arrow ink" IsChecked="{Binding ArrowColor, Converter={StaticResource choice}, ConverterParameter=Red}"><fa:FontAwesome Icon="Solid_Square" Foreground="#D32F2F"/></RadioButton>
                  <RadioButton Style="{StaticResource toggle}" ToolTip="Black arrow ink" IsChecked="{Binding ArrowColor, Converter={StaticResource choice}, ConverterParameter=Black}"><fa:FontAwesome Icon="Solid_Square" Foreground="#000000"/></RadioButton>
                  <RadioButton Style="{StaticResource toggle}" ToolTip="Blue arrow ink" IsChecked="{Binding ArrowColor, Converter={StaticResource choice}, ConverterParameter=Blue}"><fa:FontAwesome Icon="Solid_Square" Foreground="#1565C0"/></RadioButton>
                  <RadioButton Style="{StaticResource toggle}" ToolTip="Yellow arrow ink" IsChecked="{Binding ArrowColor, Converter={StaticResource choice}, ConverterParameter=Yellow}"><fa:FontAwesome Icon="Solid_Square" Foreground="#F9A825"/></RadioButton>
                  <ComboBox Width="84" Height="38" Margin="0,0,8,0" Style="{StaticResource fieldComboStyle}" SelectedItem="{Binding ArrowThicknessMm}"
                            ToolTip="Arrow shaft thickness in millimeters" AutomationProperties.Name="Arrow thickness">
                     <ComboBox.ItemsSource><x:Array Type="{x:Type sys:Double}"><sys:Double>0.5</sys:Double><sys:Double>1</sys:Double><sys:Double>2</sys:Double></x:Array></ComboBox.ItemsSource>
                     <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} mm}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
               </StackPanel>
            </StackPanel>
         </ScrollViewer>
         <StackPanel Orientation="Horizontal" Visibility="{Binding IsCanvasSizeEditable, Converter={StaticResource visibility}}"
                     IsEnabled="{Binding CanEditCanvasSize}" ToolTip="Canvas size: 10–1000 mm. Saved images lock these inputs until Clear." ToolTipService.ShowOnDisabled="True">
            <TextBlock Text="W" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource themeWindowForegroundBrush}"/>
            <local:NumericBox Value="{Binding CanvasWidthMm}" Minimum="10" Maximum="1000" Width="80" Height="38" Style="{StaticResource fieldNumericBoxStyle}" AutomationProperties.Name="Canvas width in millimeters"/>
            <TextBlock Text="× H" Margin="8,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource themeWindowForegroundBrush}"/>
            <local:NumericBox Value="{Binding CanvasHeightMm}" Minimum="10" Maximum="1000" Width="80" Height="38" Style="{StaticResource fieldNumericBoxStyle}" AutomationProperties.Name="Canvas height in millimeters"/>
            <TextBlock Text="mm" Margin="4,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource themeWindowForegroundBrush}"/>
         </StackPanel>
         <Button Style="{StaticResource icon}" ToolTip="Clear canvas" Command="{Binding Commands[ClearCommand]}"><fa:FontAwesome Icon="Solid_Eraser"/></Button>
      </WrapPanel>
      <Border x:Name="Workspace" Grid.Row="1" Background="{DynamicResource surfaceBrush}" Padding="18" SizeChanged="OnWorkspaceSizeChanged">
         <Viewbox Stretch="Uniform">
            <Grid x:Name="CanvasHost" Width="{Binding CanvasWidthMm}" Height="{Binding CanvasHeightMm}"
                  Background="Transparent" MouseLeftButtonDown="OnPointerDown" MouseMove="OnPointerMove" MouseLeftButtonUp="OnPointerUp" LostMouseCapture="OnLostCapture">
               <Grid ClipToBounds="True" Background="White">
                  <Image Source="{Binding InitialImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                  <ItemsControl ItemsSource="{Binding Items}" IsHitTestVisible="False">
                     <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
               </Grid>
               <local:ComposerOverlay x:Name="Overlay" Composer="{Binding}" IsHitTestVisible="False"/>
            </Grid>
         </Viewbox>
      </Border>
   </Grid>
</UserControl>
