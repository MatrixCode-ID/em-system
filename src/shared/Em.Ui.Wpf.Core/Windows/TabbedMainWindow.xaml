<Window x:Class="Em.Ui.Wpf.Windows.TabbedMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Em.Ui.Wpf.Windows"
        xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
        xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowState="{Binding WindowState, Mode=TwoWay}"
        Icon="pack://application:,,,/Em.Ui.Wpf.Core;component/Assets/Icons/Logo.ico"
        WindowStartupLocation="CenterScreen"
        Height="760"
        Width="1200"
        MinHeight="400"
        MinWidth="640">
    <Window.DataContext>
        <local:TabbedMainWindowVm />
    </Window.DataContext>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="titleBarToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource flatIconButtonStyle}">
                <Setter Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{StaticResource flatIconButtonPressedBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource flatIconButtonPressedBorder}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="appsButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource titleBarToggleStyle}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Padding" Value="12,0" />
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                                    </BooleanAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                                        <DiscreteBooleanKeyFrame KeyTime="0:0:0.2" Value="True" />
                                    </BooleanAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="accountButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource titleBarToggleStyle}">
                <Setter Property="Width" Value="54" />
            </Style>

            <Style x:Key="menuRowStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="highlight"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="highlight" Property="Background" Value="{StaticResource stateHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="highlight" Property="Background" Value="{StaticResource statePressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="highlight" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="menuPopupBorderStyle" TargetType="Border">
                <Setter Property="Margin" Value="8,0,8,8" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource outlineStrongBrush}" />
                <Setter Property="Background" Value="{DynamicResource themePopupBackgroundBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.3" Color="#000000" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="appsMenuStyle" TargetType="ContextMenu">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Placement" Value="Bottom" />
                <Setter Property="HorizontalOffset" Value="-8" />
                <Setter Property="VerticalOffset" Value="2" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="MinWidth" Value="240" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Style="{StaticResource menuPopupBorderStyle}"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    Background="{TemplateBinding Background}">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ItemsSource" Value="{Binding Items}" />
                        <Setter Property="Command"
                                Value="{Binding DataContext.Commands[OpenMenuItemCommand], RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- Divider above the first item of a new group (StartsGroup), e.g. after
                                             the connection and debug tools at the top of the Tools menu. -->
                                        <Border x:Name="divider"
                                                Height="1"
                                                Margin="6,5"
                                                Visibility="Collapsed"
                                                Background="{StaticResource outlineBrush}" />
                                        <Border x:Name="highlight"
                                                Grid.Row="1"
                                                MinHeight="34"
                                                Padding="10,6"
                                                CornerRadius="6"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image x:Name="icon"
                                                       Grid.Column="0"
                                                       Width="16"
                                                       Height="16"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       Source="{Binding Icon}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               FontSize="11"
                                                               Opacity="0.7"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <fa:FontAwesome x:Name="arrow"
                                                                Grid.Column="2"
                                                                Margin="12,0,0,0"
                                                                FontSize="9"
                                                                VerticalAlignment="Center"
                                                                Visibility="Collapsed"
                                                                Icon="Solid_ChevronRight" />
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="PART_Popup"
                                               Grid.Row="1"
                                               Placement="Right"
                                               HorizontalOffset="-2"
                                               VerticalOffset="-7"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Fade"
                                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Border Style="{StaticResource menuPopupBorderStyle}"
                                                    MinWidth="220"
                                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                            <Setter TargetName="divider" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger Property="HasItems" Value="True">
                                            <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="highlight" Property="Background" Value="{StaticResource stateHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSubmenuOpen" Value="True">
                                            <Setter TargetName="highlight" Property="Background" Value="{StaticResource stateHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="highlight" Property="Background" Value="{StaticResource statePressedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="highlight" Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
            </Style>

            <Style x:Key="titleBarComboItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="itemSurface"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="itemSurface" Property="Background" Value="{StaticResource stateHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="itemSurface" Property="Background" Value="{StaticResource statePressedBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="titleBarComboToggleStyle" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="shape"
                                    CornerRadius="16"
                                    Background="{StaticResource surfaceStrongBrush}"
                                    BorderBrush="{StaticResource outlineBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Border x:Name="stateLayer" CornerRadius="16" Background="Transparent" />
                                    <fa:FontAwesome FontSize="12"
                                                    Margin="12,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Icon="Solid_Server" />
                                    <fa:FontAwesome x:Name="chevron"
                                                    FontSize="9"
                                                    Opacity="0.6"
                                                    Margin="0,0,12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Icon="Solid_ChevronDown" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="stateLayer" Property="Background" Value="{StaticResource stateHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="chevron" Property="Icon" Value="Solid_ChevronUp" />
                                    <Setter TargetName="shape" Property="BorderBrush"
                                            Value="{DynamicResource themeAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="titleBarComboStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource titleBarComboItemStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Style="{StaticResource titleBarComboToggleStyle}"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Margin="32,0,30,0"
                                                  IsHitTestVisible="False"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       HorizontalOffset="-8"
                                       VerticalOffset="2"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Style="{StaticResource menuPopupBorderStyle}">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="tabContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="MinWidth" Value="220" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="{Binding PlacementTarget.Background, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground" Value="{Binding PlacementTarget.Foreground, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Style="{StaticResource menuPopupBorderStyle}"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    Background="{TemplateBinding Background}">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="highlight"
                                            MinHeight="32"
                                            Padding="10,6"
                                            CornerRadius="6"
                                            Background="Transparent">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="highlight" Property="Background" Value="{StaticResource stateHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="highlight" Property="Background" Value="{StaticResource statePressedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="highlight" Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Separator">
                                    <Border Height="1" Margin="0,6" Background="{StaticResource dividerBrush}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
            </Style>

            <Style x:Key="tabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource flatIconButtonStyle}">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- Reload sits in the tab next to close, so it is drawn larger and tinted to tell the two
                 apart at a glance: an accent icon on an accent wash, the same 14% wash the status chips
                 use. Both come from the theme accent, so the button follows light and dark on its own. -->
            <Style x:Key="tabReloadButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource themeAccentBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="wash"
                                        CornerRadius="12"
                                        Opacity="0.14"
                                        Background="{DynamicResource themeAccentBrush}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="wash" Property="Opacity" Value="0.24" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="wash" Property="Opacity" Value="0.34" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="tabScrollButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource flatIconButtonStyle}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Delay" Value="300" />
                <Setter Property="Interval" Value="60" />
            </Style>

            <Style x:Key="tabListButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource titleBarToggleStyle}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <Style x:Key="tabStripStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <controls:TabStripPanel MinItemWidth="130" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Focusable="False"
                                              CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <DockPanel>
                                                <RepeatButton DockPanel.Dock="Left"
                                                              ToolTip="Scroll left"
                                                              Command="{x:Static ScrollBar.LineLeftCommand}"
                                                              Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                              Style="{StaticResource tabScrollButtonStyle}">
                                                    <fa:FontAwesome FontSize="10" Icon="Solid_ChevronLeft" />
                                                </RepeatButton>
                                                <RepeatButton DockPanel.Dock="Right"
                                                              ToolTip="Scroll right"
                                                              Command="{x:Static ScrollBar.LineRightCommand}"
                                                              Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                              Style="{StaticResource tabScrollButtonStyle}">
                                                    <fa:FontAwesome FontSize="10" Icon="Solid_ChevronRight" />
                                                </RepeatButton>
                                                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                                            </DockPanel>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter />
                                </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Foreground"
                                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="ToolTip" Value="{Binding Title}" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="Background" Value="{DynamicResource themePopupBackgroundBrush}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                 Style="{StaticResource tabContextMenuStyle}">
                                        <MenuItem Header="Reload"
                                                  Command="{Binding PlacementTarget.Tag.Commands[ReloadTabCommand], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Close"
                                                  Command="{Binding PlacementTarget.Tag.Commands[CloseTabCommand], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Close Others"
                                                  Command="{Binding PlacementTarget.Tag.Commands[CloseOtherTabsCommand], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Close to the Right"
                                                  Command="{Binding PlacementTarget.Tag.Commands[CloseTabsToRightCommand], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Move to New Window"
                                                  Command="{Binding PlacementTarget.Tag.Commands[MoveTabToNewWindowCommand], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Height="40">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="MiddleClick"
                                                              Command="{Binding DataContext.Commands[CloseTabCommand], RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Border x:Name="stateLayer"
                                                        Margin="2,5"
                                                        CornerRadius="8"
                                                        Background="Transparent">
                                                    <DockPanel Margin="12,0,6,0" VerticalAlignment="Center">
                                                        <Button x:Name="closeButton"
                                                                DockPanel.Dock="Right"
                                                                Margin="4,0,0,0"
                                                                Visibility="Hidden"
                                                                ToolTip="Close"
                                                                Style="{StaticResource tabCloseButtonStyle}"
                                                                Command="{Binding DataContext.Commands[CloseTabCommand], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <fa:FontAwesome FontSize="10" Icon="Solid_Xmark" />
                                                        </Button>
                                                        <Button x:Name="reloadButton"
                                                                DockPanel.Dock="Right"
                                                                Visibility="Hidden"
                                                                ToolTip="Reload"
                                                                Style="{StaticResource tabReloadButtonStyle}"
                                                                Command="{Binding DataContext.Commands[ReloadTabCommand], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <fa:FontAwesome Icon="Solid_RotateRight" />
                                                        </Button>
                                                        <TextBlock Text="{Binding Title}"
                                                                   MaxWidth="200"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                                <Border x:Name="indicator"
                                                        Height="3"
                                                        Margin="10,0"
                                                        CornerRadius="2,2,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Visibility="Hidden"
                                                        Background="{DynamicResource themeAccentBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="stateLayer" Property="Background" Value="{StaticResource stateHoverBrush}" />
                                                <Setter TargetName="closeButton" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="reloadButton" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="closeButton" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="reloadButton" Property="Visibility" Value="Visible" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="stateLayer" Property="TextElement.Foreground"
                                                        Value="{DynamicResource themeAccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource themeWindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="BorderThickness" Value="{x:Static local:EmWindow.MaximizedBorderThickness}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==== title bar ==== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,8,0" VerticalAlignment="Center">
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                       Width="18" Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Title}"
                           Margin="8,0,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ToggleButton x:Name="appsButton"
                          Grid.Column="1"
                          Margin="4,0"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          Visibility="{Binding WorkspaceToolsVisibility}"
                          IsChecked="{Binding IsAppsMenuOpen, Mode=TwoWay}"
                          ClickMode="Press"
                          Style="{StaticResource appsButtonStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:FontAwesome FontSize="14" Icon="Solid_TableCellsLarge" VerticalAlignment="Center" />
                    <TextBlock Text="Apps" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                    <fa:FontAwesome FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" Icon="Solid_ChevronDown" />
                </StackPanel>
                <ToggleButton.ContextMenu>
                    <ContextMenu x:Name="appsMenu"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 ItemsSource="{Binding AppMenu}"
                                 IsOpen="{Binding IsAppsMenuOpen, Mode=TwoWay}"
                                 Background="{DynamicResource themePopupBackgroundBrush}"
                                 Foreground="{DynamicResource themeWindowForegroundBrush}"
                                 Style="{StaticResource appsMenuStyle}" />
                </ToggleButton.ContextMenu>
            </ToggleButton>

            <ListBox x:Name="tabStrip"
                     Grid.Column="2"
                     HorizontalAlignment="Left"
                     WindowChrome.IsHitTestVisibleInChrome="True"
                     Visibility="{Binding TabStripVisibility}"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     local:TabbedMainWindowTabDrag.IsEnabled="True"
                     Style="{StaticResource tabStripStyle}" />

            <ToggleButton x:Name="tabListButton"
                          Grid.Column="3"
                          Margin="4,0"
                          ToolTip="All tabs"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          Visibility="{Binding TabListButtonVisibility}"
                          IsChecked="{Binding IsTabListOpen, Mode=TwoWay}"
                          Style="{StaticResource tabListButtonStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tabs.Count}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <fa:FontAwesome FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" Icon="Solid_ChevronDown" />
                </StackPanel>
            </ToggleButton>
            <Popup PlacementTarget="{Binding ElementName=tabListButton}"
                   Placement="Bottom"
                   HorizontalOffset="-8"
                   VerticalOffset="4"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   IsOpen="{Binding IsTabListOpen, Mode=TwoWay}">
                <Border Width="300" Style="{StaticResource menuPopupBorderStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Height="32"
                                Margin="2,2,2,6"
                                Style="{StaticResource searchFieldStyle}"
                                Visibility="{Binding IsTabSearchVisible, Converter={StaticResource boolToVisibility}}">
                            <DockPanel Margin="12,0">
                                <fa:FontAwesome DockPanel.Dock="Left"
                                                FontSize="11"
                                                Opacity="0.6"
                                                VerticalAlignment="Center"
                                                Icon="Solid_MagnifyingGlass" />
                                <TextBox Margin="8,0,0,0"
                                         Tag="Search tabs"
                                         Style="{StaticResource searchBoxStyle}"
                                         Text="{Binding TabListFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer MaxHeight="360"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TabListItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource menuRowStyle}"
                                                Command="{Binding DataContext.Commands[SelectTabCommand], RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        ToolTip="Close"
                                                        Style="{StaticResource tabCloseButtonStyle}"
                                                        Command="{Binding DataContext.Commands[CloseTabCommand], RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <fa:FontAwesome FontSize="10" Icon="Solid_Xmark" />
                                                </Button>
                                                <Border x:Name="activeMark"
                                                        DockPanel.Dock="Left"
                                                        Width="3"
                                                        Height="16"
                                                        Margin="0,0,8,0"
                                                        CornerRadius="2"
                                                        Visibility="Hidden"
                                                        Background="{DynamicResource themeAccentBrush}" />
                                                <TextBlock x:Name="title"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="activeMark" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>

            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Simulate Login: says the debug build is running as without debug, and is the way
                     back to the debugger whatever the signed-in account may open. -->
                <Border Margin="2,0,8,0"
                        Padding="10,2,4,2"
                        Style="{StaticResource chipWarningStyle}"
                        Visibility="{Binding SimulatedChipVisibility}"
                        ToolTip="Debug build running as without debug (Simulate Login)">
                    <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_Flask" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="SIMULATED" VerticalAlignment="Center" />
                        <Button Margin="6,0,0,0"
                                Width="22" Height="22"
                                FontSize="11"
                                Foreground="{StaticResource warningBrush}"
                                Command="{Binding Commands[ExitSimulationCommand]}"
                                ToolTip="Exit simulation and go back to the debugger"
                                AutomationProperties.Name="Exit simulation and go back to the debugger"
                                Style="{StaticResource flatIconButtonStyle}">
                            <fa:FontAwesome Icon="Solid_RightFromBracket" />
                        </Button>
                    </StackPanel>
                </Border>
                <ComboBox Margin="2,0,6,0"
                          ToolTip="Connection"
                          Visibility="{Binding ConnectionVisibility}"
                          ItemsSource="{Binding Connections}"
                          SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                          Style="{StaticResource titleBarComboStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ToggleButton x:Name="toolsButton"
                              Margin="2,0"
                              Visibility="{Binding WorkspaceToolsVisibility}"
                              IsChecked="{Binding IsToolsMenuOpen, Mode=TwoWay}"
                              ClickMode="Press"
                              Style="{StaticResource appsButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:FontAwesome FontSize="14" Icon="Solid_Wrench" VerticalAlignment="Center" />
                        <TextBlock Text="Tools" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                        <fa:FontAwesome FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" Icon="Solid_ChevronDown" />
                    </StackPanel>
                    <ToggleButton.ContextMenu>
                        <ContextMenu x:Name="toolsMenu"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     ItemsSource="{Binding ToolsMenu}"
                                     IsOpen="{Binding IsToolsMenuOpen, Mode=TwoWay}"
                                     Background="{DynamicResource themePopupBackgroundBrush}"
                                     Foreground="{DynamicResource themeWindowForegroundBrush}"
                                     Style="{StaticResource appsMenuStyle}" />
                    </ToggleButton.ContextMenu>
                </ToggleButton>
                <ToggleButton x:Name="taskHubButton"
                              Margin="2,0"
                              ToolTip="Tasks"
                              Visibility="{Binding TaskHubVisibility}"
                              IsChecked="{Binding IsTaskHubOpen, Mode=TwoWay}"
                              Style="{StaticResource titleBarToggleStyle}">
                    <Grid Width="26" Height="26">
                        <fa:FontAwesome FontSize="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                            <fa:FontAwesome.Style>
                                <Style TargetType="fa:FontAwesome">
                                    <Setter Property="Icon" Value="Solid_ListCheck" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTaskHubBusy}" Value="True">
                                            <Setter Property="Icon" Value="Solid_Spinner" />
                                            <Setter Property="Spin" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fa:FontAwesome.Style>
                        </fa:FontAwesome>
                        <Border Margin="0,-5,-7,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource countBadgeStyle}"
                                Visibility="{Binding IsTaskHubBusy, Converter={StaticResource boolToVisibility}}">
                            <TextBlock Text="{Binding TaskHubAliveCount}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Margin="-3,-1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Fill="{StaticResource warningBrush}" Style="{StaticResource attentionDotStyle}"
                                 Visibility="{Binding HasHubTasks, Converter={StaticResource boolToVisibility}}" />
                        <Ellipse Margin="0,0,-3,-1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Visibility="{Binding TaskHubHasUnseen, Converter={StaticResource boolToVisibility}}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource attentionDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TaskHubHasUnseenFailure}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource dangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=taskHubButton}"
                       Placement="Bottom"
                       HorizontalOffset="-330"
                       VerticalOffset="2"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Focusable="False"
                       StaysOpen="False"
                       IsOpen="{Binding IsTaskHubOpen, Mode=TwoWay}">
                    <Border Width="360" Style="{StaticResource menuPopupBorderStyle}">
                        <StackPanel>
                            <TextBlock Margin="10,6,10,8" Text="MY TASKS" Style="{StaticResource sectionCaptionStyle}" />
                            <Border Height="1" Margin="0,0,0,6" Background="{StaticResource dividerBrush}" />
                            <TextBlock Margin="10,10,10,14"
                                       Text="Nothing needs your attention"
                                       Opacity="0.6"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding IsTaskHubEmpty, Converter={StaticResource boolToVisibility}}" />
                            <TextBlock Margin="10,4,10,8" FontSize="11" Foreground="{StaticResource dangerBrush}"
                                       Text="Approval tasks could not be loaded"
                                       Visibility="{Binding HubTaskLoadFailed, Converter={StaticResource boolToVisibility}}" />
                            <ScrollViewer MaxHeight="380"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource materialVerticalScrollBarStyle}" />
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <TextBlock Margin="10,6,10,8" Text="RUNNING" Style="{StaticResource sectionCaptionStyle}"
                                               Visibility="{Binding HasRunningTasks, Converter={StaticResource boolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding TaskHubItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="10,7"
                                                        Style="{StaticResource menuRowStyle}"
                                                        Command="{Binding DataContext.Commands[OpenTaskCommand], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <fa:FontAwesome x:Name="statusIcon"
                                                                        DockPanel.Dock="Left"
                                                                        Width="18"
                                                                        Margin="0,2,8,0"
                                                                        FontSize="13"
                                                                        Opacity="0.7"
                                                                        VerticalAlignment="Top"
                                                                        Icon="{Binding StatusIcon}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Opacity="0.7"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding StatusCaption, Mode=OneWay}" />
                                                                <Run x:Name="captionSeparator" Text="·" />
                                                                <Run Text="{Binding Caption, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <ProgressBar Style="{StaticResource hairlineProgressStyle}"
                                                                         Margin="0,5,0,1"
                                                                         Value="{Binding Percent, Mode=OneWay}"
                                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                                         Visibility="{Binding IsAlive, Converter={StaticResource boolToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter TargetName="statusIcon" Property="Spin" Value="True" />
                                                    <Setter TargetName="statusIcon" Property="Opacity" Value="1" />
                                                    <Setter TargetName="statusIcon" Property="Foreground" Value="{DynamicResource themeAccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Succeeded">
                                                    <Setter TargetName="statusIcon" Property="Opacity" Value="1" />
                                                    <Setter TargetName="statusIcon" Property="Foreground" Value="{StaticResource successBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter TargetName="statusIcon" Property="Opacity" Value="1" />
                                                    <Setter TargetName="statusIcon" Property="Foreground" Value="{StaticResource dangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Caption}" Value="">
                                                    <Setter TargetName="captionSeparator" Property="Text" Value="" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding HubTaskSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Margin="10,6,10,8" Text="{Binding Title}" Style="{StaticResource sectionCaptionStyle}" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="10,5,10,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,2,0,0" FontSize="11" Opacity="0.7">
                                                                        <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" waiting" />
                                                                        <Run Text="{Binding OldestAgeText, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="{Binding ActionName}" Style="{StaticResource outlinedButtonStyle}"
                                                                        VerticalAlignment="Center" Padding="12,0" Height="30"
                                                                        Visibility="{Binding CanOpen, Converter={StaticResource boolToVisibility}}"
                                                                        Command="{Binding DataContext.Commands[OpenHubTaskCommand], RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button Margin="2,0"
                        ToolTip="Color Theme"
                        Visibility="{Binding WorkspaceToolsVisibility}"
                        Command="{Binding Commands[ColorThemeCommand]}"
                        Style="{StaticResource flatIconButtonStyle}">
                    <fa:FontAwesome FontSize="18" Icon="Solid_CircleHalfStroke" />
                </Button>
            </StackPanel>

            <ToggleButton x:Name="accountButton"
                          Grid.Column="5"
                          Margin="2,0,8,0"
                          ToolTip="{Binding AccountToolTip}"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          Visibility="{Binding WorkspaceToolsVisibility}"
                          IsChecked="{Binding IsUserMenuOpen, Mode=TwoWay}"
                          Style="{StaticResource accountButtonStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{Binding UserAvatarBrush}">
                        <TextBlock Text="{Binding UserInitials}"
                                   FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <fa:FontAwesome FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" Icon="Solid_ChevronDown" />
                </StackPanel>
            </ToggleButton>
            <Popup PlacementTarget="{Binding ElementName=accountButton}"
                   Placement="Bottom"
                   HorizontalOffset="-204"
                   VerticalOffset="2"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Focusable="False"
                   StaysOpen="False"
                   IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}">
                <Border Width="250" Style="{StaticResource menuPopupBorderStyle}">
                    <StackPanel>
                        <Grid Margin="4,6,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="38" Height="38"
                                    CornerRadius="19"
                                    Background="{Binding UserAvatarBrush}">
                                <TextBlock Text="{Binding UserInitials}"
                                           FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserDisplayName}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UserAccount}"
                                           FontSize="11" Opacity="0.7"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Margin="0,0,0,6" Background="{StaticResource dividerBrush}" />
                        <Button Command="{Binding Commands[ChangePasswordCommand]}"
                                Style="{StaticResource menuRowStyle}">
                            <StackPanel Orientation="Horizontal">
                                <fa:FontAwesome FontSize="13" Width="18" Icon="Solid_Key" VerticalAlignment="Center" />
                                <TextBlock Text="Change Password" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Height="1" Margin="0,6" Background="{StaticResource dividerBrush}"
                                Visibility="{Binding SignOutVisibility}" />
                        <Button Command="{Binding Commands[SignOutCommand]}"
                                Visibility="{Binding SignOutVisibility}"
                                Style="{StaticResource menuRowStyle}">
                            <StackPanel Orientation="Horizontal">
                                <fa:FontAwesome FontSize="13" Width="18" Icon="Solid_RightFromBracket" VerticalAlignment="Center" />
                                <TextBlock Text="Sign Out" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <StackPanel Grid.Column="6"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button ToolTip="Minimize"
                        Command="{Binding Commands[MinimizeCommand]}"
                        Style="{StaticResource captionButtonStyle}"
                        Content="&#xE921;" />
                <Button Command="{Binding Commands[MaximizeRestoreCommand]}"
                        Style="{StaticResource captionButtonStyle}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE922;" />
                                <Setter Property="ToolTip" Value="Maximize" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState}" Value="Maximized">
                                        <Setter Property="Text" Value="&#xE923;" />
                                        <Setter Property="ToolTip" Value="Restore" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button ToolTip="Close"
                        Command="{Binding Commands[CloseWindowCommand]}"
                        Style="{StaticResource closeCaptionButtonStyle}"
                        Content="&#xE8BB;" />
            </StackPanel>
        </Grid>

        <!-- ==== content ==== -->
        <Border Grid.Row="1"
                Margin="8,0,8,8"
                CornerRadius="14"
                Background="{StaticResource surfaceBrush}"
                BorderBrush="{StaticResource outlineBrush}"
                BorderThickness="1">
            <Grid>
                <!-- The presenter is not a keyboard destination; focus belongs to the body controls. -->
                <ContentControl Content="{Binding CardContent}" ClipToBounds="True"
                                Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}" />
                <TextBlock Text="No tab open"
                           Opacity="0.55"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmptyHintVisible, Converter={StaticResource boolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ==== status bar ==== -->
        <!-- Main window only: a torn-off window holds tabs and nothing else. -->
        <controls:EmStatusBar Grid.Row="2"
                              Text="{Binding StatusBar.Text}"
                              LeftItems="{Binding StatusBar.LeftItems}"
                              RightItems="{Binding StatusBar.RightItems}">
            <controls:EmStatusBar.Style>
                <Style TargetType="controls:EmStatusBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusBar.IsVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ClosesWhenEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:EmStatusBar.Style>
        </controls:EmStatusBar>
    </Grid>
</Window>
