<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
                    xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                    xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows">

   <!--
      Default styles for the lookless controls of this assembly. AssemblyInfo declares the
      generic dictionary as living in the source assembly, so anything given a default style
      key here is picked up without the host merging a dictionary of its own.
   -->

   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
      <!-- The caption buttons EmWindow shares with the main window. -->
      <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/Window.xaml" />
   </ResourceDictionary.MergedDictionaries>

   <!-- ============================================================
        EM WINDOW
        A window with a title bar of its own: icon, title, an optional
        piece of content, and the caption buttons, all on the theme's
        window surface so a dialog reads like the main window beside it.

        The caption buttons follow ResizeMode the way the system ones
        do, and the Show*Button switches hide them on top of that.
        ============================================================ -->
   <Style TargetType="{x:Type windows:EmWindow}">
      <Setter Property="Background" Value="{DynamicResource themeWindowBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource outlineStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Icon" Value="pack://application:,,,/Em.Ui.Wpf.Core;component/Assets/Icons/Logo.ico" />
      <Setter Property="WindowChrome.WindowChrome">
         <Setter.Value>
            <WindowChrome CaptionHeight="40"
                          ResizeBorderThickness="6"
                          GlassFrameThickness="0"
                          CornerRadius="0"
                          UseAeroCaptionButtons="False" />
         </Setter.Value>
      </Setter>
      <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="{x:Type windows:EmWindow}">
               <Border x:Name="frame"
                       Background="{TemplateBinding Background}"
                       BorderBrush="{TemplateBinding BorderBrush}"
                       BorderThickness="{TemplateBinding BorderThickness}">
                  <Grid>
                     <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                     </Grid.RowDefinitions>

                     <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="*" />
                           <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="titleArea"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                           <Image x:Name="icon"
                                  Source="{TemplateBinding Icon}"
                                  Width="16" Height="16"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  RenderOptions.BitmapScalingMode="HighQuality" />
                           <TextBlock Text="{TemplateBinding Title}"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding TitleBarContent}"
                                          WindowChrome.IsHitTestVisibleInChrome="True" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                           <Button x:Name="minimizeButton"
                                   ToolTip="Minimize"
                                   Style="{StaticResource captionButtonStyle}"
                                   Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                   Content="&#xE921;" />
                           <Button x:Name="maximizeButton"
                                   ToolTip="Maximize"
                                   Style="{StaticResource captionButtonStyle}"
                                   Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                   Content="&#xE922;" />
                           <Button x:Name="restoreButton"
                                   ToolTip="Restore"
                                   Visibility="Collapsed"
                                   Style="{StaticResource captionButtonStyle}"
                                   Command="{x:Static SystemCommands.RestoreWindowCommand}"
                                   Content="&#xE923;" />
                           <Button ToolTip="Close"
                                   Style="{StaticResource closeCaptionButtonStyle}"
                                   Command="{x:Static SystemCommands.CloseWindowCommand}"
                                   Content="&#xE8BB;" />
                        </StackPanel>
                     </Grid>

                     <AdornerDecorator Grid.Row="1">
                        <ContentPresenter />
                     </AdornerDecorator>
                  </Grid>
               </Border>
               <ControlTemplate.Triggers>
                  <Trigger Property="WindowState" Value="Maximized">
                     <Setter TargetName="frame" Property="BorderThickness"
                             Value="{x:Static windows:EmWindow.MaximizedBorderThickness}" />
                     <Setter TargetName="frame" Property="BorderBrush" Value="Transparent" />
                     <Setter TargetName="maximizeButton" Property="Visibility" Value="Collapsed" />
                     <Setter TargetName="restoreButton" Property="Visibility" Value="Visible" />
                  </Trigger>
                  <Trigger Property="ShowMaximizeButton" Value="False">
                     <Setter TargetName="maximizeButton" Property="Visibility" Value="Collapsed" />
                     <Setter TargetName="restoreButton" Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <Trigger Property="ResizeMode" Value="CanMinimize">
                     <Setter TargetName="maximizeButton" Property="Visibility" Value="Collapsed" />
                     <Setter TargetName="restoreButton" Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <Trigger Property="ResizeMode" Value="NoResize">
                     <Setter TargetName="minimizeButton" Property="Visibility" Value="Collapsed" />
                     <Setter TargetName="maximizeButton" Property="Visibility" Value="Collapsed" />
                     <Setter TargetName="restoreButton" Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <Trigger Property="ShowMinimizeButton" Value="False">
                     <Setter TargetName="minimizeButton" Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <Trigger Property="Icon" Value="{x:Null}">
                     <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <!-- An inactive window says so the way the system does: a quieter title. -->
                  <Trigger Property="IsActive" Value="False">
                     <Setter TargetName="titleArea" Property="Opacity" Value="0.6" />
                  </Trigger>
               </ControlTemplate.Triggers>
            </ControlTemplate>
         </Setter.Value>
      </Setter>
   </Style>

   <!-- ============================================================
        WAIT DOTS
        ============================================================ -->
   <Style TargetType="{x:Type controls:WaitDots}">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource themeAccentBrush}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="{x:Type controls:WaitDots}">
               <Viewbox x:Name="root" Stretch="Uniform">
                  <Grid x:Name="track" Width="40" Height="12">
                     <Grid.RenderTransform>
                        <TranslateTransform X="0" />
                     </Grid.RenderTransform>
                     <Ellipse x:Name="dotA" Width="8" Height="8"
                              HorizontalAlignment="Left" Margin="4,0,0,0"
                              Fill="{TemplateBinding Foreground}"
                              RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                           <ScaleTransform ScaleX="0.45" ScaleY="0.45" />
                        </Ellipse.RenderTransform>
                     </Ellipse>
                     <Ellipse x:Name="dotB" Width="8" Height="8"
                              HorizontalAlignment="Center"
                              Fill="{TemplateBinding Foreground}"
                              RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                           <ScaleTransform ScaleX="0.45" ScaleY="0.45" />
                        </Ellipse.RenderTransform>
                     </Ellipse>
                     <Ellipse x:Name="dotC" Width="8" Height="8"
                              HorizontalAlignment="Right" Margin="0,0,4,0"
                              Fill="{TemplateBinding Foreground}"
                              RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                           <ScaleTransform ScaleX="0.45" ScaleY="0.45" />
                        </Ellipse.RenderTransform>
                     </Ellipse>
                  </Grid>
               </Viewbox>

               <ControlTemplate.Triggers>
                  <Trigger Property="IsActive" Value="False">
                     <Setter TargetName="root" Property="Visibility" Value="Hidden" />
                  </Trigger>
                  <Trigger Property="IsActive" Value="True">
                     <Trigger.EnterActions>
                        <BeginStoryboard x:Name="runDots">
                           <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="track"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                               From="-4" To="4"
                                               Duration="0:0:0.9"
                                               AutoReverse="True"
                                               RepeatBehavior="Forever">
                                 <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                 </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>

                              <DoubleAnimation Storyboard.TargetName="dotA"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                               From="0.45" To="1" Duration="0:0:0.6"
                                               AutoReverse="True" RepeatBehavior="Forever">
                                 <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                 </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                              <DoubleAnimation Storyboard.TargetName="dotA"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                               From="0.45" To="1" Duration="0:0:0.6"
                                               AutoReverse="True" RepeatBehavior="Forever">
                                 <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                 </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>

                              <DoubleAnimation Storyboard.TargetName="dotB"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                               From="0.45" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2"
                                               AutoReverse="True" RepeatBehavior="Forever">
                                 <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                 </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                              <DoubleAnimation Storyboard.TargetName="dotB"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                               From="0.45" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2"
                                               AutoReverse="True" RepeatBehavior="Forever">
                                 <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                 </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>

                              <DoubleAnimation Storyboard.TargetName="dotC"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                               From="0.45" To="1" Duration="0:0:0.6" BeginTime="0:0:0.4"
                                               AutoReverse="True" RepeatBehavior="Forever">
                                 <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                 </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                              <DoubleAnimation Storyboard.TargetName="dotC"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                               From="0.45" To="1" Duration="0:0:0.6" BeginTime="0:0:0.4"
                                               AutoReverse="True" RepeatBehavior="Forever">
                                 <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                 </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                           </Storyboard>
                        </BeginStoryboard>
                     </Trigger.EnterActions>
                     <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="runDots" />
                     </Trigger.ExitActions>
                  </Trigger>
               </ControlTemplate.Triggers>
            </ControlTemplate>
         </Setter.Value>
      </Setter>
   </Style>

   <!-- ============================================================
        WAIT OVERLAY
        A Material wait layer: a scrim that dims and blocks what is
        behind it, and a compact raised surface on top carrying the
        wait dots and what is being waited for.

        Reading on both themes is settled the same way as the screens
        that use it:

        - the scrim is black at 40%, which is what Material dims with
          on a light and on a dark theme alike;
        - the surface and its outline are taken from the theme, so the
          card is opaque and its text is legible whichever theme is on;
        - the one colour of its own is the accent on the dots, which
          WaitDots reads through the Em theme token.
        ============================================================ -->

   <!-- Translucent grey: a shade of the card it sits on without naming a theme colour. -->
   <SolidColorBrush x:Key="waitOverlayOutlineBrush" Color="#1F808080" />

   <Style TargetType="{x:Type controls:WaitOverlay}">
      <!-- The scrim, and the only thing a host is expected to override. -->
      <Setter Property="Background" Value="#66000000" />
      <Setter Property="Foreground"
              Value="{DynamicResource themeWindowForegroundBrush}" />
      <!-- The layer is furniture, not a stop on the way through the screen. -->
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="{x:Type controls:WaitOverlay}">
               <!-- Collapsed at rest so nothing behind it is covered, and transparent for the
                    first moment after that - see the reveal animation below. -->
               <Border x:Name="scrim"
                     CornerRadius="{TemplateBinding CornerRadius}"
                     Background="{TemplateBinding Background}"
                     Visibility="Collapsed"
                     Opacity="0">

                  <Border x:Name="card"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Padding="22,16,22,14"
                          CornerRadius="16"
                          BorderThickness="1"
                          BorderBrush="{StaticResource waitOverlayOutlineBrush}"
                          Background="{DynamicResource themeWindowBackgroundBrush}">
                     <Border.Effect>
                        <!-- Material elevation: a soft shadow straight down, never a glow. -->
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270"
                                          Color="Black" Opacity="0.28" />
                     </Border.Effect>

                     <StackPanel>
                        <controls:WaitDots x:Name="dots"
                                           Margin="0,0,0,10"
                                           HorizontalAlignment="Center"
                                           IsActive="{TemplateBinding IsWaiting}" />

                        <TextBlock x:Name="headingText"
                                   Text="{TemplateBinding Heading}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- The second line is what is being waited for, and is left out
                             entirely when the screen has nothing to add. -->
                        <TextBlock x:Name="captionText"
                                   Text="{TemplateBinding Caption}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Margin="0,4,0,0"
                                   MaxWidth="240"
                                   FontSize="11.5"
                                   Opacity="0.65"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                     </StackPanel>
                  </Border>
               </Border>

               <ControlTemplate.Triggers>
                  <Trigger Property="IsWaiting" Value="True">
                     <Setter TargetName="scrim" Property="Visibility" Value="Visible" />
                     <Trigger.EnterActions>
                        <BeginStoryboard x:Name="revealScrim">
                           <Storyboard>
                              <!-- Held back a quarter of a second on purpose. The layer blocks
                                   clicks from the moment the work starts - an element at zero
                                   opacity still takes the mouse - but a request answered in a
                                   blink never leaves the dots flashing on the screen. -->
                              <DoubleAnimation Storyboard.TargetName="scrim"
                                               Storyboard.TargetProperty="Opacity"
                                               From="0" To="1"
                                               BeginTime="0:0:0.25"
                                               Duration="0:0:0.15" />
                           </Storyboard>
                        </BeginStoryboard>
                     </Trigger.EnterActions>
                     <Trigger.ExitActions>
                        <!-- Stopping returns the opacity to the zero it is declared with. -->
                        <StopStoryboard BeginStoryboardName="revealScrim" />
                     </Trigger.ExitActions>
                  </Trigger>

                  <Trigger Property="Caption" Value="{x:Null}">
                     <Setter TargetName="captionText" Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <Trigger Property="Caption" Value="">
                     <Setter TargetName="captionText" Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <Trigger Property="Heading" Value="{x:Null}">
                     <Setter TargetName="headingText" Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <Trigger Property="Heading" Value="">
                     <Setter TargetName="headingText" Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <!-- A region too small for the card shows the dots alone. -->
                  <Trigger Property="IsCompact" Value="True">
                     <Setter TargetName="headingText" Property="Visibility" Value="Collapsed" />
                     <Setter TargetName="captionText" Property="Visibility" Value="Collapsed" />
                     <Setter TargetName="card" Property="Padding" Value="14,10" />
                     <Setter TargetName="dots" Property="Margin" Value="0" />
                  </Trigger>
                  <!-- Bare: the dots alone, large, straight on the scrim - no card. -->
                  <Trigger Property="IsBare" Value="True">
                     <Setter TargetName="headingText" Property="Visibility" Value="Collapsed" />
                     <Setter TargetName="captionText" Property="Visibility" Value="Collapsed" />
                     <Setter TargetName="card" Property="Background" Value="Transparent" />
                     <Setter TargetName="card" Property="BorderThickness" Value="0" />
                     <Setter TargetName="card" Property="Padding" Value="0" />
                     <Setter TargetName="card" Property="Effect" Value="{x:Null}" />
                     <Setter TargetName="dots" Property="Margin" Value="0" />
                     <Setter TargetName="dots" Property="Width" Value="80" />
                     <Setter TargetName="dots" Property="Height" Value="24" />
                  </Trigger>
               </ControlTemplate.Triggers>
            </ControlTemplate>
         </Setter.Value>
      </Setter>
   </Style>

   <!-- ============================================================
        EM STATUS BAR
        A thin strip along the bottom of a window: the message, the
        left items after it, the right items, and the engine's system
        slots against the edge.
        It sits on the window surface, so it inherits the window's
        foreground and needs no colour of its own in either theme.
        ============================================================ -->
   <Style x:Key="emStatusBarItemsStyle" TargetType="ItemsControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ItemsPanel">
         <Setter.Value>
            <ItemsPanelTemplate>
               <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
         </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
         <Setter.Value>
            <Style TargetType="FrameworkElement">
               <Setter Property="Margin" Value="14,0,0,0" />
               <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
         </Setter.Value>
      </Setter>
   </Style>

   <Style TargetType="{x:Type controls:EmStatusBar}">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="16,0,16,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="{x:Type controls:EmStatusBar}">
               <Border Background="{TemplateBinding Background}"
                       Padding="{TemplateBinding Padding}">
                  <Border.Resources>
                     <DataTemplate DataType="{x:Type windows:StatusUpdateItem}">
                        <Button x:Name="update" Margin="10,0,0,0" Padding="2,0" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource themeOnSurfaceVariantBrush}" ToolTip="{Binding ToolTip}" Command="{Binding RestartCommand}" ContextMenuService.ShowOnDisabled="True" ToolTipService.ShowOnDisabled="True">
                           <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter /></Border></ControlTemplate></Button.Template>
                           <Button.ContextMenu><ContextMenu><MenuItem Header="Check for update" Command="{Binding CheckCommand}" /></ContextMenu></Button.ContextMenu>
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome x:Name="icon" Icon="{Binding Icon}" Spin="{Binding Spin}" Opacity="0.55" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Text}" Margin="5,0,0,0" VerticalAlignment="Center" />
                           </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                           <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter TargetName="update" Property="Foreground" Value="{DynamicResource themeAccentBrush}" /><Setter TargetName="icon" Property="Opacity" Value="1" /></DataTrigger>
                        </DataTemplate.Triggers>
                     </DataTemplate>
                     <!-- Product version slot: v1.3.0-alpha.1 or dev; right-click copies the full version. -->
                     <DataTemplate DataType="{x:Type windows:StatusVersionItem}">
                        <TextBlock Text="{Binding Text}"
                                   ToolTip="{Binding ToolTip}"
                                   AutomationProperties.Name="{Binding ToolTip}"
                                   Opacity="0.75"
                                   Background="Transparent"
                                   VerticalAlignment="Center">
                           <TextBlock.ContextMenu>
                              <ContextMenu>
                                 <MenuItem Header="Copy version" Command="{Binding CopyCommand}" />
                              </ContextMenu>
                           </TextBlock.ContextMenu>
                        </TextBlock>
                     </DataTemplate>
                  </Border.Resources>
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                     </Grid.ColumnDefinitions>
                     <DockPanel LastChildFill="False" ClipToBounds="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{TemplateBinding Text}"
                                   Opacity="0.75"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <ItemsControl DockPanel.Dock="Left"
                                      ItemsSource="{TemplateBinding LeftItems}"
                                      Style="{StaticResource emStatusBarItemsStyle}" />
                     </DockPanel>
                     <ItemsControl Grid.Column="1"
                                   ItemsSource="{TemplateBinding RightItems}"
                                   Style="{StaticResource emStatusBarItemsStyle}" />
                     <ItemsControl Grid.Column="2"
                                   ItemsSource="{TemplateBinding SystemItems}"
                                   Style="{StaticResource emStatusBarItemsStyle}" />
                  </Grid>
               </Border>
            </ControlTemplate>
         </Setter.Value>
      </Setter>
   </Style>

<Style x:Key="emTabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource flatIconButtonStyle}">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="Focusable" Value="False" />
            </Style>
<Style x:Key="emTabScrollButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource flatIconButtonStyle}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Delay" Value="300" />
                <Setter Property="Interval" Value="60" />
            </Style>
<Style TargetType="{x:Type controls:EmTabStrip}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <controls:TabStripPanel MinItemWidth="{Binding MinItemWidth, RelativeSource={RelativeSource AncestorType={x:Type controls:EmTabStrip}}}" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:EmTabStrip}">
                                <DockPanel><ContentPresenter x:Name="leading" DockPanel.Dock="Left" Content="{TemplateBinding LeadingContent}" ContentTemplate="{TemplateBinding LeadingContentTemplate}" VerticalAlignment="Center"/><ScrollViewer Focusable="False"
                                              CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <DockPanel>
                                                <RepeatButton DockPanel.Dock="Left"
                                                              ToolTip="Scroll left"
                                                              Command="{x:Static ScrollBar.LineLeftCommand}"
                                                              Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                              Style="{StaticResource emTabScrollButtonStyle}">
                                                    <fa:FontAwesome FontSize="10" Icon="Solid_ChevronLeft" />
                                                </RepeatButton>
                                                <RepeatButton DockPanel.Dock="Right"
                                                              ToolTip="Scroll right"
                                                              Command="{x:Static ScrollBar.LineRightCommand}"
                                                              Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                              Style="{StaticResource emTabScrollButtonStyle}">
                                                    <fa:FontAwesome FontSize="10" Icon="Solid_ChevronRight" />
                                                </RepeatButton>
                                                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                                            </DockPanel>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter />
                                </ScrollViewer></DockPanel><ControlTemplate.Triggers><Trigger Property="LeadingContent" Value="{x:Null}"><Setter TargetName="leading" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource themeWindowForegroundBrush}" />
                            <Setter Property="Background" Value="{DynamicResource themePopupBackgroundBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Height="40">
                                            <Grid>
                                                <Border x:Name="stateLayer"
                                                        Margin="2,5"
                                                        CornerRadius="8"
                                                        Background="Transparent">
                                                    <DockPanel Margin="12,0,6,0" VerticalAlignment="Center">
                                                        <Button x:Name="closeButton"
                                                                DockPanel.Dock="Right"
                                                                Margin="4,0,0,0"
                                                                Visibility="Hidden"
                                                                ToolTip="Close"
                                                                Style="{StaticResource emTabCloseButtonStyle}"
                                                                Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:EmTabStrip}}}"
                                                                CommandParameter="{Binding}">
                                                            <fa:FontAwesome FontSize="10" Icon="Solid_Xmark" />
                                                        </Button>
                                                        <TextBlock Text="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                   MaxWidth="200"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                                <Border x:Name="indicator"
                                                        Height="3"
                                                        Margin="10,0"
                                                        CornerRadius="2,2,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Visibility="Hidden"
                                                        Background="{DynamicResource themeAccentBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="stateLayer" Property="Background" Value="{StaticResource stateHoverBrush}" />
                                                <Setter TargetName="closeButton" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="closeButton" Property="Visibility" Value="Visible" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="stateLayer" Property="TextElement.Foreground"
                                                        Value="{DynamicResource themeAccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                            <!-- A strip without CloseCommand has fixed tabs: no close button at all. -->
                                            <DataTrigger Binding="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:EmTabStrip}}}" Value="{x:Null}">
                                                <Setter TargetName="closeButton" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
</ResourceDictionary>
