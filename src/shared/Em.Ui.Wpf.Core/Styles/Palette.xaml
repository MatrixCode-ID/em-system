<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <!--
      The colours every screen in this application is built from.

      Two rules keep them working on the light theme and the dark theme alike:

      - every surface, outline and divider is a translucent grey (#xx808080), which darkens a
        light background and lightens a dark one without naming a theme colour. The leading
        pair of hex digits is the alpha, so the same grey reads as five different weights;
      - no accent colour lives here. The accent, and the opaque window and popup surfaces, are
        Em's theme tokens (themeAccentBrush, themeWindowBackgroundBrush, ...): EmApp writes
        them into the application resources from the active theme, and a screen reads them
        through DynamicResource, so it follows every theme switch. None of those keys may be
        declared here - a default in a merged dictionary would hide the application-level value.

      The status colours are the exception: they are mid-tone on purpose, dark enough to read
      on a light chip and light enough to read on a dark one, so one brush serves both themes.
   -->

   <!-- Surfaces: the card, and the strip or field inside it. -->
   <SolidColorBrush x:Key="surfaceBrush" Color="#0D808080" />
   <SolidColorBrush x:Key="surfaceStrongBrush" Color="#1A808080" />

   <!-- Outlines: the resting border, and the one a control wears when it is asking to be
        used - a check box, an input frame under the pointer. -->
   <SolidColorBrush x:Key="outlineBrush" Color="#29808080" />
   <SolidColorBrush x:Key="outlineStrongBrush" Color="#4D808080" />

   <!-- The line between two rows. Lighter than an outline: it separates, it does not enclose. -->
   <SolidColorBrush x:Key="dividerBrush" Color="#1F808080" />

   <!-- Material state layers: one translucent grey veil over whatever the control already
        paints, so the same two brushes serve every button variant. -->
   <SolidColorBrush x:Key="stateHoverBrush" Color="#1F808080" />
   <SolidColorBrush x:Key="statePressedBrush" Color="#33808080" />

   <!-- Status colours, each with the 14% wash used behind a chip of the same meaning. -->
   <SolidColorBrush x:Key="successBrush" Color="#2FA84F" />
   <SolidColorBrush x:Key="successChipBrush" Color="#242FA84F" />
   <SolidColorBrush x:Key="warningBrush" Color="#C98A00" />
   <SolidColorBrush x:Key="warningChipBrush" Color="#24C98A00" />
   <SolidColorBrush x:Key="dangerBrush" Color="#E05656" />
   <SolidColorBrush x:Key="dangerChipBrush" Color="#24E05656" />
   <SolidColorBrush x:Key="infoBrush" Color="#3B82F6" />
   <SolidColorBrush x:Key="infoChipBrush" Color="#243B82F6" />

</ResourceDictionary>
