<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/Palette.xaml" />
   </ResourceDictionary.MergedDictionaries>

   <!-- Native list/tree templates paint system white when disabled. Keep the
        host surface in every state; item styles still own selection/expansion. -->
   <ControlTemplate x:Key="surfaceItemsTemplate" TargetType="ItemsControl">
      <Border Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              Padding="{TemplateBinding Padding}">
         <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False"
                       CanContentScroll="{Binding (ScrollViewer.CanContentScroll), RelativeSource={RelativeSource TemplatedParent}}"
                       HorizontalScrollBarVisibility="{Binding (ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                       VerticalScrollBarVisibility="{Binding (ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
            <ItemsPresenter x:Name="ItemsPresenter" />
         </ScrollViewer>
      </Border>
   </ControlTemplate>

   <Style x:Key="surfaceListBoxStyle" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template" Value="{StaticResource surfaceItemsTemplate}" />
   </Style>

   <Style x:Key="surfaceTreeViewStyle" TargetType="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template" Value="{StaticResource surfaceItemsTemplate}" />
   </Style>

   <!-- A row of a list inside a card, the same row UserManager draws: hover and selection are
        state layers over a transparent surface, selection adds a 3px accent bar on the leading
        edge, and the divider belongs to the row so the last one closes the list off too.
        Padding is the inset of the content from the bar; the default makes a table row's cells
        start at 24 from the edge (the 3px bar plus 21), where the column captions above it
        start. Nothing here names a theme colour except the accent, and the disabled state keeps
        the surface, so a list that is busy never flashes white. -->
   <Style x:Key="listRowStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="21,8,20,8" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
               <Grid>
                  <Grid.RowDefinitions>
                     <RowDefinition Height="*" />
                     <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border x:Name="stateLayer" Grid.Row="0" Background="Transparent" MinHeight="44">
                     <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="selectionBar"
                                Width="3"
                                Margin="0,8"
                                CornerRadius="2"
                                Visibility="Hidden"
                                Background="{DynamicResource themeAccentBrush}" />
                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                     </Grid>
                  </Border>
                  <Border Grid.Row="1" Height="1" Background="{StaticResource dividerBrush}" />
               </Grid>
               <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                     <Setter TargetName="stateLayer" Property="Background" Value="{StaticResource stateHoverBrush}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                     <Setter TargetName="stateLayer" Property="Background" Value="{StaticResource statePressedBrush}" />
                     <Setter TargetName="selectionBar" Property="Visibility" Value="Visible" />
                  </Trigger>
               </ControlTemplate.Triggers>
            </ControlTemplate>
         </Setter.Value>
      </Setter>
   </Style>

   <!-- The narrow variant for a list in a side panel: less inset, same bar and divider. -->
   <Style x:Key="listRowCompactStyle" TargetType="ListBoxItem" BasedOn="{StaticResource listRowStyle}">
      <Setter Property="Padding" Value="14,6,12,6" />
   </Style>
</ResourceDictionary>
