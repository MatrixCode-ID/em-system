<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <!--
      A side sheet is a panel that slides in over a screen from the right: a filter panel, a
      catalogue, anything that belongs to the screen but should not take a column of it.

      Three pieces, held together by one piece of state - the toggle's IsChecked - which the
      other two read by name, so the sheet opens and closes without a line of code:

         <ToggleButton x:Name="xToggle" Style="{StaticResource sheetToggleStyle}">…</ToggleButton>
         …
         <ToggleButton Style="{StaticResource sheetScrimStyle}"
                       IsChecked="{Binding IsChecked, ElementName=xToggle, Mode=TwoWay}" />
         <Border x:Name="xSheet" Width="400" HorizontalAlignment="Right"> … </Border>

      The scrim and the sheet are the last children of the screen's outermost panel, so they
      cover everything; the sheet parks itself off the right edge with a TranslateTransform and
      animates back to zero on a DataTrigger that watches the toggle. The panel itself stays
      markup in the screen that owns it: its width, its frame and its contents differ every
      time, and only the behaviour is worth sharing.
   -->

   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/Palette.xaml" />
      <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/Buttons.xaml" />
   </ResourceDictionary.MergedDictionaries>

   <!-- The button that opens the sheet. A ToggleButton rather than a Button: it stays visibly
        pressed while the panel is open, which is what ties the panel to the thing that opened
        it. Sized to match the compact buttons it usually stands beside. -->
   <Style x:Key="sheetToggleStyle" TargetType="ToggleButton">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <!-- Keeps the theme's checked-state Foreground off the label: a third-party theme's ToggleButton
           style (applied by the host) turns it black while IsChecked, which is meant for its own accent filled chrome
           and is unreadable over ours. -->
      <Setter Property="Foreground"
              Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
               <Border x:Name="shape"
                       CornerRadius="17"
                       Background="Transparent"
                       BorderBrush="{StaticResource outlineBrush}"
                       BorderThickness="1">
                  <Grid>
                     <Border x:Name="stateLayer" CornerRadius="17" Background="Transparent" />
                     <ContentPresenter Margin="{TemplateBinding Padding}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                  </Grid>
               </Border>
               <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                     <Setter TargetName="stateLayer" Property="Background"
                             Value="{StaticResource stateHoverBrush}" />
                  </Trigger>
                  <Trigger Property="IsChecked" Value="True">
                     <Setter TargetName="shape" Property="Background"
                             Value="{StaticResource surfaceStrongBrush}" />
                     <Setter TargetName="shape" Property="BorderBrush"
                             Value="{DynamicResource themeAccentBrush}" />
                  </Trigger>
               </ControlTemplate.Triggers>
            </ControlTemplate>
         </Setter.Value>
      </Setter>
   </Style>

   <!-- The veil over the screen behind the panel. It is a ToggleButton rather than a Border on
        purpose: bound back to the button that opened the sheet, a click anywhere outside the
        panel unchecks it and the sheet closes - which is what a Border would have needed a code
        behind handler for. Collapsed while the sheet is shut, so none of it is in the way. -->
   <Style x:Key="sheetScrimStyle" TargetType="ToggleButton">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
         <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
               <Border Background="#33000000" />
            </ControlTemplate>
         </Setter.Value>
      </Setter>
      <Style.Triggers>
         <Trigger Property="IsChecked" Value="True">
            <Setter Property="Visibility" Value="Visible" />
            <Trigger.EnterActions>
               <BeginStoryboard>
                  <Storyboard>
                     <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                  </Storyboard>
               </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
               <BeginStoryboard>
                  <Storyboard>
                     <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                  </Storyboard>
               </BeginStoryboard>
            </Trigger.ExitActions>
         </Trigger>
      </Style.Triggers>
   </Style>

   <!-- The cross in the sheet's header. Also a ToggleButton bound back to the same state, for
        the same reason the scrim is one. -->
   <Style x:Key="sheetCloseToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource rowActionButtonStyle}">
      <Setter Property="Foreground"
              Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
   </Style>

</ResourceDictionary>
