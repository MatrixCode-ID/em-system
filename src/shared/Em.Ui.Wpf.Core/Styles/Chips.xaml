<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <!--
      A chip is one short fact wearing a rounded outline: a state, a count, a kind. It is a
      Border with a TextBlock inside rather than a control of its own, so anything can be put
      in one - a caption, an icon and a caption, a number.

      TextElement.Foreground is set on the chip and inherits down to whatever is inside it,
      which is why a coloured variant only has to name three brushes and never has to reach
      into the markup that uses it.
   -->

   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/Palette.xaml" />
   </ResourceDictionary.MergedDictionaries>

   <Style x:Key="chipStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource surfaceStrongBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource outlineBrush}" />
      <Setter Property="TextElement.FontSize" Value="11" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
   </Style>

   <Style x:Key="chipSuccessStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
      <Setter Property="Background" Value="{StaticResource successChipBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource successBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource successBrush}" />
   </Style>

   <Style x:Key="chipWarningStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
      <Setter Property="Background" Value="{StaticResource warningChipBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource warningBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource warningBrush}" />
   </Style>

   <Style x:Key="chipDangerStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
      <Setter Property="Background" Value="{StaticResource dangerChipBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource dangerBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource dangerBrush}" />
   </Style>

   <Style x:Key="chipInfoStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
      <Setter Property="Background" Value="{StaticResource infoChipBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource infoBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource infoBrush}" />
   </Style>

   <!-- Muted chip for a fact that is only context - no colour, only the neutral surface, so it
        never competes with the status chips beside it. -->
   <Style x:Key="chipMutedStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
      <Setter Property="Opacity" Value="0.65" />
   </Style>

   <!-- Accent chip for a fact that belongs to the record rather than to a scale - what kind of
        thing this is. It borrows the theme accent, the same colour the primary button and the
        current tab already use, so it never reads as a fourth status. -->
   <Style x:Key="chipAccentStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
      <Setter Property="BorderBrush"
              Value="{DynamicResource themeAccentBrush}" />
      <Setter Property="TextElement.Foreground"
              Value="{DynamicResource themeAccentBrush}" />
   </Style>

   <Style x:Key="materialAssistChipStyle" TargetType="Border">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource themeOutlineVariantBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,0" />
   </Style>
</ResourceDictionary>
