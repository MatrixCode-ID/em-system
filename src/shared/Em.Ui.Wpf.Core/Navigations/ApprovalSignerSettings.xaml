<UserControl x:Class="Em.Ui.Wpf.Navigations.ApprovalSignerSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Em.Ui.Wpf.Navigations"
 Foreground="{DynamicResource themeWindowForegroundBrush}">
 <UserControl.DataContext><local:ApprovalSignerSettingsVm/></UserControl.DataContext>
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/></ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="assignment"><StackPanel Orientation="Horizontal" Margin="0,4">
   <TextBlock Text="{Binding User.Caption}" Width="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <Button Style="{StaticResource textButtonStyle}" Content="Make signer" Command="{Binding Step.Owner.Commands[MakeSignerCommand]}" CommandParameter="{Binding}"/>
   <Button Style="{StaticResource textButtonStyle}" Content="Remove" Command="{Binding Step.Owner.Commands[RemoveCommand]}" CommandParameter="{Binding}"/>
  </StackPanel></DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="22,12,22,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Margin="0,0,0,12">
   <Button Content="Save" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[SaveCommand]}"/>
   <Button Content="Refresh" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[RefreshCommand]}" Margin="8,0,0,0"/>
   <Border Style="{StaticResource toolbarSeparatorStyle}"/>
   <ComboBox Width="250" ItemsSource="{Binding Definitions}" SelectedItem="{Binding Selected}" Style="{StaticResource fieldComboStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
  </StackPanel></ScrollViewer>
  <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="{StaticResource surfaceBrush}" BorderBrush="{StaticResource outlineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
     <StackPanel><TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
      <TextBlock Text="SIGNER · USER OR DS" Style="{StaticResource sectionCaptionStyle}"/>
      <ContentControl Content="{Binding Primary}" ContentTemplate="{StaticResource assignment}"/>
      <TextBlock Text="Drop a user or DS here" Opacity="0.5" FontSize="11" Margin="0,4,0,12"/>
      <TextBlock Text="FOUR-EYES BACKUPS" Style="{StaticResource sectionCaptionStyle}"/>
      <ItemsControl ItemsSource="{Binding Backups}" ItemTemplate="{StaticResource assignment}"/>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <DockPanel Grid.Column="2">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="USER POOL" Style="{StaticResource sectionCaptionStyle}" Margin="0,0,0,12"/>
     <Border DataContext="{Binding DynamicSigner}" Background="{StaticResource surfaceStrongBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" PreviewMouseLeftButtonDown="OnDragStart" MouseMove="OnPoolMove" ToolTip="Signer will be determined by the system when the approval is created.">
      <StackPanel><TextBlock Text="{Binding Caption}" FontWeight="SemiBold"/><TextBlock Text="Determined by the module on request" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
     </Border>
     <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter users. Dynamic Signer is always available above the filter." Margin="0,0,0,8"/>
    </StackPanel>
    <ListBox Style="{StaticResource surfaceListBoxStyle}" ItemsSource="{Binding Pool}"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" PreviewMouseLeftButtonDown="OnDragStart" MouseMove="OnPoolMove" Background="Transparent"><TextBlock Text="{Binding Caption}" TextWrapping="Wrap"/></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
  </Grid>
 </Grid>
</UserControl>
