<Window x:Class="Em.Ui.Wpf.Navigations.Publish.PublishProfileDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Publish profile" Width="880" Height="760" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource themeWindowBackgroundBrush}" Foreground="{DynamicResource themeWindowForegroundBrush}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBox" BasedOn="{StaticResource fieldBoxStyle}"/>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource fieldPasswordStyle}"/>
  <Style TargetType="ComboBox" BasedOn="{StaticResource fieldComboStyle}"/>
  <Style TargetType="CheckBox" BasedOn="{StaticResource checkBoxStyle}"/>
  <Style TargetType="Button" BasedOn="{StaticResource outlinedButtonStyle}"><Setter Property="Margin" Value="8,0,0,0"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </ResourceDictionary></Window.Resources>
 <DockPanel Margin="16"><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="message" Margin="4"/><WrapPanel HorizontalAlignment="Right"><Button Content="Save" Click="SaveClick" Style="{StaticResource filledButtonStyle}" Margin="8,0,0,0" IsDefault="True"/><Button Content="Save As" Click="SaveAsClick"/><Button Content="Cancel" IsCancel="True"/></WrapPanel></StackPanel>
  <TabControl x:Name="tabs" Style="{StaticResource materialTabControlStyle}"/>
 </DockPanel>
</Window>
