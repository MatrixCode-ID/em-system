<UserControl x:Class="Em.Ui.Wpf.Navigations.DefaultHomeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Em.Ui.Wpf.Navigations"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000">
   <UserControl.DataContext>
      <local:DefaultHomeControlVm />
   </UserControl.DataContext>

   <!--
      Home screen layout. Two panels: the navigation tree on the left, a docked tools
      panel on the right, with one search field spanning both.

      Both panels are bound to the view model. The tree on the left needs nothing but
      DefaultHomeControlVm.AppMenus: the view model splits each MenuPath into levels, and
      the templates below turn that into nested groups of tiles on their own.

      Every tile binds to the MenuNavigation item, never through it to a Navigation. The item
      carries its own Title/SubTitle/Icon/Description, taken once when it is registered, which
      is what keeps the menu text stable when a navigation renames itself while it is open -
      and what lets a tool be added by hand with no navigation behind it at all.

      Colours are deliberately built from translucent greys (#xx808080) plus the theme
      accent, so the same markup reads correctly on a light and on a dark theme without
      a second palette: a translucent grey darkens a light surface and lightens a dark one.

      Text colour is never stated - it is inherited from the window, which is the only
      value the application theme actually re-colours. System brushes are not an option
      here: SystemColors.ControlTextBrushKey stays black under a dark theme.

      The accent is the one colour taken from the theme, through the Em theme token
      themeAccentBrush. The system highlight brush would have been theme-agnostic - the same
      #0078D4 either way - and too dim against a dark background.
   -->
   <UserControl.Resources>

      <!-- ============================================================
           PALETTE
           ============================================================ -->
      <SolidColorBrush x:Key="surfaceBrush" Color="#0D808080" />
      <SolidColorBrush x:Key="surfaceHoverBrush" Color="#1F808080" />
      <SolidColorBrush x:Key="surfacePressedBrush" Color="#2E808080" />
      <SolidColorBrush x:Key="outlineBrush" Color="#33808080" />
      <SolidColorBrush x:Key="outlineStrongBrush" Color="#55808080" />

      <!-- Section rule: fades out to the right so it frames the caption instead of
           cutting the panel in half. -->
      <LinearGradientBrush x:Key="ruleBrush" StartPoint="0,0" EndPoint="1,0">
         <GradientStop Color="#44808080" Offset="0" />
         <GradientStop Color="#00808080" Offset="1" />
      </LinearGradientBrush>

      <!-- ============================================================
           SEARCH FIELD
           Plain WPF TextBox with its chrome replaced by a pill-shaped
           border; the watermark is a sibling TextBlock toggled by a
           DataTrigger on the box's own Text, so no code is involved.
           ============================================================ -->
      <Style x:Key="searchBoxStyle" TargetType="TextBox">
         <Setter Property="Background" Value="Transparent" />
         <Setter Property="BorderThickness" Value="0" />
         <Setter Property="FontSize" Value="13" />
         <Setter Property="VerticalContentAlignment" Value="Center" />
         <!-- The theme already gives TextBox a per-theme Foreground, so it is left alone;
              the caret is not themed, hence it simply follows the text colour. -->
         <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
         <Setter Property="Template">
            <Setter.Value>
               <ControlTemplate TargetType="TextBox">
                  <ScrollViewer x:Name="PART_ContentHost"
                                Focusable="False"
                                VerticalAlignment="Center"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
               </ControlTemplate>
            </Setter.Value>
         </Setter>
      </Style>

      <!-- ============================================================
           NAVIGATION GROUP (menu level)
           Chevron + caption + rule, collapsible. Depth is expressed by
           nesting: a group indents its own content through Padding, so a
           level-3 group needs no hand-tuned margin of its own.
           ============================================================ -->
      <Style x:Key="navGroupToggleStyle" TargetType="ToggleButton">
         <Setter Property="Focusable" Value="False" />
         <Setter Property="Cursor" Value="Hand" />
         <Setter Property="HorizontalContentAlignment" Value="Left" />
         <!-- No Foreground setter here on purpose: the Expander template passes its own
              Foreground in as a local value, which is what beats the theme style. That
              theme style paints a checked toggle as a highlighted chip - white text on
              light, black on dark - i.e. exactly the wrong colour for a plain header row. -->
         <Setter Property="Template">
            <Setter.Value>
               <ControlTemplate TargetType="ToggleButton">
                  <!-- Rounded hover surface over the whole header row, so the row - not
                       just the glyph - is the click target. -->
                  <Border x:Name="headerSurface"
                          CornerRadius="8"
                          Background="Transparent"
                          Padding="8,6">
                     <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <fa:FontAwesome x:Name="chevron"
                                        Grid.Column="0"
                                        Icon="Solid_ChevronDown"
                                        FontSize="11"
                                        Width="14"
                                        Opacity="0.75"
                                        Foreground="{TemplateBinding Foreground}"
                                        TextAlignment="Center"
                                        VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="1"
                                          Margin="9,0,12,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Border Grid.Column="2"
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{StaticResource ruleBrush}" />
                     </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                     <Trigger Property="IsChecked" Value="False">
                        <Setter TargetName="chevron" Property="Icon" Value="Solid_ChevronRight" />
                     </Trigger>
                     <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="headerSurface" Property="Background"
                                Value="{StaticResource surfaceBrush}" />
                     </Trigger>
                  </ControlTemplate.Triggers>
               </ControlTemplate>
            </Setter.Value>
         </Setter>
      </Style>

      <Style x:Key="navGroupStyle" TargetType="Expander">
         <Setter Property="IsExpanded" Value="True" />
         <Setter Property="FontWeight" Value="Bold" />
         <!-- Padding is the level indent for everything the group contains. -->
         <Setter Property="Padding" Value="26,6,0,10" />
         <Setter Property="Margin" Value="0,6,0,0" />
         <!-- Foreground is deliberately left to inherit: the themed text colour comes down
              the tree from the window (near-black on light, white on dark). Only level 1
              overrides it, with the accent colour. -->
         <Setter Property="Template">
            <Setter.Value>
               <ControlTemplate TargetType="Expander">
                  <StackPanel>
                     <ToggleButton Style="{StaticResource navGroupToggleStyle}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Content="{TemplateBinding Header}"
                                   ContentTemplate="{TemplateBinding HeaderTemplate}"
                                   IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                     <ContentPresenter x:Name="groupContent"
                                       Visibility="Collapsed"
                                       Margin="{TemplateBinding Padding}" />
                  </StackPanel>
                  <ControlTemplate.Triggers>
                     <Trigger Property="IsExpanded" Value="True">
                        <Setter TargetName="groupContent" Property="Visibility" Value="Visible" />
                     </Trigger>
                  </ControlTemplate.Triggers>
               </ControlTemplate>
            </Setter.Value>
         </Setter>
      </Style>

      <!-- One style per depth. Only the top level stands out - it carries the accent
           colour and a slightly larger caption; level 2 and every deeper level share the
           same font, since the indentation alone already shows how deep a group sits. -->
      <Style x:Key="navGroupLevel1Style" TargetType="Expander" BasedOn="{StaticResource navGroupStyle}">
         <Setter Property="FontSize" Value="13" />
         <Setter Property="Margin" Value="0,14,0,0" />
         <Setter Property="Foreground" Value="{DynamicResource themeAccentBrush}" />
      </Style>

      <Style x:Key="navGroupLevel2Style" TargetType="Expander" BasedOn="{StaticResource navGroupStyle}">
         <Setter Property="FontSize" Value="12" />
         <Setter Property="Margin" Value="0,8,0,0" />
      </Style>

      <!-- Same font as level 2 on purpose - a level-5 group must not end up unreadably
           small, so depth is expressed by indentation only from here on. -->
      <Style x:Key="navGroupLevelNStyle" TargetType="Expander" BasedOn="{StaticResource navGroupLevel2Style}">
         <Setter Property="Margin" Value="0,6,0,0" />
      </Style>

      <!-- ============================================================
           APP TILE
           Rounded, flat until hovered, where it picks up a surface tint,
           an accent outline and a soft shadow - the Material "raise on
           interaction" idea, kept subtle enough for a dense menu.
           ============================================================ -->
      <Style x:Key="appTileStyle" TargetType="Button">
         <Setter Property="MinWidth" Value="230" />
         <Setter Property="Margin" Value="0,3,14,3" />
         <Setter Property="Padding" Value="10,8" />
         <Setter Property="Cursor" Value="Hand" />
         <Setter Property="FontWeight" Value="Normal" />
         <Setter Property="HorizontalContentAlignment" Value="Left" />
         <Setter Property="Template">
            <Setter.Value>
               <ControlTemplate TargetType="Button">
                  <Border x:Name="tile"
                          CornerRadius="12"
                          Background="Transparent"
                          BorderThickness="1"
                          BorderBrush="Transparent"
                          Padding="{TemplateBinding Padding}">
                     <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                     <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="tile" Property="Background" Value="{StaticResource surfaceBrush}" />
                        <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource outlineBrush}" />
                        <Setter TargetName="tile" Property="Effect">
                           <Setter.Value>
                              <DropShadowEffect BlurRadius="12"
                                                ShadowDepth="1"
                                                Direction="270"
                                                Opacity="0.18"
                                                Color="#000000" />
                           </Setter.Value>
                        </Setter>
                     </Trigger>
                     <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="tile" Property="Background" Value="{StaticResource surfacePressedBrush}" />
                        <Setter TargetName="tile" Property="Effect" Value="{x:Null}" />
                     </Trigger>
                     <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="tile" Property="BorderBrush"
                                Value="{DynamicResource themeAccentBrush}" />
                     </Trigger>
                  </ControlTemplate.Triggers>
               </ControlTemplate>
            </Setter.Value>
         </Setter>
      </Style>

      <!-- Tools entries fill their column instead of flowing side by side -->
      <Style x:Key="toolTileStyle" TargetType="Button" BasedOn="{StaticResource appTileStyle}">
         <Setter Property="MinWidth" Value="0" />
         <Setter Property="Margin" Value="0,2,0,2" />
         <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>

      <!-- Icon plate: accent-tinted rounded square. The tint sits on its own Border so
           lowering its opacity does not wash out the glyph drawn over it. -->
      <Style x:Key="appIconPlateStyle" TargetType="Grid">
         <Setter Property="Width" Value="38" />
         <Setter Property="Height" Value="38" />
         <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="appIconPlateFillStyle" TargetType="Border">
         <Setter Property="CornerRadius" Value="11" />
         <Setter Property="Opacity" Value="0.14" />
         <Setter Property="Background" Value="{DynamicResource themeAccentBrush}" />
      </Style>

      <Style x:Key="appIconStyle" TargetType="fa:FontAwesome">
         <Setter Property="FontSize" Value="15" />
         <Setter Property="HorizontalAlignment" Value="Center" />
         <Setter Property="VerticalAlignment" Value="Center" />
         <Setter Property="Foreground" Value="{DynamicResource themeAccentBrush}" />
      </Style>

      <Style x:Key="appTextStackStyle" TargetType="StackPanel">
         <Setter Property="Margin" Value="12,0,4,0" />
         <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- None of the text styles pin a Foreground. System brushes such as
           SystemColors.ControlTextBrushKey are NOT re-coloured by the application theme
           (they stay black on a dark theme), whereas the colour inherited from the window
           is themed correctly - so inheritance is what keeps the text readable. -->
      <Style x:Key="appTitleStyle" TargetType="TextBlock">
         <Setter Property="FontSize" Value="12.5" />
         <Setter Property="FontWeight" Value="SemiBold" />
         <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>

      <!-- Opacity, not a hard-coded grey: it dims the subtitle against whichever text
           colour the theme is using, so it stays legible on a dark background too. -->
      <Style x:Key="appSubtitleStyle" TargetType="TextBlock">
         <Setter Property="FontSize" Value="10.5" />
         <Setter Property="Opacity" Value="0.75" />
         <Setter Property="Margin" Value="0,1,0,0" />
         <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>

      <!-- Icons arrive as an ImageSource (MenuNavigation.Icon), so a FontAwesome glyph has to
           be converted before it gets here. One consequence: the glyph colour is baked in when
           the image is built, so unlike the plate behind it, the icon does not follow the theme
           accent when the user switches between light and dark. -->
      <Style x:Key="appIconImageStyle" TargetType="Image">
         <Setter Property="Width" Value="18" />
         <Setter Property="Height" Value="18" />
         <Setter Property="HorizontalAlignment" Value="Center" />
         <Setter Property="VerticalAlignment" Value="Center" />
         <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
      </Style>

      <Style x:Key="panelCaptionStyle" TargetType="TextBlock">
         <Setter Property="FontSize" Value="10.5" />
         <Setter Property="FontWeight" Value="Bold" />
         <Setter Property="Opacity" Value="0.6" />
         <Setter Property="Margin" Value="12,2,0,8" />
      </Style>

      <!-- Bound variants of the tile styles. A hand-written tile only carries text that
           actually exists; a bound one has to cope with an entry that leaves SubTitle or
           Description empty, which would otherwise show as a blank second line and an empty
           tooltip popup. -->
      <Style x:Key="appSubtitleBoundStyle" TargetType="TextBlock" BasedOn="{StaticResource appSubtitleStyle}">
         <Style.Triggers>
            <Trigger Property="Text" Value="">
               <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
               <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
         </Style.Triggers>
      </Style>

      <Style x:Key="toolTileBoundStyle" TargetType="Button" BasedOn="{StaticResource toolTileStyle}">
         <Setter Property="ToolTip" Value="{Binding Description}" />
         <Style.Triggers>
            <DataTrigger Binding="{Binding Description}" Value="">
               <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
               <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <!-- ============================================================
           TOOLS ENTRY (bound)
           The bound item is a MenuNavigation, and every binding here stays
           on the item itself - never on the Navigation behind it. Title,
           SubTitle, Icon and Description are copied in when the entry is
           registered, so the tile keeps reading the same after a navigation
           re-titles itself at runtime, and an entry registered by hand
           (Navigation = null) renders exactly like the rest. The command to
           run it rides along on the item too, which keeps the template free
           of any lookup back to the view model.
           ============================================================ -->
      <DataTemplate x:Key="toolTileTemplate" DataType="{x:Type local:MenuNavigation}">
         <Grid>
         <Button Style="{StaticResource toolTileBoundStyle}"
                 Command="{Binding NavigateCommand}">
            <StackPanel Orientation="Horizontal">
               <StackPanel.Style>
                  <Style TargetType="StackPanel">
                     <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStorageRefresh}" Value="True">
                           <Setter Property="Margin" Value="0,0,30,0" />
                        </DataTrigger>
                     </Style.Triggers>
                  </Style>
               </StackPanel.Style>
               <Grid Style="{StaticResource appIconPlateStyle}">
                  <Border Style="{StaticResource appIconPlateFillStyle}" />
                  <Image Source="{Binding Icon}" Style="{StaticResource appIconImageStyle}" />
               </Grid>
               <StackPanel Style="{StaticResource appTextStackStyle}">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource appTitleStyle}" />
                  <TextBlock Text="{Binding SubTitle}" Style="{StaticResource appSubtitleBoundStyle}" />
                  <TextBlock Text="{Binding StorageCaption}" Style="{StaticResource appSubtitleBoundStyle}"
                             ToolTip="{Binding StorageDescription}" />
               </StackPanel>
            </StackPanel>
         </Button>
         <Button Command="{Binding RefreshCardCommand}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 ToolTip="Refresh card storage" AutomationProperties.Name="Refresh card storage"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Button.Style>
               <Style TargetType="Button" BasedOn="{StaticResource toolTileStyle}">
                  <Setter Property="Width" Value="26" />
                  <Setter Property="Height" Value="26" />
                  <Setter Property="Padding" Value="7" />
                  <Setter Property="Margin" Value="0,6,6,0" />
                  <Setter Property="HorizontalContentAlignment" Value="Center" />
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                     <DataTrigger Binding="{Binding HasStorageRefresh}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                     </DataTrigger>
                     <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                     </Trigger>
                  </Style.Triggers>
               </Style>
            </Button.Style>
            <fa:FontAwesome Icon="Solid_ArrowsRotate" FontSize="12" />
         </Button>
         </Grid>
      </DataTemplate>

      <!-- ============================================================
           APP TILE (bound)
           Same visual as the hand-written tile, with the two guards a
           bound tile needs: no empty second line and no empty tooltip
           when the entry leaves SubTitle/Description unset.
           ============================================================ -->
      <Style x:Key="appTileBoundStyle" TargetType="Button" BasedOn="{StaticResource appTileStyle}">
         <Setter Property="ToolTip" Value="{Binding Description}" />
         <Style.Triggers>
            <DataTrigger Binding="{Binding Description}" Value="">
               <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
               <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <DataTemplate x:Key="appTileTemplate" DataType="{x:Type local:MenuNavigation}">
         <Button Style="{StaticResource appTileBoundStyle}"
                 Command="{Binding NavigateCommand}">
            <StackPanel Orientation="Horizontal">
               <Grid Style="{StaticResource appIconPlateStyle}">
                  <Border Style="{StaticResource appIconPlateFillStyle}" />
                  <Image Source="{Binding Icon}" Style="{StaticResource appIconImageStyle}" />
               </Grid>
               <StackPanel Style="{StaticResource appTextStackStyle}">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource appTitleStyle}" />
                  <TextBlock Text="{Binding SubTitle}" Style="{StaticResource appSubtitleBoundStyle}" />
               </StackPanel>
            </StackPanel>
         </Button>
      </DataTemplate>

      <!-- The host for a run of tiles. A WrapPanel fills a row left to right and only then starts
           the next one, so the column count follows the panel width instead of being fixed. -->
      <Style x:Key="appTilesHostStyle" TargetType="ItemsControl">
         <Setter Property="ItemTemplate" Value="{StaticResource appTileTemplate}" />
         <Setter Property="ItemsPanel">
            <Setter.Value>
               <ItemsPanelTemplate>
                  <WrapPanel />
               </ItemsPanelTemplate>
            </Setter.Value>
         </Setter>
      </Style>

      <!-- ============================================================
           NAVIGATION GROUP (bound)
           One style for every depth: the level is a property of the
           bound MenuGroup, so a DataTrigger picks the look instead of
           the caller having to choose a per-level style. Level 1 carries
           the accent, level 2 and deeper share one font - the indent
           already shows how deep a group sits.
           ============================================================ -->
      <Style x:Key="navGroupBoundStyle" TargetType="Expander" BasedOn="{StaticResource navGroupLevelNStyle}">
         <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="1">
               <Setter Property="FontSize" Value="13" />
               <Setter Property="Margin" Value="0,14,0,0" />
               <Setter Property="Foreground"
                       Value="{DynamicResource themeAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="2">
               <Setter Property="FontSize" Value="12" />
               <Setter Property="Margin" Value="0,8,0,0" />
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <!-- Keyless on purpose: an implicit template is what lets a group render its own child
           groups by simply binding an ItemsControl to Groups, giving the whole tree - however
           deep MenuPath goes - from this one template. -->
      <DataTemplate DataType="{x:Type local:MenuGroup}">
         <Expander Header="{Binding Header}" Style="{StaticResource navGroupBoundStyle}">
            <StackPanel>
               <!-- Tiles of this group first, then the groups nested under it - the same order
                    the levels are read in. -->
               <ItemsControl ItemsSource="{Binding Items}" Style="{StaticResource appTilesHostStyle}" />
               <ItemsControl ItemsSource="{Binding Groups}" />
            </StackPanel>
         </Expander>
      </DataTemplate>


      <!-- ============================================================
           API CONNECTIONS ENTRY
           One radio per stored connection profile. The radio is the item's
           own template rather than a hand-wired group, so single selection
           comes from the ListBox itself; the radio is not hit-testable, which
           makes the whole row - not just the dot - the click target.
           ============================================================ -->
      <Style x:Key="connectionItemStyle" TargetType="ListBoxItem">
         <Setter Property="Padding" Value="0" />
         <Setter Property="Margin" Value="0" />
         <Setter Property="HorizontalContentAlignment" Value="Stretch" />
         <Setter Property="Cursor" Value="Hand" />
         <Setter Property="Template">
            <Setter.Value>
               <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="row" CornerRadius="9" Background="Transparent" Padding="10,6">
                     <RadioButton Focusable="False"
                                  IsHitTestVisible="False"
                                  FontSize="12"
                                  VerticalContentAlignment="Center"
                                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ContentPresenter />
                     </RadioButton>
                  </Border>
                  <ControlTemplate.Triggers>
                     <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="row" Property="Background" Value="{StaticResource surfaceHoverBrush}" />
                     </Trigger>
                     <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="row" Property="Background" Value="{StaticResource surfaceBrush}" />
                     </Trigger>
                  </ControlTemplate.Triggers>
               </ControlTemplate>
            </Setter.Value>
         </Setter>
      </Style>

      <!-- The list is a plain surface inside the card: the card already draws the
           background and the outline, so the ListBox contributes neither. Virtualization
           is off so every radio shares one panel - the list is short by nature. -->
      <Style x:Key="connectionListStyle" TargetType="ListBox">
         <Setter Property="Background" Value="Transparent" />
         <Setter Property="BorderThickness" Value="0" />
         <Setter Property="Padding" Value="0" />
         <Setter Property="ItemContainerStyle" Value="{StaticResource connectionItemStyle}" />
         <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
         <Setter Property="ItemsPanel">
            <Setter.Value>
               <ItemsPanelTemplate>
                  <StackPanel />
               </ItemsPanelTemplate>
            </Setter.Value>
         </Setter>
      </Style>

      <!-- Icon-only action button sitting in a panel caption row. Square, no chrome of its
           own until the pointer is over it, so the caption stays the loudest thing on the row. -->
      <Style x:Key="captionIconButtonStyle" TargetType="Button">
         <Setter Property="Width" Value="26" />
         <Setter Property="Height" Value="26" />
         <Setter Property="Padding" Value="0" />
         <Setter Property="Cursor" Value="Hand" />
         <Setter Property="Background" Value="Transparent" />
         <Setter Property="BorderThickness" Value="0" />
         <Setter Property="Template">
            <Setter.Value>
               <ControlTemplate TargetType="Button">
                  <Border x:Name="plate"
                          CornerRadius="8"
                          Background="{TemplateBinding Background}">
                     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                     <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="plate" Property="Background" Value="{StaticResource surfaceHoverBrush}" />
                     </Trigger>
                     <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="plate" Property="Background" Value="{StaticResource surfacePressedBrush}" />
                     </Trigger>
                     <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="plate" Property="Opacity" Value="0.35" />
                     </Trigger>
                  </ControlTemplate.Triggers>
               </ControlTemplate>
            </Setter.Value>
         </Setter>
      </Style>
   </UserControl.Resources>

   <Grid Margin="14,12,14,0">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- =========================================================
           SEARCH - spans both panels, it filters the whole home screen
           ========================================================= -->
      <Border Grid.Row="0"
              Height="38"
              Margin="0,0,0,14"
              CornerRadius="19"
              Background="{StaticResource surfaceBrush}"
              BorderThickness="1"
              BorderBrush="{StaticResource outlineBrush}">
         <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <fa:FontAwesome Grid.Column="0"
                            Icon="Solid_MagnifyingGlass"
                            FontSize="13"
                            Opacity="0.6"
                            VerticalAlignment="Center" />

            <Grid Grid.Column="1" Margin="12,0,0,0">
               <TextBox x:Name="searchBox" Style="{StaticResource searchBoxStyle}" />
               <!-- Watermark: shown only while the box is empty -->
               <TextBlock Text="Search"
                          FontSize="13"
                          Opacity="0.55"
                          IsHitTestVisible="False"
                          VerticalAlignment="Center">
                  <TextBlock.Style>
                     <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                           <DataTrigger Binding="{Binding Text, ElementName=searchBox}" Value="">
                              <Setter Property="Visibility" Value="Visible" />
                           </DataTrigger>
                        </Style.Triggers>
                     </Style>
                  </TextBlock.Style>
               </TextBlock>
            </Grid>
         </Grid>
      </Border>

      <Grid Grid.Row="1">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>

         <!-- =========================================================
              MAIN PANEL - the navigation tree
              Everything here is bound: the view model turns the flat
              AppMenus list into RootAppMenus (entries with no MenuPath)
              plus AppMenuGroups (the tree built from MenuPath), and the
              templates in the resources render both, at any depth.
              ========================================================= -->
         <ScrollViewer Grid.Column="0"
                       Margin="0,0,14,0"
                       Padding="0,0,10,0"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
               <!-- Menus registered without a MenuPath. They belong to no group, so they sit
                    above the tree rather than being invented a caption of their own. -->
               <ItemsControl ItemsSource="{Binding RootAppMenus}"
                             Style="{StaticResource appTilesHostStyle}" />

               <!-- The tree itself. No template is named here: MenuGroup has an implicit one,
                    and that template renders its own child groups the same way, so a MenuPath
                    of any depth arrives on screen without extra markup. -->
               <ItemsControl ItemsSource="{Binding AppMenuGroups}" />
            </StackPanel>
         </ScrollViewer>

         <!-- =========================================================
              RIGHT COLUMN - docked cards
              Two cards stacked: the API connection picker on top, the
              tools list under it. Both are 276 wide and share the 14px
              gutter used between the tree and this column, so the gap
              between the cards reads the same as the gap beside them.
              ========================================================= -->
         <!-- Both cards can drop out - the tools card when no tool is registered, the
              connections card outside a debug run or with no profile stored - and the column
              itself goes with them. Its ColumnDefinition is sized Auto, so collapsing here hands
              the width back to the navigation tree instead of leaving a gap. d:Visibility keeps
              the column visible in the designer, where every collection is empty. -->
         <Grid Grid.Column="1" Width="276" d:Visibility="Visible">
            <Grid.Style>
               <Style TargetType="Grid">
                  <Style.Triggers>
                     <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                           <Condition Binding="{Binding StaticToolMenus.Count}" Value="0" />
                           <Condition Binding="{Binding IsDebugMode}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" />
                     </MultiDataTrigger>
                     <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                           <Condition Binding="{Binding StaticToolMenus.Count}" Value="0" />
                           <Condition Binding="{Binding ApiConnections.Count}" Value="0" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" />
                     </MultiDataTrigger>
                  </Style.Triggers>
               </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto" />
               <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- =========================================================
                 API CONNECTIONS CARD
                 The connection profiles the client can talk to, one radio
                 each, plus an icon-only button that tests whichever one is
                 picked. This is the single-page counterpart of the
                 connection combo box in the multi-tab toolbar.

                 Only a debug run offers this: outside it the application decides which
                 server to talk to, so there is nothing here for the user to pick. The card also
                 goes when no profile is stored at all, rather than showing an empty box.
                 ========================================================= -->
            <Grid Grid.Row="0" Margin="0,0,0,14" d:Visibility="Visible">
               <Grid.Style>
                  <Style TargetType="Grid">
                     <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDebugMode}" Value="False">
                           <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ApiConnections.Count}" Value="0">
                           <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                     </Style.Triggers>
                  </Style>
               </Grid.Style>
               <Border CornerRadius="16" Background="{StaticResource surfaceBrush}" />
               <Border CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource outlineBrush}" />
               <StackPanel Margin="10,14,10,14" IsEnabled="{Binding IsNotBusy}">
                  <!-- Caption row: the caption keeps the same style and indent as the tools
                       caption, and the test button is pushed to the opposite edge. -->
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                     </Grid.ColumnDefinitions>

                     <TextBlock Grid.Column="0"
                                Text="API CONNECTIONS"
                                VerticalAlignment="Center"
                                Style="{StaticResource panelCaptionStyle}" />

                     <Button Grid.Column="1"
                             Margin="0,0,2,8"
                             Style="{StaticResource captionIconButtonStyle}"
                             Command="{Binding Commands[TestConnectionCommand]}"
                             ToolTip="Test the selected connection">
                        <fa:FontAwesome Icon="Solid_PlugCircleCheck"
                                        FontSize="13"
                                        Foreground="{DynamicResource themeAccentBrush}" />
                     </Button>
                  </Grid>

                  <!-- Capped rather than free-growing: a long list of profiles would otherwise
                       push the tools card off the bottom of the column. -->
                  <ScrollViewer MaxHeight="220"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                     <!-- Bound straight to the application's own connection collection, so a
                          profile saved or deleted in the Connection Config dialog shows up here
                          without anything having to refresh the card. Picking an entry makes it
                          the active connection of the whole application. -->
                     <ListBox Style="{StaticResource connectionListStyle}"
                              ItemsSource="{Binding ApiConnections}"
                              SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                              DisplayMemberPath="ProfileName" />
                  </ScrollViewer>

                  <!-- Result of the last test, same dot-plus-caption pair the connection editor
                       dialog carries in its status bar. It reads "Not tested" until the button is
                       used, and goes back to that whenever another profile is picked. -->
                  <StackPanel Orientation="Horizontal" Margin="12,10,10,0">
                     <Ellipse Width="8" Height="8"
                              VerticalAlignment="Center"
                              Fill="{Binding StatusBrush, FallbackValue=Gray}" />
                     <TextBlock Text="{Binding StatusText, FallbackValue='Not tested'}"
                                Margin="8,0,0,0"
                                FontSize="10.5"
                                Opacity="0.8"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                  </StackPanel>
               </StackPanel>

               <!-- Scoped to the card rather than to the window: the handshake only blocks this
                    one panel, and the home screen behind it stays usable. -->
               <controls:WaitOverlay IsWaiting="{Binding InWaiting}" Caption="{Binding WaiterText}" />
            </Grid>

            <!-- =========================================================
                 TOOLS CARD
                 A card holding the fixed, non-module entries. Same tile
                 visual as the main panel, one entry per row.

                 The entries come from the view model, filled by hand in
                 RenderStaticItems - either from an existing navigation or as a
                 plain entry with its own command and no navigation at all. The
                 caption sits outside the ItemsControl so it stays put no matter
                 what the collection holds.
                 ========================================================= -->
            <!-- The whole card - heading included - disappears when there is nothing to put in
                 it, since an application is free to register no tools at all. Count comes from
                 the ObservableCollection itself, which raises a change notification for it, so
                 this follows later additions. d:Visibility keeps the card visible in the
                 designer, where the collection is always empty. -->
            <Grid Grid.Row="1" d:Visibility="Visible">
               <Grid.Style>
                  <Style TargetType="Grid">
                     <Style.Triggers>
                        <DataTrigger Binding="{Binding StaticToolMenus.Count}" Value="0">
                           <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                     </Style.Triggers>
                  </Style>
               </Grid.Style>
               <Border CornerRadius="16" Background="{StaticResource surfaceBrush}" />
               <Border CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource outlineBrush}" />
               <ScrollViewer Margin="10,14,10,14"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                     <TextBlock Text="TOOLS" Style="{StaticResource panelCaptionStyle}" />

                     <!-- Bound to DefaultHomeControlVm.StaticToolMenus, which RenderStaticItems
                          fills by hand. No grouping and no filtering here on purpose: the tools
                          list is a fixed, flat set of entries, so a plain ItemsControl carries it.
                          Entries added manually - a tool that is not a navigation - land in the
                          same collection and use the same template. The designer shows this panel
                          empty; the collection is only populated at runtime. -->
                     <ItemsControl x:Name="staticItemsHost"
                                   ItemsSource="{Binding StaticToolMenus}"
                                   ItemTemplate="{StaticResource toolTileTemplate}" />
                  </StackPanel>
               </ScrollViewer>
            </Grid>
         </Grid>
      </Grid>
   </Grid>
</UserControl>
