<UserControl x:Class="Em.Ui.Wpf.Navigations.ApprovalManager"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Em.Ui.Wpf.Navigations"
 xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
 Background="{DynamicResource themeWindowBackgroundBrush}" Foreground="{DynamicResource themeWindowForegroundBrush}">
 <UserControl.DataContext><local:ApprovalManagerVm/></UserControl.DataContext>
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/>
    <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/Approval.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <DataTemplate x:Key="changeCompactTemplate">
    <Border BorderBrush="{StaticResource dividerBrush}" BorderThickness="0,0,0,1" Padding="2,10">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
       <TextBlock Text="{Binding FieldName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Entity}" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="OLD" Style="{StaticResource sectionCaptionStyle}"/><TextBlock Text="{Binding OldValue}" TextWrapping="Wrap" Opacity="0.75"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="PROPOSED" Style="{StaticResource sectionCaptionStyle}"/><TextBlock Text="{Binding NewValue}" TextWrapping="Wrap" FontWeight="SemiBold"/></StackPanel>
     </Grid>
    </Border>
   </DataTemplate>
   <DataTemplate x:Key="changeTemplate">
    <Border Style="{StaticResource innerCardStyle}" Padding="10" Margin="0,4">
     <StackPanel>
      <TextBlock Text="{Binding FieldName}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Entity}" Opacity="0.55" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding EntityKey}" Opacity="0.55" TextWrapping="Wrap"/>
      <Grid Margin="0,8,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0"><TextBlock Text="OLD" Style="{StaticResource sectionCaptionStyle}"/><TextBlock Text="{Binding OldValue}" TextWrapping="Wrap"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="CURRENT" Style="{StaticResource sectionCaptionStyle}"/><TextBlock Text="{Binding CurrentValue}" TextWrapping="Wrap"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="PROPOSED" Style="{StaticResource sectionCaptionStyle}"/><TextBlock Text="{Binding NewValue}" TextWrapping="Wrap"/></StackPanel>
      </Grid>
     </StackPanel>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="{Binding RootMargin}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel IsEnabled="{Binding IsReady}" Visibility="{Binding ShowToolbar, Converter={StaticResource boolToVisibility}}">
   <DockPanel Margin="0,0,0,12">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="Refresh" Style="{StaticResource tonalButtonStyle}" Command="{Binding Commands[RefreshCommand]}" Margin="8,0"/>
     <ToggleButton Content="Filters" Style="{StaticResource sheetToggleStyle}" IsChecked="{Binding FilterSheetOpen}"/>
    </StackPanel>
    <Border CornerRadius="19" BorderThickness="1" BorderBrush="{StaticResource outlineBrush}" Padding="14,0" Height="38" MaxWidth="430" HorizontalAlignment="Left">
     <TextBox Style="{StaticResource searchBoxStyle}" Tag="Search number, requester or summary" Width="340" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
      <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Commands[ApplyFiltersCommand]}"/></TextBox.InputBindings>
     </TextBox>
    </Border>
   </DockPanel>
   <WrapPanel Margin="0,0,0,10">
    <ComboBox Style="{StaticResource fieldComboStyle}" Width="175" ItemsSource="{Binding Modes}" SelectedIndex="{Binding Mode}" Margin="0,0,8,0"/>
    <ComboBox Style="{StaticResource fieldComboStyle}" Width="190" IsEditable="True" ItemsSource="{Binding DocTypes}" Text="{Binding DocType, UpdateSourceTrigger=LostFocus}" Tag="All document types" Margin="0,0,12,0"/>
    <Button Content="Approve selected" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[ApproveSelectedCommand]}"/>
   </WrapPanel>
   <ItemsControl ItemsSource="{Binding FilterChips}" Margin="0,0,0,10">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource chipMutedStyle}" Margin="0,0,6,4"><StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding Caption}" VerticalAlignment="Center"/>
      <Button Content="×" Style="{StaticResource flatIconButtonStyle}" Width="24" Height="24" Margin="6,0,0,0"
       Command="{Binding DataContext.Commands[RemoveFilterCommand], RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"/>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource cardStyle}" BorderBrush="{StaticResource dangerBrush}" Padding="14" Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource boolToVisibility}}">
   <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ListColumnWidth}"/><ColumnDefinition Width="{Binding GapColumnWidth}"/><ColumnDefinition Width="{Binding DetailColumnWidth}"/></Grid.ColumnDefinitions>
   <Grid Visibility="{Binding ShowLeftColumn, Converter={StaticResource boolToVisibility}}">
    <Grid.RowDefinitions><RowDefinition Height="{Binding ListRowHeight}"/><RowDefinition Height="{Binding PdfRowHeight}"/></Grid.RowDefinitions>
    <Border Style="{StaticResource cardStyle}" Visibility="{Binding ShowList, Converter={StaticResource boolToVisibility}}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ListView x:Name="RequestsList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0" Background="Transparent"
       IsEnabled="{Binding IsReady}" Foreground="{DynamicResource themeWindowForegroundBrush}" ItemContainerStyle="{StaticResource materialListViewItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      <TextBlock Text="No approval requests" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <Border Grid.Row="1" BorderBrush="{StaticResource dividerBrush}" BorderThickness="0,1,0,0" Padding="12" Visibility="{Binding ShowPager, Converter={StaticResource boolToVisibility}}">
       <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding PageCaption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Content="|‹" Style="{StaticResource flatIconButtonStyle}" Command="{Binding Commands[FirstPageCommand]}"/>
        <Button Content="‹" Style="{StaticResource flatIconButtonStyle}" Command="{Binding Commands[PreviousPageCommand]}"/>
        <Button Content="›" Style="{StaticResource flatIconButtonStyle}" Command="{Binding Commands[NextPageCommand]}"/>
        <Button Content="›|" Style="{StaticResource flatIconButtonStyle}" Command="{Binding Commands[LastPageCommand]}"/>
        <ComboBox Width="76" Margin="10,0,0,0" Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}"/>
       </WrapPanel>
      </Border>
     </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource cardStyle}" Margin="0,12,0,0" Visibility="{Binding ShowDocumentSurface, Converter={StaticResource boolToVisibility}}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ContentControl Content="{Binding PdfContent}">
      <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Height" Value="280"/><Style.Triggers><DataTrigger Binding="{Binding IsDocumentMode}" Value="True"><Setter Property="Height" Value="Auto"/></DataTrigger></Style.Triggers></Style></ContentControl.Style>
      </ContentControl>
      <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowChangesInDocument, Converter={StaticResource boolToVisibility}}">
       <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource changeTemplate}"/>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{StaticResource dividerBrush}" BorderThickness="0,1,0,0" Padding="12" Visibility="{Binding IsDocumentMode, Converter={StaticResource boolToVisibility}}">
       <WrapPanel>
        <Button Content="Previous" Style="{StaticResource textButtonStyle}" Command="{Binding Commands[PreviousRequestCommand]}" Margin="0,0,6,0"/>
        <Button Content="Next" Style="{StaticResource textButtonStyle}" Command="{Binding Commands[NextRequestCommand]}" Margin="0,0,16,0"/>
        <Button Content="Approve" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[ApproveCommand]}" Margin="0,0,6,0"/>
        <Button Content="Reject" Style="{StaticResource dangerOutlinedButtonStyle}" Command="{Binding Commands[RejectCommand]}" Margin="0,0,6,0"/>
        <Button Content="Approve (override)" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[GuardOverrideCommand]}" Visibility="{Binding ShowGuardOverride, Converter={StaticResource boolToVisibility}}" Margin="0,0,6,0"/>
        <Button Content="Withdraw" Style="{StaticResource textDangerButtonStyle}" Command="{Binding Commands[CancelCommand]}"/>
       </WrapPanel>
      </Border>
     </Grid>
    </Border>
   </Grid>
   <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,48,0,0" HorizontalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource boolToVisibility}}">
    <TextBlock Text="No change requests" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="Changes submitted for approval will appear here." Opacity="0.65" Margin="0,6,0,0" HorizontalAlignment="Center"/>
   </StackPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowRequestDetail, Converter={StaticResource boolToVisibility}}">
    <StackPanel>
     <Border Style="{StaticResource cardStyle}" Padding="14" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="REQUEST" Style="{StaticResource sectionCaptionStyle}"/>
       <StackPanel Visibility="{Binding ShowRequestLinks, Converter={StaticResource boolToVisibility}}">
        <TextBlock Text="{Binding Request.DocKeyDisplay}" FontSize="17" FontWeight="SemiBold" Margin="0,6" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Request.DocType}" Opacity="0.65"/>
       </StackPanel>
       <StackPanel Visibility="{Binding IsCompact, Converter={StaticResource boolToVisibility}}">
        <ComboBox Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsEnabled="{Binding IsReady}" Margin="0,6,0,0"
         Visibility="{Binding ShowRequestPicker, Converter={StaticResource boolToVisibility}}">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Info.RequesterName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Info.Stage, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Info.RequestDate, Mode=OneWay, StringFormat=dd MMM yyyy HH:mm}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <DockPanel Margin="0,8,0,0">
         <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Content="{Binding Request.Stage}">
          <ContentControl.ContentTemplate><DataTemplate>
           <Border x:Name="chip" Style="{StaticResource chipMutedStyle}"><TextBlock Text="{Binding}"/></Border>
           <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="Approved"><Setter TargetName="chip" Property="Style" Value="{StaticResource chipSuccessStyle}"/></DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Pending"><Setter TargetName="chip" Property="Style" Value="{StaticResource chipWarningStyle}"/></DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Rejected"><Setter TargetName="chip" Property="Style" Value="{StaticResource chipDangerStyle}"/></DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Cancelled"><Setter TargetName="chip" Property="Style" Value="{StaticResource chipDangerStyle}"/></DataTrigger>
           </DataTemplate.Triggers>
          </DataTemplate></ContentControl.ContentTemplate>
         </ContentControl>
         <TextBlock Text="{Binding Request.RequesterName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding Request.RequestDate, StringFormat=Requested {0:dd MMM yyyy HH:mm}}" Opacity="0.65" Margin="0,2,0,0"/>
       </StackPanel>
       <WrapPanel Margin="0,10,0,0" Visibility="{Binding ShowRequestLinks, Converter={StaticResource boolToVisibility}}">
        <Button Content="Open" Style="{StaticResource tonalButtonStyle}" Command="{Binding Commands[OpenDocumentCommand]}" Margin="0,0,6,6"/>
        <Button Content="Open tab" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[OpenTabCommand]}" Margin="0,0,6,6"/>
        <Button Content="Source document" Style="{StaticResource textButtonStyle}" Command="{Binding Commands[OpenOriginalCommand]}" Margin="0,0,6,6"/>
       </WrapPanel>
       <WrapPanel Visibility="{Binding IsDocumentMode, Converter={StaticResource boolToVisibility}}">
        <Button Content="Previous" Style="{StaticResource textButtonStyle}" Command="{Binding Commands[PreviousRequestCommand]}"/>
        <Button Content="Next" Style="{StaticResource textButtonStyle}" Command="{Binding Commands[NextRequestCommand]}"/>
        <Button Content="List" Style="{StaticResource textButtonStyle}" Command="{Binding Commands[CloseDocumentCommand]}"/>
       </WrapPanel>
       <StackPanel Visibility="{Binding ShowStepPicker, Converter={StaticResource boolToVisibility}}">
        <TextBlock Text="STEP" Style="{StaticResource sectionCaptionStyle}" Margin="0,12,0,6"/>
        <ComboBox IsEnabled="{Binding IsReady}" Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding StepNames}" SelectedItem="{Binding SelectedStepName}"/>
        <TextBlock Text="{Binding SelectedStep.Status}" Margin="0,6" Opacity="0.65"/>
       </StackPanel>
       <ContentControl Content="{Binding StepPanel}" Margin="0,6">
        <ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><DataTrigger Binding="{Binding StepPanel}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ContentControl.Style>
       </ContentControl>
       <TextBlock Text="{Binding GuardReason}" Foreground="{StaticResource warningBrush}" TextWrapping="Wrap" Margin="0,6" Visibility="{Binding HasGuardReason, Converter={StaticResource boolToVisibility}}"/>
       <TextBox Style="{StaticResource fieldBoxStyle}" Tag="Decision note (optional)" Margin="0,12,0,0" Text="{Binding DecisionNote, UpdateSourceTrigger=PropertyChanged}"/>
       <WrapPanel Margin="0,10,0,0" Visibility="{Binding ShowList, Converter={StaticResource boolToVisibility}}">
        <Button Content="Approve" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[ApproveCommand]}" Margin="0,0,6,6"/>
        <Button Content="Reject" Style="{StaticResource dangerOutlinedButtonStyle}" Command="{Binding Commands[RejectCommand]}" Margin="0,0,6,6"/>
        <Button Content="Approve (override)" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[GuardOverrideCommand]}" Visibility="{Binding ShowGuardOverride, Converter={StaticResource boolToVisibility}}" Margin="0,0,6,6"/>
        <Button Content="Withdraw" Style="{StaticResource textDangerButtonStyle}" Command="{Binding Commands[CancelCommand]}"/>
       </WrapPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource cardStyle}" Padding="14" Margin="0,0,0,10" Visibility="{Binding HasConflicts, Converter={StaticResource boolToVisibility}}">
      <StackPanel><TextBlock Text="DATA CONFLICTS" Style="{StaticResource sectionCaptionStyle}"/>
       <ItemsControl ItemsSource="{Binding Conflicts}" ItemTemplate="{StaticResource changeTemplate}"/>
       <TextBlock Text="The entity no longer exists. This conflict cannot be overridden." TextWrapping="Wrap" Visibility="{Binding ConflictIsFinal, Converter={StaticResource boolToVisibility}}"/>
       <Button Content="Apply anyway" Style="{StaticResource dangerOutlinedButtonStyle}" Command="{Binding Commands[ConflictOverrideCommand]}" Visibility="{Binding ShowConflictOverride, Converter={StaticResource boolToVisibility}}" Margin="0,8"/>
       <Button Content="Reject request" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[ConflictRejectCommand]}"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource cardStyle}" Padding="14" Margin="0,0,0,10"><StackPanel>
      <ToggleButton x:Name="changesToggle" Content="PROPOSED CHANGES" Style="{StaticResource groupHeaderToggleStyle}" IsChecked="True"/>
      <StackPanel Visibility="{Binding IsChecked, ElementName=changesToggle, Converter={StaticResource boolToVisibility}}">
       <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource changeTemplate}" Visibility="{Binding ShowRequestLinks, Converter={StaticResource boolToVisibility}}"/>
       <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource changeCompactTemplate}" Visibility="{Binding IsCompact, Converter={StaticResource boolToVisibility}}"/>
      </StackPanel>
     </StackPanel></Border>
     <ItemsControl ItemsSource="{Binding InfoCards}" Visibility="{Binding ShowInfoCards, Converter={StaticResource boolToVisibility}}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource cardStyle}" Padding="14" Margin="0,0,0,10"><StackPanel>
       <ToggleButton x:Name="infoToggle" Content="{Binding Title}" Style="{StaticResource groupHeaderToggleStyle}" IsChecked="True"/>
       <ContentControl Content="{Binding Content}" Visibility="{Binding IsChecked, ElementName=infoToggle, Converter={StaticResource boolToVisibility}}"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border Style="{StaticResource cardStyle}" Padding="14" Margin="0,0,0,10"><StackPanel>
      <ToggleButton x:Name="timelineToggle" Content="TIMELINE" Style="{StaticResource groupHeaderToggleStyle}" IsChecked="{Binding TimelineOpen}"/>
      <StackPanel Visibility="{Binding IsChecked, ElementName=timelineToggle, Converter={StaticResource boolToVisibility}}">
      <ItemsControl ItemsSource="{Binding Timeline}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{StaticResource dividerBrush}" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/></StackPanel>
        <TextBlock Text="{Binding Entry.ActorName}"/>
        <TextBlock Text="{Binding Entry.Date, StringFormat=dd MMM yyyy HH:mm}" Opacity="0.55"/>
        <TextBlock Text="{Binding Entry.StepName}" Opacity="0.65"/>
        <TextBlock Text="{Binding Entry.Note}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBox Style="{StaticResource fieldBoxStyle}" Tag="Write a comment" Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65" Margin="0,10,0,6"/>
      <Button Content="Add comment" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[CommentCommand]}"/>
      </StackPanel>
     </StackPanel></Border>
     <ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource innerCardStyle}" Padding="10" Margin="0,0,0,6"><StackPanel>
       <TextBlock Text="{Binding RequestId}" FontFamily="Consolas" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding StepName}" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <ToggleButton Grid.RowSpan="3" Style="{StaticResource sheetScrimStyle}" IsChecked="{Binding FilterSheetOpen}"/>
  <Border Grid.RowSpan="3" Width="360" HorizontalAlignment="Right" Background="{DynamicResource themePopupBackgroundBrush}" BorderBrush="{StaticResource outlineBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Visibility="{Binding FilterSheetOpen, Converter={StaticResource boolToVisibility}}">
   <StackPanel>
    <TextBlock Text="FILTER REQUESTS" Style="{StaticResource sectionCaptionStyle}" Margin="0,0,0,20"/>
    <TextBlock Text="Stage" Margin="0,0,0,6"/><ComboBox Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding Stages}" SelectedItem="{Binding Stage}"/>
    <TextBlock Text="Search" Margin="0,16,0,6"/><TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
    <Button Content="Apply filters" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[ApplyFiltersCommand]}" Margin="0,22,0,8"/>
    <Button Content="Clear all" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[ClearFiltersCommand]}"/>
    <ToggleButton Content="Close" Style="{StaticResource sheetToggleStyle}" IsChecked="{Binding FilterSheetOpen}" Margin="0,12,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
