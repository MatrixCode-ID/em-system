<UserControl x:Class="Em.Ui.Wpf.Navigations.ApprovalManager"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Em.Ui.Wpf.Navigations"
 Foreground="{DynamicResource themeWindowForegroundBrush}">
 <UserControl.DataContext><local:ApprovalManagerVm/></UserControl.DataContext>
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="visible"/>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="22,12,22,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
   <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
    <Button Style="{StaticResource outlinedButtonStyle}" Content="Refresh" Command="{Binding Commands[RefreshCommand]}"/>
    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFilters, Converter={StaticResource visible}}">
     <Border Style="{StaticResource toolbarSeparatorStyle}"/>
     <ComboBox Width="190" Margin="0,0,8,0" Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}">
      <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Kind}" Opacity="0.55" Margin="0,0,6,0"/><TextBlock Text="{Binding Title}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <TextBox Width="160" Margin="0,0,8,0" Style="{StaticResource fieldBoxStyle}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search approval names and summaries, then refresh."/>
     <ComboBox Width="120" Margin="0,0,8,0" Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding Stages}" SelectedItem="{Binding Stage}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     <CheckBox Content="Needs my action" IsChecked="{Binding WaitingForMe}" VerticalAlignment="Center"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="1" Text="{Binding Error}" TextWrapping="Wrap" Foreground="#E05656" Margin="0,0,0,8"/>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ListWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,16,0" Visibility="{Binding ShowFilters, Converter={StaticResource visible}}">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
     <Button Style="{StaticResource textButtonStyle}" Content="Previous" Command="{Binding Commands[PreviousCommand]}"/>
     <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8,0"/>
     <Button Style="{StaticResource textButtonStyle}" Content="Next" Command="{Binding Commands[NextCommand]}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="APPROVAL / SUMMARY / STATUS" Style="{StaticResource columnHeaderStyle}" Margin="8,0,0,8"/></StackPanel>
    <ListBox Style="{StaticResource surfaceListBoxStyle}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRequest}" IsEnabled="{Binding IsNotBusy}">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,8">
      <TextBlock Text="{Binding cApprovalName}" FontWeight="SemiBold"/><TextBlock Text="{Binding cSummary}" TextWrapping="Wrap" Margin="0,4"/>
      <TextBlock Text="{Binding cApprovalRequestStage}" Opacity="0.6"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <ComboBox Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRequest}" Margin="0,0,0,12" Visibility="{Binding IsCompact, Converter={StaticResource visible}}">
      <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding cSummary}"/><TextBlock Text="{Binding cApprovalRequestStage}" Margin="8,0,0,0"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,12" Opacity="0.65"/>
     <StackPanel ToolTip="Required for rejection, withdrawal, void and reinstate. Optional for signing." ToolTipService.ShowOnDisabled="True">
      <TextBlock Text="Decision note / reason" Style="{StaticResource fieldLabelStyle}"/>
      <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsData, Converter={StaticResource visible}}">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
       <Button Content="Approve" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[ApproveCommand]}"/>
       <Button Content="Reject" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[RejectCommand]}" Margin="8,0"/>
       <Button Content="Withdraw" Style="{StaticResource textButtonStyle}" Command="{Binding Commands[WithdrawCommand]}"/>
      </StackPanel>
      <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBlock Text="COLUMN" Style="{StaticResource columnHeaderStyle}"/><TextBlock Grid.Column="1" Text="OLD" Style="{StaticResource columnHeaderStyle}"/>
       <TextBlock Grid.Column="2" Text="CURRENT" Style="{StaticResource columnHeaderStyle}"/><TextBlock Grid.Column="3" Text="PROPOSED" Style="{StaticResource columnHeaderStyle}"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Column}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Original}" TextWrapping="Wrap" Margin="8,0"/>
        <TextBlock Grid.Column="2" Text="{Binding Current}" TextWrapping="Wrap" Margin="8,0"/><TextBlock Grid.Column="3" Text="{Binding Proposed}" TextWrapping="Wrap" Margin="8,0"/>
       </Grid>
       <StackPanel Visibility="{Binding Conflict, Converter={StaticResource visible}}" Margin="0,6,0,0" ToolTip="Explain why the proposed value should replace the conflicting current value.">
        <TextBlock Text="Conflict · override reason" Foreground="#C98A00"/><TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
       </StackPanel>
      </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{Binding CreateSnapshots}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,12"/>
     </StackPanel>
     <local:ApprovalEditor Visibility="{Binding IsSystem, Converter={StaticResource visible}}"/>
     <Expander Header="Timeline and comments" IsExpanded="False" Style="{StaticResource sectionExpanderStyle}" Margin="0,12,0,0">
      <StackPanel>
       <ItemsControl ItemsSource="{Binding Timeline}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comment visible to everyone who can view this request." Margin="0,8,0,6"/>
       <Button Content="Add comment" Style="{StaticResource outlinedButtonStyle}" HorizontalAlignment="Left" Command="{Binding Commands[CommentCommand]}"/>
      </StackPanel>
     </Expander>
     <Expander Header="Attachments" Style="{StaticResource sectionExpanderStyle}" Margin="0,12,0,0" Visibility="{Binding Detail.CanAttach, Converter={StaticResource visible}}">
      <StackPanel>
       <Button Content="Attach file" HorizontalAlignment="Left" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[AttachCommand]}" Margin="0,6"/>
       <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource textButtonStyle}" HorizontalAlignment="Left" Content="{Binding cApprovalRequestAttachmentName}" Command="{Binding DataContext.Commands[DownloadCommand], RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
