<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Em.Ui.Wpf.Navigations" xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls" xmlns:shared="clr-namespace:Em.Ui.Wpf.Shared" xmlns:fa="http://schemas.fontawesome.com/icons/fonts" x:Class="Em.Ui.Wpf.Navigations.ObjectStorageManager" x:Name="storeRoot">
   <UserControl.DataContext>
      <local:ObjectStorageManagerVm/>
   </UserControl.DataContext>
   <UserControl.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/>
         </ResourceDictionary.MergedDictionaries>
         <BooleanToVisibilityConverter x:Key="boolVisibility"/>
         <Style x:Key="storeRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource listRowStyle}">
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick"/>
         </Style>
         <Style x:Key="storeSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource outlineBrush}"/>
         </Style>
         <DataTemplate x:Key="optionTemplate">
            <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis"/>
         </DataTemplate>
         <DataTemplate x:Key="policyNameTemplate">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
         </DataTemplate>
         <!-- MANAGED and NOT DECLARED chips of a StoreBucketInfo; nothing for an ordinary bucket. -->
         <DataTemplate x:Key="managedChipsTemplate">
            <StackPanel Orientation="Horizontal">
               <Border Style="{StaticResource chipAccentStyle}" Margin="8,0,0,0" Padding="8,1" ToolTipService.ShowDuration="60000" Visibility="{Binding IsManaged, Converter={StaticResource boolVisibility}}">
                  <Border.ToolTip>
                     <StackPanel MaxWidth="360">
                        <TextBlock Text="{Binding Owner, StringFormat=Managed by {0}}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Contents are read-only here; the policy keeps its access and the bucket cannot be deleted." TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"/>
                     </StackPanel>
                  </Border.ToolTip>
                  <TextBlock Text="MANAGED"/>
               </Border>
               <Border Style="{StaticResource chipWarningStyle}" Margin="6,0,0,0" Padding="8,1" ToolTipService.ShowDuration="60000" Visibility="{Binding IsUndeclared, Converter={StaticResource boolVisibility}}"
                       ToolTip="The application no longer declares this bucket. It stays locked until it is released with More &gt; Release managed bucket.">
                  <TextBlock Text="NOT DECLARED"/>
               </Border>
            </StackPanel>
         </DataTemplate>
      </ResourceDictionary>
   </UserControl.Resources>
   <Grid ClipToBounds="True" PreviewKeyDown="OnPreviewKeyDown">
      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <DockPanel Margin="22,8,22,0" LastChildFill="True">
            <controls:FeatureServiceToggle x:Name="serviceToggle" DockPanel.Dock="Right" />
         <controls:EmTabStrip ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}" TitlePath="Title" CanReorder="False" IsEnabled="{Binding CanBrowse}"/>
         </DockPanel>

         <!-- Buckets and the object browser -->
         <Grid Grid.Row="1" Visibility="{Binding IsBucketsTab, Converter={StaticResource boolVisibility}}">
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Margin="22,12,22,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsNotBrowsing, Converter={StaticResource boolVisibility}}">
               <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[NewBucketCommand]}">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_Plus" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="New bucket" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Border Style="{StaticResource storeSeparatorStyle}"/>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[OpenBucketCommand]}">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_FolderOpen" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Browse" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[OpenBucketPageCommand]}" Margin="8,0,0,0" ToolTip="Open the bucket editor in its own tab: settings and objects on one screen.">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_UpRightFromSquare" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Open in tab" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[EditBucketCommand]}" Margin="8,0,0,0">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_Pen" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[DeleteBucketCommand]}" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="Delete an empty bucket. A managed bucket cannot be deleted.">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_TrashCan" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Button Style="{StaticResource outlinedButtonStyle}" Margin="8,0,0,0" Click="OnMoreClick" IsEnabled="{Binding CanBrowse}" ToolTip="More bucket actions" AutomationProperties.Name="More bucket actions">
                     <fa:FontAwesome Icon="Solid_EllipsisVertical" Style="{StaticResource buttonIconStyle}" Margin="0"/>
                     <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource cascadeContextMenuStyle}">
                           <MenuItem Header="Release managed bucket" Command="{Binding Commands[ReleaseBucketCommand]}" ToolTipService.ShowOnDisabled="True" ToolTip="Turns a managed bucket that its application no longer declares into an ordinary bucket. Contents and policy are kept."/>
                        </ContextMenu>
                     </Button.ContextMenu>
                  </Button>
               </StackPanel>
            </ScrollViewer>
            <ScrollViewer Margin="22,12,22,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsBrowsing, Converter={StaticResource boolVisibility}}">
               <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[UploadCommand]}">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_Upload" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Upload" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Border Style="{StaticResource storeSeparatorStyle}"/>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[DownloadCommand]}">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_Download" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Download" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[VersionsCommand]}" Margin="8,0,0,0">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_ClockRotateLeft" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Versions" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[DeleteObjectCommand]}" Margin="8,0,0,0">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_TrashCan" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Border Style="{StaticResource storeSeparatorStyle}"/>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[CloseBrowserCommand]}">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_ArrowLeft" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="All buckets" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
               </StackPanel>
            </ScrollViewer>
            <ItemsControl Grid.Row="1" Margin="22,0,22,10" ItemsSource="{Binding Crumbs}" Visibility="{Binding IsBrowsing, Converter={StaticResource boolVisibility}}">
               <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                     <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
               </ItemsControl.ItemsPanel>
               <ItemsControl.ItemTemplate>
                  <DataTemplate>
                     <StackPanel Orientation="Horizontal">
                        <TextBlock Text="/" Style="{StaticResource fieldHelpStyle}" VerticalAlignment="Center" Margin="2,0"/>
                        <Button Style="{StaticResource textButtonStyle}" Content="{Binding Title}" ToolTip="{Binding Prefix}" AutomationProperties.Name="{Binding Title}"
                                Command="{Binding DataContext.Commands[NavigateCrumbCommand], ElementName=storeRoot}" CommandParameter="{Binding}"/>
                     </StackPanel>
                  </DataTemplate>
               </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Grid.Row="2" Margin="22,0,22,0" Style="{StaticResource cardStyle}" Padding="0">
               <Grid>
                  <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid Margin="22,12">
                     <TextBlock Text="BUCKETS" Style="{StaticResource sectionCaptionStyle}" VerticalAlignment="Center" Visibility="{Binding IsNotBrowsing, Converter={StaticResource boolVisibility}}"/>
                     <TextBlock Text="{Binding OpenBucket.Name, StringFormat=OBJECTS IN {0}}" Style="{StaticResource sectionCaptionStyle}" VerticalAlignment="Center" Visibility="{Binding IsBrowsing, Converter={StaticResource boolVisibility}}"/>
                     <Button Style="{StaticResource rowActionButtonStyle}" HorizontalAlignment="Right" Command="{Binding Commands[RefreshCommand]}" ToolTip="Reload" AutomationProperties.Name="Reload">
                        <fa:FontAwesome Icon="Solid_ArrowsRotate" FontSize="13"/>
                     </Button>
                  </Grid>
                  <!-- Bucket table -->
                  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsNotBrowsing, Converter={StaticResource boolVisibility}}">
                     <Grid MinWidth="920">
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto"/>
                           <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="24,0,20,10">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="330"/>
                              <ColumnDefinition Width="150"/>
                              <ColumnDefinition Width="90"/>
                              <ColumnDefinition Width="110"/>
                              <ColumnDefinition Width="110"/>
                              <ColumnDefinition Width="110"/>
                           </Grid.ColumnDefinitions>
                           <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="1" Text="POLICY" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="2" Text="OBJECTS" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="3" Text="SIZE" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="4" Text="QUOTA" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="5" Text="ACCESS" Style="{StaticResource sectionCaptionStyle}"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Buckets}" SelectedItem="{Binding SelectedBucket, Mode=TwoWay}" Style="{StaticResource surfaceListBoxStyle}" ItemContainerStyle="{StaticResource storeRowStyle}" BorderThickness="0" IsEnabled="{Binding CanBrowse}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Buckets">
                           <ListBox.ItemTemplate>
                              <DataTemplate>
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="330"/>
                                       <ColumnDefinition Width="150"/>
                                       <ColumnDefinition Width="90"/>
                                       <ColumnDefinition Width="110"/>
                                       <ColumnDefinition Width="110"/>
                                       <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" Margin="0,0,12,0" LastChildFill="True">
                                       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource managedChipsTemplate}"/>
                                       </StackPanel>
                                       <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                    </DockPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PolicyName}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PolicyName}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Objects, StringFormat={}{0:N0}}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Bytes, Converter={x:Static local:ObjectStorageManager.SizeConverter}}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding QuotaBytes, Converter={x:Static local:ObjectStorageManager.LimitConverter}}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Access}" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="{Binding PublicPath}"/>
                                 </Grid>
                              </DataTemplate>
                           </ListBox.ItemTemplate>
                        </ListBox>
                     </Grid>
                  </ScrollViewer>
                  <!-- Object browser -->
                  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsBrowsing, Converter={StaticResource boolVisibility}}">
                     <Grid MinWidth="760">
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto"/>
                           <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="24,0,20,10">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="30"/>
                              <ColumnDefinition Width="300"/>
                              <ColumnDefinition Width="100"/>
                              <ColumnDefinition Width="70"/>
                              <ColumnDefinition Width="160"/>
                              <ColumnDefinition Width="100"/>
                           </Grid.ColumnDefinitions>
                           <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="2" Text="SIZE" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="3" Text="VERSION" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="4" Text="MODIFIED" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="5" Text="TYPE" Style="{StaticResource sectionCaptionStyle}"/>
                        </Grid>
                        <ListBox x:Name="objectList" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" Style="{StaticResource surfaceListBoxStyle}" ItemContainerStyle="{StaticResource storeRowStyle}" BorderThickness="0" IsEnabled="{Binding CanBrowse}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" Drop="OnObjectsDrop" DragOver="OnObjectsDragOver" AutomationProperties.Name="Objects">
                           <ListBox.ItemTemplate>
                              <DataTemplate>
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="30"/>
                                       <ColumnDefinition Width="300"/>
                                       <ColumnDefinition Width="100"/>
                                       <ColumnDefinition Width="70"/>
                                       <ColumnDefinition Width="160"/>
                                       <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <fa:FontAwesome Grid.Column="0" Icon="Solid_Folder" FontSize="13" VerticalAlignment="Center" Visibility="{Binding IsFolder, Converter={StaticResource boolVisibility}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding VersionText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Object.Mime}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Object.Mime}"/>
                                 </Grid>
                              </DataTemplate>
                           </ListBox.ItemTemplate>
                        </ListBox>
                     </Grid>
                  </ScrollViewer>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="22,8,22,12" Visibility="{Binding IsBrowsing, Converter={StaticResource boolVisibility}}">
                     <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[LoadMoreCommand]}" Visibility="{Binding HasMore, Converter={StaticResource boolVisibility}}">
                        <TextBlock Text="Load more"/>
                     </Button>
                     <TextBlock Text="Drop files here to upload them to this folder. Uploading an existing name adds a new version." Style="{StaticResource fieldHelpStyle}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Visibility="{Binding CanChangeContents, Converter={StaticResource boolVisibility}}"/>
                     <TextBlock Text="{Binding ManagedNotice}" Style="{StaticResource fieldHelpStyle}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Visibility="{Binding IsOpenBucketManaged, Converter={StaticResource boolVisibility}}"/>
                  </StackPanel>
               </Grid>
            </Border>
         </Grid>

         <!-- Volumes -->
         <Grid Grid.Row="1" Visibility="{Binding IsVolumesTab, Converter={StaticResource boolVisibility}}">
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Margin="22,12,22,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
               <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[NewVolumeCommand]}">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_Plus" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="New volume" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Border Style="{StaticResource storeSeparatorStyle}"/>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[EditVolumeCommand]}">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_Pen" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[DeleteVolumeCommand]}" Margin="8,0,0,0">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_TrashCan" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
               </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Margin="22,0,22,0" Style="{StaticResource cardStyle}" Padding="0">
               <Grid>
                  <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid Margin="22,12">
                     <TextBlock Text="VOLUMES" Style="{StaticResource sectionCaptionStyle}" VerticalAlignment="Center"/>
                     <Button Style="{StaticResource rowActionButtonStyle}" HorizontalAlignment="Right" Command="{Binding Commands[RefreshCommand]}" ToolTip="Reload volumes" AutomationProperties.Name="Reload volumes">
                        <fa:FontAwesome Icon="Solid_ArrowsRotate" FontSize="13"/>
                     </Button>
                  </Grid>
                  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                     <Grid MinWidth="860">
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto"/>
                           <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="24,0,20,10">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="150"/>
                              <ColumnDefinition Width="90"/>
                              <ColumnDefinition Width="230"/>
                              <ColumnDefinition Width="90"/>
                              <ColumnDefinition Width="100"/>
                              <ColumnDefinition Width="80"/>
                              <ColumnDefinition Width="100"/>
                           </Grid.ColumnDefinitions>
                           <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="1" Text="STATE" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="2" Text="PATH" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="3" Text="COPIES" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="4" Text="SIZE" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="5" Text="MISSING" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="6" Text="CHECK" Style="{StaticResource sectionCaptionStyle}"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume, Mode=TwoWay}" Style="{StaticResource surfaceListBoxStyle}" ItemContainerStyle="{StaticResource storeRowStyle}" BorderThickness="0" IsEnabled="{Binding CanBrowse}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Volumes">
                           <ListBox.ItemTemplate>
                              <DataTemplate>
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="150"/>
                                       <ColumnDefinition Width="90"/>
                                       <ColumnDefinition Width="230"/>
                                       <ColumnDefinition Width="90"/>
                                       <ColumnDefinition Width="100"/>
                                       <ColumnDefinition Width="80"/>
                                       <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding State}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Path}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Probe.ResolvedPath}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Blobs, StringFormat={}{0:N0}}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Bytes, Converter={x:Static local:ObjectStorageManager.SizeConverter}}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Missing, StringFormat={}{0:N0}}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Probe.IsValid, Converter={x:Static local:ObjectStorageManager.ProbeConverter}}" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="{Binding Probe.Message}"/>
                                 </Grid>
                              </DataTemplate>
                           </ListBox.ItemTemplate>
                        </ListBox>
                     </Grid>
                  </ScrollViewer>
               </Grid>
            </Border>
         </Grid>

         <!-- Policies -->
         <Grid Grid.Row="1" Visibility="{Binding IsPoliciesTab, Converter={StaticResource boolVisibility}}">
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Margin="22,12,22,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
               <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[NewPolicyCommand]}">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_Plus" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="New policy" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Border Style="{StaticResource storeSeparatorStyle}"/>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[EditPolicyCommand]}">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_Pen" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
                  <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[DeletePolicyCommand]}" Margin="8,0,0,0">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome Icon="Solid_TrashCan" Style="{StaticResource buttonIconStyle}"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                     </StackPanel>
                  </Button>
               </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Margin="22,0,22,0" Style="{StaticResource cardStyle}" Padding="0">
               <Grid>
                  <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid Margin="22,12">
                     <TextBlock Text="POLICIES" Style="{StaticResource sectionCaptionStyle}" VerticalAlignment="Center"/>
                     <Button Style="{StaticResource rowActionButtonStyle}" HorizontalAlignment="Right" Command="{Binding Commands[RefreshCommand]}" ToolTip="Reload policies" AutomationProperties.Name="Reload policies">
                        <fa:FontAwesome Icon="Solid_ArrowsRotate" FontSize="13"/>
                     </Button>
                  </Grid>
                  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                     <Grid MinWidth="960">
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto"/>
                           <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="24,0,20,10">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="270"/>
                              <ColumnDefinition Width="90"/>
                              <ColumnDefinition Width="170"/>
                              <ColumnDefinition Width="110"/>
                              <ColumnDefinition Width="110"/>
                              <ColumnDefinition Width="80"/>
                              <ColumnDefinition Width="80"/>
                           </Grid.ColumnDefinitions>
                           <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="1" Text="REPLICAS" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="2" Text="RETENTION" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="3" Text="QUOTA" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="4" Text="ACCESS" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="5" Text="VOLUMES" Style="{StaticResource sectionCaptionStyle}"/>
                           <TextBlock Grid.Column="6" Text="BUCKETS" Style="{StaticResource sectionCaptionStyle}"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}" Style="{StaticResource surfaceListBoxStyle}" ItemContainerStyle="{StaticResource storeRowStyle}" BorderThickness="0" IsEnabled="{Binding CanBrowse}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Policies">
                           <ListBox.ItemTemplate>
                              <DataTemplate>
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="270"/>
                                       <ColumnDefinition Width="90"/>
                                       <ColumnDefinition Width="170"/>
                                       <ColumnDefinition Width="110"/>
                                       <ColumnDefinition Width="110"/>
                                       <ColumnDefinition Width="80"/>
                                       <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" Margin="0,0,12,0" LastChildFill="True">
                                       <Border DockPanel.Dock="Right" Style="{StaticResource chipAccentStyle}" Margin="8,0,0,0" Padding="8,1" Visibility="{Binding IsManaged, Converter={StaticResource boolVisibility}}">
                                          <Border.ToolTip>
                                             <TextBlock TextWrapping="Wrap" MaxWidth="340"><TextBlock.Text><Binding Path="ManagedBucket" StringFormat="Belongs to managed bucket '{0}'. Its access is set by the application; every other field can be changed."/></TextBlock.Text></TextBlock>
                                          </Border.ToolTip>
                                          <TextBlock Text="MANAGED"/>
                                       </Border>
                                       <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                    </DockPanel>
                                    <TextBlock Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                       <TextBlock.Text>
                                          <MultiBinding StringFormat="{}{0} / {1}">
                                             <Binding Path="ReplicaMin"/>
                                             <Binding Path="ReplicaTarget"/>
                                          </MultiBinding>
                                       </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Converter={x:Static local:ObjectStorageManager.RetentionConverter}}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding QuotaBytes, Converter={x:Static local:ObjectStorageManager.LimitConverter}}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Access}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding VolumeIds.Length}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Buckets}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                 </Grid>
                              </DataTemplate>
                           </ListBox.ItemTemplate>
                        </ListBox>
                     </Grid>
                  </ScrollViewer>
               </Grid>
            </Border>
         </Grid>

         <!-- Maintenance -->
         <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsMaintenanceTab, Converter={StaticResource boolVisibility}}">
            <StackPanel Margin="22,12,22,0">
               <Border Style="{StaticResource cardStyle}" Padding="22,12,22,16">
                  <StackPanel>
                     <Grid>
                        <TextBlock Text="STATUS" Style="{StaticResource sectionCaptionStyle}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource rowActionButtonStyle}" HorizontalAlignment="Right" Command="{Binding Commands[RefreshStatusCommand]}" ToolTip="Reload status and tasks" AutomationProperties.Name="Reload status and tasks">
                           <fa:FontAwesome Icon="Solid_ArrowsRotate" FontSize="13"/>
                        </Button>
                     </Grid>
                     <ItemsControl ItemsSource="{Binding StatusLines}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                           <DataTemplate>
                              <Grid Margin="0,3">
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Text="{Binding Caption}" Style="{StaticResource metaLabelStyle}"/>
                                 <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource metaValueStyle}" TextWrapping="Wrap"/>
                              </Grid>
                           </DataTemplate>
                        </ItemsControl.ItemTemplate>
                     </ItemsControl>
                  </StackPanel>
               </Border>
               <Border Style="{StaticResource cardStyle}" Padding="22,12,22,16" Margin="0,12,0,0">
                  <StackPanel>
                     <TextBlock Text="GARBAGE COLLECTION" Style="{StaticResource sectionCaptionStyle}"/>
                     <TextBlock Text="Deletes blobs no version refers to once they have been orphans longer than the grace period. Review first, then run." Style="{StaticResource fieldHelpStyle}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                     <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanBrowse}">
                        <TextBlock Text="Grace period (hours)" Style="{StaticResource fieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <controls:NumericBox Width="110" Style="{StaticResource fieldNumericBoxStyle}" Minimum="1" Maximum="720" Value="{Binding GcGraceHours}"/>
                        <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[ReviewGcCommand]}" Margin="14,0,0,0">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_MagnifyingGlass" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Review" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                        <Button Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[RunGcCommand]}" Margin="8,0,0,0">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_Broom" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Run" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                     </StackPanel>
                     <TextBlock Text="{Binding GcReviewText}" Style="{StaticResource fieldHelpStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
               </Border>
               <Border Style="{StaticResource cardStyle}" Padding="22,12,22,16" Margin="0,12,0,0">
                  <StackPanel>
                     <TextBlock Text="RETENTION AND REPAIR" Style="{StaticResource sectionCaptionStyle}"/>
                     <TextBlock Text="Retention purges old versions by each policy's rules (it also runs every six hours). Repair checks every copy on disk and writes missing copies up to each policy's replica target." Style="{StaticResource fieldHelpStyle}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                     <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[RunRetentionCommand]}">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_ClockRotateLeft" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Run retention" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                        <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[RunRepairCommand]}" Margin="8,0,0,0">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_Wrench" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Run repair" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                     </StackPanel>
                  </StackPanel>
               </Border>
               <Border Style="{StaticResource cardStyle}" Padding="22,12,22,16" Margin="0,12,0,16">
                  <StackPanel>
                     <TextBlock Text="TASKS" Style="{StaticResource sectionCaptionStyle}"/>
                     <TextBlock Text="No maintenance task is running." Style="{StaticResource fieldHelpStyle}" Margin="0,6,0,0">
                        <TextBlock.Visibility>
                           <Binding Path="Tasks.Count" Converter="{x:Static local:ObjectStorageManager.ZeroVisibilityConverter}"/>
                        </TextBlock.Visibility>
                     </TextBlock>
                     <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                           <DataTemplate>
                              <Grid Margin="0,4">
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                 <TextBlock Grid.Column="1" Text="{Binding Status}"/>
                                 <TextBlock Grid.Column="2" Text="{Binding Caption}" TextWrapping="Wrap" ToolTip="{Binding ErrorMessage}"/>
                              </Grid>
                           </DataTemplate>
                        </ItemsControl.ItemTemplate>
                     </ItemsControl>
                  </StackPanel>
               </Border>
            </StackPanel>
         </ScrollViewer>

         <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="22,8,22,14" Style="{StaticResource fieldHelpStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Grid>

      <!-- Side sheet -->
      <Border Background="{StaticResource surfaceStrongBrush}" Visibility="{Binding IsEditorOpen, Converter={StaticResource boolVisibility}}"/>
      <Border Width="520" MaxWidth="{Binding ActualWidth, ElementName=storeRoot}" HorizontalAlignment="Right" Background="{DynamicResource themeWindowBackgroundBrush}" BorderBrush="{StaticResource outlineBrush}" BorderThickness="1,0,0,0" Visibility="{Binding IsEditorOpen, Converter={StaticResource boolVisibility}}">
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <StackPanel>
               <!-- Bucket editor -->
               <Border Style="{StaticResource cardStyle}" Padding="22,16" Visibility="{Binding IsBucketEditorOpen, Converter={StaticResource boolVisibility}}">
                  <StackPanel IsEnabled="{Binding CanEdit}">
                     <TextBlock Text="BUCKET" Style="{StaticResource sectionCaptionStyle}"/>
                     <TextBlock Text="Name" Style="{StaticResource fieldLabelStyle}" Margin="0,10,0,4"/>
                     <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding BucketDraftName, UpdateSourceTrigger=PropertyChanged}" MaxLength="63" IsEnabled="{Binding IsNewBucket}" Tag="my-bucket"/>
                     <TextBlock Text="3–63 lowercase letters, digits, '-' and '.'. The name cannot change later." Style="{StaticResource fieldHelpStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                     <StackPanel Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000">
                        <StackPanel.ToolTip>
                           <TextBlock Text="{Binding BucketPolicyHelp}" TextWrapping="Wrap" MaxWidth="340"/>
                        </StackPanel.ToolTip>
                        <TextBlock Text="Policy" Style="{StaticResource fieldLabelStyle}" Margin="0,14,0,4"/>
                        <ComboBox Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding BucketPolicyChoices}" SelectedItem="{Binding BucketDraftPolicy, Mode=TwoWay}" ItemTemplate="{StaticResource policyNameTemplate}" IsEnabled="{Binding CanChooseBucketPolicy}" AutomationProperties.Name="Policy"/>
                     </StackPanel>
                     <TextBlock Text="State" Style="{StaticResource fieldLabelStyle}" Margin="0,14,0,4"/>
                     <ComboBox Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding BucketStates}" SelectedValuePath="Value" SelectedValue="{Binding BucketDraftState}" ItemTemplate="{StaticResource optionTemplate}" AutomationProperties.Name="Bucket state"/>
                     <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource outlineBrush}" Background="{StaticResource surfaceStrongBrush}" Visibility="{Binding IsBucketDraftManaged, Converter={StaticResource boolVisibility}}">
                        <StackPanel>
                           <StackPanel Orientation="Horizontal">
                              <Border Style="{StaticResource chipAccentStyle}" Padding="8,1"><TextBlock Text="MANAGED"/></Border>
                              <Border Style="{StaticResource chipWarningStyle}" Padding="8,1" Margin="6,0,0,0" Visibility="{Binding IsBucketDraftUndeclared, Converter={StaticResource boolVisibility}}"><TextBlock Text="NOT DECLARED"/></Border>
                              <TextBlock Text="{Binding BucketDraftManagedCaption}" Style="{StaticResource fieldLabelStyle}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                           </StackPanel>
                           <TextBlock Text="{Binding BucketDraftDescription}" Style="{StaticResource fieldHelpStyle}" Margin="0,8,0,0" TextWrapping="Wrap" ToolTip="Written by the application; it cannot be edited here."/>
                        </StackPanel>
                     </Border>
                     <TextBlock Text="Note" Style="{StaticResource fieldLabelStyle}" Margin="0,14,0,4"/>
                     <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding BucketDraftNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/>
                     <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[SaveBucketCommand]}">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_FloppyDisk" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Save" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                        <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[CloseEditorCommand]}" Margin="8,0,0,0">
                           <TextBlock Text="Cancel"/>
                        </Button>
                     </StackPanel>
                  </StackPanel>
               </Border>

               <!-- Volume editor -->
               <Border Style="{StaticResource cardStyle}" Padding="22,16" Visibility="{Binding IsVolumeEditorOpen, Converter={StaticResource boolVisibility}}">
                  <StackPanel IsEnabled="{Binding CanEdit}">
                     <TextBlock Text="VOLUME" Style="{StaticResource sectionCaptionStyle}"/>
                     <TextBlock Text="Name" Style="{StaticResource fieldLabelStyle}" Margin="0,10,0,4"/>
                     <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding VolumeDraft.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                     <TextBlock Text="State" Style="{StaticResource fieldLabelStyle}" Margin="0,14,0,4"/>
                     <ComboBox Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding VolumeStates}" SelectedValuePath="Value" SelectedValue="{Binding VolumeDraft.State}" ItemTemplate="{StaticResource optionTemplate}" AutomationProperties.Name="Volume state"/>
                     <TextBlock Text="Folder" Style="{StaticResource fieldLabelStyle}" Margin="0,14,0,4"/>
                     <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding VolumeDraft.Path, UpdateSourceTrigger=PropertyChanged}" MaxLength="400" IsReadOnly="{Binding IsVolumePathLocked}" Tag="./data/objects"/>
                        <Button Grid.Column="1" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[ValidateVolumeCommand]}" Margin="8,0,0,0">
                           <TextBlock Text="Check"/>
                        </Button>
                     </Grid>
                     <TextBlock Text="A folder on the API server: absolute, or relative to the API content root. A volume that holds copies keeps its folder." Style="{StaticResource fieldHelpStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                     <TextBlock Text="{Binding VolumeValidation}" Style="{StaticResource fieldHelpStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                     <TextBlock Text="Note" Style="{StaticResource fieldLabelStyle}" Margin="0,14,0,4"/>
                     <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding VolumeDraft.Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/>
                     <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[SaveVolumeCommand]}">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_FloppyDisk" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Save" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                        <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[CloseEditorCommand]}" Margin="8,0,0,0">
                           <TextBlock Text="Cancel"/>
                        </Button>
                     </StackPanel>
                  </StackPanel>
               </Border>

               <!-- Policy editor -->
               <Border Style="{StaticResource cardStyle}" Padding="22,16" Visibility="{Binding IsPolicyEditorOpen, Converter={StaticResource boolVisibility}}">
                  <Border.Resources>
                     <!-- Field help shown on hover: wrapped so a long explanation stays a readable block. -->
                     <Style TargetType="ToolTip">
                        <Setter Property="ContentTemplate">
                           <Setter.Value>
                              <DataTemplate>
                                 <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="340"/>
                              </DataTemplate>
                           </Setter.Value>
                        </Setter>
                     </Style>
                  </Border.Resources>
                  <StackPanel IsEnabled="{Binding CanEdit}">
                     <TextBlock Text="POLICY" Style="{StaticResource sectionCaptionStyle}"/>
                     <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsPolicyManaged, Converter={StaticResource boolVisibility}}">
                        <Border Style="{StaticResource chipAccentStyle}" Padding="8,1"><TextBlock Text="MANAGED"/></Border>
                        <TextBlock Style="{StaticResource fieldHelpStyle}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"><TextBlock.Text><Binding Path="PolicyManagedBucket" StringFormat="Belongs to managed bucket '{0}'; access is fixed by its application."/></TextBlock.Text></TextBlock>
                     </StackPanel>
                     <StackPanel Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Unique display name of the policy, up to 100 characters. It is what the Policy list of the bucket editor shows.">
                        <TextBlock Text="Name" Style="{StaticResource fieldLabelStyle}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding PolicyName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                     </StackPanel>
                     <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Active: the policy can be given to buckets. Disabled: buckets that already use it keep it, but it cannot be given to a new or another bucket.">
                           <TextBlock Text="State" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,4"/>
                           <ComboBox Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding PolicyStates}" SelectedValuePath="Value" SelectedValue="{Binding PolicyState}" ItemTemplate="{StaticResource optionTemplate}" AutomationProperties.Name="Policy state"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding PolicyAccessHelp}">
                           <TextBlock Text="Access" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,4"/>
                           <ComboBox Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding AccessOptions}" SelectedValuePath="Value" SelectedValue="{Binding PolicyAccess}" ItemTemplate="{StaticResource optionTemplate}" IsEnabled="{Binding CanChangePolicyAccess}" AutomationProperties.Name="Access"/>
                        </StackPanel>
                     </Grid>
                     <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Copies that must be written before an upload succeeds (1-16). An upload fails with 503 when fewer active volumes are available.">
                           <TextBlock Text="Minimum replicas" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,4"/>
                           <controls:NumericBox Style="{StaticResource fieldNumericBoxStyle}" Minimum="1" Maximum="16" Value="{Binding PolicyReplicaMin}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Copies background replication and Repair aim for (1-16). Must not be less than the minimum, and the policy needs at least this many checked volumes.">
                           <TextBlock Text="Target replicas" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,4"/>
                           <controls:NumericBox Style="{StaticResource fieldNumericBoxStyle}" Minimum="1" Maximum="16" Value="{Binding PolicyReplicaTarget}"/>
                        </StackPanel>
                     </Grid>
                     <TextBlock Text="Uploads finish after the minimum number of copies; background replication writes the rest." Style="{StaticResource fieldHelpStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                     <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Older (non-current) versions kept per object, 0-100000. Empty keeps all; 0 keeps none. The current version is never purged. Retention runs every six hours and on request.">
                           <TextBlock Text="Keep old versions" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,4"/>
                           <TextBox Style="{StaticResource fieldBoxStyle}" shared:NumericInput.Kind="Integer" Text="{Binding PolicyKeepVersions, UpdateSourceTrigger=PropertyChanged}" Tag="All"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Maximum age in days of older versions, 1-36500. Empty keeps them forever. With both fields filled, a version is purged when it breaks either rule.">
                           <TextBlock Text="Keep old versions for (days)" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,4"/>
                           <TextBox Style="{StaticResource fieldBoxStyle}" shared:NumericInput.Kind="Integer" Text="{Binding PolicyKeepDays, UpdateSourceTrigger=PropertyChanged}" Tag="Forever"/>
                        </StackPanel>
                     </Grid>
                     <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Maximum size per bucket in MB, counting every kept version (before deduplication). Decimals allowed. Empty means unlimited. An upload over the quota fails with 409.">
                           <TextBlock Text="Quota (MB)" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,4"/>
                           <TextBox Style="{StaticResource fieldBoxStyle}" shared:NumericInput.Kind="Decimal" Text="{Binding PolicyQuotaMb, UpdateSourceTrigger=PropertyChanged}" Tag="Unlimited"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Maximum number of objects (keys) per bucket; deleted objects that still have history count. A new version of an existing key is always allowed. Empty means unlimited.">
                           <TextBlock Text="Object quota" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,4"/>
                           <TextBox Style="{StaticResource fieldBoxStyle}" shared:NumericInput.Kind="Integer" Text="{Binding PolicyQuotaObjects, UpdateSourceTrigger=PropertyChanged}" Tag="Unlimited"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Largest single upload in MB. Decimals allowed. Empty means unlimited. A larger upload is stopped while streaming and fails with 413.">
                           <TextBlock Text="Max object (MB)" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,4"/>
                           <TextBox Style="{StaticResource fieldBoxStyle}" shared:NumericInput.Kind="Decimal" Text="{Binding PolicyMaxObjectMb, UpdateSourceTrigger=PropertyChanged}" Tag="Unlimited"/>
                        </StackPanel>
                     </Grid>
                     <TextBlock Text="Leave a field empty for no limit. Quotas count every kept version per bucket." Style="{StaticResource fieldHelpStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                     <Grid Margin="0,14,0,4">
                        <TextBlock Text="Volumes in priority order" Style="{StaticResource fieldLabelStyle}" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Check the volumes the policy may store on and order them with the arrows. The first active volume receives uploads first and copies follow the order. Check at least as many volumes as target replicas. Changing the list does not move existing data; Repair adds missing copies."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                           <Button Style="{StaticResource rowActionButtonStyle}" Command="{Binding Commands[MoveVolumeUpCommand]}" ToolTip="Move up" AutomationProperties.Name="Move volume up">
                              <fa:FontAwesome Icon="Solid_ArrowUp" FontSize="13"/>
                           </Button>
                           <Button Style="{StaticResource rowActionButtonStyle}" Command="{Binding Commands[MoveVolumeDownCommand]}" ToolTip="Move down" AutomationProperties.Name="Move volume down" Margin="4,0,0,0">
                              <fa:FontAwesome Icon="Solid_ArrowDown" FontSize="13"/>
                           </Button>
                        </StackPanel>
                     </Grid>
                     <ListBox ItemsSource="{Binding PolicyVolumes}" SelectedItem="{Binding SelectedPolicyVolume, Mode=TwoWay}" Style="{StaticResource surfaceListBoxStyle}" ItemContainerStyle="{StaticResource listRowCompactStyle}" BorderThickness="0" MaxHeight="220" AutomationProperties.Name="Policy volumes">
                        <ListBox.ItemTemplate>
                           <DataTemplate>
                              <StackPanel Orientation="Horizontal">
                                 <CheckBox Style="{StaticResource checkBoxStyle}" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Volume.Name}"/>
                                 <TextBlock Text="{Binding Volume.Name}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                 <TextBlock Text="{Binding Volume.State}" Style="{StaticResource fieldHelpStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                              </StackPanel>
                           </DataTemplate>
                        </ListBox.ItemTemplate>
                     </ListBox>
                     <StackPanel Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" ToolTip="Free note for administrators, up to 500 characters.">
                        <TextBlock Text="Note" Style="{StaticResource fieldLabelStyle}" Margin="0,14,0,4"/>
                        <TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding PolicyNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/>
                     </StackPanel>
                     <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[SavePolicyCommand]}">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_FloppyDisk" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Save" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                        <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[CloseEditorCommand]}" Margin="8,0,0,0">
                           <TextBlock Text="Cancel"/>
                        </Button>
                     </StackPanel>
                  </StackPanel>
               </Border>

               <!-- Versions -->
               <Border Style="{StaticResource cardStyle}" Padding="22,16" Visibility="{Binding IsVersionsOpen, Converter={StaticResource boolVisibility}}">
                  <StackPanel IsEnabled="{Binding CanEdit}">
                     <TextBlock Text="VERSIONS" Style="{StaticResource sectionCaptionStyle}"/>
                     <TextBlock Text="{Binding VersionsKey}" Style="{StaticResource metaValueStyle}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                     <TextBlock Text="{Binding ManagedNotice}" Style="{StaticResource fieldHelpStyle}" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="{Binding IsOpenBucketManaged, Converter={StaticResource boolVisibility}}"/>
                     <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[RestoreVersionCommand]}">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_RotateLeft" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Restore" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                        <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[DownloadVersionCommand]}" Margin="8,0,0,0">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_Download" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Download" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                        <Button Style="{StaticResource dangerOutlinedButtonStyle}" Command="{Binding Commands[PurgeVersionCommand]}" Margin="8,0,0,0">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_TrashCan" Style="{StaticResource buttonIconStyle}"/>
                              <TextBlock Text="Delete permanently" VerticalAlignment="Center"/>
                           </StackPanel>
                        </Button>
                     </StackPanel>
                     <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" Style="{StaticResource surfaceListBoxStyle}" ItemContainerStyle="{StaticResource listRowCompactStyle}" BorderThickness="0" MaxHeight="420" AutomationProperties.Name="Versions">
                        <ListBox.ItemTemplate>
                           <DataTemplate>
                              <Grid>
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="70"/>
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Text="{Binding Version, StringFormat=v{0}}" VerticalAlignment="Center"/>
                                 <TextBlock Grid.Column="1" Text="{Binding Converter={x:Static local:ObjectStorageManager.VersionConverter}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Mime}"/>
                                 <TextBlock Grid.Column="2" Text="{Binding CreatedAt, Converter={x:Static local:ObjectStorageManager.LocalTimeConverter}}" VerticalAlignment="Center"/>
                                 <TextBlock Grid.Column="3" Text="current" Style="{StaticResource fieldHelpStyle}" VerticalAlignment="Center" Visibility="{Binding IsCurrent, Converter={StaticResource boolVisibility}}"/>
                              </Grid>
                           </DataTemplate>
                        </ListBox.ItemTemplate>
                     </ListBox>
                     <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[CloseEditorCommand]}" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <TextBlock Text="Close"/>
                     </Button>
                  </StackPanel>
               </Border>
               <TextBlock Text="{Binding Status}" Margin="22,10,22,16" Style="{StaticResource fieldHelpStyle}" TextWrapping="Wrap"/>
            </StackPanel>
         </ScrollViewer>
      </Border>
      <controls:WaitOverlay IsWaiting="{Binding InWaiting}" Caption="{Binding WaiterText}"/>
   </Grid>
</UserControl>
