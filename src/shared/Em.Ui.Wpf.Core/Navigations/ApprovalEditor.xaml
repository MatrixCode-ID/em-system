<UserControl x:Class="Em.Ui.Wpf.Navigations.ApprovalEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:fa="http://schemas.fontawesome.com/icons/fonts">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="visible"/>
  <Style x:Key="viewerCard" TargetType="Border"><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="{StaticResource surfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource outlineBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="signeeCard" TargetType="Border" BasedOn="{StaticResource viewerCard}">
   <Setter Property="Width" Value="208"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Padding" Value="14,12"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource themeAccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="stepChip" TargetType="Border" BasedOn="{StaticResource chipMutedStyle}">
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{StaticResource warningChipBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding IsSigned}" Value="True"><Setter Property="Background" Value="{StaticResource successChipBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding IsRejected}" Value="True"><Setter Property="Background" Value="{StaticResource dangerChipBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Margin="0,0,0,12">
   <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[PreviewCommand]}" Visibility="{Binding HasPreview, Converter={StaticResource visible}}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><fa:FontAwesome Icon="Solid_FilePdf" Style="{StaticResource buttonIconStyle}"/><TextBlock Text="Document preview"/></StackPanel></Button>
   <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[SourceCommand]}" Visibility="{Binding HasSource, Converter={StaticResource visible}}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><fa:FontAwesome Icon="Solid_ArrowUpRightFromSquare" Style="{StaticResource buttonIconStyle}"/><TextBlock Text="{Binding SourceCaption}"/></StackPanel></Button>
   <ItemsControl ItemsSource="{Binding ModuleToolbar}" Margin="0,0,12,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding Command}" Style="{StaticResource outlinedButtonStyle}" Margin="0,0,8,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Content="Reinstate" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[ReinstateCommand]}" Margin="0,0,8,0"/>
   <Button Content="Void" Style="{StaticResource dangerOutlinedButtonStyle}" Command="{Binding Commands[VoidCommand]}" Margin="0,0,20,0"/>
   <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[RefreshCommand]}"><StackPanel Orientation="Horizontal"><fa:FontAwesome Icon="Solid_ArrowsRotate" Style="{StaticResource buttonIconStyle}"/><TextBlock Text="Refresh"/></StackPanel></Button>
   <TextBlock Text="{Binding RefreshedText}" Margin="10,0,20,0" Opacity="0.65" VerticalAlignment="Center"/>
   <ToggleButton Style="{StaticResource sheetToggleStyle}" IsChecked="{Binding IsSignersOpen}" Margin="0,0,8,0" ToolTip="Show or hide the signer cards"><StackPanel Orientation="Horizontal"><fa:FontAwesome Icon="Solid_PenNib" Style="{StaticResource buttonIconStyle}"/><TextBlock Text="{Binding SignersToggleText}"/></StackPanel></ToggleButton>
   <ToggleButton Style="{StaticResource sheetToggleStyle}" IsChecked="{Binding IsSidePanelOpen}" ToolTip="Show or hide attachments and comments"><StackPanel Orientation="Horizontal"><fa:FontAwesome Icon="Regular_Comments" Style="{StaticResource buttonIconStyle}"/><TextBlock Text="{Binding SidePanelToggleText}"/></StackPanel></ToggleButton>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{Binding SideGap}"/><ColumnDefinition Width="{Binding SideWidth}"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource viewerCard}"><ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl Content="{Binding ModuleView}"/></ScrollViewer></Border>
    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnSignersWheel" Visibility="{Binding IsSignersOpen, Converter={StaticResource visible}}">
     <ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource signeeCard}"><StackPanel>
       <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource stepChip}" Margin="8,0,0,0"><TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding LevelCaption}" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="{Binding Step.cApprovalRequestStepName}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding SignerName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding BackupNames}" Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Text="{Binding ViewerRole}" Foreground="{DynamicResource themeAccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsMyTurn, Converter={StaticResource visible}}">
        <Button Content="Sign" Style="{StaticResource filledButtonStyle}" Command="{Binding Owner.Commands[SignStepCommand]}" CommandParameter="{Binding}"/>
        <Button Content="Reject" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Owner.Commands[RejectStepCommand]}" CommandParameter="{Binding}" Margin="8,0,0,0"/>
       </StackPanel>
       <TextBlock Text="{Binding SignatureText}" Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding VerificationCode}" FontFamily="Consolas" FontSize="10" Opacity="0.6"/>
       <Button Content="Decision note" HorizontalAlignment="Left" Style="{StaticResource textButtonStyle}" Command="{Binding Owner.Commands[SignatureNoteCommand]}" CommandParameter="{Binding}" Visibility="{Binding HasNote, Converter={StaticResource visible}}"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource viewerCard}" Visibility="{Binding IsSidePanelOpen, Converter={StaticResource visible}}"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="16,12,10,8"><Button DockPanel.Dock="Right" ToolTip="Attach file" Style="{StaticResource flatIconButtonStyle}" Command="{Binding Commands[AttachCommand]}" Visibility="{Binding Detail.CanAttach, Converter={StaticResource visible}}"><fa:FontAwesome Icon="Solid_Plus"/></Button><TextBlock Text="Attachments" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <ListBox Grid.Row="1" MaxHeight="190" Margin="8,0,8,12" ItemsSource="{Binding Files}" Style="{StaticResource surfaceListBoxStyle}" ItemContainerStyle="{StaticResource listRowCompactStyle}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
     <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button ToolTip="Preview" Style="{StaticResource flatIconButtonStyle}" Command="{Binding DataContext.Commands[PreviewAttachmentCommand], RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Row}" Visibility="{Binding CanPreview, Converter={StaticResource visible}}"><fa:FontAwesome Icon="Regular_Eye"/></Button><Button ToolTip="Download" Style="{StaticResource flatIconButtonStyle}" Command="{Binding DataContext.Commands[DownloadCommand], RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Row}"><fa:FontAwesome Icon="Solid_Download"/></Button></StackPanel><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" FontSize="11" Opacity="0.65"/></StackPanel></DockPanel>
    </DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="2" Height="1" Background="{StaticResource dividerBrush}"/>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="Comments" FontWeight="SemiBold" Margin="16,12,10,8"/>
     <ListBox Grid.Row="1" ItemsSource="{Binding Comments}" Style="{StaticResource surfaceListBoxStyle}" ItemContainerStyle="{StaticResource listRowCompactStyle}" HorizontalContentAlignment="Stretch" Margin="8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="11" Opacity="0.6"/><TextBlock Text="{Binding Author}" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Decision}" FontSize="10.5" Foreground="{DynamicResource themeAccentBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
    <DockPanel Grid.Row="4" Margin="12"><Button DockPanel.Dock="Right" Style="{StaticResource tonalButtonStyle}" Command="{Binding Commands[CommentCommand]}" Margin="8,0,0,0" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal"><fa:FontAwesome Icon="Solid_PaperPlane" Style="{StaticResource buttonIconStyle}"/><TextBlock Text="Send"/></StackPanel></Button><TextBox Style="{StaticResource fieldBoxStyle}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Tag="Write a comment" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/></DockPanel>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
