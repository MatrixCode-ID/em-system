<UserControl x:Class="Em.Ui.Wpf.Navigations.ApprovalEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="visible"/>
 </ResourceDictionary></UserControl.Resources>
 <StackPanel>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Margin="0,0,0,12">
   <Button Content="Document preview" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[PreviewCommand]}" Visibility="{Binding HasPreview, Converter={StaticResource visible}}" Margin="0,0,8,0"/>
   <Button Content="Source" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[SourceCommand]}" Visibility="{Binding HasSource, Converter={StaticResource visible}}"/>
   <Border Style="{StaticResource toolbarSeparatorStyle}"/>
   <Button Content="Reinstate" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[ReinstateCommand]}"/>
   <Button Content="Void" Style="{StaticResource textButtonStyle}" Command="{Binding Commands[VoidCommand]}" Margin="8,0,0,0"/>
   <ItemsControl ItemsSource="{Binding ModuleToolbar}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding Command}" Style="{StaticResource outlinedButtonStyle}" Margin="8,0,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
  <ContentControl Content="{Binding ModuleView}" Margin="0,0,0,16"/>
  <ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource surfaceBrush}" BorderBrush="{StaticResource outlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="255">
    <StackPanel><TextBlock Text="{Binding Heading}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Opacity="0.55" Margin="0,4,0,8"/>
     <TextBlock Text="{Binding Candidates}" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="{Binding CanDecide}">
      <Button Content="Sign" Style="{StaticResource filledButtonStyle}" Command="{Binding Owner.Commands[SignStepCommand]}" CommandParameter="{Binding}"/>
      <Button Content="Reject" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Owner.Commands[RejectStepCommand]}" CommandParameter="{Binding}" Margin="8,0,0,0"/>
     </StackPanel>
    </StackPanel>
   </Border></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </StackPanel>
</UserControl>
