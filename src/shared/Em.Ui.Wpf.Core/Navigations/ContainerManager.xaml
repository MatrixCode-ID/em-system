<UserControl x:Class="Em.Ui.Wpf.Navigations.ContainerManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:publish="clr-namespace:Em.Ui.Wpf.Navigations.Publish" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Em.Ui.Wpf.Navigations"
             xmlns:conv="clr-namespace:Em.Ui.Wpf.Converters"
             xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
             xmlns:shared="clr-namespace:Em.Ui.Wpf.Shared"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             Foreground="{DynamicResource themeWindowForegroundBrush}">
   <UserControl.DataContext>
      <local:ContainerManagerVm />
   </UserControl.DataContext>

   <UserControl.InputBindings>
      <KeyBinding Key="F5" Command="{Binding Commands[RefreshCommand]}" />
   </UserControl.InputBindings>

   <UserControl.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <conv:InverseBoolToVisibilityConverter x:Key="inverseBoolToVisibility" />
         <conv:EntityTintConverter x:Key="entityTintConverter" />

         <!-- ==== empty / disabled state ==== -->
         <Style x:Key="stateIconStyle" TargetType="fa:FontAwesome">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="HorizontalAlignment" Value="Center" />
         </Style>

         <Style x:Key="stateTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,14,0,0" />
         </Style>

         <Style x:Key="stateNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource secondaryCellStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Margin" Value="0,4,0,0" />
         </Style>

         <!-- ==== panels ==== -->
         <Style x:Key="panelCardStyle" TargetType="Border" BasedOn="{StaticResource cardStyle}">
            <Setter Property="Background" Value="{StaticResource surfaceBrush}" />
         </Style>

         <Style x:Key="panelHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource surfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource dividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="13,13,0,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="18,0,10,0" />
         </Style>

         <!-- The disc that carries an entity's colour and glyph; the colour comes from the name. -->
         <Style x:Key="tintDiscStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
         </Style>

         <Style x:Key="tintDiscLargeStyle" TargetType="Border" BasedOn="{StaticResource tintDiscStyle}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="13" />
         </Style>

         <Style x:Key="monoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource metaValueStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
         </Style>

         <!-- ==== list row (roots) ==== -->
         <Style x:Key="ctnRowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                     <Grid>
                        <Grid.RowDefinitions>
                           <RowDefinition Height="*" />
                           <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="stateLayer" Grid.Row="0" Background="Transparent" MinHeight="52">
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border x:Name="selectionBar"
                                      Grid.Column="0"
                                      Width="3"
                                      Margin="0,8"
                                      CornerRadius="2"
                                      Visibility="Hidden"
                                      Background="{DynamicResource themeAccentBrush}" />
                              <ContentPresenter Grid.Column="1"
                                                Margin="13,0,12,0"
                                                VerticalAlignment="Center" />
                           </Grid>
                        </Border>

                        <Border Grid.Row="1" Height="1" Background="{StaticResource dividerBrush}" />
                     </Grid>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="stateLayer" Property="Background"
                                   Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                           <Setter TargetName="stateLayer" Property="Background"
                                   Value="{StaticResource statePressedBrush}" />
                           <Setter TargetName="selectionBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- ==== tree ==== -->
         <Style x:Key="ctnExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ToggleButton">
                     <Border Background="Transparent" Width="22" Height="30">
                        <fa:FontAwesome x:Name="chevron"
                                        Icon="Solid_ChevronRight"
                                        FontSize="9"
                                        Opacity="0.55"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                           <Setter TargetName="chevron" Property="Icon" Value="Solid_ChevronDown" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <Style x:Key="ctnTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="TreeViewItem">
                     <Grid>
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto" />
                           <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="header"
                                Grid.Row="0"
                                Margin="0,1"
                                CornerRadius="8"
                                Background="Transparent">
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="22" />
                                 <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <ToggleButton x:Name="expander"
                                            Grid.Column="0"
                                            Style="{StaticResource ctnExpanderStyle}"
                                            ClickMode="Press"
                                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                              <ContentPresenter Grid.Column="1" ContentSource="Header" />
                           </Grid>
                        </Border>

                        <ItemsPresenter x:Name="children"
                                        Grid.Row="1"
                                        Margin="18,0,0,0"
                                        Visibility="Collapsed" />
                     </Grid>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                           <Setter TargetName="children" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                           <Setter TargetName="expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="header" Property="IsMouseOver" Value="True">
                           <Setter TargetName="header" Property="Background" Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                           <Setter TargetName="header" Property="Background" Value="{StaticResource statePressedBrush}" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- ==== drop targets: a folder row takes a dragged node, a root row moves it to the top ==== -->
         <Style x:Key="nodeDropFrameStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding IsFolder}" Value="True">
                  <Setter Property="shared:DropTarget.Command"
                          Value="{Binding DataContext.Commands[DropCommand], RelativeSource={RelativeSource AncestorType=TreeView}}" />
                  <Setter Property="shared:DropTarget.Target" Value="{Binding}" />
                  <Setter Property="shared:DropTarget.Effect" Value="Move" />
               </DataTrigger>
               <Trigger Property="shared:DropTarget.IsDraggingOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource statePressedBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource themeAccentBrush}" />
               </Trigger>
            </Style.Triggers>
         </Style>

         <Style x:Key="rootDropFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="shared:DropTarget.Command"
                    Value="{Binding DataContext.Commands[DropCommand], RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="shared:DropTarget.Target" Value="{Binding}" />
            <Setter Property="shared:DropTarget.Effect" Value="Move" />
            <Style.Triggers>
               <Trigger Property="shared:DropTarget.IsDraggingOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource statePressedBrush}" />
               </Trigger>
            </Style.Triggers>
         </Style>

         <!-- ==== token expiry chip: red once expired, yellow in the last two weeks ==== -->
         <Style x:Key="expiryChipStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
            <Style.Triggers>
               <DataTrigger Binding="{Binding ExpiryState}" Value="Soon">
                  <Setter Property="Background" Value="{StaticResource warningChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource warningBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding ExpiryState}" Value="Expired">
                  <Setter Property="Background" Value="{StaticResource dangerChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource dangerBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource dangerBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <!-- ==== a clickable row inside a panel ==== -->
         <Style x:Key="linkRowStyle" TargetType="Border">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
               <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource stateHoverBrush}" />
               </Trigger>
            </Style.Triggers>
         </Style>

         <!-- ==== manifest tag chip ==== -->
         <Style x:Key="tagChipButtonStyle" TargetType="Button" BasedOn="{StaticResource compactOutlinedButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontFamily" Value="Consolas" />
         </Style>

         <!-- ==== toolbar buttons: the UserManager strip (38 high, 8 apart) ==== -->
         <Style x:Key="tbFilled" TargetType="Button" BasedOn="{StaticResource filledButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
         </Style>
         <Style x:Key="tbOutlined" TargetType="Button" BasedOn="{StaticResource outlinedButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
         </Style>
         <Style x:Key="tbDanger" TargetType="Button" BasedOn="{StaticResource dangerOutlinedButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
         </Style>
      </ResourceDictionary>
   </UserControl.Resources>

   <TabControl Style="{StaticResource materialTabControlStyle}" Foreground="{DynamicResource themeWindowForegroundBrush}">
   <TabItem Header="Containers" Style="{StaticResource materialTabItemStyle}">
   <Grid>
      <Grid Visibility="{Binding IsRegistryDisabled, Converter={StaticResource inverseBoolToVisibility}}">
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
         </Grid.RowDefinitions>

         <!-- =========================================================
              TOOLBAR - what creates on the left, what acts on the selection after it,
              the storage figure and the reload on the right. Edit and Delete exist twice
              in the same cell (one for a root, one for a folder or container) and only one
              is shown, so no button ever changes place when the selection changes.
              ========================================================= -->
         <Grid Grid.Row="0" Margin="22,12,22,10">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource tbFilled}" Command="{Binding Commands[NewRootCommand]}" ToolTip="Create a root">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_Plus" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="New Root" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
            <Border Grid.Column="1" Style="{StaticResource toolbarSeparatorStyle}" />
            <Button Grid.Column="2" Style="{StaticResource tbOutlined}" Command="{Binding Commands[NewFolderCommand]}" ToolTip="Create a folder in the selected root or folder">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_FolderPlus" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="New Folder" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource tbOutlined}" Command="{Binding Commands[NewImageCommand]}" ToolTip="Create a container in the selected root or folder">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_Box" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="New Container" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
            <Border Grid.Column="4" Style="{StaticResource toolbarSeparatorStyle}" />
            <Grid Grid.Column="5">
               <Button Style="{StaticResource tbOutlined}" Command="{Binding Commands[EditRootCommand]}"
                       Visibility="{Binding ShowRootDetail, Converter={StaticResource boolToVisibility}}"
                       ToolTip="Edit the description and status of the selected root">
                  <StackPanel Orientation="Horizontal">
                     <fa:FontAwesome Icon="Solid_PenToSquare" Style="{StaticResource buttonIconStyle}" />
                     <TextBlock Text="Edit" VerticalAlignment="Center" />
                  </StackPanel>
               </Button>
               <Button Style="{StaticResource tbOutlined}" Command="{Binding Commands[EditNodeCommand]}"
                       Visibility="{Binding ShowRootDetail, Converter={StaticResource inverseBoolToVisibility}}"
                       ToolTip="Rename the selected folder, or edit the selected container">
                  <StackPanel Orientation="Horizontal">
                     <fa:FontAwesome Icon="Solid_PenToSquare" Style="{StaticResource buttonIconStyle}" />
                     <TextBlock Text="{Binding EditNodeCaption}" VerticalAlignment="Center" />
                  </StackPanel>
               </Button>
            </Grid>
            <Button Grid.Column="6" Style="{StaticResource tbOutlined}" Command="{Binding Commands[MoveNodeCommand]}" ToolTip="Move the selected folder or container to another folder">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_FolderTree" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Move to..." VerticalAlignment="Center" />
               </StackPanel>
            </Button>
            <Grid Grid.Column="7">
               <Button Style="{StaticResource tbDanger}" Command="{Binding Commands[DeleteRootCommand]}"
                       Visibility="{Binding ShowRootDetail, Converter={StaticResource boolToVisibility}}"
                       ToolTip="Delete the selected root, which has to be empty">
                  <StackPanel Orientation="Horizontal">
                     <fa:FontAwesome Icon="Solid_TrashCan" Style="{StaticResource buttonIconStyle}" />
                     <TextBlock Text="Delete" VerticalAlignment="Center" />
                  </StackPanel>
               </Button>
               <Button Style="{StaticResource tbDanger}" Command="{Binding Commands[DeleteNodeCommand]}"
                       Visibility="{Binding ShowRootDetail, Converter={StaticResource inverseBoolToVisibility}}"
                       ToolTip="Delete the selected folder (it has to be empty) or container (with its manifests and tags)">
                  <StackPanel Orientation="Horizontal">
                     <fa:FontAwesome Icon="Solid_TrashCan" Style="{StaticResource buttonIconStyle}" />
                     <TextBlock Text="Delete" VerticalAlignment="Center" />
                  </StackPanel>
               </Button>
            </Grid>

            <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center">
               <Button Style="{StaticResource outlinedButtonStyle}"
                       Command="{Binding Commands[GarbageCollectionCommand]}"
                       ToolTip="Review and remove blobs, uploads and files no manifest uses"
                       AutomationProperties.Name="Garbage collection">
                  <StackPanel Orientation="Horizontal">
                     <fa:FontAwesome Icon="Solid_Broom" Style="{StaticResource buttonIconStyle}" />
                     <TextBlock Text="Garbage collection" VerticalAlignment="Center" />
                  </StackPanel>
               </Button>
               <Border Style="{StaticResource toolbarSeparatorStyle}" />
               <Border Style="{StaticResource chipStyle}" ToolTip="{Binding StorageDetail}">
                  <TextBlock Text="{Binding StorageCaption}" />
               </Border>
               <Button Style="{StaticResource rowActionButtonStyle}" Margin="4,0,0,0"
                       Command="{Binding Commands[RefreshStorageCommand]}"
                       ToolTip="Refresh storage information independently"
                       AutomationProperties.Name="Refresh storage information">
                  <fa:FontAwesome Icon="Solid_ArrowsRotate" />
               </Button>
               <Border Style="{StaticResource toolbarSeparatorStyle}" />
               <Button Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[RefreshCommand]}" ToolTip="Reload roots and containers (F5)">
                  <StackPanel Orientation="Horizontal">
                     <fa:FontAwesome Icon="Solid_ArrowsRotate" Style="{StaticResource buttonIconStyle}" />
                     <TextBlock Text="Refresh" VerticalAlignment="Center" />
                  </StackPanel>
               </Button>
            </StackPanel>
         </Grid>
               <Grid Grid.Row="1" Margin="22,0,22,22">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="250" />
                     <ColumnDefinition Width="14" />
                     <ColumnDefinition Width="1.3*" MinWidth="260" />
                     <ColumnDefinition Width="14" />
                     <ColumnDefinition Width="*" MinWidth="300" MaxWidth="460" />
                  </Grid.ColumnDefinitions>

                  <!-- ==== roots ==== -->
                  <Border Grid.Column="0" Style="{StaticResource panelCardStyle}">
                     <Grid>
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto" />
                           <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource panelHeaderStyle}">
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="ROOTS"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource sectionCaptionStyle}" />
                           </Grid>
                        </Border>

                        <ListBox x:Name="rootList"
                                 Style="{StaticResource surfaceListBoxStyle}"
                                 Foreground="{DynamicResource themeWindowForegroundBrush}"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding Roots}"
                                 SelectedItem="{Binding SelectedRoot}"
                                 IsEnabled="{Binding IsNotBusy}"
                                 ItemContainerStyle="{StaticResource ctnRowStyle}">
                           <ListBox.InputBindings>
                              <KeyBinding Key="Delete" Command="{Binding Commands[DeleteRootCommand]}" />
                           </ListBox.InputBindings>
                           <ListBox.ContextMenu>
                              <ContextMenu>
                                 <MenuItem Header="New root" Command="{Binding Commands[NewRootCommand]}" />
                                 <Separator />
                                 <MenuItem Header="Edit root" Command="{Binding Commands[EditRootCommand]}" />
                                 <MenuItem Header="Delete root" Command="{Binding Commands[DeleteRootCommand]}" />
                              </ContextMenu>
                           </ListBox.ContextMenu>
                           <ListBox.ItemTemplate>
                              <DataTemplate>
                                 <Border Style="{StaticResource rootDropFrameStyle}" Margin="-13,0,-12,0" Padding="13,0,12,0">
                                 <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="Auto" />
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource tintDiscStyle}"
                                            Background="{Binding Name, Converter={StaticResource entityTintConverter}}">
                                       <fa:FontAwesome Icon="Solid_Cubes"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Name,
                                                                            Converter={StaticResource entityTintConverter},
                                                                            ConverterParameter=Text}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                       <TextBlock x:Name="rootName"
                                                  Text="{Binding Name}"
                                                  FontWeight="SemiBold"
                                                  Style="{StaticResource primaryCellStyle}"
                                                  ToolTip="{Binding Name}" />
                                       <Border Style="{StaticResource chipMutedStyle}"
                                               Margin="0,3,0,0"
                                               Padding="7,1"
                                               Visibility="{Binding IsActive, Converter={StaticResource inverseBoolToVisibility}}">
                                          <TextBlock Text="Disabled" />
                                       </Border>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource chipStyle}"
                                            ToolTip="{Binding Summary}">
                                       <TextBlock Text="{Binding ImageCount}" />
                                    </Border>
                                 </Grid>
                                 </Border>
                                 <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                       <Setter TargetName="rootName" Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                 </DataTemplate.Triggers>
                              </DataTemplate>
                           </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasNoRoots, Converter={StaticResource boolToVisibility}}">
                           <fa:FontAwesome Icon="Solid_Cubes" Style="{StaticResource stateIconStyle}" />
                           <TextBlock Text="No roots yet" Style="{StaticResource stateTitleStyle}" />
                           <TextBlock Text="A root is the first part of every pull name, like acme in host/acme/api."
                                      Style="{StaticResource stateNoteStyle}"
                                      MaxWidth="220" />
                        </StackPanel>
                     </Grid>
                  </Border>

                  <!-- ==== tree ==== -->
                  <Border Grid.Column="2" Style="{StaticResource panelCardStyle}">
                     <Grid>
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto" />
                           <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource panelHeaderStyle}">
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                 <TextBlock Text="{Binding SelectedRoot.Name, FallbackValue=''}"
                                            Style="{StaticResource groupCaptionStyle}"
                                            FontSize="13.5" />
                                 <Border Style="{StaticResource chipStyle}"
                                         Margin="10,0,0,0"
                                         Visibility="{Binding IsTreeLoaded, Converter={StaticResource boolToVisibility}}">
                                    <TextBlock Text="{Binding SelectedRoot.Summary}" />
                                 </Border>
                              </StackPanel>
                           </Grid>
                        </Border>

                        <TreeView x:Name="ctnTree"
                                  Style="{StaticResource surfaceTreeViewStyle}"
                                  Foreground="{DynamicResource themeWindowForegroundBrush}"
                                  Grid.Row="1"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="12,8"
                                  ItemsSource="{Binding TreeNodes}"
                                  IsEnabled="{Binding IsNotBusy}"
                                  ItemContainerStyle="{StaticResource ctnTreeItemStyle}"
                                  shared:DropTarget.Command="{Binding Commands[DropCommand]}"
                                  shared:DropTarget.Effect="Move"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                           <TreeView.InputBindings>
                              <KeyBinding Key="Delete" Command="{Binding Commands[DeleteNodeCommand]}" />
                              <KeyBinding Key="F2" Command="{Binding Commands[EditNodeCommand]}" />
                           </TreeView.InputBindings>
                           <TreeView.ContextMenu>
                              <ContextMenu>
                                 <MenuItem Header="New folder" Command="{Binding Commands[NewFolderCommand]}" />
                                 <MenuItem Header="New container" Command="{Binding Commands[NewImageCommand]}" />
                                 <Separator />
                                 <MenuItem Header="{Binding EditNodeCaption}" Command="{Binding Commands[EditNodeCommand]}" />
                                 <MenuItem Header="Move to..." Command="{Binding Commands[MoveNodeCommand]}" />
                                 <Separator />
                                 <MenuItem Header="Delete" Command="{Binding Commands[DeleteNodeCommand]}" />
                              </ContextMenu>
                           </TreeView.ContextMenu>
                           <TreeView.Resources>
                              <HierarchicalDataTemplate DataType="{x:Type local:CtnTreeNode}"
                                                        ItemsSource="{Binding Children}">
                                 <Border Style="{StaticResource nodeDropFrameStyle}">
                                 <Grid x:Name="nodeRow"
                                       Background="Transparent"
                                       MinHeight="32"
                                       shared:DragSource.Payload="{Binding}">
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="Auto" />
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <fa:FontAwesome x:Name="nodeIcon"
                                                    Grid.Column="0"
                                                    Icon="{Binding Icon}"
                                                    Width="20"
                                                    FontSize="14"
                                                    Opacity="0.7"
                                                    VerticalAlignment="Center" />
                                    <TextBlock x:Name="nodeName"
                                               Grid.Column="1"
                                               Margin="8,0,10,0"
                                               Style="{StaticResource primaryCellStyle}"
                                               Text="{Binding Name}"
                                               ToolTip="{Binding Name}" />
                                    <StackPanel Grid.Column="2"
                                                Margin="0,0,10,0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                       <Border Style="{StaticResource chipMutedStyle}"
                                               Margin="0,0,8,0"
                                               Padding="7,1"
                                               Visibility="{Binding IsActive, Converter={StaticResource inverseBoolToVisibility}}">
                                          <TextBlock Text="Disabled" />
                                       </Border>
                                       <TextBlock Style="{StaticResource secondaryCellStyle}" Text="{Binding Caption}" />
                                    </StackPanel>
                                 </Grid>
                                 </Border>
                                 <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                       <Setter TargetName="nodeIcon" Property="Foreground"
                                               Value="{DynamicResource themeAccentBrush}" />
                                       <Setter TargetName="nodeIcon" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                       <Setter TargetName="nodeName" Property="Opacity" Value="0.55" />
                                       <Setter TargetName="nodeIcon" Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                 </HierarchicalDataTemplate.Triggers>
                              </HierarchicalDataTemplate>
                           </TreeView.Resources>
                        </TreeView>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsRootEmpty, Converter={StaticResource boolToVisibility}}">
                           <fa:FontAwesome Icon="Regular_FolderOpen" Style="{StaticResource stateIconStyle}" />
                           <TextBlock Text="This root is empty" Style="{StaticResource stateTitleStyle}" />
                           <TextBlock Text="Create a folder or a container here. A container must exist before an image can be pushed to it."
                                      Style="{StaticResource stateNoteStyle}" />
                        </StackPanel>
                     </Grid>
                  </Border>

                  <!-- ==== detail ==== -->
                  <Border Grid.Column="4" Style="{StaticResource panelCardStyle}">
                     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="20,18,20,20">

                           <!-- == root == -->
                           <StackPanel Visibility="{Binding ShowRootDetail, Converter={StaticResource boolToVisibility}}">
                              <Grid>
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                 </Grid.ColumnDefinitions>
                                 <Border Style="{StaticResource tintDiscLargeStyle}"
                                         Background="{Binding SelectedRoot.Name, Converter={StaticResource entityTintConverter}}">
                                    <fa:FontAwesome Icon="Solid_Cubes"
                                                    FontSize="19"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{Binding SelectedRoot.Name,
                                                                         Converter={StaticResource entityTintConverter},
                                                                         ConverterParameter=Text}" />
                                 </Border>
                                 <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedRoot.Name}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                       <Border Style="{StaticResource chipSuccessStyle}"
                                               Visibility="{Binding SelectedRoot.IsActive, Converter={StaticResource boolToVisibility}}">
                                          <TextBlock Text="Active" />
                                       </Border>
                                       <Border Style="{StaticResource chipMutedStyle}"
                                               Visibility="{Binding SelectedRoot.IsActive, Converter={StaticResource inverseBoolToVisibility}}">
                                          <TextBlock Text="Disabled" />
                                       </Border>
                                    </StackPanel>
                                 </StackPanel>
                              </Grid>


                              <TextBlock Text="{Binding SelectedRoot.Description}"
                                         Margin="0,16,0,0"
                                         TextWrapping="Wrap"
                                         Style="{StaticResource primaryCellStyle}"
                                         TextTrimming="None"
                                         Visibility="{Binding SelectedRoot.HasDescription, Converter={StaticResource boolToVisibility}}" />

                              <UniformGrid Columns="3" Margin="0,18,0,0">
                                 <StackPanel>
                                    <TextBlock Text="FOLDERS" Style="{StaticResource metaLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedRoot.Info.FolderCount}" Style="{StaticResource metaValueStyle}" />
                                 </StackPanel>
                                 <StackPanel>
                                    <TextBlock Text="CONTAINERS" Style="{StaticResource metaLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedRoot.Info.ImageCount}" Style="{StaticResource metaValueStyle}" />
                                 </StackPanel>
                                 <StackPanel>
                                    <TextBlock Text="CREATED" Style="{StaticResource metaLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedRoot.CreatedCaption}" Style="{StaticResource metaValueStyle}" />
                                 </StackPanel>
                              </UniformGrid>

                              <Border Style="{StaticResource innerCardStyle}" Margin="0,18,0,0" Padding="12,8">
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                       <TextBlock Text="PULL PREFIX" Style="{StaticResource metaLabelStyle}" />
                                       <TextBlock Text="{Binding DetailPullName}"
                                                  Style="{StaticResource monoValueStyle}"
                                                  ToolTip="{Binding DetailPullName}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource rowActionButtonStyle}"
                                            Command="{Binding Commands[CopyPullNameCommand]}"
                                            ToolTip="Copy">
                                       <fa:FontAwesome Icon="Regular_Copy" />
                                    </Button>
                                 </Grid>
                              </Border>

                              <TextBlock Text="Manage robot identities and access in User Manager → Robots."
                                         Margin="0,22,0,8" TextWrapping="Wrap"
                                         Style="{StaticResource secondaryCellStyle}" TextTrimming="None" />
                           </StackPanel>

                           <!-- == folder == -->
                           <StackPanel Visibility="{Binding ShowFolderDetail, Converter={StaticResource boolToVisibility}}">
                              <Grid>
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                 </Grid.ColumnDefinitions>
                                 <Border Style="{StaticResource tintDiscLargeStyle}"
                                         Background="{StaticResource surfaceStrongBrush}">
                                    <fa:FontAwesome Icon="Solid_Folder"
                                                    FontSize="19"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource themeAccentBrush}" />
                                 </Border>
                                 <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedNode.Name}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Folder" Style="{StaticResource secondaryCellStyle}" Margin="0,3,0,0" />
                                 </StackPanel>
                              </Grid>


                              <UniformGrid Columns="2" Margin="0,6,0,0">
                                 <StackPanel>
                                    <TextBlock Text="PATH" Style="{StaticResource metaLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedNode.Path}"
                                               Style="{StaticResource metaValueStyle}"
                                               ToolTip="{Binding SelectedNode.Path}" />
                                 </StackPanel>
                                 <StackPanel>
                                    <TextBlock Text="CONTAINS" Style="{StaticResource metaLabelStyle}" />
                                    <TextBlock Text="{Binding FolderSummary}" Style="{StaticResource metaValueStyle}" />
                                 </StackPanel>
                              </UniformGrid>

                              <TextBlock Margin="0,18,0,0"
                                         TextWrapping="Wrap"
                                         Style="{StaticResource secondaryCellStyle}"
                                         TextTrimming="None"
                                         Text="Folders only group containers in this screen. They are not part of the pull name, so moving a container between folders never changes how it is pulled." />
                           </StackPanel>

                           <!-- == container == -->
                           <StackPanel Visibility="{Binding ShowImageDetail, Converter={StaticResource boolToVisibility}}">
                              <Grid>
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                 </Grid.ColumnDefinitions>
                                 <Border Style="{StaticResource tintDiscLargeStyle}"
                                         Background="{Binding SelectedNode.Image.RootName, Converter={StaticResource entityTintConverter}}">
                                    <fa:FontAwesome Icon="Solid_Box"
                                                    FontSize="19"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{Binding SelectedNode.Image.RootName,
                                                                         Converter={StaticResource entityTintConverter},
                                                                         ConverterParameter=Text}" />
                                 </Border>
                                 <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedNode.Image.FullName}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedNode.Image.FullName}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                       <Border Style="{StaticResource chipSuccessStyle}"
                                               Visibility="{Binding SelectedNode.IsActive, Converter={StaticResource boolToVisibility}}">
                                          <TextBlock Text="Active" />
                                       </Border>
                                       <Border Style="{StaticResource chipMutedStyle}"
                                               Visibility="{Binding SelectedNode.IsActive, Converter={StaticResource inverseBoolToVisibility}}">
                                          <TextBlock Text="Disabled" />
                                       </Border>
                                    </StackPanel>
                                 </StackPanel>
                              </Grid>


                              <TextBlock Text="{Binding SelectedNode.Description}"
                                         Margin="0,16,0,0"
                                         TextWrapping="Wrap"
                                         Style="{StaticResource primaryCellStyle}"
                                         TextTrimming="None"
                                         Visibility="{Binding SelectedNode.HasDescription, Converter={StaticResource boolToVisibility}}" />

                              <UniformGrid Columns="2" Margin="0,18,0,0">
                                 <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="TAGS" Style="{StaticResource metaLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedNode.Image.TagCount}" Style="{StaticResource metaValueStyle}" />
                                 </StackPanel>
                                 <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="MANIFESTS" Style="{StaticResource metaLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedNode.Image.ManifestCount}" Style="{StaticResource metaValueStyle}" />
                                 </StackPanel>
                                 <StackPanel>
                                    <TextBlock Text="LAST PUSHED" Style="{StaticResource metaLabelStyle}" />
                                    <TextBlock Text="{Binding LastPushedCaption}" Style="{StaticResource metaValueStyle}" />
                                 </StackPanel>
                                 <StackPanel>
                                    <TextBlock Text="CREATED" Style="{StaticResource metaLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedNode.CreatedCaption}" Style="{StaticResource metaValueStyle}" />
                                 </StackPanel>
                              </UniformGrid>

                              <Border Style="{StaticResource innerCardStyle}" Margin="0,18,0,0" Padding="12,8">
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                       <TextBlock Text="PULL NAME" Style="{StaticResource metaLabelStyle}" />
                                       <TextBlock Text="{Binding DetailPullName}"
                                                  Style="{StaticResource monoValueStyle}"
                                                  ToolTip="{Binding DetailPullName}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource rowActionButtonStyle}"
                                            Command="{Binding Commands[CopyPullNameCommand]}"
                                            ToolTip="Copy pull name">
                                       <fa:FontAwesome Icon="Regular_Copy" />
                                    </Button>
                                 </Grid>
                              </Border>

                              <TextBlock Margin="0,8,0,0"
                                         TextWrapping="Wrap"
                                         Style="{StaticResource secondaryCellStyle}"
                                         TextTrimming="None"
                                         Foreground="{StaticResource warningBrush}"
                                         Opacity="1"
                                         Visibility="{Binding IsInsecureHost, Converter={StaticResource boolToVisibility}}"
                                         Text="This server is reached over plain HTTP. Docker only accepts that for localhost, so docker login and docker pull to this address will be refused until the server is served over HTTPS." />

                              <TextBlock Text="MANIFESTS"
                                         Margin="0,22,0,10"
                                         Style="{StaticResource sectionCaptionStyle}" />

                              <TextBlock Style="{StaticResource secondaryCellStyle}"
                                         Text="Loading..."
                                         Visibility="{Binding IsManifestsLoading, Converter={StaticResource boolToVisibility}}" />

                              <ItemsControl ItemsSource="{Binding Manifests}">
                                 <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                       <Border Style="{StaticResource innerCardStyle}" Margin="0,0,0,8" Padding="12,10,12,6"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                          <Border.ContextMenu>
                                             <ContextMenu>
                                                <MenuItem Header="Delete manifest"
                                                          Command="{Binding PlacementTarget.Tag.Commands[DeleteManifestCommand],
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                   <MenuItem.Icon>
                                                      <fa:FontAwesome Icon="Solid_TrashCan" Foreground="{StaticResource dangerBrush}" />
                                                   </MenuItem.Icon>
                                                </MenuItem>
                                             </ContextMenu>
                                          </Border.ContextMenu>
                                          <StackPanel>
                                             <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                   <ItemsPanelTemplate>
                                                      <WrapPanel />
                                                   </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                   <DataTemplate>
                                                      <Button Style="{StaticResource tagChipButtonStyle}"
                                                              Content="{Binding}"
                                                              ToolTip="Copy docker pull for this tag. Right-click for more, including delete."
                                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              Command="{Binding DataContext.Commands[CopyTagPullCommand],
                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}">
                                                         <Button.ContextMenu>
                                                            <ContextMenu>
                                                               <MenuItem Header="Copy docker pull"
                                                                         Command="{Binding PlacementTarget.Tag.Commands[CopyTagPullCommand],
                                                                                           RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                         CommandParameter="{Binding PlacementTarget.Content,
                                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                               <MenuItem Header="Copy docker tag + push"
                                                                         Command="{Binding PlacementTarget.Tag.Commands[CopyTagPushCommand],
                                                                                           RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                         CommandParameter="{Binding PlacementTarget.Content,
                                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                               <Separator />
                                                               <MenuItem Header="Delete tag"
                                                                         Command="{Binding PlacementTarget.Tag.Commands[DeleteTagCommand],
                                                                                           RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                         CommandParameter="{Binding PlacementTarget.Content,
                                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                  <MenuItem.Icon>
                                                                     <fa:FontAwesome Icon="Solid_TrashCan" Foreground="{StaticResource dangerBrush}" />
                                                                  </MenuItem.Icon>
                                                               </MenuItem>
                                                            </ContextMenu>
                                                         </Button.ContextMenu>
                                                      </Button>
                                                   </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                             </ItemsControl>

                                             <TextBlock Text="untagged"
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource secondaryCellStyle}"
                                                        Visibility="{Binding HasTags, Converter={StaticResource inverseBoolToVisibility}}" />

                                             <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                   <ColumnDefinition Width="*" />
                                                   <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ShortDigest}"
                                                           Style="{StaticResource monoValueStyle}"
                                                           ToolTip="{Binding Digest}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                   <Button Style="{StaticResource rowActionButtonStyle}"
                                                           ToolTip="Copy digest"
                                                           Command="{Binding DataContext.Commands[CopyDigestCommand],
                                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}">
                                                      <fa:FontAwesome Icon="Regular_Copy" />
                                                   </Button>
                                                   <Button Style="{StaticResource rowActionButtonStyle}"
                                                           ToolTip="Copy docker pull by digest"
                                                           Command="{Binding DataContext.Commands[CopyDigestPullCommand],
                                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}">
                                                      <fa:FontAwesome Icon="Solid_Download" />
                                                   </Button>
                                                   <Button Style="{StaticResource rowActionButtonStyle}"
                                                           ToolTip="Delete manifest"
                                                           AutomationProperties.Name="Delete manifest"
                                                           Command="{Binding DataContext.Commands[DeleteManifestCommand],
                                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}">
                                                      <fa:FontAwesome Icon="Solid_TrashCan" Foreground="{StaticResource dangerBrush}" />
                                                   </Button>
                                                </StackPanel>
                                             </Grid>

                                             <TextBlock Text="{Binding MediaType}"
                                                        Style="{StaticResource secondaryCellStyle}"
                                                        ToolTip="{Binding MediaType}" />
                                             <TextBlock Margin="0,2,0,4"
                                                        Style="{StaticResource secondaryCellStyle}"
                                                        TextWrapping="Wrap"
                                                        TextTrimming="None">
                                                <Run Text="{Binding MetaCaption, Mode=OneWay}" />
                                             </TextBlock>
                                          </StackPanel>
                                       </Border>
                                    </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                              </ItemsControl>
                           </StackPanel>
                        </Grid>
                     </ScrollViewer>
                  </Border>
               </Grid>

            <!-- =================================================
                 ROBOTS
                 The accounts docker logs in with, on the left; the chosen robot's token
                 details and its access to each root on the right.
                 ================================================= -->


      </Grid>

      <StackPanel VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Visibility="{Binding IsRegistryDisabled, Converter={StaticResource boolToVisibility}}">
         <fa:FontAwesome Icon="Solid_Cubes" Style="{StaticResource stateIconStyle}" FontSize="44" />
         <TextBlock Text="Container registry is not enabled on this server."
                    Margin="0,16,0,0"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
         <TextBlock Text="The server does not publish a container registry. Use Settings with the settings management claim, save, and restart the API, then refresh."
                    Margin="0,6,0,0"
                    MaxWidth="420"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Style="{StaticResource secondaryCellStyle}"
                    HorizontalAlignment="Center" />
         <Button Style="{StaticResource outlinedButtonStyle}"
                 Margin="0,18,0,0"
                 HorizontalAlignment="Center"
                 Command="{Binding Commands[RefreshCommand]}">
            <StackPanel Orientation="Horizontal">
               <fa:FontAwesome Icon="Solid_ArrowsRotate" Style="{StaticResource buttonIconStyle}" />
               <TextBlock Text="Refresh" VerticalAlignment="Center" />
            </StackPanel>
         </Button>
      </StackPanel>

      <controls:WaitOverlay IsWaiting="{Binding InWaiting}" Caption="{Binding WaiterText}" />
   </Grid>
</TabItem>
<TabItem Header="Settings" Style="{StaticResource materialTabItemStyle}"><controls:StorageSettingsCard x:Name="settingsCard"/></TabItem>
<TabItem Header="Publish" Style="{StaticResource materialTabItemStyle}"><publish:PublishView x:Name="publisher"/></TabItem></TabControl>
</UserControl>
