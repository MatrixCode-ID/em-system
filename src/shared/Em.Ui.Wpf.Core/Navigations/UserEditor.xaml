<UserControl x:Class="Em.Ui.Wpf.Navigations.UserEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Em.Ui.Wpf.Navigations"
             xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
             xmlns:conv="clr-namespace:Em.Ui.Wpf.Converters"
             xmlns:shared="clr-namespace:Em.Ui.Wpf.Shared"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1180">
   <UserControl.DataContext>
      <local:UserEditorVm/>
   </UserControl.DataContext>

   <!--
      User editor screen: one record, opened from the user list. As on the list screen the
      host draws the title and subtitle in its own navigation bar directly above, so there
      is no screen title here and the tool strip stays chrome-less.

      Markup only - no view model stands behind this file yet, so every value below is a
      literal sample that shows the intended layout; the fields become bindings once the
      data layer lands.

      The same two rules as the list screen keep this working on both themes:

      - every surface, outline and divider is a translucent grey (#xx808080), which darkens
        a light background and lightens a dark one without naming a theme colour;
      - the one colour taken from the theme is the accent, read through the Em
        theme token themeAccentBrush, so the primary button, the tab underline and the focused field follow
        the theme.

      The layout is a summary column beside a working column:

      - the left card is the record at a glance - who this is, what state the account is in,
        and the facts that are read far more often than they are edited;
      - the right card is where the editing happens, split into three tabs so a long form
        never turns into one endless scroll.

      Styles are deliberately named the same as their twins in UserManager.xaml. Both files
      are meant to give their chrome up to a shared dictionary later, and identical names
      make that a move rather than a rewrite.
   -->

   <UserControl.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <!-- Round, chrome-less icon buttons for the small in-place actions. -->
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/FlatIconButton.xaml" />
            <!-- The shared inputs, for the inline date picker on the role cards. Every key this
                 file declares itself still wins over the merged one of the same name. -->
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/Inputs.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <!-- ============================================================
              PALETTE
              ============================================================ -->
         <SolidColorBrush x:Key="surfaceBrush" Color="#0D808080" />
         <SolidColorBrush x:Key="surfaceStrongBrush" Color="#1A808080" />
         <SolidColorBrush x:Key="outlineBrush" Color="#29808080" />
         <SolidColorBrush x:Key="outlineStrongBrush" Color="#4D808080" />
         <SolidColorBrush x:Key="dividerBrush" Color="#1F808080" />

         <!-- Material state layers: one translucent grey veil over whatever the control
              already paints, so the same two brushes serve every button variant. -->
         <SolidColorBrush x:Key="stateHoverBrush" Color="#1F808080" />
         <SolidColorBrush x:Key="statePressedBrush" Color="#33808080" />

         <!-- Status colours are mid-tone on purpose: dark enough to read on a light chip,
              light enough to read on a dark one. -->
         <SolidColorBrush x:Key="successBrush" Color="#2FA84F" />
         <SolidColorBrush x:Key="successChipBrush" Color="#242FA84F" />
         <SolidColorBrush x:Key="warningBrush" Color="#C98A00" />
         <SolidColorBrush x:Key="warningChipBrush" Color="#24C98A00" />
         <SolidColorBrush x:Key="dangerBrush" Color="#E05656" />
         <SolidColorBrush x:Key="dangerChipBrush" Color="#24E05656" />
         <SolidColorBrush x:Key="infoBrush" Color="#3B82F6" />

         <!-- ============================================================
              TYPOGRAPHY
              ============================================================ -->
         <!-- Section captions are written upper case by hand - WPF has no letter spacing,
              so case is the only thing separating a caption from the fields under it. -->
         <Style x:Key="sectionCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="0,26,0,12" />
         </Style>

         <Style x:Key="primaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
         </Style>

         <Style x:Key="secondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource primaryTextStyle}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.6" />
         </Style>

         <!-- Caption over a field. Sentence case, unlike a section caption: a label this
              close to its editor reads better as a word than as a heading. -->
         <Style x:Key="fieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="2,0,0,6" />
         </Style>

         <!-- The line under a field: what the value is for, or what shape it has to take. -->
         <Style x:Key="fieldHelpStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
         </Style>

         <!-- The same line as the help text, but saying what is wrong rather than what the
              field is for. It takes the help line's place while it shows, so a field never
              carries two lines of prose at once. -->
         <Style x:Key="fieldErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource fieldHelpStyle}">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource dangerBrush}" />
         </Style>

         <!-- ============================================================
              BUTTONS
              Four material variants sharing one template shape: a rounded
              container, a state layer over it, then the content. Only the
              resting brushes differ, so a variant costs a few setters
              rather than another template.
              ============================================================ -->
         <Style x:Key="materialButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- The template draws its own focus ring; the dotted default one squares off
                 the pill shape. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="Button">
                     <!-- CornerRadius 19 is half the resting height, i.e. a full pill. -->
                     <Border x:Name="shape"
                             CornerRadius="19"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                           <Border x:Name="stateLayer" CornerRadius="19" Background="Transparent" />
                           <ContentPresenter Margin="{TemplateBinding Padding}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                        </Grid>
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="stateLayer" Property="Background"
                                   Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                           <Setter TargetName="stateLayer" Property="Background"
                                   Value="{StaticResource statePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                           <Setter TargetName="shape" Property="BorderBrush"
                                   Value="{DynamicResource themeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                           <Setter TargetName="shape" Property="Opacity" Value="0.4" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- Filled: the single primary action on the screen - here, committing the record.
              Accent background plus a soft shadow, which is the only elevation in the
              layout. -->
         <Style x:Key="filledButtonStyle" TargetType="Button" BasedOn="{StaticResource materialButtonBaseStyle}">
            <Setter Property="Background"
                    Value="{DynamicResource themeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Effect">
               <Setter.Value>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#000000" />
               </Setter.Value>
            </Setter>
            <Style.Triggers>
               <!-- Material raises a filled button as the pointer comes over it. -->
               <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Effect">
                     <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000" />
                     </Setter.Value>
                  </Setter>
               </Trigger>
            </Style.Triggers>
         </Style>

         <!-- Tonal: a secondary action that still wants a surface of its own. -->
         <Style x:Key="tonalButtonStyle" TargetType="Button" BasedOn="{StaticResource materialButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource surfaceStrongBrush}" />
         </Style>

         <!-- Outlined: the quietest of the four, an outline and nothing else at rest. -->
         <Style x:Key="outlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource materialButtonBaseStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource outlineBrush}" />
         </Style>

         <!-- Danger: an outlined button wearing the warning colour, for the actions that end
              something - suspending an account, signing every device out. It is never
              filled: a red block would out-shout Save, which is the action this screen
              actually exists for. -->
         <Style x:Key="dangerButtonStyle" TargetType="Button" BasedOn="{StaticResource materialButtonBaseStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource dangerBrush}" />
            <Setter Property="Foreground" Value="{StaticResource dangerBrush}" />
         </Style>

         <!-- Text button: no chrome at all, for small actions that must stay available but
              must not compete with anything. -->
         <Style x:Key="textButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"
                    Value="{DynamicResource themeAccentBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="Button">
                     <Border x:Name="shape" CornerRadius="14" Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="shape" Property="Background"
                                   Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- The same text button in the warning colour, for a destructive action that has
              to stay quiet - it sits inside a section rather than on the tool strip. -->
         <Style x:Key="textDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource textButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource dangerBrush}" />
         </Style>

         <!-- Icon and caption share one line inside every toolbar button. -->
         <Style x:Key="buttonIconStyle" TargetType="fa:FontAwesome">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
         </Style>

         <!-- Small in-place actions: the shared flat icon button, one size down. -->
         <Style x:Key="rowActionButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource flatIconButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.75" />
         </Style>

         <!-- ============================================================
              CHIPS
              TextElement.Foreground is set on the chip and inherits down to
              the caption inside it, so a variant only has to name three
              brushes.
              ============================================================ -->
         <Style x:Key="chipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource surfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource outlineBrush}" />
            <Setter Property="TextElement.FontSize" Value="11" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
         </Style>

         <Style x:Key="chipSuccessStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
            <Setter Property="Background" Value="{StaticResource successChipBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource successBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource successBrush}" />
         </Style>

         <Style x:Key="chipWarningStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
            <Setter Property="Background" Value="{StaticResource warningChipBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource warningBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource warningBrush}" />
         </Style>

         <Style x:Key="chipDangerStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
            <Setter Property="Background" Value="{StaticResource dangerChipBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource dangerBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource dangerBrush}" />
         </Style>

         <!-- Muted chip for a fact that is only context - no colour, only the neutral
              surface, so it never competes with the state chips. -->
         <Style x:Key="chipMutedStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
            <Setter Property="Opacity" Value="0.65" />
         </Style>

         <!-- ============================================================
              AVATAR
              Initials on a tinted disc, the same device the list uses, one
              size up because here it stands for the whole record.
              ============================================================ -->
         <Style x:Key="avatarStyle" TargetType="Border">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="88" />
            <Setter Property="CornerRadius" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Center" />
         </Style>

         <Style x:Key="avatarTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="29" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
         </Style>

         <!-- ============================================================
              TEXT FIELDS
              One outlined field for every kind of value. The watermark is
              part of the template and reads the field's Tag, so a field
              costs one line of markup and never needs a name, a code
              behind handler or a sibling TextBlock.
              ============================================================ -->
         <Style x:Key="fieldBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource surfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource outlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- The theme gives TextBox its Foreground; the caret is not themed, so it
                 simply follows the text colour. -->
            <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="TextBox">
                     <Border x:Name="shape"
                             CornerRadius="10"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}">
                        <!-- No Padding on this Grid: TextBoxBase already insets its own
                             text by Padding, so a margin here would indent the typed text
                             twice while the watermark below moved only once. The watermark
                             carries the padding itself, which lands it on the same left
                             edge as the text that replaces it. -->
                        <Grid>
                           <ScrollViewer x:Name="PART_ContentHost"
                                         Focusable="False"
                                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                         HorizontalScrollBarVisibility="Hidden"
                                         VerticalScrollBarVisibility="Hidden" />
                           <!-- Watermark: the field's own Tag, shown only while it is
                                empty. A plain Binding rather than a TemplateBinding, so
                                the Tag object is converted to text on the way in. -->
                           <TextBlock x:Name="watermark"
                                      Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Margin="{TemplateBinding Padding}"
                                      Opacity="0.45"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                           <Setter TargetName="watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="shape" Property="BorderBrush"
                                   Value="{StaticResource outlineStrongBrush}" />
                        </Trigger>
                        <!-- Focus is the one state the accent is spent on inside a form:
                             it says which field the keyboard is talking to. -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                           <Setter TargetName="shape" Property="BorderBrush"
                                   Value="{DynamicResource themeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                           <Setter TargetName="shape" Property="Background"
                                   Value="{StaticResource surfaceBrush}" />
                           <Setter Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                           <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <!-- Last of the triggers on purpose: a field holding something that
                             cannot be saved stays marked while it is hovered and while it is
                             being typed into, which is exactly when the reader needs to see
                             it. An earlier trigger would be painted over by those two. -->
                        <Trigger Property="shared:FieldValidation.HasError" Value="True">
                           <Setter TargetName="shape" Property="BorderBrush"
                                   Value="{StaticResource dangerBrush}" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- Same field grown into a paragraph. Height Auto is NaN, which is what lets
              MinHeight decide the resting size while the box still grows with its text. -->
         <Style x:Key="fieldMultilineStyle" TargetType="TextBox" BasedOn="{StaticResource fieldBoxStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
         </Style>

         <!-- Password field. A PasswordBox has no Text property to trigger on, so it wears
              no watermark - the label above it and the help line below carry the meaning
              instead. -->
         <Style x:Key="fieldPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource surfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource outlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="PasswordBox">
                     <Border x:Name="shape"
                             CornerRadius="10"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}">
                        <!-- As in the text field, Padding is left to PasswordBoxBase so
                             the dots start on the same left edge as the fields above. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="shape" Property="BorderBrush"
                                   Value="{StaticResource outlineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                           <Setter TargetName="shape" Property="BorderBrush"
                                   Value="{DynamicResource themeAccentBrush}" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- Picker frame: a field whose value is chosen somewhere else - another record,
              a dialog. It is a Border rather than an editor because nothing is typed into
              it; the button on the right is what opens the chooser. -->
         <Style x:Key="pickerFieldStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,0,6,0" />
            <Setter Property="Background" Value="{StaticResource surfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource outlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
         </Style>

         <!-- Date box: the frame around the editor, matching the fields around it. -->
         <Style x:Key="dateFieldStyle" TargetType="Border" BasedOn="{StaticResource pickerFieldStyle}">
            <Setter Property="Padding" Value="12,0" />
         </Style>

         <!-- ============================================================
              DROP DOWN
              A plain ComboBox with its chrome replaced, shaped like the
              text fields beside it so a row of mixed editors still reads
              as one row.

              The drop down is the only surface here that cannot be a
              translucent grey: a popup floats over whatever is behind the
              window, so it needs an opaque background - here the theme's
              popup surface token, themePopupBackgroundBrush.
              ============================================================ -->
         <Style x:Key="fieldComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ComboBoxItem">
                     <Border x:Name="itemSurface"
                             CornerRadius="7"
                             Background="Transparent"
                             Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="itemSurface" Property="Background"
                                   Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                           <Setter TargetName="itemSurface" Property="Background"
                                   Value="{StaticResource statePressedBrush}" />
                           <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- The toggle draws the field itself: the box and the chevron. The selected value
              is painted over it by the ComboBox template, so this stays a pure piece of
              chrome. -->
         <Style x:Key="fieldComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- A style of our own does not displace the theme style: properties this style
                 leaves alone keep taking the theme's setters and triggers. The theme's
                 ToggleButton turns Foreground black while IsChecked, which is meant for its
                 own accent-filled chrome and is unreadable over ours, so every ToggleButton
                 here pins Foreground back to the colour it would have inherited. RadioButton
                 and CheckBox carry no such trigger and are left alone. -->
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ToggleButton">
                     <Border x:Name="shape"
                             CornerRadius="10"
                             Background="{StaticResource surfaceStrongBrush}"
                             BorderBrush="{StaticResource outlineBrush}"
                             BorderThickness="1">
                        <Grid>
                           <Border x:Name="stateLayer" CornerRadius="10" Background="Transparent" />
                           <fa:FontAwesome x:Name="chevron"
                                           Icon="Solid_ChevronDown"
                                           FontSize="9"
                                           Opacity="0.6"
                                           Margin="0,0,14,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                        </Grid>
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="stateLayer" Property="Background"
                                   Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <!-- Open list: the chevron points the other way and the field is
                             outlined in the accent, so it is clear which field the popup
                             below belongs to. -->
                        <Trigger Property="IsChecked" Value="True">
                           <Setter TargetName="chevron" Property="Icon" Value="Solid_ChevronUp" />
                           <Setter TargetName="shape" Property="BorderBrush"
                                   Value="{DynamicResource themeAccentBrush}" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <Style x:Key="fieldComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource fieldComboItemStyle}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ComboBox">
                     <Grid>
                        <!-- ClickMode Press opens the list on the way down, the way a
                             native drop down does. -->
                        <ToggleButton Style="{StaticResource fieldComboToggleStyle}"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- The selected value sits above the toggle and lets the mouse
                             through, so clicking the text still opens the list. -->
                        <ContentPresenter Margin="14,0,32,0"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               VerticalOffset="4"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                           <!-- The margin is what leaves room for the shadow; without it
                                the popup clips its own drop shadow away. -->
                           <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="8,0,8,8"
                                   Padding="4"
                                   CornerRadius="10"
                                   Background="{DynamicResource themePopupBackgroundBrush}"
                                   BorderBrush="{StaticResource outlineBrush}"
                                   BorderThickness="1">
                              <Border.Effect>
                                 <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                                   Opacity="0.3" Color="#000000" />
                              </Border.Effect>
                              <ItemsPresenter />
                           </Border>
                        </Popup>
                     </Grid>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- ============================================================
              TOGGLES
              A switch for a setting that is on or off, a check box for a
              value picked out of a set, a chip for a role, and a segment
              for the one state that is exclusive.
              ============================================================ -->
         <Style x:Key="switchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ToggleButton">
                     <Border x:Name="track"
                             CornerRadius="11"
                             Background="{StaticResource surfaceStrongBrush}"
                             BorderBrush="{StaticResource outlineStrongBrush}"
                             BorderThickness="1">
                        <Border x:Name="thumb"
                                Width="15"
                                Height="15"
                                Margin="3,0,0,0"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                Background="#99808080" />
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                           <Setter TargetName="track" Property="Background"
                                   Value="{DynamicResource themeAccentBrush}" />
                           <Setter TargetName="track" Property="BorderBrush"
                                   Value="{DynamicResource themeAccentBrush}" />
                           <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                           <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
                           <Setter TargetName="thumb" Property="Background" Value="White" />
                        </Trigger>
                        <!-- Dimmed rather than recoloured, so a locked switch keeps the
                             theme's colours on both themes. -->
                        <Trigger Property="IsEnabled" Value="False">
                           <Setter Property="Opacity" Value="0.4" />
                           <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <Style x:Key="checkBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Left, not the default Stretch: a stretched check box keeps its transparent
                 hit area running to the end of the row, which would hand the cursor to
                 empty space well past the caption. Aligned left, the control ends where
                 the caption ends and so does the hand. -->
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="CheckBox">
                     <!-- Transparent background makes the whole row the click target, not
                          just the box and the glyph. -->
                     <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box"
                                Grid.Column="0"
                                Width="18"
                                Height="18"
                                CornerRadius="5"
                                Background="Transparent"
                                BorderBrush="{StaticResource outlineStrongBrush}"
                                BorderThickness="1.4"
                                VerticalAlignment="Center">
                           <fa:FontAwesome x:Name="tick"
                                           Icon="Solid_Check"
                                           FontSize="9"
                                           Opacity="0"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter x:Name="caption"
                                          Grid.Column="1"
                                          Margin="11,0,0,0"
                                          VerticalAlignment="Center" />
                     </Grid>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                           <Setter TargetName="box" Property="Background"
                                   Value="{DynamicResource themeAccentBrush}" />
                           <Setter TargetName="box" Property="BorderBrush"
                                   Value="{DynamicResource themeAccentBrush}" />
                           <Setter TargetName="tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="box" Property="BorderBrush"
                                   Value="{DynamicResource themeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                           <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- The same box with no caption beside it, for the permission grid where the
              column header already says what the box means. Width pins the control to the
              box itself: with an empty caption the presenter still carries its own left
              margin, and that margin would be 11px of hand cursor over nothing. -->
         <Style x:Key="gridCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource checkBoxStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Margin" Value="0" />
         </Style>

         <!-- Role chip: several may be on at once, so it is a ToggleButton rather than a
              segment. -->
         <Style x:Key="filterChipStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- Keeps the theme's checked-state Foreground off the label; see
                 fieldComboToggleStyle. -->
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ToggleButton">
                     <Border x:Name="shape"
                             CornerRadius="15"
                             Background="Transparent"
                             BorderBrush="{StaticResource outlineBrush}"
                             BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                           <fa:FontAwesome x:Name="tick"
                                           Icon="Solid_Check"
                                           FontSize="10"
                                           Margin="0,0,7,0"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center" />
                           <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="shape" Property="Background"
                                   Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <!-- A tick appears next to the caption while the chip is on: with
                             several chips on at once, the outline alone is easy to miss. -->
                        <Trigger Property="IsChecked" Value="True">
                           <Setter TargetName="shape" Property="Background"
                                   Value="{StaticResource statePressedBrush}" />
                           <Setter TargetName="shape" Property="BorderBrush"
                                   Value="{DynamicResource themeAccentBrush}" />
                           <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                           <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- One segment of the segmented control that carries the account state.
              RadioButtons in one group, so the state stays exclusive with no code. -->
         <Style x:Key="segmentStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="RadioButton">
                     <Border x:Name="shape" CornerRadius="13" Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="shape" Property="Background"
                                   Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                           <Setter TargetName="shape" Property="Background"
                                   Value="{DynamicResource themeAccentBrush}" />
                           <Setter Property="Foreground" Value="White" />
                           <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- ============================================================
              TABS
              Material tabs: a caption with an accent underline on the
              current one, over a single divider that runs the width of the
              card. No box, no border - the card is already the frame.
              ============================================================ -->
         <Style x:Key="editorTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="TabItem">
                     <Border x:Name="shape" Background="Transparent" Height="46">
                        <Grid>
                           <!-- The pill is the object: it carries the hand cursor and it is
                                what lights up on hover, so the pointer changes exactly where
                                something answers to it. The caption lives inside the pill and
                                therefore takes the same cursor. The band around it is only
                                the strip's surface - a click there still selects the tab, but
                                nothing about it looks clickable, so the cursor stays an
                                arrow. Setting the cursor on the style instead would put it on
                                the whole 46px item, which is what made the strip feel like
                                one large button. -->
                           <Border x:Name="stateLayer"
                                   Margin="4,6"
                                   CornerRadius="8"
                                   Background="Transparent"
                                   Cursor="Hand">
                              <ContentPresenter ContentSource="Header"
                                                Margin="16,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                           </Border>
                           <!-- The underline is the whole selected state; it is hidden
                                rather than collapsed so the caption never shifts. -->
                           <Border x:Name="indicator"
                                   Height="3"
                                   Margin="10,0"
                                   CornerRadius="2,2,0,0"
                                   VerticalAlignment="Bottom"
                                   Visibility="Hidden"
                                   Background="{DynamicResource themeAccentBrush}" />
                        </Grid>
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="stateLayer" Property="Background"
                                   Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                           <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                           <Setter Property="FontWeight" Value="SemiBold" />
                           <Setter Property="Foreground"
                                   Value="{DynamicResource themeAccentBrush}" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <Style x:Key="editorTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource editorTabItemStyle}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="TabControl">
                     <Grid>
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto" />
                           <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource surfaceStrongBrush}"
                                BorderBrush="{StaticResource dividerBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="13,13,0,0">
                           <TabPanel IsItemsHost="True" Margin="10,0,0,0" HorizontalAlignment="Left" />
                        </Border>

                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                     </Grid>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- ============================================================
              SUMMARY CARD PARTS
              A meta row is a caption over its value rather than a pair on
              one line: at 340px a two column pair either wraps or trims,
              and stacking keeps every value readable whatever its length.
              ============================================================ -->
         <Style x:Key="metaLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.5" />
         </Style>

         <Style x:Key="metaValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
         </Style>

         <!-- ============================================================
              ACTIVITY TIMELINE
              A dot per event on one vertical rule. The rule is drawn by the
              entry itself and stretches the whole row, so the chain closes
              up whatever height an entry ends up with.
              ============================================================ -->
         <Style x:Key="timelineDotStyle" TargetType="Border">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource outlineStrongBrush}" />
         </Style>

         <Style x:Key="timelineRuleStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="0,18,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource dividerBrush}" />
         </Style>

         <!-- ============================================================
              BINDING HELPERS
              The avatar reads its initials and its tint straight off the
              contact name, the same way the user list does, so one person
              keeps one colour wherever they show up.
              ============================================================ -->
         <BooleanToVisibilityConverter x:Key="boolToVisibility" />
         <conv:InitialsConverter x:Key="initialsConverter" />
         <conv:AvatarPaletteConverter x:Key="avatarPaletteConverter" />

         <!-- One chip that takes the colour of the state it is showing, rather than four
              chips of which three are hidden. Inactive falls through to the neutral chip:
              it is the absence of a state, not a state worth colouring. -->
         <Style x:Key="stateChipStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
            <Style.Triggers>
               <DataTrigger Binding="{Binding Data.cUserState}" Value="Active">
                  <Setter Property="Background" Value="{StaticResource successChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource successBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource successBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Data.cUserState}" Value="Pending">
                  <Setter Property="Background" Value="{StaticResource warningChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource warningBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Data.cUserState}" Value="Suspended">
                  <Setter Property="Background" Value="{StaticResource dangerChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource dangerBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource dangerBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <!-- ============================================================
              PASSWORD STRENGTH
              Four bars, each lit once the password has met that many rules,
              and all four take their colour from the same score - so the
              meter fills and warms up together instead of a bar at a time.

              The unlit colour is a Setter rather than an attribute on the
              bar itself: a local value outranks a trigger, and a bar that
              named its own background could never be lit.
              ============================================================ -->
         <Style x:Key="strengthBarStyle" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource outlineBrush}" />
         </Style>

         <Style x:Key="strengthBar1Style" TargetType="Border" BasedOn="{StaticResource strengthBarStyle}">
            <Style.Triggers>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="1">
                  <Setter Property="Background" Value="{StaticResource dangerBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="2">
                  <Setter Property="Background" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="3">
                  <Setter Property="Background" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                  <Setter Property="Background" Value="{StaticResource successBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <Style x:Key="strengthBar2Style" TargetType="Border" BasedOn="{StaticResource strengthBarStyle}">
            <Setter Property="Margin" Value="5,0,0,0" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="2">
                  <Setter Property="Background" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="3">
                  <Setter Property="Background" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                  <Setter Property="Background" Value="{StaticResource successBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <Style x:Key="strengthBar3Style" TargetType="Border" BasedOn="{StaticResource strengthBarStyle}">
            <Setter Property="Margin" Value="5,0,0,0" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="3">
                  <Setter Property="Background" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                  <Setter Property="Background" Value="{StaticResource successBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <Style x:Key="strengthBar4Style" TargetType="Border" BasedOn="{StaticResource strengthBarStyle}">
            <Setter Property="Margin" Value="5,0,0,0" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                  <Setter Property="Background" Value="{StaticResource successBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <Style x:Key="strengthCaptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.5" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="1">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Foreground" Value="{StaticResource dangerBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="2">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Foreground" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="3">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Foreground" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Foreground" Value="{StaticResource successBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <!-- A rule that is still open is faded, not red: nothing has gone wrong yet, the
              password simply is not finished. Fading the whole row rather than swapping the
              tick for another glyph keeps the three rules on one vertical line. -->
         <Style x:Key="passwordRuleRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Opacity" Value="0.4" />
         </Style>

      </ResourceDictionary>
   </UserControl.Resources>

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- =========================================================
           TOOL STRIP - actions only, no screen title
           The host already draws the screen title and subtitle in its own
           navigation bar directly above this control, so a title here would
           put the same caption on screen twice. The strip stays chrome-less
           for the same reason: a second filled bar right under the host's
           bar reads as a double header.

           Actions on the left in the order they are used, the record's own
           state on the right, which keeps the strip readable when the window
           is narrow: the buttons never move.
           ========================================================= -->
      <Grid Grid.Row="0" Margin="22,12,22,10">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>

         <!-- Committing the record is the one thing this screen is for, so it is the only
              filled button on it. -->
         <Button Grid.Column="0"
                 Style="{StaticResource filledButtonStyle}"
                 Command="{Binding Commands[SaveCommand]}"
                 ToolTip="Save this user">
            <StackPanel Orientation="Horizontal">
               <fa:FontAwesome Icon="Solid_FloppyDisk" Style="{StaticResource buttonIconStyle}" />
               <TextBlock Text="Save Changes" VerticalAlignment="Center" />
            </StackPanel>
         </Button>

         <!-- Separator: what commits or undoes the edit on one side, what acts on the
              account itself on the other. -->
         <Border Grid.Column="1"
                 Width="1"
                 Height="22"
                 Margin="14,0"
                 VerticalAlignment="Center"
                 Background="{StaticResource outlineBrush}" />

         <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource tonalButtonStyle}"
                    Command="{Binding Commands[DiscardCommand]}"
                    ToolTip="Put every field back to the stored value">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_RotateLeft" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Discard" VerticalAlignment="Center" />
               </StackPanel>
            </Button>

            <Button Style="{StaticResource dangerButtonStyle}" Margin="10,0,0,0"
                    Command="{Binding Commands[SuspendCommand]}"
                    ToolTip="Block this account from signing in">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_Ban" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Suspend" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
         </StackPanel>

         <!-- The right hand end is what the record is doing right now: whether it differs
              from what is stored, and when it was last written. -->
         <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource chipWarningStyle}"
                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource boolToVisibility}}">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_CirclePause" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="Unsaved changes" VerticalAlignment="Center" />
               </StackPanel>
            </Border>
            <Border Style="{StaticResource chipMutedStyle}" Margin="8,0,0,0">
               <TextBlock Text="{Binding SavedCaption}" />
            </Border>
         </StackPanel>

         <Button Grid.Column="5"
                 Style="{StaticResource rowActionButtonStyle}"
                 Margin="8,0,0,0"
                 ToolTip="More actions">
            <fa:FontAwesome Icon="Solid_EllipsisVertical" />
         </Button>
      </Grid>

      <!-- =========================================================
           BODY - summary column beside the working column
           ========================================================= -->
      <Grid Grid.Row="1" Margin="22,0,22,22">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>

         <!-- ==== summary card ====
              Read far more often than it is edited: who this is, what state the account is
              in, and the handful of facts that answer most questions without opening a tab.
              The account state lives here rather than in the form, because it is the one
              field that is changed on its own, without touching anything else. -->
         <Border Grid.Column="0"
                 CornerRadius="14"
                 Background="{StaticResource surfaceBrush}"
                 BorderBrush="{StaticResource outlineBrush}"
                 BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
               <StackPanel Margin="22,24,22,22">

                  <!-- Avatar with the camera button parked on its lower right, the way a
                       profile picture is changed everywhere else. -->
                  <Grid Width="88" Height="88" HorizontalAlignment="Center">
                     <Border Style="{StaticResource avatarStyle}"
                             Background="{Binding Data.cContactFullName, Converter={StaticResource avatarPaletteConverter}}">
                        <TextBlock Text="{Binding Data.cContactFullName, Converter={StaticResource initialsConverter}}"
                                   Style="{StaticResource avatarTextStyle}"
                                   Foreground="{Binding Data.cContactFullName, Converter={StaticResource avatarPaletteConverter},
                                                        ConverterParameter=Text}" />
                     </Border>
                     <Button Style="{StaticResource rowActionButtonStyle}"
                             Width="30" Height="30"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Opacity="1"
                             Background="{StaticResource surfaceStrongBrush}"
                             ToolTip="Change picture">
                        <fa:FontAwesome Icon="Solid_Camera" FontSize="11" />
                     </Button>
                  </Grid>

                  <TextBlock Text="{Binding Data.cContactFullName}"
                             FontSize="17"
                             FontWeight="SemiBold"
                             Margin="0,14,0,0"
                             TextAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Data.cUserAccount}"
                             FontSize="12"
                             Opacity="0.6"
                             Margin="0,3,0,0"
                             TextAlignment="Center" />

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                     <Border Style="{StaticResource stateChipStyle}">
                        <TextBlock Text="{Binding Data.cUserState}" />
                     </Border>
                     <!-- The second chip carries the administrator flag, not a job title: an
                          account says what it may do, a contact says who the person is. It is
                          there only while the flag is on - an account that is not an
                          administrator has nothing to say here. -->
                     <Border Style="{StaticResource chipDangerStyle}" Margin="7,0,0,0"
                             Visibility="{Binding Data.cUserIsAdmin, Converter={StaticResource boolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                           <fa:FontAwesome Icon="Solid_UserShield" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center" />
                           <TextBlock Text="Administrator" VerticalAlignment="Center" />
                        </StackPanel>
                     </Border>
                  </StackPanel>

                  <Border Height="1" Margin="0,20" Background="{StaticResource dividerBrush}" />

                  <!-- Account state: the one field that is changed without touching the
                       rest of the record, so it sits with the summary rather than in the
                       form. The segments share a group, which keeps the state exclusive. -->
                  <TextBlock Text="ACCOUNT STATE" Style="{StaticResource sectionCaptionStyle}" Margin="0,0,0,10" />
                  <Border CornerRadius="15"
                          Padding="2"
                          Background="{StaticResource surfaceBrush}"
                          BorderBrush="{StaticResource outlineBrush}"
                          BorderThickness="1">
                     <UniformGrid Columns="2" Rows="2">
                        <RadioButton GroupName="userState" Style="{StaticResource segmentStyle}" Content="Active"
                                     IsChecked="{Binding IsStateActive, Mode=TwoWay}" />
                        <RadioButton GroupName="userState" Style="{StaticResource segmentStyle}" Content="Pending"
                                     IsChecked="{Binding IsStatePending, Mode=TwoWay}" />
                        <RadioButton GroupName="userState" Style="{StaticResource segmentStyle}" Content="Suspended"
                                     IsChecked="{Binding IsStateSuspended, Mode=TwoWay}" />
                        <RadioButton GroupName="userState" Style="{StaticResource segmentStyle}" Content="Inactive"
                                     IsChecked="{Binding IsStateInactive, Mode=TwoWay}" />
                     </UniformGrid>
                  </Border>

                  <TextBlock Text="A suspended account keeps every setting it has; it simply cannot sign in."
                             Style="{StaticResource fieldHelpStyle}"
                             Margin="2,10,0,0" />
                  <Border Height="1" Margin="0,20" Background="{StaticResource dividerBrush}" />

                  <!-- A user is not an employee, and administrator is not a job title: it is
                       the one switch on the record that decides what the account may do, so
                       it sits beside the state rather than inside the form. -->
                  <TextBlock Text="ADMINISTRATOR" Style="{StaticResource sectionCaptionStyle}" Margin="0,0,0,10" />

                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                     </Grid.ColumnDefinitions>
                     <TextBlock Grid.Column="0"
                                Text="Full access to every module and setting."
                                Style="{StaticResource primaryTextStyle}"
                                TextTrimming="None"
                                TextWrapping="Wrap"
                                Margin="0,0,12,0" />
                     <ToggleButton Grid.Column="1" Style="{StaticResource switchStyle}"
                                   IsChecked="{Binding Data.cUserIsAdmin, Mode=TwoWay}" />
                  </Grid>

                  <!-- The consequence, not the setting: a red panel rather than a grey help
                       line, because this is the only switch on the screen that can hand out
                       everything at once. -->
                  <Border Margin="0,12,0,0"
                          CornerRadius="10"
                          Padding="12,10"
                          Background="{StaticResource dangerChipBrush}">
                     <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <fa:FontAwesome Grid.Column="0"
                                        Icon="Solid_UserShield"
                                        FontSize="12"
                                        Margin="0,1,0,0"
                                        VerticalAlignment="Top"
                                        Foreground="{StaticResource dangerBrush}" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource dangerBrush}"
                                   Text="An administrator bypasses every access rule on the record. Give it only to the people who run the system." />
                     </Grid>
                  </Border>

                  <Border Height="1" Margin="0,20" Background="{StaticResource dividerBrush}" />

                  <TextBlock Text="AT A GLANCE" Style="{StaticResource sectionCaptionStyle}" Margin="0,0,0,12" />

                  <StackPanel>
                     <TextBlock Text="LINKED CONTACT" Style="{StaticResource metaLabelStyle}" />
                     <TextBlock Text="{Binding Data.cContactFullName}" Style="{StaticResource metaValueStyle}" />
                  </StackPanel>

                  <StackPanel Margin="0,14,0,0">
                     <TextBlock Text="LAST SIGN-IN" Style="{StaticResource metaLabelStyle}" />
                     <TextBlock Text="{Binding LastSignInCaption}" Style="{StaticResource metaValueStyle}" />
                  </StackPanel>

                  <!-- Who created or last touched the record is not stored anywhere yet, so these
                       two carry the date alone rather than a name that would have to be made up. -->
                  <StackPanel Margin="0,14,0,0">
                     <TextBlock Text="CREATED" Style="{StaticResource metaLabelStyle}" />
                     <TextBlock Text="{Binding CreatedCaption}" Style="{StaticResource metaValueStyle}" />
                  </StackPanel>

                  <StackPanel Margin="0,14,0,0">
                     <TextBlock Text="LAST UPDATED" Style="{StaticResource metaLabelStyle}" />
                     <TextBlock Text="{Binding LastUpdatedCaption}" Style="{StaticResource metaValueStyle}" />
                  </StackPanel>

                  <Border Height="1" Margin="0,20" Background="{StaticResource dividerBrush}" />

                  <!-- The record's own identifier, kept last and kept quiet: it is never
                       edited, and it only matters when a record has to be pointed at from
                       somewhere else. -->
                  <StackPanel>
                     <TextBlock Text="RECORD ID" Style="{StaticResource metaLabelStyle}" />
                     <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" />
                           <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Data.cUserId}"
                                   FontFamily="Consolas"
                                   FontSize="11.5"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Style="{StaticResource rowActionButtonStyle}"
                                Width="26" Height="26"
                                Command="{Binding Commands[CopyRecordIdCommand]}"
                                ToolTip="Copy to clipboard">
                           <fa:FontAwesome Icon="Solid_Copy" FontSize="11" />
                        </Button>
                     </Grid>
                  </StackPanel>
               </StackPanel>
            </ScrollViewer>
         </Border>

         <!-- ==== working card ====
              Three tabs so a long form never becomes one endless scroll, in the order they
              are needed: who the account is and how it signs in, what it may do, what has
              happened to it. -->
         <Border Grid.Column="1"
                 Margin="18,0,0,0"
                 CornerRadius="14"
                 Background="{StaticResource surfaceBrush}"
                 BorderBrush="{StaticResource outlineBrush}"
                 BorderThickness="1">
            <TabControl Style="{StaticResource editorTabControlStyle}">

               <!-- =====================================================
                    PROFILE
                    Fields in two columns, grouped by what they describe.
                    A section is a caption plus its fields, and the pairs
                    line up because every row is the same two-column grid.
                    ===================================================== -->
               <TabItem Header="Profile">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                     <StackPanel Margin="24,0,24,26">

                        <TextBlock Text="IDENTITY" Style="{StaticResource sectionCaptionStyle}" Margin="0,22,0,12" />

                        <!-- A user is not a person and not an employee. Everything that
                             describes the human being - the name, how to reach them,
                             where they are - belongs to the contact record, and is edited
                             here in place. The only identity this screen owns is the
                             sign-in name. -->
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="20" />
                              <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>

                           <StackPanel Grid.Column="0">
                              <!-- The asterisk is the accent's other job on this screen:
                                   it marks what cannot be left empty. -->
                              <TextBlock Style="{StaticResource fieldLabelStyle}">
                                 <Run Text="Account" />
                                 <Run Text="*" Foreground="{DynamicResource themeAccentBrush}" />
                              </TextBlock>
                              <TextBox Style="{StaticResource fieldBoxStyle}"
                                       Tag="Sign-in name"
                                       Text="{Binding Data.cUserAccount, UpdateSourceTrigger=PropertyChanged}" />
                              <TextBlock Text="Used to sign in. Letters, digits and dots; it has to be unique."
                                         Style="{StaticResource fieldHelpStyle}" />
                           </StackPanel>

                           <!-- The person this account signs in as. Picked from the contact
                                list rather than typed, so an account and a person can never
                                drift apart. -->
                           <StackPanel Grid.Column="2">
                              <TextBlock Style="{StaticResource fieldLabelStyle}">
                                 <Run Text="Linked contact" />
                                 <Run Text="*" Foreground="{DynamicResource themeAccentBrush}" />
                              </TextBlock>
                              <Border Style="{StaticResource pickerFieldStyle}">
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="Auto" />
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="26" Height="26"
                                            CornerRadius="13"
                                            Background="{Binding Data.cContactFullName,
                                                                 Converter={StaticResource avatarPaletteConverter}}"
                                            VerticalAlignment="Center">
                                       <TextBlock Text="{Binding Data.cContactFullName,
                                                                 Converter={StaticResource initialsConverter}}"
                                                  FontSize="10" FontWeight="SemiBold"
                                                  Foreground="{Binding Data.cContactFullName,
                                                                       Converter={StaticResource avatarPaletteConverter},
                                                                       ConverterParameter=Text}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Data.cContactFullName}"
                                               Margin="11,0,0,0"
                                               Style="{StaticResource primaryTextStyle}" />

                                    <Button Grid.Column="2"
                                            Style="{StaticResource rowActionButtonStyle}"
                                            Command="{Binding Commands[PickContactCommand]}"
                                            ToolTip="Pick another contact">
                                       <fa:FontAwesome Icon="Solid_MagnifyingGlass" />
                                    </Button>
                                 </Grid>
                              </Border>
                              <TextBlock Text="The person behind the account. Every field under this one belongs to that contact."
                                         Style="{StaticResource fieldHelpStyle}" />
                           </StackPanel>
                        </Grid>

                        <!-- Three values that belong to the contact rather than to the
                             account, but typed here: this screen writes them straight onto
                             the record it has open. -->
                        <Grid Margin="0,18,0,0">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="20" />
                              <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>

                           <StackPanel Grid.Column="0">
                              <TextBlock Text="Full name" Style="{StaticResource fieldLabelStyle}" />
                              <TextBox Style="{StaticResource fieldBoxStyle}"
                                       Tag="The person's full name"
                                       Text="{Binding Data.cContactFullName, UpdateSourceTrigger=PropertyChanged}" />
                           </StackPanel>

                           <!-- The address is checked while it is typed rather than on save: a
                                field that says what is wrong the moment it is wrong costs the
                                reader one keystroke to fix, while a message raised on save
                                costs a trip back through the form. An empty box says nothing -
                                the e-mail is not required, it only has to be an address when
                                one is given. -->
                           <StackPanel Grid.Column="2">
                              <TextBlock Text="E-mail" Style="{StaticResource fieldLabelStyle}" />
                              <TextBox Style="{StaticResource fieldBoxStyle}"
                                       Tag="Where this person is reached"
                                       shared:FieldValidation.HasError="{Binding HasEmailError}"
                                       Text="{Binding Data.cCommValue, UpdateSourceTrigger=PropertyChanged}" />
                              <TextBlock Text="This does not look like an e-mail address - it needs a name, an @ and a domain, as in someone@example.com."
                                         Style="{StaticResource fieldErrorStyle}"
                                         Visibility="{Binding HasEmailError, Converter={StaticResource boolToVisibility}}" />
                           </StackPanel>
                        </Grid>

                        <!-- The address line takes a street, a city and a country, while the
                             ZIP never grows past a handful of characters, so the two share a
                             row split unevenly instead of the usual pair of equal columns. -->
                        <Grid Margin="0,18,0,0">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="20" />
                              <ColumnDefinition Width="140" />
                           </Grid.ColumnDefinitions>

                           <StackPanel Grid.Column="0">
                              <TextBlock Text="Address" Style="{StaticResource fieldLabelStyle}" />
                              <TextBox Style="{StaticResource fieldBoxStyle}"
                                       Tag="Street, city and country"
                                       Text="{Binding Data.cAddressLocation, UpdateSourceTrigger=PropertyChanged}" />
                           </StackPanel>

                           <!-- Checked the same way as the e-mail, and just as loosely: a postal
                                code has a different shape in every country, so only its length
                                and the characters it is made of are worth refusing. -->
                           <StackPanel Grid.Column="2">
                              <TextBlock Text="ZIP" Style="{StaticResource fieldLabelStyle}" />
                              <TextBox Style="{StaticResource fieldBoxStyle}"
                                       Tag="Postal code"
                                       MaxLength="10"
                                       shared:FieldValidation.HasError="{Binding HasZipError}"
                                       Text="{Binding Data.cAddressZip, UpdateSourceTrigger=PropertyChanged}" />
                              <TextBlock Text="A postal code is 3 to 10 letters or digits, with a space or a dash between them at most."
                                         Style="{StaticResource fieldErrorStyle}"
                                         Visibility="{Binding HasZipError, Converter={StaticResource boolToVisibility}}" />
                           </StackPanel>
                        </Grid>

                        <TextBlock Text="Name, e-mail and address describe the person rather than the account, so changing them here changes them for that contact everywhere."
                                   Style="{StaticResource fieldHelpStyle}"
                                   Margin="2,10,0,0" />

                        <!-- =====================================================
                             SECURITY
                             There is no security tab: at this stage the only credential an
                             account has is a password, and a whole tab holding one field
                             promises more than the system can keep. It lives here instead,
                             directly under the sign-in name it belongs to.
                             ===================================================== -->
                        <TextBlock Text="SECURITY" Style="{StaticResource sectionCaptionStyle}" />

                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="20" />
                              <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>

                           <StackPanel Grid.Column="0">
                              <TextBlock Text="New password" Style="{StaticResource fieldLabelStyle}" />
                              <!-- The reveal button sits over the field rather than inside
                                   its template: a PasswordBox template hosts the editor
                                   and nothing else. -->
                              <!-- A PasswordBox keeps its value out of the property system, so it
                                   is the one field on this screen that cannot be bound. The
                                   handler behind it does nothing but hand the typed text to the
                                   view model, which owns every rule shown underneath. -->
                              <!-- Revealing means swapping editors, not unmasking one: a
                                   PasswordBox never shows its characters. Only one of the two
                                   is ever visible, both sit on the same value in the view
                                   model, and the text box is the one that can bind to it. -->
                              <Grid>
                                 <PasswordBox x:Name="NewPasswordBox"
                                              Style="{StaticResource fieldPasswordStyle}" Padding="14,0,42,0"
                                              PasswordChanged="NewPasswordBox_PasswordChanged"
                                              Visibility="{Binding IsPasswordMasked, Converter={StaticResource boolToVisibility}}" />
                                 <TextBox Style="{StaticResource fieldBoxStyle}" Padding="14,0,42,0"
                                          Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding IsPasswordRevealed, Converter={StaticResource boolToVisibility}}" />
                                 <Button Style="{StaticResource rowActionButtonStyle}"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,7,0"
                                         ToolTip="{Binding PasswordRevealCaption}"
                                         Command="{Binding Commands[TogglePasswordRevealCommand]}">
                                    <fa:FontAwesome FontSize="12">
                                       <fa:FontAwesome.Style>
                                          <!-- The crossed-out eye is what the button will do next,
                                               not what the field is doing now. -->
                                          <Style TargetType="fa:FontAwesome">
                                             <Setter Property="Icon" Value="Solid_Eye" />
                                             <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordRevealed}" Value="True">
                                                   <Setter Property="Icon" Value="Solid_EyeSlash" />
                                                </DataTrigger>
                                             </Style.Triggers>
                                          </Style>
                                       </fa:FontAwesome.Style>
                                    </fa:FontAwesome>
                                 </Button>
                              </Grid>
                           </StackPanel>

                           <StackPanel Grid.Column="2">
                              <TextBlock Text="Repeat password" Style="{StaticResource fieldLabelStyle}" />
                              <!-- The repeat box stays masked whatever the button does: it is
                                   there to catch a typing slip, and reading the first field
                                   back is already enough to check what was typed. -->
                              <PasswordBox x:Name="RepeatPasswordBox"
                                           Style="{StaticResource fieldPasswordStyle}"
                                           PasswordChanged="RepeatPasswordBox_PasswordChanged" />
                           </StackPanel>
                        </Grid>

                        <!-- Strength as four bars rather than a number: it says how far
                             along the password is at a glance, and the caption beside it
                             names what it says. Four bars whatever the rules are: they show
                             how much of the policy is met, not how many rules there are.
                             Gone entirely when the policy has no rules left to report on. -->
                        <Grid Margin="0,16,0,0"
                              Visibility="{Binding IsPasswordPolicyShown, Converter={StaticResource boolToVisibility}}">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                           </Grid.ColumnDefinitions>
                           <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                              <Border Style="{StaticResource strengthBar1Style}" />
                              <Border Style="{StaticResource strengthBar2Style}" />
                              <Border Style="{StaticResource strengthBar3Style}" />
                              <Border Style="{StaticResource strengthBar4Style}" />
                           </StackPanel>
                           <TextBlock Grid.Column="1"
                                      Text="{Binding PasswordStrengthCaption}"
                                      Style="{StaticResource strengthCaptionStyle}" />
                        </Grid>

                        <!-- The rules, each showing whether it is already met. A rule that
                             is still open is grey, not red: nothing has gone wrong yet. -->
                        <!-- One row per rule, and one bar on the meter above per rule met, so the
                             two always agree on how far along the password is. -->
                        <!-- Each row is there only while its rule is in force, so a policy that
                             drops a rule drops the line that promises it too. -->
                        <StackPanel Margin="0,14,0,0">
                           <StackPanel Visibility="{Binding IsMinLengthRuleShown, Converter={StaticResource boolToVisibility}}">
                              <StackPanel.Style>
                                 <Style TargetType="StackPanel" BasedOn="{StaticResource passwordRuleRowStyle}">
                                    <Style.Triggers>
                                       <DataTrigger Binding="{Binding PasswordHasMinLength}" Value="True">
                                          <Setter Property="Opacity" Value="1" />
                                       </DataTrigger>
                                    </Style.Triggers>
                                 </Style>
                              </StackPanel.Style>
                              <fa:FontAwesome Icon="Solid_CircleCheck" FontSize="11"
                                              Foreground="{StaticResource successBrush}" VerticalAlignment="Center" />
                              <!-- The number comes from the policy in force, not from the screen. -->
                              <TextBlock Text="{Binding MinLengthRuleCaption}" Margin="9,0,0,0" FontSize="11.5"
                                         VerticalAlignment="Center" />
                           </StackPanel>

                           <StackPanel Visibility="{Binding IsMixedCaseRuleShown, Converter={StaticResource boolToVisibility}}">
                              <StackPanel.Style>
                                 <Style TargetType="StackPanel" BasedOn="{StaticResource passwordRuleRowStyle}">
                                    <Style.Triggers>
                                       <DataTrigger Binding="{Binding PasswordHasMixedCase}" Value="True">
                                          <Setter Property="Opacity" Value="1" />
                                       </DataTrigger>
                                    </Style.Triggers>
                                 </Style>
                              </StackPanel.Style>
                              <fa:FontAwesome Icon="Solid_CircleCheck" FontSize="11"
                                              Foreground="{StaticResource successBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="Upper and lower case letters" Margin="9,0,0,0" FontSize="11.5"
                                         VerticalAlignment="Center" />
                           </StackPanel>

                           <StackPanel Visibility="{Binding IsDigitRuleShown, Converter={StaticResource boolToVisibility}}">
                              <StackPanel.Style>
                                 <Style TargetType="StackPanel" BasedOn="{StaticResource passwordRuleRowStyle}">
                                    <Style.Triggers>
                                       <DataTrigger Binding="{Binding PasswordHasDigit}" Value="True">
                                          <Setter Property="Opacity" Value="1" />
                                       </DataTrigger>
                                    </Style.Triggers>
                                 </Style>
                              </StackPanel.Style>
                              <fa:FontAwesome Icon="Solid_CircleCheck" FontSize="11"
                                              Foreground="{StaticResource successBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="At least one number" Margin="9,0,0,0" FontSize="11.5"
                                         VerticalAlignment="Center" />
                           </StackPanel>

                           <StackPanel Visibility="{Binding IsSymbolRuleShown, Converter={StaticResource boolToVisibility}}">
                              <StackPanel.Style>
                                 <Style TargetType="StackPanel" BasedOn="{StaticResource passwordRuleRowStyle}">
                                    <Style.Triggers>
                                       <DataTrigger Binding="{Binding PasswordHasSymbol}" Value="True">
                                          <Setter Property="Opacity" Value="1" />
                                       </DataTrigger>
                                    </Style.Triggers>
                                 </Style>
                              </StackPanel.Style>
                              <fa:FontAwesome Icon="Solid_CircleCheck" FontSize="11"
                                              Foreground="{StaticResource successBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="At least one symbol" Margin="9,0,0,0" FontSize="11.5"
                                         VerticalAlignment="Center" />
                           </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                           <Button Style="{StaticResource tonalButtonStyle}"
                                   Command="{Binding Commands[SetPasswordCommand]}">
                              <StackPanel Orientation="Horizontal">
                                 <fa:FontAwesome Icon="Solid_Key" Style="{StaticResource buttonIconStyle}" />
                                 <TextBlock Text="Set password" VerticalAlignment="Center" />
                              </StackPanel>
                           </Button>
                           <TextBlock Text="A password is stored one way only: it can be replaced, never read back."
                                      Margin="16,0,0,0"
                                      FontSize="11.5"
                                      Opacity="0.5"
                                      VerticalAlignment="Center"
                                      TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- =====================================================
                             PREFERENCES
                             Nothing here is stored yet: the landing screen has no column
                             behind it, and Home is the only screen there is. It stays
                             because the choice itself is real, so the day a second screen
                             can be landed on, the field is already in the right place.
                             ===================================================== -->
                        <TextBlock Text="PREFERENCES" Style="{StaticResource sectionCaptionStyle}" />

                        <StackPanel>
                           <TextBlock Text="Landing screen" Style="{StaticResource fieldLabelStyle}" />
                           <ComboBox Style="{StaticResource fieldComboStyle}" HorizontalAlignment="Left"
                                     MinWidth="280"
                                     ItemsSource="{Binding LandingNavigations}"
                                     SelectedItem="{Binding LandingNavigation, Mode=TwoWay}" />
                           <TextBlock Text="Where this user lands right after signing in. Home is the only screen so far."
                                      Style="{StaticResource fieldHelpStyle}" />
                        </StackPanel>

                        <!-- The note belongs to the contact rather than to the account, but
                             unlike the name and the e-mail above it, it is typed here. -->
                        <TextBlock Text="NOTE" Style="{StaticResource sectionCaptionStyle}" />
                        <TextBox Style="{StaticResource fieldMultilineStyle}"
                                 Tag="Anything recorded about how this person is reached"
                                 Text="{Binding Data.cCommNote, UpdateSourceTrigger=PropertyChanged}" />
                     </StackPanel>
                  </ScrollViewer>
               </TabItem>

               <!-- =====================================================
                    ROLES
                    One card per role on the server, each with a switch.
                    A role is how access is given; switching a card only
                    marks the record changed, and Save sends it together
                    with the rest of the form.
                    ===================================================== -->
               <TabItem Header="Roles">
                  <!-- The selected tab paints its header in the accent through Foreground, and the
                       content would inherit it; the theme's text colour is pinned back here. -->
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                TextElement.Foreground="{DynamicResource themeWindowForegroundBrush}">
                     <StackPanel Margin="24,0,24,26">

                        <Grid Margin="0,22,0,12">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                           </Grid.ColumnDefinitions>
                           <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <TextBlock Text="ROLES" Style="{StaticResource sectionCaptionStyle}" Margin="0,0,0,4" />
                              <TextBlock Text="Switch a role on to give it to this account. Changes are saved with the Save button."
                                         Style="{StaticResource fieldHelpStyle}"
                                         Margin="0,0,16,0" />
                           </StackPanel>
                           <!-- The list is dynamic, so it carries its own small refresh button
                                in its top right corner, like every other dynamic card. -->
                           <Button Grid.Column="1"
                                   Style="{StaticResource rowActionButtonStyle}"
                                   VerticalAlignment="Top"
                                   Command="{Binding Commands[RefreshRolesCommand]}"
                                   ToolTip="Reload roles"
                                   AutomationProperties.Name="Reload roles">
                              <fa:FontAwesome Icon="Solid_RotateRight" />
                           </Button>
                        </Grid>

                        <!-- Narrows the cards when there are many roles. It only hides cards: a hidden
                             card keeps its changes and Save still sends them. -->
                        <Grid Margin="0,0,0,12">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" MaxWidth="360" />
                              <ColumnDefinition Width="Auto" />
                           </Grid.ColumnDefinitions>
                           <Border Grid.Column="0"
                                   Height="38"
                                   CornerRadius="19"
                                   Background="{StaticResource surfaceStrongBrush}"
                                   BorderBrush="{StaticResource outlineBrush}"
                                   BorderThickness="1">
                              <Grid Margin="16,0">
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                 </Grid.ColumnDefinitions>
                                 <fa:FontAwesome Grid.Column="0"
                                                 Icon="Solid_MagnifyingGlass"
                                                 FontSize="13"
                                                 Opacity="0.6"
                                                 VerticalAlignment="Center" />
                                 <TextBox Grid.Column="1"
                                          Margin="12,0,0,0"
                                          Tag="Search role name or description"
                                          AutomationProperties.Name="Search roles"
                                          Text="{Binding RoleSearch, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource searchBoxStyle}" />
                              </Grid>
                           </Border>
                           <TextBlock Grid.Column="1"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      FontSize="12"
                                      Opacity="0.6"
                                      Text="{Binding RoleSearchCaption}" />
                        </Grid>

                        <!-- System accounts already hold everything and have no row a role could
                             point to, so their cards are shown but locked. -->
                        <Border Margin="0,0,0,12"
                                CornerRadius="10"
                                Padding="14,11"
                                Background="{StaticResource surfaceStrongBrush}"
                                BorderBrush="{StaticResource outlineBrush}"
                                BorderThickness="1"
                                Visibility="{Binding IsSystemAccount, Converter={StaticResource boolToVisibility}}">
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <fa:FontAwesome Grid.Column="0" Icon="Solid_Lock" FontSize="13"
                                              Foreground="{StaticResource infoBrush}" VerticalAlignment="Top"
                                              Margin="0,1,0,0" />
                              <TextBlock Grid.Column="1" Margin="11,0,0,0" FontSize="12" Opacity="0.75"
                                         TextWrapping="Wrap"
                                         Text="System accounts already hold every permission and cannot be given roles." />
                           </Grid>
                        </Border>

                        <Border Margin="0,0,0,12"
                                CornerRadius="10"
                                Padding="14,10"
                                Background="{StaticResource dangerChipBrush}"
                                BorderBrush="{StaticResource dangerBrush}"
                                BorderThickness="1"
                                Visibility="{Binding HasRolesError, Converter={StaticResource boolToVisibility}}">
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <fa:FontAwesome Grid.Column="0" Icon="Solid_TriangleExclamation" FontSize="13"
                                              Foreground="{StaticResource dangerBrush}" VerticalAlignment="Top"
                                              Margin="0,1,0,0" />
                              <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="12" TextWrapping="Wrap"
                                         Foreground="{StaticResource dangerBrush}">
                                 <Run Text="The roles could not be loaded:" />
                                 <Run Text="{Binding RolesError, Mode=OneWay}" />
                              </TextBlock>
                           </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="2,4,0,12"
                                    Visibility="{Binding IsRolesLoading, Converter={StaticResource boolToVisibility}}">
                           <fa:FontAwesome Icon="Solid_Spinner" Spin="True" FontSize="12" Opacity="0.6"
                                           VerticalAlignment="Center" />
                           <TextBlock Text="Loading roles..." Margin="8,0,0,0" FontSize="12" Opacity="0.6"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="No roles yet. Create one in Role Manager."
                                   Margin="2,4,0,12" FontSize="12" Opacity="0.6"
                                   Visibility="{Binding IsRolesEmpty, Converter={StaticResource boolToVisibility}}" />

                        <TextBlock Text="No role matches the search."
                                   Margin="2,4,0,12" FontSize="12" Opacity="0.6"
                                   Visibility="{Binding IsRoleSearchEmpty, Converter={StaticResource boolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding RoleCards}" Focusable="False">
                           <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                 <WrapPanel />
                              </ItemsPanelTemplate>
                           </ItemsControl.ItemsPanel>
                           <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                 <Border x:Name="card"
                                         Visibility="{Binding IsSearchMatch, Converter={StaticResource boolToVisibility}}"
                                         Width="300"
                                         Margin="0,0,12,12"
                                         Padding="16,14"
                                         CornerRadius="12"
                                         Background="{StaticResource surfaceBrush}"
                                         BorderBrush="{StaticResource outlineBrush}"
                                         BorderThickness="1">
                                    <StackPanel>
                                       <Grid>
                                          <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                          </Grid.ColumnDefinitions>
                                          <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                             <StackPanel Orientation="Horizontal">
                                                <!-- The accent dot marks a card whose change is
                                                     still waiting for Save. -->
                                                <Ellipse x:Name="changedDot" Width="7" Height="7"
                                                         Margin="0,0,7,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource themeAccentBrush}"
                                                         Visibility="Collapsed"
                                                         ToolTip="Not saved yet" />
                                                <TextBlock Text="{Binding RoleName}" FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           ToolTip="{Binding RoleName}" />
                                             </StackPanel>
                                             <WrapPanel Margin="0,6,0,0">
                                                <Border Style="{StaticResource chipMutedStyle}" Margin="0,0,6,4"
                                                        Padding="8,1"
                                                        Visibility="{Binding IsRoleInactive, Converter={StaticResource boolToVisibility}}"
                                                        ToolTip="An inactive role grants nothing until it is made active again.">
                                                   <TextBlock Text="INACTIVE" FontSize="10" />
                                                </Border>
                                                <Border Style="{StaticResource chipWarningStyle}" Margin="0,0,6,4"
                                                        Padding="8,1"
                                                        Visibility="{Binding IsScheduled, Converter={StaticResource boolToVisibility}}">
                                                   <TextBlock Text="{Binding PeriodStateCaption}" FontSize="10" />
                                                </Border>
                                                <Border Style="{StaticResource chipDangerStyle}" Margin="0,0,6,4"
                                                        Padding="8,1"
                                                        Visibility="{Binding IsExpired, Converter={StaticResource boolToVisibility}}">
                                                   <TextBlock Text="{Binding PeriodStateCaption}" FontSize="10" />
                                                </Border>
                                             </WrapPanel>
                                          </StackPanel>
                                          <ToggleButton Grid.Column="1"
                                                        Style="{StaticResource switchStyle}"
                                                        VerticalAlignment="Top"
                                                        IsChecked="{Binding IsAssigned, Mode=TwoWay}"
                                                        IsEnabled="{Binding IsEditable}"
                                                        ToolTip="Give this role to the account"
                                                        AutomationProperties.Name="{Binding RoleName, StringFormat='Give role {0}'}" />
                                       </Grid>

                                       <TextBlock Text="{Binding RoleDescription}"
                                                  Margin="0,4,0,0"
                                                  FontSize="12"
                                                  Opacity="0.75"
                                                  TextWrapping="Wrap"
                                                  TextTrimming="CharacterEllipsis"
                                                  MaxHeight="34"
                                                  ToolTip="{Binding RoleDescription}"
                                                  Visibility="{Binding HasDescription, Converter={StaticResource boolToVisibility}}" />
                                       <TextBlock Text="{Binding ClaimCountCaption}"
                                                  Margin="0,4,0,0"
                                                  FontSize="11"
                                                  Opacity="0.55"
                                                  Visibility="{Binding HasClaimCount, Converter={StaticResource boolToVisibility}}" />

                                       <!-- The period only matters for a role that is on, so the
                                            pickers follow the switch. The pickers name the theme's
                                            text colour themselves: the platform DatePicker style
                                            brings a fixed dark one that vanishes on the dark theme. -->
                                       <Grid Margin="0,12,0,0">
                                          <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="8" />
                                             <ColumnDefinition Width="*" />
                                          </Grid.ColumnDefinitions>
                                          <StackPanel Grid.Column="0">
                                             <TextBlock Text="Start" Style="{StaticResource fieldLabelStyle}" Margin="2,0,0,5" />
                                             <Border x:Name="startFrame" Style="{StaticResource dateFieldStyle}" Height="34"
                                                     IsEnabled="{Binding IsPeriodEnabled}">
                                                <DatePicker Style="{StaticResource inlineDatePickerStyle}"
                                                            Foreground="{DynamicResource themeWindowForegroundBrush}"
                                                            FontSize="12"
                                                            Tag="From now"
                                                            SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                                            AutomationProperties.Name="Role start date" />
                                             </Border>
                                          </StackPanel>
                                          <StackPanel Grid.Column="2">
                                             <TextBlock Text="Expiry" Style="{StaticResource fieldLabelStyle}" Margin="2,0,0,5" />
                                             <Border x:Name="expiryFrame" Style="{StaticResource dateFieldStyle}" Height="34"
                                                     IsEnabled="{Binding IsPeriodEnabled}">
                                                <DatePicker Style="{StaticResource inlineDatePickerStyle}"
                                                            Foreground="{DynamicResource themeWindowForegroundBrush}"
                                                            FontSize="12"
                                                            Tag="No end"
                                                            SelectedDate="{Binding ExpiryDate, Mode=TwoWay}"
                                                            AutomationProperties.Name="Role expiry date" />
                                             </Border>
                                          </StackPanel>
                                       </Grid>
                                       <TextBlock Text="Expiry is before start."
                                                  Style="{StaticResource fieldErrorStyle}"
                                                  Visibility="{Binding HasPeriodError, Converter={StaticResource boolToVisibility}}" />
                                    </StackPanel>
                                 </Border>
                                 <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                       <Setter TargetName="changedDot" Property="Visibility" Value="Visible" />
                                       <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource themeAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasPeriodError}" Value="True">
                                       <Setter TargetName="startFrame" Property="BorderBrush" Value="{StaticResource dangerBrush}" />
                                       <Setter TargetName="expiryFrame" Property="BorderBrush" Value="{StaticResource dangerBrush}" />
                                    </DataTrigger>
                                 </DataTemplate.Triggers>
                              </DataTemplate>
                           </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- A note, not a warning: it explains a rule of the screen rather
                             than reporting that something went wrong. -->
                        <Border Margin="0,4,0,0"
                                CornerRadius="10"
                                Padding="14,11"
                                Background="{StaticResource surfaceStrongBrush}"
                                BorderBrush="{StaticResource outlineBrush}"
                                BorderThickness="1">
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <fa:FontAwesome Grid.Column="0" Icon="Solid_CircleInfo" FontSize="13"
                                              Foreground="{StaticResource infoBrush}" VerticalAlignment="Top"
                                              Margin="0,1,0,0" />
                              <TextBlock Grid.Column="1"
                                         Margin="11,0,0,0"
                                         FontSize="12"
                                         Opacity="0.75"
                                         TextWrapping="Wrap"
                                         Text="Access rules are read when a user signs in. Anything changed here takes effect the next time this account signs in." />
                           </Grid>
                        </Border>
                     </StackPanel>
                  </ScrollViewer>
               </TabItem>

               <!-- =====================================================
                    ACTIVITY
                    What has happened to this account, newest first. Read
                    only by nature: the tab answers "who changed this and
                    when", which is the question a record like this gets
                    asked most often after something goes wrong.
                    ===================================================== -->
               <TabItem Header="Activity">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                     <StackPanel Margin="24,0,24,26">

                        <Grid Margin="0,22,0,14">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                           </Grid.ColumnDefinitions>
                           <TextBlock Grid.Column="0" Text="RECENT ACTIVITY"
                                      Style="{StaticResource sectionCaptionStyle}" Margin="0"
                                      VerticalAlignment="Center" />
                           <ComboBox Grid.Column="1" Style="{StaticResource fieldComboStyle}"
                                     Height="34" MinWidth="150" SelectedIndex="0" FontSize="12">
                              <ComboBoxItem Content="Last 30 days" />
                              <ComboBoxItem Content="Last 90 days" />
                              <ComboBoxItem Content="Everything" />
                           </ComboBox>
                        </Grid>

                        <!-- entry 1 -->
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="22" />
                              <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>
                           <Grid Grid.Column="0">
                              <Border Style="{StaticResource timelineRuleStyle}" />
                              <Border Style="{StaticResource timelineDotStyle}"
                                      Background="{DynamicResource themeAccentBrush}" />
                           </Grid>
                           <StackPanel Grid.Column="1" Margin="12,0,0,22">
                              <TextBlock Text="Role changed to Sales Manager" Style="{StaticResource primaryTextStyle}"
                                         FontWeight="SemiBold" />
                              <TextBlock Text="09 Sep 2026, 09:14 - by Budi Santoso"
                                         Style="{StaticResource secondaryTextStyle}" Margin="0,3,0,0" />
                           </StackPanel>
                        </Grid>

                        <!-- entry 2 -->
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="22" />
                              <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>
                           <Grid Grid.Column="0">
                              <Border Style="{StaticResource timelineRuleStyle}" />
                              <Border Style="{StaticResource timelineDotStyle}" />
                           </Grid>
                           <StackPanel Grid.Column="1" Margin="12,0,0,22">
                              <TextBlock Text="Signed in from Em Desktop" Style="{StaticResource primaryTextStyle}" />
                              <TextBlock Text="09 Sep 2026, 08:41 - 192.0.2.24, Jakarta"
                                         Style="{StaticResource secondaryTextStyle}" Margin="0,3,0,0" />
                           </StackPanel>
                        </Grid>

                        <!-- entry 3 -->
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="22" />
                              <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>
                           <Grid Grid.Column="0">
                              <Border Style="{StaticResource timelineRuleStyle}" />
                              <Border Style="{StaticResource timelineDotStyle}"
                                      Background="{StaticResource warningBrush}" />
                           </Grid>
                           <StackPanel Grid.Column="1" Margin="12,0,0,22">
                              <TextBlock Text="Password reset link sent" Style="{StaticResource primaryTextStyle}" />
                              <TextBlock Text="02 Sep 2026, 11:07 - by Budi Santoso"
                                         Style="{StaticResource secondaryTextStyle}" Margin="0,3,0,0" />
                           </StackPanel>
                        </Grid>

                        <!-- entry 4 -->
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="22" />
                              <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>
                           <Grid Grid.Column="0">
                              <Border Style="{StaticResource timelineRuleStyle}" />
                              <Border Style="{StaticResource timelineDotStyle}"
                                      Background="{StaticResource dangerBrush}" />
                           </Grid>
                           <StackPanel Grid.Column="1" Margin="12,0,0,22">
                              <TextBlock Text="Three failed sign-in attempts" Style="{StaticResource primaryTextStyle}" />
                              <TextBlock Text="28 Aug 2026, 22:19 - 198.51.100.9, Bandung"
                                         Style="{StaticResource secondaryTextStyle}" Margin="0,3,0,0" />
                           </StackPanel>
                        </Grid>

                        <!-- The last entry drops the rule: there is nothing under it for
                             the line to reach. -->
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="22" />
                              <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>
                           <Border Grid.Column="0" Style="{StaticResource timelineDotStyle}"
                                   Background="{StaticResource successBrush}" />
                           <StackPanel Grid.Column="1" Margin="12,0,0,0">
                              <TextBlock Text="Account created" Style="{StaticResource primaryTextStyle}" />
                              <TextBlock Text="14 Feb 2025, 10:02 - by Budi Santoso"
                                         Style="{StaticResource secondaryTextStyle}" Margin="0,3,0,0" />
                           </StackPanel>
                        </Grid>

                        <Button Style="{StaticResource outlinedButtonStyle}"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Left"
                                Content="Load older activity" />
                     </StackPanel>
                  </ScrollViewer>
               </TabItem>
            </TabControl>
         </Border>
      </Grid>

      <!-- Spans both rows so the tool strip is covered too: saving is exactly when the
           buttons on it must not be pressed a second time. -->
      <controls:WaitOverlay Grid.Row="0" Grid.RowSpan="2"
                         IsWaiting="{Binding InWaiting}"
                         Caption="{Binding WaiterText}" />
   </Grid>
</UserControl>
