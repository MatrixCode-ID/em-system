<UserControl x:Class="Em.Ui.Wpf.Navigations.BusinessTaskManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Em.Ui.Wpf.Navigations"
             xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200">
   <UserControl.DataContext>
      <local:BusinessTaskManagerVm />
   </UserControl.DataContext>

   <UserControl.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <!-- ==== status cell ==== -->
         <Style x:Key="statusIconStyle" TargetType="fa:FontAwesome">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.7" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding Status}" Value="Running">
                  <Setter Property="Spin" Value="True" />
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Foreground" Value="{DynamicResource themeAccentBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Status}" Value="Succeeded">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Foreground" Value="{StaticResource successBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Status}" Value="Failed">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Foreground" Value="{StaticResource dangerBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <Style x:Key="statusDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource secondaryCellStyle}">
            <Setter Property="Text" Value="{Binding Caption}" />
            <Setter Property="ToolTip" Value="{Binding Caption}" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding IsFailed}" Value="True">
                  <Setter Property="Text" Value="{Binding ErrorMessage}" />
                  <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                  <Setter Property="Foreground" Value="{StaticResource dangerBrush}" />
                  <Setter Property="Opacity" Value="1" />
               </DataTrigger>
            </Style.Triggers>
         </Style>
      </ResourceDictionary>
   </UserControl.Resources>

   <Grid>
      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
         </Grid.RowDefinitions>

         <!-- ==== limit card ==== -->
         <Border Grid.Row="0" Margin="22,12,22,0" Padding="22,16" Style="{StaticResource cardStyle}">
            <Grid>
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
               </Grid.ColumnDefinitions>

               <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                  <TextBlock Text="CONCURRENCY LIMIT" Style="{StaticResource sectionCaptionStyle}" />
                  <TextBlock Margin="0,6,0,0" Text="{Binding LimitHint}" Style="{StaticResource fieldHelpStyle}" />
               </StackPanel>

               <ComboBox Grid.Column="1"
                         Width="180"
                         Style="{StaticResource fieldComboStyle}"
                         IsEnabled="{Binding IsAdmin}"
                         ItemsSource="{Binding LimitModes}"
                         DisplayMemberPath="Caption"
                         SelectedValuePath="Mode"
                         SelectedValue="{Binding LimitMode}" />
               <controls:NumericBox Grid.Column="2"
                                    Width="120"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource fieldNumericBoxStyle}"
                                    IsEnabled="{Binding IsAdmin}"
                                    Minimum="1"
                                    Maximum="1000"
                                    Value="{Binding LimitValue}" />
               <Button Grid.Column="3"
                       Margin="14,0,0,0"
                       Style="{StaticResource filledButtonStyle}"
                       Visibility="{Binding IsAdmin, Converter={StaticResource boolToVisibility}}"
                       Command="{Binding Commands[SaveLimitCommand]}">
                  <StackPanel Orientation="Horizontal">
                     <fa:FontAwesome Icon="Solid_FloppyDisk" Style="{StaticResource buttonIconStyle}" />
                     <TextBlock Text="Save" VerticalAlignment="Center" />
                  </StackPanel>
               </Button>
            </Grid>
         </Border>

         <!-- ==== toolbar ==== -->
         <Grid Grid.Row="1" Margin="24,18,22,8">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="TASKS"
                       VerticalAlignment="Center"
                       Style="{StaticResource sectionCaptionStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
               <Border Style="{StaticResource chipStyle}">
                  <TextBlock Text="{Binding SummaryCaption}" />
               </Border>
               <Button Style="{StaticResource rowActionButtonStyle}"
                       Margin="10,0,0,0"
                       Command="{Binding Commands[RefreshCommand]}"
                       ToolTip="Refresh">
                  <fa:FontAwesome Icon="Solid_ArrowsRotate" />
               </Button>
            </StackPanel>
         </Grid>

         <!-- ==== list card ==== -->
         <Border Grid.Row="2" Margin="22,0,22,22" Style="{StaticResource cardStyle}">
            <Grid Grid.IsSharedSizeScope="True">
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
               </Grid.RowDefinitions>

               <Border Grid.Row="0"
                       Background="{StaticResource surfaceStrongBrush}"
                       BorderBrush="{StaticResource dividerBrush}"
                       BorderThickness="0,0,0,1"
                       CornerRadius="13,13,0,0">
                  <Grid Margin="24,0,20,0" Height="38">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="colScope" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="colOwner" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="colStatus" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="colStarted" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="colFinished" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="colActions" />
                     </Grid.ColumnDefinitions>

                     <TextBlock Grid.Column="0" Text="TASK" Style="{StaticResource columnHeaderStyle}" />
                     <TextBlock Grid.Column="1" Text="SCOPE" MinWidth="80" Margin="20,0,0,0"
                                Style="{StaticResource columnHeaderStyle}" />
                     <TextBlock Grid.Column="2" Text="OWNER" MinWidth="150" Margin="20,0,0,0"
                                Style="{StaticResource columnHeaderStyle}" />
                     <TextBlock Grid.Column="3" Text="STATUS" Width="240" Margin="20,0,0,0"
                                Style="{StaticResource columnHeaderStyle}" />
                     <TextBlock Grid.Column="4" Text="STARTED" MinWidth="130" Margin="20,0,0,0"
                                Style="{StaticResource columnHeaderStyle}" />
                     <TextBlock Grid.Column="5" Text="FINISHED" MinWidth="130" Margin="20,0,0,0"
                                Style="{StaticResource columnHeaderStyle}" />
                     <Border Grid.Column="6" MinWidth="108" Margin="16,0,0,0" />
                  </Grid>
               </Border>

               <ScrollViewer Grid.Row="1"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Tasks}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                           <Grid>
                              <Grid.RowDefinitions>
                                 <RowDefinition Height="*" />
                                 <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>

                              <Border x:Name="stateLayer" Grid.Row="0" Background="Transparent" MinHeight="56">
                                 <Grid Margin="24,8,20,8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="Auto" SharedSizeGroup="colScope" />
                                       <ColumnDefinition Width="Auto" SharedSizeGroup="colOwner" />
                                       <ColumnDefinition Width="Auto" SharedSizeGroup="colStatus" />
                                       <ColumnDefinition Width="Auto" SharedSizeGroup="colStarted" />
                                       <ColumnDefinition Width="Auto" SharedSizeGroup="colFinished" />
                                       <ColumnDefinition Width="Auto" SharedSizeGroup="colActions" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                       <TextBlock Style="{StaticResource primaryCellStyle}"
                                                  Text="{Binding Title}"
                                                  ToolTip="{Binding Title}" />
                                       <TextBlock Margin="0,2,0,0" Style="{StaticResource secondaryCellStyle}"
                                                  FontFamily="Consolas"
                                                  ToolTip="{Binding Key}">
                                          <Run Text="{Binding ModuleName, Mode=OneWay}" />
                                          <Run Text="·" />
                                          <Run Text="{Binding Key, Mode=OneWay}" />
                                          <Run Text="·" />
                                          <Run Text="{Binding OutputCaption, Mode=OneWay}" />
                                       </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="1" MinWidth="80" Margin="20,0,0,0">
                                       <Border Style="{StaticResource chipMutedStyle}">
                                          <TextBlock Text="{Binding ScopeCaption}" />
                                       </Border>
                                    </Border>

                                    <TextBlock Grid.Column="2" MinWidth="150" MaxWidth="220" Margin="20,0,0,0"
                                               Style="{StaticResource secondaryCellStyle}"
                                               Text="{Binding OwnerName}"
                                               ToolTip="{Binding OwnerName}" />

                                    <StackPanel Grid.Column="3" Width="240" Margin="20,0,0,0" VerticalAlignment="Center">
                                       <StackPanel Orientation="Horizontal">
                                          <fa:FontAwesome Icon="{Binding StatusIcon}" Style="{StaticResource statusIconStyle}" />
                                          <TextBlock Style="{StaticResource primaryCellStyle}" Text="{Binding StatusCaption}" />
                                       </StackPanel>
                                       <ProgressBar Style="{StaticResource hairlineProgressStyle}"
                                                    Value="{Binding Percent, Mode=OneWay}"
                                                    IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                    Visibility="{Binding IsAlive, Converter={StaticResource boolToVisibility}}" />
                                       <TextBlock Style="{StaticResource statusDetailStyle}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" MinWidth="130" Margin="20,0,0,0"
                                               Style="{StaticResource secondaryCellStyle}"
                                               Text="{Binding StartedCaption}" />
                                    <TextBlock Grid.Column="5" MinWidth="130" Margin="20,0,0,0"
                                               Style="{StaticResource secondaryCellStyle}"
                                               Text="{Binding FinishedCaption}" />

                                    <StackPanel Grid.Column="6"
                                                MinWidth="108"
                                                Margin="16,0,0,0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                       <Button Style="{StaticResource rowActionButtonStyle}"
                                               ToolTip="Download result"
                                               Visibility="{Binding CanDownload, Converter={StaticResource boolToVisibility}}"
                                               Command="{Binding DataContext.Commands[DownloadResultCommand],
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}">
                                          <fa:FontAwesome Icon="Solid_Download" />
                                       </Button>
                                       <Button Style="{StaticResource rowActionButtonStyle}"
                                               ToolTip="Cancel task"
                                               Visibility="{Binding CanCancel, Converter={StaticResource boolToVisibility}}"
                                               Command="{Binding DataContext.Commands[CancelTaskCommand],
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}">
                                          <fa:FontAwesome Icon="Solid_Xmark" Foreground="{StaticResource dangerBrush}" />
                                       </Button>
                                       <Button Style="{StaticResource rowActionButtonStyle}"
                                               ToolTip="Clear task"
                                               Visibility="{Binding CanClear, Converter={StaticResource boolToVisibility}}"
                                               Command="{Binding DataContext.Commands[ClearTaskCommand],
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}">
                                          <fa:FontAwesome Icon="Solid_Broom" />
                                       </Button>
                                    </StackPanel>
                                 </Grid>
                              </Border>

                              <Border Grid.Row="1" Height="1" Background="{StaticResource dividerBrush}" />
                           </Grid>
                           <DataTemplate.Triggers>
                              <Trigger SourceName="stateLayer" Property="IsMouseOver" Value="True">
                                 <Setter TargetName="stateLayer" Property="Background"
                                         Value="{StaticResource stateHoverBrush}" />
                              </Trigger>
                           </DataTemplate.Triggers>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>

               <StackPanel Grid.Row="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource boolToVisibility}}">
                  <fa:FontAwesome Icon="Solid_ListCheck"
                                  FontSize="34"
                                  Opacity="0.35"
                                  HorizontalAlignment="Center" />
                  <TextBlock Text="No business task on the server"
                             Margin="0,14,0,0"
                             FontSize="15"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="Long-running work started by modules appears here while it runs."
                             Margin="0,4,0,0"
                             Style="{StaticResource secondaryCellStyle}"
                             HorizontalAlignment="Center" />
               </StackPanel>
            </Grid>
         </Border>
      </Grid>

      <controls:WaitOverlay IsWaiting="{Binding InWaiting}" Caption="{Binding WaiterText}" />
   </Grid>
</UserControl>
