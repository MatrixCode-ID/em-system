<UserControl x:Class="Em.Ui.Wpf.Navigations.RoleManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Em.Ui.Wpf.Navigations"
             xmlns:conv="clr-namespace:Em.Ui.Wpf.Converters"
             xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
             xmlns:shared="clr-namespace:Em.Ui.Wpf.Shared"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             Foreground="{DynamicResource themeWindowForegroundBrush}"
             TextElement.Foreground="{DynamicResource themeWindowForegroundBrush}"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1320">
   <UserControl.DataContext>
      <local:RoleManagerVm/>
   </UserControl.DataContext>

   <!--
      Role manager screen: a master-detail workspace. The rail on the left lists the roles,
      the pane on the right shows the one that is selected - what it may do, who carries it,
      and what is recorded about it. A role is only worth anything through its permissions
      and its members, so a plain one-row-per-role table would leave the whole subject of the
      screen off the page; the split is what puts a role and its consequences side by side.

      As on the user manager there is no screen title here: the host draws the title and the
      subtitle in its own navigation bar directly above this control, so a title of our own
      would put the same caption on screen twice.

      Nothing inside a role is written as it is edited. What is being changed here is what
      people are allowed to do, so a claim taken away by a slip of the mouse must not leave
      for the server on its own: the view model holds the role as it was opened and the role
      as it is wanted, and the action bar at the foot of the pane is what sends the difference.
      That is why the check marks, the row buttons and the member list all bind to plain view
      model state and none of them carries a command that writes.

      Two rules keep the design working on both the light and the dark theme:

      - every surface, outline and divider is a translucent grey (#xx808080), which darkens
        a light background and lightens a dark one without naming a theme colour;
      - the one colour taken from the theme is the accent, read through the Em
        theme token themeAccentBrush, so the primary button, the selection marker and the current tab all
        follow the theme.
   -->

   <UserControl.Resources>
      <ResourceDictionary>
         <!-- The shared design language: the palette, the text roles, the buttons, the chips,
              the inputs, the cards, the tabs and the side sheet. Everything below is what is
              really this screen's own. -->
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <!-- A role is not a person, so it carries an emblem rather than initials, and the tint
              is what tells two roles apart at a glance down the rail. Neither is stored: the
              glyph comes from the row's own icon token and the colour is worked out from its
              name, so the same role is the same colour wherever it is drawn. -->
         <conv:UiIconConverter x:Key="uiIconConverter" />
         <conv:EntityTintConverter x:Key="entityTintConverter" />

         <!-- A member is a person, so that disc keeps the initials the user list uses. -->
         <conv:InitialsConverter x:Key="initialsConverter" />
         <conv:AvatarPaletteConverter x:Key="avatarPaletteConverter" />

         <!-- Sepasang dengan boolToVisibility milik Cards.xaml: dua sisi dari satu keadaan, mis.
              nama yang tampil saat diam dan isian yang menggantikannya saat diedit. -->
         <conv:InverseBoolToVisibilityConverter x:Key="inverseBoolToVisibility" />

         <!-- ============================================================
              ROLE EMBLEM
              A tinted disc carrying one glyph.
              ============================================================ -->
         <Style x:Key="roleEmblemStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
         </Style>

         <Style x:Key="roleEmblemIconStyle" TargetType="fa:FontAwesome">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
         </Style>

         <!-- The same emblem at the head of the detail pane, where it stands for the whole
              record rather than for one row. -->
         <Style x:Key="roleEmblemLargeStyle" TargetType="Border" BasedOn="{StaticResource roleEmblemStyle}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="17" />
         </Style>

         <Style x:Key="memberAvatarStyle" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
         </Style>

         <Style x:Key="memberAvatarTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
         </Style>

         <!-- ============================================================
              ROLE RAIL ROW
              A row is a ListBoxItem: hover and selection are state layers
              over a transparent surface, and selection additionally shows
              an accent bar on the leading edge. The divider belongs to the
              row template, so the last row keeps it too - that is what
              closes the list off against the footer.
              ============================================================ -->
         <Style x:Key="roleRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                     <Grid>
                        <Grid.RowDefinitions>
                           <RowDefinition Height="*" />
                           <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="stateLayer" Grid.Row="0" Background="Transparent" MinHeight="64">
                           <Grid>
                              <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <!-- Selection marker: a 3px accent bar, hidden at rest. -->
                              <Border x:Name="selectionBar"
                                      Grid.Column="0"
                                      Width="3"
                                      Margin="0,9"
                                      CornerRadius="2"
                                      Visibility="Hidden"
                                      Background="{DynamicResource themeAccentBrush}" />
                              <ContentPresenter Grid.Column="1"
                                                Margin="15,0,14,0"
                                                VerticalAlignment="Center" />
                           </Grid>
                        </Border>

                        <Border Grid.Row="1" Height="1" Background="{StaticResource dividerBrush}" />
                     </Grid>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="stateLayer" Property="Background"
                                   Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                           <Setter TargetName="stateLayer" Property="Background"
                                   Value="{StaticResource statePressedBrush}" />
                           <Setter TargetName="selectionBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- ============================================================
              EMPTY STATES
              A list with nothing in it says what is missing and what to do
              about it, rather than leaving a blank card that reads like a
              screen that failed to load.
              ============================================================ -->
         <Style x:Key="emptyStateTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.75" />
         </Style>

         <Style x:Key="emptyStateNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource fieldHelpStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Margin" Value="0,6,0,0" />
         </Style>

         <!-- The line above a row inside a folded group. It is hidden on the first row, which is
              what keeps it a divider between rows rather than a line under the group header that
              already draws one of its own. PreviousData is null only for the first item. -->
         <Style x:Key="listRowDividerStyle" TargetType="Border" BasedOn="{StaticResource rowDividerStyle}">
            <Style.Triggers>
               <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

      </ResourceDictionary>
   </UserControl.Resources>

   <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- =========================================================
           TOOLBAR - tools only, no screen title
           Actions on the left in the order they are used, the counters
           on the right, which keeps the strip readable when the window
           is narrow: the buttons never move.

           Searching and filtering are not here. Each of the three lists
           on this screen is searched in its own place - the roles in the
           rail, the modules and the members inside their own tab - so a
           single search box up here would have to guess which of them
           the caret meant.
           ========================================================= -->
      <Grid Grid.Row="0" Margin="22,12,22,10">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>

         <!-- The primary action leads the strip and is the only filled button here. There is no
              dialog behind it: the new role appears as a draft row at the top of the rail and is
              only born in the database when it is saved. -->
         <Button Grid.Column="0"
                 Style="{StaticResource filledButtonStyle}"
                 Command="{Binding Commands[NewRoleCommand]}"
                 ToolTip="Create a new role">
            <StackPanel Orientation="Horizontal">
               <fa:FontAwesome Icon="Solid_ShieldHalved" Style="{StaticResource buttonIconStyle}" />
               <TextBlock Text="New Role" VerticalAlignment="Center" />
            </StackPanel>
         </Button>

         <!-- Separator: what creates a record on one side, what acts on the records that
              already exist on the other. -->
         <Border Grid.Column="1"
                 Width="1"
                 Height="22"
                 Margin="14,0"
                 VerticalAlignment="Center"
                 Background="{StaticResource outlineBrush}" />

         <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Copying an existing role is how most new roles are really made: start from the
                 one that is nearly right, then take a few permissions away. It lands as a draft
                 too, so the copy can be corrected before anybody can be given it. -->
            <Button Style="{StaticResource outlinedButtonStyle}"
                    Command="{Binding Commands[DuplicateRoleCommand]}"
                    ToolTip="Create a copy of the selected role, as a draft">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_Copy" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Duplicate" VerticalAlignment="Center" />
               </StackPanel>
            </Button>

            <Button Style="{StaticResource outlinedButtonStyle}" Margin="8,0,0,0"
                    IsEnabled="False"
                    ToolTip="Not built yet: exporting the roles and their permissions to a file">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_FileExport" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Export" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
         </StackPanel>

         <!-- How much there is. Both counters come from the same reload the rail is filled
              from, so neither can drift away from what the screen is showing. -->
         <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource chipStyle}">
               <TextBlock Text="{Binding TotalCaption}" />
            </Border>
            <Border Style="{StaticResource chipStyle}" Margin="8,0,0,0">
               <TextBlock Text="{Binding AssignmentCaption}" />
            </Border>
         </StackPanel>
      </Grid>

      <!-- =========================================================
           BODY - the rail and the detail pane, each in its own card
           The splitter between them is a plain WPF GridSplitter, so the
           reader can give the rail more room for long role names without
           anything behind it.
           ========================================================= -->
      <Grid Grid.Row="1" Margin="22,0,22,22">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="520" />
         </Grid.ColumnDefinitions>

         <!-- =====================================================
              ROLE RAIL
              Search, then the facet, then the roles themselves: the
              two controls that decide what the list holds sit above
              the list they decide.

              The search box and the facet are drawn but not bound.
              Filtering a list that is paged on the server means a
              query the server does not offer yet, and hiding the two
              controls until it does would mean drawing the head of
              the rail twice - see usermanager-filter-ui-design.md.
              ===================================================== -->
         <Border Grid.Column="0" Style="{StaticResource cardStyle}">
            <Grid>
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
               </Grid.RowDefinitions>

               <Border Grid.Row="0" Style="{StaticResource searchFieldStyle}" Margin="12,12,12,0">
                  <Grid Margin="14,0">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>

                     <fa:FontAwesome Grid.Column="0"
                                     Icon="Solid_MagnifyingGlass"
                                     FontSize="12"
                                     Opacity="0.6"
                                     VerticalAlignment="Center" />

                     <TextBox Grid.Column="1"
                              Margin="11,0,0,0"
                              Tag="Search role"
                              Style="{StaticResource searchBoxStyle}" />
                  </Grid>
               </Border>

               <Grid Grid.Row="1" Margin="12,10,12,10">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- A role is either in use or switched off, and the two are rarely wanted
                       together, so the facet is worth a permanent control rather than a sheet. -->
                  <Border Grid.Column="0"
                          CornerRadius="15"
                          Padding="2"
                          HorizontalAlignment="Left"
                          Background="{StaticResource surfaceBrush}"
                          BorderBrush="{StaticResource outlineBrush}"
                          BorderThickness="1">
                     <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="roleQuickFilter" Style="{StaticResource segmentStyle}"
                                     Content="All" IsChecked="True" />
                        <RadioButton GroupName="roleQuickFilter" Style="{StaticResource segmentStyle}"
                                     Content="In use" />
                        <RadioButton GroupName="roleQuickFilter" Style="{StaticResource segmentStyle}"
                                     Content="Disabled" />
                     </StackPanel>
                  </Border>

                  <Button Grid.Column="1"
                          Style="{StaticResource rowActionButtonStyle}"
                          IsEnabled="False"
                          ToolTip="Not built yet: sorting and list options">
                     <fa:FontAwesome Icon="Solid_EllipsisVertical" />
                  </Button>
               </Grid>

               <!-- Chrome is stripped from the ListBox so the card border stays the only frame
                    around the rows. One row is one role: its emblem, its name, the sentence
                    that says what it is for, and how many accounts carry it.

                    A draft sits at the top of this list like any other row. It has no name yet,
                    so the row says what it is instead of showing an empty line, and it has no
                    members to count because it has no id for anybody to be assigned to. -->
               <ListBox Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding Roles}"
                        SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource roleRowStyle}">
                  <ListBox.ItemTemplate>
                     <DataTemplate>
                        <Grid x:Name="row">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                           </Grid.ColumnDefinitions>

                           <Border Grid.Column="0" Style="{StaticResource roleEmblemStyle}"
                                   Background="{Binding cRoleName, Converter={StaticResource entityTintConverter}}">
                              <fa:FontAwesome Style="{StaticResource roleEmblemIconStyle}"
                                              Icon="{Binding EffectiveUiIcon, Converter={StaticResource uiIconConverter}}"
                                              Foreground="{Binding cRoleName,
                                                                   Converter={StaticResource entityTintConverter},
                                                                   ConverterParameter=Text}" />
                           </Border>

                           <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                              <TextBlock x:Name="rowName" Text="{Binding cRoleName}" FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis"
                                         Style="{StaticResource primaryCellStyle}"
                                         ToolTip="{Binding cRoleName}" />
                              <TextBlock x:Name="rowNote" Text="{Binding cRoleDescription}"
                                         Margin="0,2,0,0"
                                         TextTrimming="CharacterEllipsis"
                                         Style="{StaticResource secondaryCellStyle}" />
                           </StackPanel>

                           <StackPanel x:Name="rowMembers" Grid.Column="2" Orientation="Horizontal"
                                       VerticalAlignment="Center">
                              <fa:FontAwesome Icon="Solid_User" FontSize="10" Opacity="0.5"
                                              VerticalAlignment="Center" Margin="0,0,5,0" />
                              <TextBlock Text="{Binding MemberCount}" Style="{StaticResource secondaryCellStyle}" />
                           </StackPanel>

                           <!-- A role nobody may be given any more keeps its members - they are
                                history, not a mistake - so the row is dimmed rather than hidden,
                                and the chip says which of the two it is. -->
                           <Border x:Name="rowOffChip" Grid.Column="2"
                                   Style="{StaticResource chipMutedStyle}"
                                   Visibility="Collapsed">
                              <TextBlock Text="OFF" />
                           </Border>
                        </Grid>

                        <DataTemplate.Triggers>
                           <DataTrigger Binding="{Binding cRoleState}" Value="Disabled">
                              <Setter TargetName="row" Property="Opacity" Value="0.6" />
                              <Setter TargetName="rowMembers" Property="Visibility" Value="Collapsed" />
                              <Setter TargetName="rowOffChip" Property="Visibility" Value="Visible" />
                           </DataTrigger>

                           <!-- A role name is unique and never empty, so an empty one can only be
                                a draft nobody has typed a name into yet. -->
                           <DataTrigger Binding="{Binding cRoleName}" Value="">
                              <Setter TargetName="rowName" Property="Text" Value="New role" />
                              <Setter TargetName="rowName" Property="Opacity" Value="0.55" />
                           </DataTrigger>

                           <DataTrigger Binding="{Binding IsBlank}" Value="True">
                              <Setter TargetName="rowNote" Property="Text" Value="Not saved yet" />
                              <Setter TargetName="rowMembers" Property="Visibility" Value="Collapsed" />
                              <Setter TargetName="rowOffChip" Property="Visibility" Value="Collapsed" />
                           </DataTrigger>
                        </DataTemplate.Triggers>
                     </DataTemplate>
                  </ListBox.ItemTemplate>
               </ListBox>

               <!-- Nothing to list at all. Drawn over the list rather than instead of it, so the
                    rail keeps its shape and the message sits where the rows would be. -->
               <StackPanel Grid.Row="2"
                           Margin="24,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasNoRole, Converter={StaticResource boolToVisibility}}">
                  <fa:FontAwesome Icon="Solid_ShieldHalved" FontSize="26" Opacity="0.25"
                                  HorizontalAlignment="Center" Margin="0,0,0,14" />
                  <TextBlock Text="No role yet" Style="{StaticResource emptyStateTitleStyle}" />
                  <TextBlock Text="A role gathers a set of permissions that several accounts can carry at once. Start one with New Role."
                             Style="{StaticResource emptyStateNoteStyle}" />
               </StackPanel>

               <!-- ==== rail footer: how much of the list is on screen ==== -->
               <Border Grid.Row="3"
                       BorderBrush="{StaticResource dividerBrush}"
                       BorderThickness="0,1,0,0">
                  <Grid Margin="14,8,10,8">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                     </Grid.ColumnDefinitions>

                     <TextBlock Grid.Column="0"
                                Text="{Binding RailCaption}"
                                VerticalAlignment="Center"
                                Style="{StaticResource secondaryCellStyle}" />

                     <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource rowActionButtonStyle}"
                                Command="{Binding Commands[PreviousPageCommand]}"
                                ToolTip="Previous page">
                           <fa:FontAwesome Icon="Solid_ChevronLeft" />
                        </Button>
                        <Button Style="{StaticResource rowActionButtonStyle}"
                                Command="{Binding Commands[NextPageCommand]}"
                                ToolTip="Next page">
                           <fa:FontAwesome Icon="Solid_ChevronRight" />
                        </Button>
                     </StackPanel>
                  </Grid>
               </Border>
            </Grid>
         </Border>

         <!-- The splitter is a column of its own rather than an overlay, so the gap between
              the two cards is the grip: nothing is covered and nothing has to move. -->
         <GridSplitter Grid.Column="1"
                       Width="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Stretch"
                       Background="Transparent"
                       ShowsPreview="False"
                       ResizeDirection="Columns"
                       ResizeBehavior="PreviousAndNext" />

         <!-- =====================================================
              DETAIL PANE
              The record header, then the three faces of a role - what
              it may do, who carries it, what is recorded about it -
              then the bar that saves or discards whatever was changed
              in them.
              ===================================================== -->
         <Border Grid.Column="2" Style="{StaticResource cardStyle}">
            <Grid>
               <!-- Nothing open: the pane says so rather than showing an empty record. -->
               <StackPanel Margin="32,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSelectedRole, Converter={StaticResource inverseBoolToVisibility}}">
                  <fa:FontAwesome Icon="Solid_HandPointer" FontSize="26" Opacity="0.25"
                                  HorizontalAlignment="Center" Margin="0,0,0,14" />
                  <TextBlock Text="No role is open" Style="{StaticResource emptyStateTitleStyle}" />
                  <TextBlock Text="Pick a role in the list on the left to see what it may do and who carries it."
                             Style="{StaticResource emptyStateNoteStyle}" />
               </StackPanel>

               <Grid Visibility="{Binding HasSelectedRole, Converter={StaticResource boolToVisibility}}">
                  <Grid.RowDefinitions>
                     <RowDefinition Height="Auto" />
                     <RowDefinition Height="*" />
                     <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!-- ==== record header ====
                       The emblem, the name and the state on one line; the sentence that explains
                       the role under it; the facts that are true of it whichever tab is open at
                       the bottom. The actions on the right are the ones that act on the role as
                       a whole - everything that edits its contents lives inside a tab.

                       The name and the sentence have two faces: a caption while the record is
                       being read, and a field once Edit details is pressed. What closes that mode
                       again is the save at the foot of the pane, not an OK of its own, so a name
                       travels the same road as a claim or a member. -->
                  <Grid Grid.Row="0" Margin="22,20,18,18">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                     </Grid.ColumnDefinitions>

                     <Border Grid.Column="0" Style="{StaticResource roleEmblemLargeStyle}"
                             Background="{Binding SelectedRole.cRoleName, Converter={StaticResource entityTintConverter}}">
                        <fa:FontAwesome Style="{StaticResource roleEmblemIconStyle}"
                                        FontSize="21"
                                        Icon="{Binding SelectedRole.EffectiveUiIcon, Converter={StaticResource uiIconConverter}}"
                                        Foreground="{Binding SelectedRole.cRoleName,
                                                             Converter={StaticResource entityTintConverter},
                                                             ConverterParameter=Text}" />
                     </Border>

                     <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                           <TextBlock Text="{Binding SelectedRole.cRoleName}"
                                      FontSize="19"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsEditingDetails,
                                                           Converter={StaticResource inverseBoolToVisibility}}" />

                           <Border Width="260"
                                   Style="{StaticResource searchFieldStyle}"
                                   Visibility="{Binding IsEditingDetails,
                                                        Converter={StaticResource boolToVisibility}}">
                              <TextBox Margin="14,0"
                                       Tag="Role name"
                                       Style="{StaticResource searchBoxStyle}"
                                       Text="{Binding SelectedRole.cRoleName, UpdateSourceTrigger=PropertyChanged}" />
                           </Border>

                           <Border Margin="12,0,0,0">
                              <Border.Style>
                                 <Style TargetType="Border" BasedOn="{StaticResource chipSuccessStyle}">
                                    <Style.Triggers>
                                       <!-- Switched off is not a status on the live scale, so the chip
                                            drops back to the muted shape the rail row already uses. -->
                                       <DataTrigger Binding="{Binding SelectedRole.cRoleState}" Value="Disabled">
                                          <Setter Property="Background" Value="{StaticResource surfaceStrongBrush}" />
                                          <Setter Property="BorderBrush" Value="{StaticResource outlineBrush}" />
                                          <Setter Property="Opacity" Value="0.65" />
                                          <Setter Property="TextElement.Foreground"
                                                  Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                       </DataTrigger>
                                    </Style.Triggers>
                                 </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding StateCaption}" />
                           </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedRole.cRoleDescription}"
                                   Margin="0,7,0,0"
                                   FontSize="12.5"
                                   Opacity="0.65"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsEditingDetails,
                                                        Converter={StaticResource inverseBoolToVisibility}}" />

                        <Border Style="{StaticResource searchFieldStyle}"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding IsEditingDetails,
                                                     Converter={StaticResource boolToVisibility}}">
                           <TextBox Margin="14,0"
                                    Tag="What this role is for"
                                    Style="{StaticResource searchBoxStyle}"
                                    Text="{Binding SelectedRole.cRoleDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <!-- The facts that stay true whichever tab is open, so they are read once
                             here rather than hunted for on the third tab. Who last changed the
                             role is not among them: the row records when it changed, not by
                             whom. -->
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                           <fa:FontAwesome Icon="Solid_User" FontSize="10" Opacity="0.5"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                           <TextBlock Text="{Binding MemberCountCaption}" Style="{StaticResource secondaryCellStyle}" />

                           <TextBlock Text="&#183;" Margin="9,0" Opacity="0.4"
                                      Style="{StaticResource secondaryCellStyle}" />

                           <fa:FontAwesome Icon="Solid_Key" FontSize="10" Opacity="0.5"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                           <TextBlock Text="{Binding ClaimCountCaption}"
                                      Style="{StaticResource secondaryCellStyle}" />

                           <TextBlock Text="&#183;" Margin="9,0" Opacity="0.4"
                                      Style="{StaticResource secondaryCellStyle}" />

                           <TextBlock Text="{Binding LastChangedLine}"
                                      Style="{StaticResource secondaryCellStyle}" />
                        </StackPanel>
                     </StackPanel>

                     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource compactOutlinedButtonStyle}"
                                Command="{Binding Commands[EditDetailsCommand]}"
                                ToolTip="Change the name and the description of this role">
                           <StackPanel Orientation="Horizontal">
                              <fa:FontAwesome Icon="Solid_PenToSquare" Style="{StaticResource buttonIconStyle}" />
                              <TextBlock Text="Edit details" VerticalAlignment="Center" />
                           </StackPanel>
                        </Button>

                        <Button Style="{StaticResource rowActionButtonStyle}" Margin="6,0,0,0"
                                Command="{Binding Commands[DuplicateRoleCommand]}"
                                ToolTip="Create a copy of this role, as a draft">
                           <fa:FontAwesome Icon="Solid_Copy" />
                        </Button>
                        <Button Style="{StaticResource rowActionButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Not built yet: more actions">
                           <fa:FontAwesome Icon="Solid_EllipsisVertical" />
                        </Button>
                     </StackPanel>
                  </Grid>

                  <!-- ==== the three faces of a role ==== -->
                  <TabControl Grid.Row="1" Style="{StaticResource materialTabControlStyle}">
                     <!-- =================================================
                          PERMISSIONS
                          What a role may do is a list of claims and nothing
                          more: a claim is either on the list or it is not.
                          There is deliberately no grid of modules against
                          actions - which actions a module offers is that
                          module's own business, and a fixed set of columns
                          would have to invent one set that fits all of them.

                          The list is grouped by the module that declared the
                          claim rather than carrying the module as a column
                          beside every row: a claim called "Read" means nothing
                          on its own, and repeating "acme.order" down five rows
                          says the same thing five times. The group caption says
                          it once, and the rows under it are then free to be as
                          short as the claim names really are.

                          Only the modules this role actually draws on are here.
                          Everything the application declares - including what
                          this role does not carry - is one press away in the
                          catalogue sheet, which is the right place for it: this
                          tab answers "what may this role do", not "what is
                          there at all".
                          ================================================= -->
                     <TabItem Header="Permissions">
                        <Grid>
                           <!-- A draft has no id yet, so nothing can point at it. The tab says
                                that rather than simply going grey, because "why" is the part
                                the reader actually needs. -->
                           <StackPanel Margin="32,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SelectedRole.IsBlank,
                                                            Converter={StaticResource boolToVisibility}}">
                              <fa:FontAwesome Icon="Solid_Lock" FontSize="24" Opacity="0.25"
                                              HorizontalAlignment="Center" Margin="0,0,0,14" />
                              <TextBlock Text="Save the role first" Style="{StaticResource emptyStateTitleStyle}" />
                              <TextBlock Text="{Binding DraftLockCaption}"
                                         Style="{StaticResource emptyStateNoteStyle}" />
                           </StackPanel>

                           <!-- The whole body of the tab is where a claim is dropped, its empty
                                state included: the cards below regroup themselves anyway, so
                                demanding that a claim land on the right card would only ask for
                                accuracy that buys nothing. Whether what is being dragged may land
                                at all is the command's own answer, asked again on every move of
                                the mouse - a draft says no through the same command that greys
                                the rest of this tab out. -->
                           <Grid x:Name="permissionDropArea"
                                 shared:DropTarget.Command="{Binding Commands[GrantDroppedCommand]}"
                                 Visibility="{Binding SelectedRole.IsBlank,
                                                      Converter={StaticResource inverseBoolToVisibility}}">
                              <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="*" />
                              </Grid.RowDefinitions>

                              <Grid Grid.Row="0" Margin="22,18,22,0">
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>

                                 <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                       <TextBlock Text="CLAIMS" Style="{StaticResource sectionCaptionStyle}"
                                                  VerticalAlignment="Center" />
                                       <Border Style="{StaticResource chipMutedStyle}" Margin="10,0,0,0">
                                          <TextBlock Text="{Binding GrantedSummaryCaption}" />
                                       </Border>

                                       <!-- Opens or folds every module at once. It is one ToggleButton
                                            rather than two buttons because the two actions are the two
                                            ends of a single piece of state: pressing it moves every
                                            group below, and a group that is then folded by hand simply
                                            parts company with it until the toggle is pressed again.

                                            The caption and the chevron are the state read back, so the
                                            button always says what pressing it will do. The caption is
                                            given a MinWidth because the two words are not the same
                                            length and the button must not jump between them. -->
                                       <ToggleButton x:Name="expandAllToggle"
                                                     Style="{StaticResource textButtonStyle}"
                                                     IsChecked="{Binding ArePermissionGroupsExpanded, Mode=TwoWay}"
                                                     Margin="8,0,0,0"
                                                     ToolTip="Open or fold every module at once">
                                          <StackPanel Orientation="Horizontal">
                                             <fa:FontAwesome FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <fa:FontAwesome.Style>
                                                   <Style TargetType="fa:FontAwesome">
                                                      <Setter Property="Icon" Value="Solid_ChevronUp" />
                                                      <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsChecked, ElementName=expandAllToggle}"
                                                                      Value="False">
                                                            <Setter Property="Icon" Value="Solid_ChevronDown" />
                                                         </DataTrigger>
                                                      </Style.Triggers>
                                                   </Style>
                                                </fa:FontAwesome.Style>
                                             </fa:FontAwesome>

                                             <TextBlock MinWidth="64" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                   <Style TargetType="TextBlock">
                                                      <Setter Property="Text" Value="Collapse all" />
                                                      <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsChecked, ElementName=expandAllToggle}"
                                                                      Value="False">
                                                            <Setter Property="Text" Value="Expand all" />
                                                         </DataTrigger>
                                                      </Style.Triggers>
                                                   </Style>
                                                </TextBlock.Style>
                                             </TextBlock>
                                          </StackPanel>
                                       </ToggleButton>

                                       <!-- What the last drop did. The counters beside it move on
                                            their own, but a drop that changes nothing - a claim
                                            already held, a module already full - moves nothing
                                            either, and without a word it reads as a drag that
                                            failed. It clears itself after a few seconds. -->
                                       <Border Style="{StaticResource chipSuccessStyle}"
                                               Margin="10,0,0,0"
                                               MaxWidth="280"
                                               Visibility="{Binding HasDropFeedback,
                                                                    Converter={StaticResource boolToVisibility}}">
                                          <TextBlock Text="{Binding DropFeedbackCaption}"
                                                     TextTrimming="CharacterEllipsis"
                                                     ToolTip="{Binding DropFeedbackCaption}" />
                                       </Border>
                                    </StackPanel>
                                    <TextBlock Text="Everything the members of this role may do. A claim that is not on this list is one they may not use. Open All claims and drag one over to grant it."
                                               Style="{StaticResource fieldHelpStyle}"
                                               Margin="0,4,16,0" />
                                 </StackPanel>

                                 <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource searchFieldStyle}" Width="190">
                                       <Grid Margin="14,0">
                                          <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="*" />
                                          </Grid.ColumnDefinitions>

                                          <fa:FontAwesome Grid.Column="0"
                                                          Icon="Solid_MagnifyingGlass"
                                                          FontSize="12"
                                                          Opacity="0.6"
                                                          VerticalAlignment="Center" />

                                          <TextBox Grid.Column="1"
                                                   Margin="11,0,0,0"
                                                   Tag="Search claim"
                                                   Style="{StaticResource searchBoxStyle}" />
                                       </Grid>
                                    </Border>

                                    <!-- Opens the catalogue sheet. A ToggleButton rather than a Button:
                                         it stays visibly pressed while the sheet is open, which is what
                                         ties the panel to the thing that opened it. The sheet itself is
                                         the last child of the screen, so it covers the whole control. -->
                                    <ToggleButton x:Name="catalogueToggle"
                                                  Style="{StaticResource sheetToggleStyle}"
                                                  Margin="8,0,0,0"
                                                  ToolTip="See every claim the application declares">
                                       <StackPanel Orientation="Horizontal">
                                          <fa:FontAwesome Icon="Solid_Key" Style="{StaticResource buttonIconStyle}" />
                                          <TextBlock Text="All claims" VerticalAlignment="Center" />
                                       </StackPanel>
                                    </ToggleButton>
                                 </StackPanel>
                              </Grid>

                              <ScrollViewer Foreground="{DynamicResource themeWindowForegroundBrush}" Grid.Row="1"
                                            Padding="22,14,22,0"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                                 <!-- One card per module, one row per claim inside it. The cards flow
                                      rather than stack: a module carries a handful of short claim names,
                                      so a full-width card per module would leave most of the pane empty
                                      and push the last modules off the bottom of the screen.

                                      ItemWidth is what makes them line up in columns - every card takes
                                      the same slot, and how many fit is decided by the width the pane
                                      actually has rather than by a number written here: two side by side
                                      when the rail has been given room, three or four when it has not.
                                      VerticalAlignment Top is what lets a card keep its own height
                                      instead of being stretched to the tallest one beside it.

                                      Each body is folded away by its own header: the header is a
                                      ToggleButton bound to the group's own state, and the body reads it
                                      back through the plain boolean-to-visibility converter. -->
                                 <ItemsControl ItemsSource="{Binding GrantedGroups}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                       <ItemsPanelTemplate>
                                          <WrapPanel ItemWidth="236" />
                                       </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                          <Border Style="{StaticResource innerCardStyle}"
                                                  Margin="0,0,12,12"
                                                  VerticalAlignment="Top">
                                             <StackPanel>
                                                <ToggleButton x:Name="groupHeader"
                                                              Style="{StaticResource groupHeaderToggleStyle}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                                   <!-- The name takes the star and the other two take
                                                        what they need, so a long module name gives
                                                        way with an ellipsis instead of pushing the
                                                        count and the button off the card. These
                                                        cards are pinned to one width, so there is
                                                        no growing out of it. -->
                                                   <Grid>
                                                      <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*" />
                                                         <ColumnDefinition Width="Auto" />
                                                         <ColumnDefinition Width="Auto" />
                                                      </Grid.ColumnDefinitions>

                                                      <TextBlock Grid.Column="0"
                                                                 Text="{Binding ModuleName}"
                                                                 Style="{StaticResource groupCaptionStyle}" />
                                                      <Border Grid.Column="1"
                                                              Style="{StaticResource chipMutedStyle}"
                                                              Margin="10,0,0,0">
                                                         <TextBlock Text="{Binding GrantedCaption}" />
                                                      </Border>

                                                      <!-- The row X taken up one level: it takes the
                                                           whole module back in one press instead of
                                                           asking for a press per claim. A Button
                                                           inside a ToggleButton is safe - ButtonBase
                                                           marks the press handled, so the card does
                                                           not fold underneath it.

                                                           The negative right margin is what lines it
                                                           up with the X's on the rows below: the
                                                           header strip is inset 18 and the rows 16,
                                                           and a column of buttons two pixels out of
                                                           true is exactly the kind of thing the eye
                                                           catches without knowing why. -->
                                                      <Button Grid.Column="2"
                                                              Style="{StaticResource rowActionButtonStyle}"
                                                              Margin="6,0,-2,0"
                                                              Command="{Binding DataContext.Commands[RevokeModuleCommand],
                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="Take every claim of this module back from the role">
                                                         <fa:FontAwesome Icon="Solid_Xmark" />
                                                      </Button>
                                                   </Grid>
                                                </ToggleButton>

                                                <ItemsControl ItemsSource="{Binding Granted}"
                                                              Visibility="{Binding IsChecked, ElementName=groupHeader,
                                                                                   Converter={StaticResource boolToVisibility}}">
                                                   <ItemsControl.ItemTemplate>
                                                      <DataTemplate>
                                                         <StackPanel>
                                                            <Border Style="{StaticResource listRowDividerStyle}" />
                                                            <Grid Height="44" Margin="16,0">
                                                               <Grid.ColumnDefinitions>
                                                                  <ColumnDefinition Width="*" />
                                                                  <ColumnDefinition Width="Auto" />
                                                               </Grid.ColumnDefinitions>
                                                               <TextBlock Grid.Column="0"
                                                                          Text="{Binding Name}"
                                                                          Margin="0,0,10,0"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          Style="{StaticResource primaryCellStyle}"
                                                                          ToolTip="{Binding Key}" />
                                                               <Button Grid.Column="1"
                                                                       Style="{StaticResource rowActionButtonStyle}"
                                                                       Command="{Binding DataContext.Commands[RevokeClaimCommand],
                                                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}"
                                                                       ToolTip="Take this claim back from the role">
                                                                  <fa:FontAwesome Icon="Solid_Xmark" />
                                                               </Button>
                                                            </Grid>
                                                         </StackPanel>
                                                      </DataTemplate>
                                                   </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                             </StackPanel>
                                          </Border>
                                       </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                              </ScrollViewer>

                              <StackPanel Grid.Row="1"
                                          Margin="32,0"
                                          VerticalAlignment="Center">
                                 <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                       <Setter Property="Visibility" Value="Collapsed" />
                                       <Style.Triggers>
                                          <DataTrigger Binding="{Binding GrantedGroups.Count}" Value="0">
                                             <Setter Property="Visibility" Value="Visible" />
                                          </DataTrigger>
                                       </Style.Triggers>
                                    </Style>
                                 </StackPanel.Style>

                                 <fa:FontAwesome Icon="Solid_Key" FontSize="24" Opacity="0.25"
                                                 HorizontalAlignment="Center" Margin="0,0,0,14" />
                                 <TextBlock Text="This role carries no claim" Style="{StaticResource emptyStateTitleStyle}" />
                                 <TextBlock Text="Anybody given this role can sign in and see the application, and nothing more. Open All claims and drag one over to grant it."
                                            Style="{StaticResource emptyStateNoteStyle}" />
                              </StackPanel>

                              <!-- The drop area made visible, and only while something that may
                                   actually land is over it. It says what dropping does rather than
                                   what is being dropped: the ghost following the cursor already
                                   names that, and pulling it as far as the view model would drag
                                   hover state in there for the sake of one sentence. -->
                              <Border Grid.Row="0" Grid.RowSpan="2"
                                      Margin="16"
                                      CornerRadius="10"
                                      BorderThickness="2"
                                      BorderBrush="{DynamicResource themeAccentBrush}"
                                      Background="{StaticResource surfaceBrush}"
                                      IsHitTestVisible="False"
                                      Visibility="{Binding (shared:DropTarget.IsDraggingOver),
                                                           ElementName=permissionDropArea,
                                                           Converter={StaticResource boolToVisibility}}">
                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <fa:FontAwesome Icon="Solid_HandPointer" FontSize="20" Opacity="0.55"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="Drop to grant it to this role"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                 </StackPanel>
                              </Border>
                           </Grid>
                        </Grid>
                     </TabItem>

                     <TabItem Header="Members">
                        <Grid>
                           <StackPanel Margin="32,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SelectedRole.IsBlank,
                                                            Converter={StaticResource boolToVisibility}}">
                              <fa:FontAwesome Icon="Solid_Lock" FontSize="24" Opacity="0.25"
                                              HorizontalAlignment="Center" Margin="0,0,0,14" />
                              <TextBlock Text="Save the role first" Style="{StaticResource emptyStateTitleStyle}" />
                              <TextBlock Text="Nobody can be given a role that does not exist yet: an assignment points at an id, and this one has not been issued."
                                         Style="{StaticResource emptyStateNoteStyle}" />
                           </StackPanel>

                           <Grid Visibility="{Binding SelectedRole.IsBlank,
                                                      Converter={StaticResource inverseBoolToVisibility}}">
                              <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="*" />
                              </Grid.RowDefinitions>

                              <Grid Grid.Row="0" Margin="22,18,22,0">
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>

                                 <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="MEMBERS" Style="{StaticResource sectionCaptionStyle}" />
                                    <TextBlock Text="Accounts that carry this role. An assignment may start on a future date and may be given an end date."
                                               Style="{StaticResource fieldHelpStyle}"
                                               Margin="0,4,16,0" />
                                 </StackPanel>

                                 <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource searchFieldStyle}" Width="210">
                                       <Grid Margin="14,0">
                                          <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="*" />
                                          </Grid.ColumnDefinitions>

                                          <fa:FontAwesome Grid.Column="0"
                                                          Icon="Solid_MagnifyingGlass"
                                                          FontSize="12"
                                                          Opacity="0.6"
                                                          VerticalAlignment="Center" />

                                          <TextBox Grid.Column="1"
                                                   Margin="11,0,0,0"
                                                   Tag="Search member"
                                                   Style="{StaticResource searchBoxStyle}" />
                                       </Grid>
                                    </Border>

                                    <!-- Giving the role to somebody needs a way of picking an account,
                                         which is the same piece of screen the Add claim button is
                                         waiting for. Both arrive together. -->
                                    <Button Style="{StaticResource compactFilledButtonStyle}" Margin="8,0,0,0"
                                            IsEnabled="False"
                                            ToolTip="Not built yet: giving this role to an account">
                                       <StackPanel Orientation="Horizontal">
                                          <fa:FontAwesome Icon="Solid_UserPlus" Style="{StaticResource buttonIconStyle}" />
                                          <TextBlock Text="Assign user" VerticalAlignment="Center" />
                                       </StackPanel>
                                    </Button>
                                 </StackPanel>
                              </Grid>

                              <ScrollViewer Foreground="{DynamicResource themeWindowForegroundBrush}" Grid.Row="1"
                                            Padding="22,14,22,0"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                                 <Border Style="{StaticResource innerCardStyle}" Margin="0,0,0,20"
                                         VerticalAlignment="Top">
                                    <StackPanel>
                                       <Border Style="{StaticResource innerCardHeaderStyle}">
                                          <Grid Height="40" Margin="18,0">
                                             <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="180" />
                                                <ColumnDefinition Width="*" MinWidth="150" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="70" />
                                             </Grid.ColumnDefinitions>
                                             <TextBlock Grid.Column="0" Text="ACCOUNT" Style="{StaticResource columnHeaderStyle}" />
                                             <TextBlock Grid.Column="1" Text="FULL NAME" Style="{StaticResource columnHeaderStyle}" />
                                             <TextBlock Grid.Column="2" Text="ASSIGNED" Style="{StaticResource columnHeaderStyle}" />
                                             <TextBlock Grid.Column="3" Text="EXPIRES" Style="{StaticResource columnHeaderStyle}" />
                                             <TextBlock Grid.Column="4" Text="STATE" Style="{StaticResource columnHeaderStyle}" />
                                             <!-- Empty caption over the row actions; the column width is
                                                  what reserves their place. -->
                                             <TextBlock Grid.Column="5" Text="" Style="{StaticResource columnHeaderStyle}" />
                                          </Grid>
                                       </Border>

                                       <ItemsControl ItemsSource="{Binding MemberRows}">
                                          <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                <StackPanel>
                                                   <Border Style="{StaticResource listRowDividerStyle}" />
                                                   <Grid x:Name="memberRow" Height="56" Margin="18,0">
                                                      <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*" MinWidth="180" />
                                                         <ColumnDefinition Width="*" MinWidth="150" />
                                                         <ColumnDefinition Width="120" />
                                                         <ColumnDefinition Width="120" />
                                                         <ColumnDefinition Width="112" />
                                                         <ColumnDefinition Width="70" />
                                                      </Grid.ColumnDefinitions>

                                                      <!-- The disc is drawn from the full name, so it still
                                                           reads as a person even though the caption beside
                                                           it is the account. -->
                                                      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,14,0">
                                                         <Border Style="{StaticResource memberAvatarStyle}"
                                                                 Background="{Binding FullName,
                                                                                      Converter={StaticResource avatarPaletteConverter}}">
                                                            <TextBlock Style="{StaticResource memberAvatarTextStyle}"
                                                                       Text="{Binding FullName,
                                                                                      Converter={StaticResource initialsConverter}}"
                                                                       Foreground="{Binding FullName,
                                                                                            Converter={StaticResource avatarPaletteConverter},
                                                                                            ConverterParameter=Text}" />
                                                         </Border>
                                                         <TextBlock Text="{Binding Account}" Margin="11,0,0,0"
                                                                    FontWeight="SemiBold"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Style="{StaticResource primaryCellStyle}" />
                                                      </StackPanel>

                                                      <TextBlock Grid.Column="1" Text="{Binding FullName}" Margin="0,0,14,0"
                                                                 TextTrimming="CharacterEllipsis"
                                                                 Style="{StaticResource primaryCellStyle}" />
                                                      <TextBlock Grid.Column="2" Text="{Binding StartCaption}"
                                                                 Style="{StaticResource secondaryCellStyle}" />
                                                      <!-- An assignment with no end date is the normal case, so
                                                           the cell says so in words rather than sitting empty. -->
                                                      <TextBlock Grid.Column="3" Text="{Binding ExpiryCaption}"
                                                                 Style="{StaticResource secondaryCellStyle}" />

                                                      <!-- The chip keeps its shape and only swaps palette, so
                                                           the three states read as one scale. -->
                                                      <Border x:Name="memberStateChip" Grid.Column="4"
                                                              Style="{StaticResource chipSuccessStyle}">
                                                         <TextBlock Text="{Binding StateCaption}" />
                                                      </Border>

                                                      <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                                  VerticalAlignment="Center">
                                                         <Button Style="{StaticResource rowActionButtonStyle}"
                                                                 IsEnabled="False"
                                                                 ToolTip="Not built yet: changing the period of this assignment">
                                                            <fa:FontAwesome Icon="Solid_PenToSquare" />
                                                         </Button>
                                                         <Button Style="{StaticResource rowActionButtonStyle}"
                                                                 Command="{Binding DataContext.Commands[RemoveMemberCommand],
                                                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 CommandParameter="{Binding}"
                                                                 ToolTip="Take this role away from the account">
                                                            <fa:FontAwesome Icon="Solid_Xmark" />
                                                         </Button>
                                                      </StackPanel>
                                                   </Grid>
                                                </StackPanel>

                                                <DataTemplate.Triggers>
                                                   <DataTrigger Binding="{Binding StateCaption}" Value="SCHEDULED">
                                                      <Setter TargetName="memberStateChip" Property="Style"
                                                              Value="{StaticResource chipWarningStyle}" />
                                                      <Setter TargetName="memberStateChip" Property="ToolTip"
                                                              Value="The start date has not been reached yet" />
                                                   </DataTrigger>
                                                   <!-- The row stays on the list because it is what explains
                                                        what somebody could do last quarter; it is dimmed so it
                                                        never reads as current. -->
                                                   <DataTrigger Binding="{Binding StateCaption}" Value="EXPIRED">
                                                      <Setter TargetName="memberStateChip" Property="Style"
                                                              Value="{StaticResource chipDangerStyle}" />
                                                      <Setter TargetName="memberRow" Property="Opacity" Value="0.6" />
                                                   </DataTrigger>
                                                </DataTemplate.Triggers>
                                             </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                       </ItemsControl>

                                       <StackPanel Margin="18,26,18,30">
                                          <StackPanel.Style>
                                             <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                   <DataTrigger Binding="{Binding MemberRows.Count}" Value="0">
                                                      <Setter Property="Visibility" Value="Visible" />
                                                   </DataTrigger>
                                                </Style.Triggers>
                                             </Style>
                                          </StackPanel.Style>

                                          <TextBlock Text="Nobody carries this role" Style="{StaticResource emptyStateTitleStyle}" />
                                          <TextBlock Text="A role with no members changes nothing on its own. It is still worth keeping - what it may do is agreed first, and the accounts follow."
                                                     Style="{StaticResource emptyStateNoteStyle}" />
                                       </StackPanel>
                                    </StackPanel>
                                 </Border>
                              </ScrollViewer>
                           </Grid>
                        </Grid>
                     </TabItem>

                     <!-- =================================================
                          DETAILS
                          What is recorded about the role rather than what it
                          does: the facts the application keeps, and the two
                          actions that take it out of use.
                          ================================================= -->
                     <TabItem Header="Details">
                        <ScrollViewer Foreground="{DynamicResource themeWindowForegroundBrush}" Padding="22,18,22,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                           <StackPanel Margin="0,0,0,20">

                              <TextBlock Text="RECORDED FACTS" Style="{StaticResource sectionCaptionStyle}" />
                              <TextBlock Text="Kept by the application itself. Nothing here is typed in, and nothing here can be edited."
                                         Style="{StaticResource fieldHelpStyle}" />

                              <Border Style="{StaticResource innerCardStyle}" Margin="0,12,0,0" Padding="20,18">
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                       <RowDefinition Height="Auto" />
                                       <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                                       <TextBlock Text="IDENTIFIER" Style="{StaticResource metaLabelStyle}" />
                                       <TextBlock Text="{Binding IdentifierCaption}"
                                                  Style="{StaticResource metaValueStyle}"
                                                  ToolTip="{Binding IdentifierCaption}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                                       <TextBlock Text="STATE" Style="{StaticResource metaLabelStyle}" />
                                       <TextBlock Text="{Binding StateDetailCaption}" Style="{StaticResource metaValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                       <TextBlock Text="MEMBERS" Style="{StaticResource metaLabelStyle}" />
                                       <TextBlock Text="{Binding MemberDetailCaption}"
                                                  Style="{StaticResource metaValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,20,16,0">
                                       <TextBlock Text="CLAIMS GRANTED" Style="{StaticResource metaLabelStyle}" />
                                       <TextBlock Text="{Binding ClaimDetailCaption}" Style="{StaticResource metaValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,20,16,0">
                                       <TextBlock Text="LAST CHANGED" Style="{StaticResource metaLabelStyle}" />
                                       <TextBlock Text="{Binding LastChangedCaption}" Style="{StaticResource metaValueStyle}" />
                                    </StackPanel>

                                    <!-- The row records when it changed, not by whom, so the cell says
                                         that rather than naming somebody it cannot know. -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,20,0,0">
                                       <TextBlock Text="LAST CHANGED BY" Style="{StaticResource metaLabelStyle}" />
                                       <TextBlock Text="Not recorded"
                                                  Opacity="0.55"
                                                  Style="{StaticResource metaValueStyle}"
                                                  ToolTip="The role keeps when it was last changed, but not who changed it" />
                                    </StackPanel>
                                 </Grid>
                              </Border>

                              <!-- The two actions that take a role out of use. They are last on the
                                   page, in their own outlined block, so neither can be reached by
                                   accident on the way to something else.

                                   Disabling only moves the state column, so it travels with the save
                                   at the foot of the pane like everything else on this screen.
                                   Deleting does not: it is the one thing here that cannot be taken
                                   back, so it asks first and goes on its own. -->
                              <TextBlock Text="TAKING THIS ROLE OUT OF USE"
                                         Style="{StaticResource sectionCaptionStyle}"
                                         Margin="0,22,0,0" />

                              <Border Margin="0,12,0,0"
                                      Padding="20,18"
                                      CornerRadius="12"
                                      Background="{StaticResource dangerChipBrush}"
                                      BorderBrush="{StaticResource dangerBrush}"
                                      BorderThickness="1">
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                       <TextBlock Text="Disabling keeps the role and its history; it simply cannot be handed out any more."
                                                  FontSize="12.5"
                                                  TextWrapping="Wrap" />
                                       <TextBlock Text="Deleting takes the role off every account that carries it, and cannot be undone. Disabling is what is wanted almost every time."
                                                  Style="{StaticResource fieldHelpStyle}"
                                                  Margin="0,6,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                       <!-- One button for both directions: a role that has been
                                            switched off has to be able to come back, and a second
                                            button for that would sit here doing nothing almost all
                                            of the time. What it says is what pressing it will do. -->
                                       <Button Command="{Binding Commands[DisableRoleCommand]}">
                                          <Button.Style>
                                             <Style TargetType="Button" BasedOn="{StaticResource compactOutlinedButtonStyle}">
                                                <Setter Property="ToolTip"
                                                        Value="Keep the role, but stop it being handed out" />
                                                <Style.Triggers>
                                                   <DataTrigger Binding="{Binding SelectedRole.cRoleState}" Value="Disabled">
                                                      <Setter Property="ToolTip" Value="Let this role be handed out again" />
                                                   </DataTrigger>
                                                </Style.Triggers>
                                             </Style>
                                          </Button.Style>

                                          <StackPanel Orientation="Horizontal">
                                             <fa:FontAwesome>
                                                <fa:FontAwesome.Style>
                                                   <Style TargetType="fa:FontAwesome" BasedOn="{StaticResource buttonIconStyle}">
                                                      <Setter Property="Icon" Value="Solid_Ban" />
                                                      <Style.Triggers>
                                                         <DataTrigger Binding="{Binding SelectedRole.cRoleState}" Value="Disabled">
                                                            <Setter Property="Icon" Value="Solid_CircleCheck" />
                                                         </DataTrigger>
                                                      </Style.Triggers>
                                                   </Style>
                                                </fa:FontAwesome.Style>
                                             </fa:FontAwesome>
                                             <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                   <Style TargetType="TextBlock">
                                                      <Setter Property="Text" Value="Disable role" />
                                                      <Style.Triggers>
                                                         <DataTrigger Binding="{Binding SelectedRole.cRoleState}" Value="Disabled">
                                                            <Setter Property="Text" Value="Enable role" />
                                                         </DataTrigger>
                                                      </Style.Triggers>
                                                   </Style>
                                                </TextBlock.Style>
                                             </TextBlock>
                                          </StackPanel>
                                       </Button>

                                       <Button Style="{StaticResource dangerOutlinedButtonStyle}"
                                               Height="34"
                                               Padding="15,0"
                                               FontSize="12.5"
                                               Margin="8,0,0,0"
                                               Command="{Binding Commands[DeleteRoleCommand]}"
                                               ToolTip="Remove the role and every assignment of it">
                                          <StackPanel Orientation="Horizontal">
                                             <fa:FontAwesome Icon="Solid_TriangleExclamation"
                                                             Style="{StaticResource buttonIconStyle}" />
                                             <TextBlock Text="Delete role" VerticalAlignment="Center" />
                                          </StackPanel>
                                       </Button>
                                    </StackPanel>
                                 </Grid>
                              </Border>
                           </StackPanel>
                        </ScrollViewer>
                     </TabItem>
                  </TabControl>

                  <!-- ==== action bar ====
                       Everything inside the tabs is edited in place, so the bar that commits it
                       belongs to the pane rather than to a tab: whichever tab the change was made
                       on, it is saved from the same place. The line on the left is the size of the
                       difference itself, read off the very object that will be sent - so it cannot
                       drift away from what saving would really do. -->
                  <Border Grid.Row="2"
                          BorderBrush="{StaticResource dividerBrush}"
                          BorderThickness="0,1,0,0">
                     <Grid Margin="22,12">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" />
                           <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                           <fa:FontAwesome Icon="Solid_CircleInfo" FontSize="11" Opacity="0.5"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                           <TextBlock Text="{Binding ChangeCaption}"
                                      TextTrimming="CharacterEllipsis"
                                      Style="{StaticResource secondaryCellStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                           <Button Style="{StaticResource outlinedButtonStyle}"
                                   Content="Discard"
                                   Command="{Binding Commands[DiscardCommand]}"
                                   ToolTip="Put everything back the way it was when the role was opened, and close the name editor" />
                           <Button Style="{StaticResource filledButtonStyle}"
                                   Margin="10,0,0,0"
                                   Command="{Binding Commands[SaveChangesCommand]}"
                                   ToolTip="Save the changes to this role">
                              <StackPanel Orientation="Horizontal">
                                 <fa:FontAwesome Icon="Solid_FloppyDisk" Style="{StaticResource buttonIconStyle}" />
                                 <TextBlock Text="Save changes" VerticalAlignment="Center" />
                              </StackPanel>
                           </Button>
                        </StackPanel>
                     </Grid>
                  </Border>
               </Grid>
            </Grid>
         </Border>
      </Grid>

      <!-- =========================================================
           CLAIM CATALOGUE SHEET
           Everything the application declares, not just what this role
           carries. It answers the question the tab behind it cannot -
           "what is there at all" - without making the reader open the
           add dialog to find out.

           It is a side sheet rather than a dialog: it slides in over the
           screen, leaves the tab underneath untouched, and closes on the
           first click outside it. The panel is always in the tree and
           simply parked off the right edge, which is what lets the slide
           be two animations on one trigger instead of code. The "All
           claims" toggle owns the state; the scrim and the panel both
           react to its IsChecked.

           Both live in the outer grid's two rows at once, so they cover
           the toolbar as well as the body.
           ========================================================= -->
      <!-- The scrim keeps dimming the screen while a claim is being dragged out of the sheet, but
           it stops catching the mouse: without that the drop would land on the scrim and the tab
           behind it would never hear about it. Only the catching stops, so a plain click still
           closes the sheet as before. The rule is local to this screen rather than in the shared
           style - other screens use the same scrim and have nothing to drag out of it. -->
      <ToggleButton Grid.Row="0" Grid.RowSpan="2"
                    IsChecked="{Binding IsChecked, ElementName=catalogueToggle, Mode=TwoWay}">
         <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource sheetScrimStyle}">
               <Style.Triggers>
                  <DataTrigger Binding="{Binding (shared:DragSource.IsDragActive),
                                                 RelativeSource={RelativeSource Self}}"
                               Value="True">
                     <Setter Property="IsHitTestVisible" Value="False" />
                  </DataTrigger>
               </Style.Triggers>
            </Style>
         </ToggleButton.Style>
      </ToggleButton>

      <Border x:Name="catalogueSheet"
              Grid.Row="0" Grid.RowSpan="2"
              Width="400"
              HorizontalAlignment="Right"
              Background="{DynamicResource themeWindowBackgroundBrush}"
              BorderBrush="{StaticResource outlineBrush}"
              BorderThickness="1,0,0,0">
         <Border.RenderTransform>
            <TranslateTransform X="420" />
         </Border.RenderTransform>
         <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.3" Color="#000000" />
         </Border.Effect>
         <Border.Style>
            <Style TargetType="Border">
               <!-- Parked: no clicks reach a panel the reader cannot see. -->
               <Setter Property="IsHitTestVisible" Value="False" />
               <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChecked, ElementName=catalogueToggle}" Value="True">
                     <Setter Property="IsHitTestVisible" Value="True" />
                     <DataTrigger.EnterActions>
                        <BeginStoryboard>
                           <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                               To="0" Duration="0:0:0.22">
                                 <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                 </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                           </Storyboard>
                        </BeginStoryboard>
                     </DataTrigger.EnterActions>
                     <DataTrigger.ExitActions>
                        <BeginStoryboard>
                           <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                               To="420" Duration="0:0:0.18">
                                 <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseIn" />
                                 </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                           </Storyboard>
                        </BeginStoryboard>
                     </DataTrigger.ExitActions>
                  </DataTrigger>
               </Style.Triggers>
            </Style>
         </Border.Style>

         <Grid>
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="*" />
               <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==== sheet header ==== -->
            <Grid Grid.Row="0" Margin="22,20,16,16">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
               </Grid.ColumnDefinitions>

               <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Claim catalogue" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Every claim the modules of this application declare"
                             FontSize="11.5"
                             Opacity="0.6"
                             Margin="0,2,0,0"
                             TextWrapping="Wrap" />
               </StackPanel>

               <ToggleButton Grid.Column="1"
                             Style="{StaticResource sheetCloseToggleStyle}"
                             IsChecked="{Binding IsChecked, ElementName=catalogueToggle, Mode=TwoWay}"
                             ToolTip="Close">
                  <fa:FontAwesome Icon="Solid_Xmark" />
               </ToggleButton>
            </Grid>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{StaticResource dividerBrush}" />

            <!-- ==== what to look at ====
                 A catalogue is read for two different reasons - to find one claim, or to see
                 what this role is missing - so it carries both a search box and the facet that
                 splits the list against the role that is open behind the sheet. Neither is
                 bound yet; they arrive with the picker that grants a claim. -->
            <StackPanel Grid.Row="1" Margin="22,16,22,12">
               <Border Style="{StaticResource searchFieldStyle}">
                  <Grid Margin="14,0">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>

                     <fa:FontAwesome Grid.Column="0"
                                     Icon="Solid_MagnifyingGlass"
                                     FontSize="12"
                                     Opacity="0.6"
                                     VerticalAlignment="Center" />

                     <TextBox Grid.Column="1"
                              Margin="11,0,0,0"
                              Tag="Search claim or module"
                              Style="{StaticResource searchBoxStyle}" />
                  </Grid>
               </Border>

               <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0"
                          CornerRadius="15"
                          Padding="2"
                          HorizontalAlignment="Left"
                          Background="{StaticResource surfaceBrush}"
                          BorderBrush="{StaticResource outlineBrush}"
                          BorderThickness="1">
                     <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="catalogueFacet" Style="{StaticResource segmentStyle}"
                                     Content="All" IsChecked="True" />
                        <RadioButton GroupName="catalogueFacet" Style="{StaticResource segmentStyle}"
                                     Content="On this role" />
                        <RadioButton GroupName="catalogueFacet" Style="{StaticResource segmentStyle}"
                                     Content="Not yet" />
                     </StackPanel>
                  </Border>

                  <!-- The same folding switch the tab behind carries, over the sheet's own
                       groups: the catalogue is the longer of the two lists, so it needs it
                       more. See the note on the one in the Permissions tab. -->
                  <ToggleButton x:Name="catalogueExpandAllToggle"
                                Grid.Column="1"
                                Style="{StaticResource textButtonStyle}"
                                IsChecked="{Binding AreCatalogueGroupsExpanded, Mode=TwoWay}"
                                ToolTip="Open or fold every module at once">
                     <StackPanel Orientation="Horizontal">
                        <fa:FontAwesome FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center">
                           <fa:FontAwesome.Style>
                              <Style TargetType="fa:FontAwesome">
                                 <Setter Property="Icon" Value="Solid_ChevronUp" />
                                 <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=catalogueExpandAllToggle}"
                                                 Value="False">
                                       <Setter Property="Icon" Value="Solid_ChevronDown" />
                                    </DataTrigger>
                                 </Style.Triggers>
                              </Style>
                           </fa:FontAwesome.Style>
                        </fa:FontAwesome>

                        <TextBlock MinWidth="64" VerticalAlignment="Center">
                           <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                 <Setter Property="Text" Value="Collapse all" />
                                 <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=catalogueExpandAllToggle}"
                                                 Value="False">
                                       <Setter Property="Text" Value="Expand all" />
                                    </DataTrigger>
                                 </Style.Triggers>
                              </Style>
                           </TextBlock.Style>
                        </TextBlock>
                     </StackPanel>
                  </ToggleButton>
               </Grid>
            </StackPanel>

            <!-- ==== the catalogue itself ====
                 The same grouped cards the tab behind uses, so a claim looks the same wherever
                 it is read. The tick on the right is the only thing this list says about the
                 role that is open: it carries this one already. -->
            <ScrollViewer Foreground="{DynamicResource themeWindowForegroundBrush}" Grid.Row="2"
                          Padding="22,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
               <ItemsControl ItemsSource="{Binding ClaimGroups}" Margin="0,0,0,16">
                  <ItemsControl.ItemTemplate>
                     <DataTemplate>
                        <!-- The payload sits on the card itself rather than on its header: what
                             the ghost replicates is whatever carries the payload, and what is
                             wanted here is the picture of the whole card. The header still works
                             as a place to take hold of it, because its events reach the card by
                             bubbling - and a claim row inside still wins over the card, because
                             its own payload is deeper in. -->
                        <Border Style="{StaticResource innerCardStyle}" Margin="0,0,0,12"
                                shared:DragSource.Payload="{Binding}">
                           <StackPanel>
                              <!-- The header is the one part of the card the claim rows do not
                                   cover, so it is where the whole module is taken hold of. It
                                   still folds the card on a plain click - dragging it lets the
                                   mouse capture go, and a ToggleButton only clicks while it still
                                   holds it. -->
                              <ToggleButton x:Name="catalogueGroupHeader"
                                            Style="{StaticResource groupHeaderToggleStyle}"
                                            IsChecked="{Binding IsCatalogueExpanded, Mode=TwoWay}"
                                            ToolTip="Click to fold, drag to grant the whole module">
                                 <!-- Same shape as the header on the tab behind: the name takes the
                                      star and gives way with an ellipsis, the rest keeps its place
                                      at the right edge. -->
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="*" />
                                       <ColumnDefinition Width="Auto" />
                                       <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding ModuleName}"
                                               Style="{StaticResource groupCaptionStyle}" />
                                    <Border Grid.Column="1" Style="{StaticResource chipMutedStyle}" Margin="10,0,0,0">
                                       <TextBlock Text="{Binding CatalogueCaption}" />
                                    </Border>

                                    <!-- The same grip the claim rows carry, for the same reason:
                                         it does not have to be used, it only says the header can
                                         be dragged at all. -->
                                    <fa:FontAwesome Grid.Column="2"
                                                    Icon="Solid_GripVertical"
                                                    FontSize="11"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                       <fa:FontAwesome.Style>
                                          <Style TargetType="fa:FontAwesome">
                                             <Setter Property="Opacity" Value="0" />
                                             <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=catalogueGroupHeader}"
                                                             Value="True">
                                                   <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                             </Style.Triggers>
                                          </Style>
                                       </fa:FontAwesome.Style>
                                    </fa:FontAwesome>
                                 </Grid>
                              </ToggleButton>

                              <ItemsControl ItemsSource="{Binding Claims}"
                                            Visibility="{Binding IsChecked, ElementName=catalogueGroupHeader,
                                                                 Converter={StaticResource boolToVisibility}}">
                                 <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                       <StackPanel>
                                          <Border Style="{StaticResource listRowDividerStyle}" />
                                          <!-- A row of its own carries a claim of its own: dragging
                                               it grants that one claim. The background has to be
                                               painted, transparent or not, or the gaps between the
                                               two captions are not hit and the drag never starts. -->
                                          <Grid x:Name="catalogueClaimRow"
                                                Height="50" Margin="8,0,18,0"
                                                Background="Transparent"
                                                shared:DragSource.Payload="{Binding}">
                                             <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>

                                             <!-- Not a handle that has to be used - the whole row
                                                  is draggable - only the thing that says the row
                                                  can be dragged at all. -->
                                             <fa:FontAwesome Grid.Column="0"
                                                             Icon="Solid_GripVertical"
                                                             FontSize="11"
                                                             Width="10"
                                                             VerticalAlignment="Center">
                                                <fa:FontAwesome.Style>
                                                   <Style TargetType="fa:FontAwesome">
                                                      <Setter Property="Opacity" Value="0" />
                                                      <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsMouseOver, ElementName=catalogueClaimRow}"
                                                                      Value="True">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                         </DataTrigger>
                                                      </Style.Triggers>
                                                   </Style>
                                                </fa:FontAwesome.Style>
                                             </fa:FontAwesome>

                                             <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                                <TextBlock Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource primaryCellStyle}"
                                                           ToolTip="{Binding Key}" />
                                                <TextBlock Text="{Binding UsageCaption}" Margin="0,2,0,0"
                                                           Style="{StaticResource secondaryCellStyle}" />
                                             </StackPanel>
                                             <fa:FontAwesome Grid.Column="2" Icon="Solid_Check" FontSize="12"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource successBrush}"
                                                             Visibility="{Binding IsGranted,
                                                                                  Converter={StaticResource boolToVisibility}}"
                                                             ToolTip="The open role carries this claim" />
                                          </Grid>
                                       </StackPanel>
                                    </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                              </ItemsControl>
                           </StackPanel>
                        </Border>
                     </DataTemplate>
                  </ItemsControl.ItemTemplate>
               </ItemsControl>
            </ScrollViewer>

            <!-- ==== sheet footer ====
                 How much there is, and where it came from. The catalogue is not a table
                 anybody edits - it is whatever the modules registered when the server
                 started - so the footer says that rather than offering a button. -->
            <Border Grid.Row="3" BorderBrush="{StaticResource dividerBrush}" BorderThickness="0,1,0,0">
               <StackPanel Margin="22,12">
                  <TextBlock Text="{Binding CatalogueSummaryCaption}"
                             Style="{StaticResource secondaryCellStyle}" />
                  <TextBlock Text="Declared by the modules themselves; the list changes only when a module does. Drag a claim - or a whole module - over the tab behind to grant it."
                             Style="{StaticResource fieldHelpStyle}"
                             Margin="0,3,0,0" />
               </StackPanel>
            </Border>
         </Grid>
      </Border>

      <!-- Last child of the outer grid and spanning both of its rows, so it covers the toolbar,
           the rail, the detail pane and the sheet alike: until the server has answered there is
           nothing here worth touching. Without the span it would land in the auto sized toolbar
           row and push the toolbar open instead of covering the screen. -->
      <controls:WaitOverlay Grid.Row="0" Grid.RowSpan="2"
                            IsWaiting="{Binding InWaiting}"
                            Caption="{Binding WaiterText}" />
   </Grid>
</UserControl>
