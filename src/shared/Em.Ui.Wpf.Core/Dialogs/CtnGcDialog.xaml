<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.CtnGcDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                  xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                  xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
                  xmlns:conv="clr-namespace:Em.Ui.Wpf.Converters"
                  xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                  mc:Ignorable="d"
                  Title="Garbage Collection"
                  Width="640"
                  Height="620"
                  MinWidth="480"
                  MinHeight="420"
                  ResizeMode="CanResize"
                  ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner">

   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <conv:InverseBoolToVisibilityConverter x:Key="inverseBoolToVisibility" />

         <Style x:Key="gcMonoStyle" TargetType="TextBlock" BasedOn="{StaticResource secondaryCellStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
         </Style>

         <Style x:Key="gcLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource secondaryCellStyle}">
            <Setter Property="Margin" Value="0,0,16,4" />
         </Style>

         <Style x:Key="gcValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="13" />
         </Style>
      </ResourceDictionary>
   </windows:EmWindow.Resources>

   <windows:EmWindow.DataContext>
      <local:CtnGcDialogVm />
   </windows:EmWindow.DataContext>

   <Grid>
      <Grid Margin="22,4,22,22">
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
         </Grid.RowDefinitions>

         <!-- ==== banner ==== -->
         <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="42" Height="42" VerticalAlignment="Center">
               <Border CornerRadius="12" Opacity="0.18" Background="{DynamicResource themeAccentBrush}" />
               <fa:FontAwesome Icon="Solid_Broom"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource themeAccentBrush}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
               <TextBlock Text="Garbage Collection" FontSize="16" FontWeight="SemiBold" />
               <TextBlock Text="Frees disk space held by blobs no manifest uses, stale uploads and leftover files. Review first; nothing is deleted until you run it."
                          Margin="0,4,0,0"
                          FontSize="12.5"
                          Opacity="0.75"
                          TextWrapping="Wrap" />
            </StackPanel>
         </Grid>

         <!-- ==== grace period ==== -->
         <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <Grid>
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="Auto" />
               </Grid.ColumnDefinitions>
               <TextBlock Text="Grace period (hours)"
                          Style="{StaticResource fieldLabelStyle}"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center" />
               <controls:NumericBox Grid.Column="1"
                                    Style="{StaticResource fieldNumericBoxStyle}"
                                    Minimum="1"
                                    Maximum="720"
                                    Increment="1"
                                    Value="{Binding GraceHours, UpdateSourceTrigger=PropertyChanged}" />
               <Button Grid.Column="2"
                       Style="{StaticResource outlinedButtonStyle}"
                       Margin="8,0,0,0"
                       Command="{Binding Commands[ReviewCommand]}"
                       AutomationProperties.Name="Review">
                  <StackPanel Orientation="Horizontal">
                     <fa:FontAwesome Icon="Solid_MagnifyingGlass" Style="{StaticResource buttonIconStyle}" />
                     <TextBlock Text="Review" VerticalAlignment="Center" />
                  </StackPanel>
               </Button>
            </Grid>
            <TextBlock Text="Only items older than this are removed, so pushes in progress are not touched."
                       Style="{StaticResource fieldHelpStyle}" />
         </StackPanel>

         <!-- ==== error ==== -->
         <TextBlock Grid.Row="2"
                    Margin="0,12,0,0"
                    Text="{Binding ErrorText}"
                    Foreground="{StaticResource dangerBrush}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasError, Converter={StaticResource boolToVisibility}}" />

         <!-- ==== summary ==== -->
         <StackPanel Grid.Row="3"
                     Margin="0,16,0,0"
                     Visibility="{Binding HasReport, Converter={StaticResource boolToVisibility}}">
            <TextBlock Text="{Binding ResultTitle}"
                       Margin="0,0,0,8"
                       Style="{StaticResource sectionCaptionStyle}" />
            <Grid Visibility="{Binding IsEmpty, Converter={StaticResource inverseBoolToVisibility}}">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
               </Grid.ColumnDefinitions>
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
               </Grid.RowDefinitions>

               <TextBlock Grid.Row="0" Text="Orphaned blobs" Style="{StaticResource gcLabelStyle}" />
               <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BlobsCaption}" Style="{StaticResource gcValueStyle}" />
               <TextBlock Grid.Row="1" Text="Stale uploads" Style="{StaticResource gcLabelStyle}" />
               <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UploadsCaption}" Style="{StaticResource gcValueStyle}" />
               <TextBlock Grid.Row="2" Text="Leftover blob files" Style="{StaticResource gcLabelStyle}" />
               <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrphanBlobFilesCaption}" Style="{StaticResource gcValueStyle}" />
               <TextBlock Grid.Row="3" Text="Leftover upload files" Style="{StaticResource gcLabelStyle}" />
               <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OrphanUploadFilesCaption}" Style="{StaticResource gcValueStyle}" />

               <Border Grid.Row="4" Grid.ColumnSpan="2"
                       Height="1"
                       Margin="0,4,0,8"
                       Opacity="0.2"
                       Background="{DynamicResource themeWindowForegroundBrush}" />

               <TextBlock Grid.Row="5" Text="Total" Style="{StaticResource gcLabelStyle}" FontWeight="SemiBold" />
               <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TotalCaption}"
                          Style="{StaticResource gcValueStyle}" FontWeight="SemiBold" />
            </Grid>
            <TextBlock Text="{Binding EmptyCaption}"
                       Style="{StaticResource secondaryCellStyle}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource boolToVisibility}}" />
         </StackPanel>

         <!-- ==== blob list ==== -->
         <Grid Grid.Row="4"
               Margin="0,12,0,0"
               Visibility="{Binding ShowList, Converter={StaticResource boolToVisibility}}">
            <Grid.RowDefinitions>
               <RowDefinition Height="*" />
               <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource innerCardStyle}" ClipToBounds="True">
            <ListBox Style="{StaticResource surfaceListBoxStyle}"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource listRowStyle}"
                     ItemsSource="{Binding ListedBlobs}"
                     VirtualizingPanel.IsVirtualizing="True">
               <ListBox.ItemTemplate>
                  <DataTemplate>
                     <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="*" />
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto" />
                           <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding ShortDigest}"
                                   Style="{StaticResource gcMonoStyle}"
                                   ToolTip="{Binding Digest}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource rowActionButtonStyle}"
                                Margin="4,0,0,0"
                                ToolTip="Copy digest"
                                AutomationProperties.Name="Copy digest"
                                Command="{Binding DataContext.Commands[CopyDigestCommand], RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}">
                           <fa:FontAwesome Icon="Regular_Copy" />
                        </Button>
                        <TextBlock Grid.Column="3" Text="{Binding SizeCaption}"
                                   Style="{StaticResource secondaryCellStyle}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding CreatedCaption}"
                                   Style="{StaticResource secondaryCellStyle}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="5"
                                   Text="{Binding LinkedCaption}"
                                   Style="{StaticResource secondaryCellStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LinkedCaption}" />
                     </Grid>
                  </DataTemplate>
               </ListBox.ItemTemplate>
            </ListBox>
            </Border>
            <TextBlock Grid.Row="1"
                       Margin="0,6,0,0"
                       Text="{Binding TruncatedCaption}"
                       Style="{StaticResource secondaryCellStyle}"
                       Visibility="{Binding ShowTruncated, Converter={StaticResource boolToVisibility}}" />
         </Grid>

         <!-- ==== warnings ==== -->
         <ScrollViewer Grid.Row="5"
                       MaxHeight="96"
                       Margin="0,10,0,0"
                       VerticalScrollBarVisibility="Auto"
                       Visibility="{Binding HasWarnings, Converter={StaticResource boolToVisibility}}">
            <TextBlock Text="{Binding WarningsText}"
                       Foreground="{StaticResource warningBrush}"
                       TextWrapping="Wrap" />
         </ScrollViewer>

         <!-- ==== actions ==== -->
         <StackPanel Grid.Row="6"
                     Margin="0,18,0,0"
                     Orientation="Horizontal"
                     HorizontalAlignment="Right">
            <Button Style="{StaticResource textButtonStyle}"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Close" />
            <Button Style="{StaticResource dangerOutlinedButtonStyle}"
                    Command="{Binding Commands[RunCommand]}"
                    AutomationProperties.Name="Run garbage collection">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_Broom" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Run garbage collection" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
         </StackPanel>
      </Grid>

      <controls:WaitOverlay IsWaiting="{Binding InWaiting}" Caption="{Binding WaiterText}" />
   </Grid>
</windows:EmWindow>
