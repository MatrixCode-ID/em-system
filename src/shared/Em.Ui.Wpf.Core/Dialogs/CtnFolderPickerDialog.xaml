<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.CtnFolderPickerDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                    xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                    xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                    mc:Ignorable="d"
                    Title="{Binding Title}"
                    Width="460"
                    Height="520"
                    MinHeight="360"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">

   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <Style x:Key="choiceItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                     <Border x:Name="stateLayer"
                             MinHeight="36"
                             Margin="6,1"
                             CornerRadius="8"
                             Background="Transparent">
                        <ContentPresenter Margin="10,0" VerticalAlignment="Center" />
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="stateLayer" Property="Background" Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                           <Setter TargetName="stateLayer" Property="Background" Value="{StaticResource statePressedBrush}" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>
      </ResourceDictionary>
   </windows:EmWindow.Resources>

   <windows:EmWindow.DataContext>
      <local:CtnFolderPickerDialogVm />
   </windows:EmWindow.DataContext>

   <Grid Margin="22,4,22,22">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ==== banner ==== -->
      <Grid Grid.Row="0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>

         <Grid Width="42" Height="42" VerticalAlignment="Center">
            <Border CornerRadius="12" Opacity="0.18" Background="{DynamicResource themeAccentBrush}" />
            <fa:FontAwesome Icon="Solid_FolderTree"
                            FontSize="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource themeAccentBrush}" />
         </Grid>

         <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Caption}"
                       Margin="0,4,0,0"
                       FontSize="12.5"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
         </StackPanel>
      </Grid>

      <!-- ==== choices ==== -->
      <Border Grid.Row="1"
              Margin="0,18,0,0"
              Style="{StaticResource innerCardStyle}">
         <ListBox Background="Transparent"
                  Style="{StaticResource surfaceListBoxStyle}"
                  BorderThickness="0"
                  Padding="0,6"
                  ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding Selected}"
                  ItemContainerStyle="{StaticResource choiceItemStyle}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
               <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                     <fa:FontAwesome Icon="{Binding Icon}"
                                     Width="20"
                                     FontSize="14"
                                     Opacity="0.8"
                                     Foreground="{DynamicResource themeAccentBrush}"
                                     VerticalAlignment="Center" />
                     <TextBlock Text="{Binding Label}"
                                Margin="8,0,0,0"
                                Style="{StaticResource primaryCellStyle}" />
                  </StackPanel>
               </DataTemplate>
            </ListBox.ItemTemplate>
         </ListBox>
      </Border>

      <!-- ==== actions ==== -->
      <StackPanel Grid.Row="2"
                  Margin="0,18,0,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
         <Button Style="{StaticResource textButtonStyle}"
                 Margin="0,0,8,0"
                 IsCancel="True"
                 Content="Cancel" />
         <Button Style="{StaticResource filledButtonStyle}"
                 MinWidth="96"
                 IsDefault="True"
                 Command="{Binding Commands[OkCommand]}"
                 Content="Move here" />
      </StackPanel>
   </Grid>
</windows:EmWindow>
