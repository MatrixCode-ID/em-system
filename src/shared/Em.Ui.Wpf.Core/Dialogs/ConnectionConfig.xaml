<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.ConnectionConfig"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                    xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                    xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                    mc:Ignorable="d"
                    Title="API Server Connections"
                    Width="760"
                    Height="520"
                    MinWidth="640"
                    MinHeight="420"
                    ResizeMode="CanResize"
                    ShowMinimizeButton="False"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">


   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <Style x:Key="listCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="VerticalAlignment" Value="Center" />
         </Style>

         <Style x:Key="connectionRowStyle" TargetType="ListBoxItem">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                     <Border x:Name="row"
                             Height="42"
                             Margin="6,1"
                             Padding="16,0"
                             CornerRadius="8"
                             Background="Transparent">
                        <Border.InputBindings>
                           <MouseBinding MouseAction="LeftDoubleClick"
                                         Command="{Binding DataContext.Commands[EditConnectionCommand], RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Border.InputBindings>
                        <ContentPresenter VerticalAlignment="Center" />
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="row" Property="Background" Value="{StaticResource stateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                           <Setter TargetName="row" Property="Background" Value="{StaticResource statePressedBrush}" />
                           <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <Style x:Key="emptyListTextStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding ApiConnections.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
               </DataTrigger>
            </Style.Triggers>
         </Style>
      </ResourceDictionary>
   </windows:EmWindow.Resources>

   <windows:EmWindow.DataContext>
      <local:ConnectionConfigVm />
   </windows:EmWindow.DataContext>

   <Grid Margin="22,4,22,22">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ==== banner ==== -->
      <Border Grid.Row="0"
              CornerRadius="14"
              Padding="18,16"
              Background="{StaticResource surfaceStrongBrush}"
              BorderBrush="{StaticResource outlineBrush}"
              BorderThickness="1">
         <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="42" Height="42" VerticalAlignment="Center">
               <Border CornerRadius="12" Opacity="0.18" Background="{DynamicResource themeAccentBrush}" />
               <fa:FontAwesome Icon="Solid_Plug"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource themeAccentBrush}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
               <TextBlock Text="API Server Connections"
                          FontSize="16"
                          FontWeight="SemiBold" />
               <TextBlock Text="Manage the Web API server connection profiles used by the application."
                          Margin="0,4,0,0"
                          FontSize="12.5"
                          Opacity="0.75"
                          TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="2"
                    Style="{StaticResource tonalButtonStyle}"
                    Command="{Binding Commands[AddConnectionCommand]}">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_Plus" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Add" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
         </Grid>
      </Border>

      <!-- ==== list ==== -->
      <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource cardStyle}">
         <Grid>
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto" />
               <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="38"
                    Padding="22,0"
                    Background="{StaticResource surfaceStrongBrush}"
                    BorderBrush="{StaticResource dividerBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0">
               <Grid>
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="180" />
                     <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="PROFILE" Style="{StaticResource listCaptionStyle}" />
                  <TextBlock Grid.Column="1" Text="SERVER URL" Style="{StaticResource listCaptionStyle}" />
                  <TextBlock Grid.Column="2" Text="TIMEOUT (S)" Style="{StaticResource listCaptionStyle}" />
               </Grid>
            </Border>

            <ListBox Grid.Row="1"
                     Padding="0,4"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource connectionRowStyle}"
                     ItemsSource="{Binding ApiConnections}"
                     SelectedItem="{Binding SelectedApiConnection, Mode=TwoWay}">
               <ListBox.ItemTemplate>
                  <DataTemplate>
                     <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="180" />
                           <ColumnDefinition Width="*" />
                           <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="0,0,12,0"
                                   Text="{Binding ProfileName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Margin="0,0,12,0"
                                   Opacity="0.8"
                                   Text="{Binding Host}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Host}" />
                        <TextBlock Grid.Column="2"
                                   Opacity="0.8"
                                   Text="{Binding Timeout}" />
                     </Grid>
                  </DataTemplate>
               </ListBox.ItemTemplate>
               <ListBox.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                     <MenuItem Header="Edit" Command="{Binding Commands[EditConnectionCommand]}" />
                     <MenuItem Header="Delete" Command="{Binding Commands[DeleteConnectionCommand]}" />
                  </ContextMenu>
               </ListBox.ContextMenu>
            </ListBox>

            <TextBlock Grid.Row="1"
                       Text="No connection profiles yet"
                       Style="{StaticResource emptyListTextStyle}" />
         </Grid>
      </Border>

      <!-- ==== actions ==== -->
      <StackPanel Grid.Row="2"
                  Margin="0,18,0,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
         <Button Style="{StaticResource outlinedButtonStyle}"
                 MinWidth="104"
                 IsCancel="True"
                 Content="Close" />
      </StackPanel>
   </Grid>
</windows:EmWindow>
