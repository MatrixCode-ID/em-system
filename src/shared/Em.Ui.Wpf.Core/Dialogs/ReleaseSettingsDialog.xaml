<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.ReleaseSettingsDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                    xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                    xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                    xmlns:conv="clr-namespace:Em.Ui.Wpf.Converters"
                    mc:Ignorable="d"
                    Title="Release Settings"
                    Width="900"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">

   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <conv:InverseBoolToVisibilityConverter x:Key="inverseBoolToVisibility" />

         <Style x:Key="settingCardStyle" TargetType="Border" BasedOn="{StaticResource cardStyle}">
            <Setter Property="Padding" Value="18,14,18,16" />
         </Style>

         <Style x:Key="pathBoxStyle" TargetType="TextBox" BasedOn="{StaticResource fieldBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12" />
         </Style>

         <Style x:Key="browseButtonStyle" TargetType="Button" BasedOn="{StaticResource compactOutlinedButtonStyle}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Content" Value="Browse" />
         </Style>

         <Style x:Key="noteStyle" TargetType="TextBlock" BasedOn="{StaticResource fieldHelpStyle}">
            <Setter Property="Margin" Value="2,10,0,0" />
         </Style>

         <Style x:Key="warningNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource noteStyle}">
            <Setter Property="Foreground" Value="{StaticResource warningBrush}" />
            <Setter Property="Opacity" Value="1" />
         </Style>

         <Style x:Key="exportableChipStyle" TargetType="Border" BasedOn="{StaticResource chipMutedStyle}">
            <Style.Triggers>
               <DataTrigger Binding="{Binding SelectedKey.IsExportable}" Value="True">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="BorderBrush" Value="{StaticResource warningBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource warningBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>
      </ResourceDictionary>
   </windows:EmWindow.Resources>

   <windows:EmWindow.DataContext>
      <local:ReleaseSettingsDialogVm />
   </windows:EmWindow.DataContext>

   <ScrollViewer MaxHeight="860" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="22,4,22,22">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ==== banner ==== -->
      <Grid Grid.Row="0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>

         <Grid Width="42" Height="42" VerticalAlignment="Center">
            <Border CornerRadius="12" Opacity="0.18" Background="{DynamicResource themeAccentBrush}" />
            <fa:FontAwesome Icon="Solid_Gear"
                            FontSize="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource themeAccentBrush}" />
         </Grid>

         <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding BannerTitle}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Where Prepare publishes, where Sync writes the release, and the key that signs it."
                       Margin="0,4,0,0"
                       FontSize="12.5"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
         </StackPanel>
      </Grid>

      <!-- ==== source and target ==== -->
      <Grid Grid.Row="1" Margin="0,20,0,0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>

         <Border Grid.Column="0" Style="{StaticResource settingCardStyle}">
            <StackPanel>
               <TextBlock Text="SOURCE" Style="{StaticResource sectionCaptionStyle}" Margin="2,0,0,12" />

               <TextBlock Text="Solution (.slnx)" Style="{StaticResource fieldLabelStyle}" />
               <Grid>
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Style="{StaticResource pathBoxStyle}" Text="{Binding SolutionPath, Mode=OneWay}"
                           ToolTip="{Binding SolutionPath}" />
                  <Button Grid.Column="1" Style="{StaticResource browseButtonStyle}"
                          Command="{Binding Commands[BrowseSolutionCommand]}" />
               </Grid>

               <TextBlock Text="Host project" Style="{StaticResource fieldLabelStyle}" Margin="2,12,0,6" />
               <ComboBox Style="{StaticResource fieldComboStyle}"
                         Height="36"
                         ItemsSource="{Binding HostProjects}"
                         SelectedItem="{Binding HostProject}" />

               <TextBlock Text="Local publish folder" Style="{StaticResource fieldLabelStyle}" Margin="2,12,0,6" />
               <Grid>
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Style="{StaticResource pathBoxStyle}" Text="{Binding PublishFolder, Mode=OneWay}"
                           ToolTip="{Binding PublishFolder}" />
                  <Button Grid.Column="1" Style="{StaticResource browseButtonStyle}"
                          Command="{Binding Commands[BrowsePublishFolderCommand]}" />
               </Grid>

               <TextBlock Text="{Binding SdkCaption}" Style="{StaticResource noteStyle}"
                          Visibility="{Binding IsSdkMissing, Converter={StaticResource inverseBoolToVisibility}}" />
               <TextBlock Text="{Binding SdkCaption}" Style="{StaticResource warningNoteStyle}"
                          Visibility="{Binding IsSdkMissing, Converter={StaticResource boolToVisibility}}" />
            </StackPanel>
         </Border>

         <Border Grid.Column="2" Style="{StaticResource settingCardStyle}">
            <StackPanel>
               <TextBlock Text="TARGET" Style="{StaticResource sectionCaptionStyle}" Margin="2,0,0,12" />

               <Border CornerRadius="15"
                       Padding="2"
                       HorizontalAlignment="Left"
                       Background="{StaticResource surfaceBrush}"
                       BorderBrush="{StaticResource outlineBrush}"
                       BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                     <RadioButton GroupName="releaseTarget" Style="{StaticResource segmentStyle}"
                                  Content="Server CDN"
                                  IsChecked="{Binding IsCdnTarget}"
                                  IsEnabled="{Binding CanUseCdn}"
                                  ToolTip="{Binding CdnOptionTooltip}"
                                  ToolTipService.ShowOnDisabled="True" />
                     <RadioButton GroupName="releaseTarget" Style="{StaticResource segmentStyle}"
                                  Content="Folder"
                                  IsChecked="{Binding IsFolderTarget}"
                                  ToolTip="Publish to a local or network folder" />
                  </StackPanel>
               </Border>

               <StackPanel Visibility="{Binding IsFolderTarget, Converter={StaticResource boolToVisibility}}">
                  <TextBlock Text="Target folder" Style="{StaticResource fieldLabelStyle}" Margin="2,12,0,6" />
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                     </Grid.ColumnDefinitions>
                     <TextBox Style="{StaticResource pathBoxStyle}" Text="{Binding TargetFolder, Mode=OneWay}"
                              ToolTip="{Binding TargetFolder}" />
                     <Button Grid.Column="1" Style="{StaticResource browseButtonStyle}"
                             Command="{Binding Commands[BrowseTargetFolderCommand]}" />
                  </Grid>
               </StackPanel>

               <TextBlock Text="Release folder" Style="{StaticResource fieldLabelStyle}" Margin="2,12,0,6" />
               <TextBox Style="{StaticResource fieldBoxStyle}"
                        Height="36"
                        FontSize="12"
                        Tag="wpf-release"
                        Text="{Binding ReleaseFolder, UpdateSourceTrigger=PropertyChanged}" />

               <TextBlock Text="{Binding TargetCaption}" Style="{StaticResource noteStyle}"
                          Visibility="{Binding IsTargetBlocked, Converter={StaticResource inverseBoolToVisibility}}" />
               <TextBlock Text="{Binding TargetCaption}" Style="{StaticResource warningNoteStyle}"
                          Visibility="{Binding IsTargetBlocked, Converter={StaticResource boolToVisibility}}" />
            </StackPanel>
         </Border>
      </Grid>

      <!-- ==== signing key ==== -->
      <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource settingCardStyle}">
         <StackPanel>
            <Grid Margin="2,0,0,12">
               <TextBlock Text="SIGNING KEY" Style="{StaticResource sectionCaptionStyle}" VerticalAlignment="Center" />
               <Button Style="{StaticResource rowActionButtonStyle}"
                       HorizontalAlignment="Right"
                       Margin="0,-8,-8,-8"
                       Command="{Binding Commands[RefreshKeysCommand]}"
                       ToolTip="Read the installed keys again">
                  <fa:FontAwesome Icon="Solid_ArrowsRotate" />
               </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
               <RadioButton GroupName="keySource" Style="{StaticResource segmentStyle}" Content="Windows certificate store" IsChecked="{Binding IsStoreSource}"/>
               <RadioButton GroupName="keySource" Style="{StaticResource segmentStyle}" Content="Key file in this profile" IsChecked="{Binding IsFileSource}"/>
            </StackPanel>
            <Grid>
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="Auto" />
               </Grid.ColumnDefinitions>

               <StackPanel Grid.Column="0">
                  <TextBlock Text="Key" Style="{StaticResource fieldLabelStyle}" />
                  <ComboBox Visibility="{Binding IsStoreSource, Converter={StaticResource boolToVisibility}}" Style="{StaticResource fieldComboStyle}"
                            Height="36"
                            ItemsSource="{Binding SigningKeys}"
                            SelectedItem="{Binding SelectedKey}"
                            DisplayMemberPath="Caption" />

                  <Grid Margin="2,12,0,0" Visibility="{Binding HasSigningKey, Converter={StaticResource boolToVisibility}}">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>
                     <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="KEY ID" Style="{StaticResource metaLabelStyle}" />
                        <TextBlock Text="{Binding SelectedKey.KeyId}" Style="{StaticResource metaValueStyle}" FontFamily="Consolas" />
                     </StackPanel>
                     <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="EXPIRES" Style="{StaticResource metaLabelStyle}" />
                        <TextBlock Text="{Binding SelectedKey.ExpiresCaption}" Style="{StaticResource metaValueStyle}" />
                     </StackPanel>
                     <Border Grid.Column="2" Style="{StaticResource exportableChipStyle}" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding SelectedKey.ExportableCaption}" />
                     </Border>
                  </Grid>

                  <TextBlock Text="{Binding SigningCaption}" Style="{StaticResource noteStyle}" FontFamily="Consolas"
                             Visibility="{Binding HasSigningKey, Converter={StaticResource boolToVisibility}}" />
                  <TextBlock Text="{Binding SigningCaption}" Style="{StaticResource warningNoteStyle}"
                             Visibility="{Binding HasSigningKey, Converter={StaticResource inverseBoolToVisibility}}" />
               </StackPanel>

               <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,22,0,0">
                  <StackPanel Orientation="Horizontal">
                     <Button Style="{StaticResource compactOutlinedButtonStyle}" Margin="0,0,8,0"
                             Command="{Binding Commands[ImportKeyCommand]}"
                             ToolTip="Install a signing key from a .pfx file">
                        <StackPanel Orientation="Horizontal">
                           <fa:FontAwesome Icon="Solid_FileImport" Style="{StaticResource buttonIconStyle}" />
                           <TextBlock Text="Import" VerticalAlignment="Center" />
                        </StackPanel>
                     </Button>
                     <Button Style="{StaticResource compactOutlinedButtonStyle}" Margin="0,0,8,0"
                             Command="{Binding Commands[CreateKeyCommand]}"
                             ToolTip="Create a new signing key and save it as a .pfx file">
                        <StackPanel Orientation="Horizontal">
                           <fa:FontAwesome Icon="Solid_Key" Style="{StaticResource buttonIconStyle}" />
                           <TextBlock Text="Create" VerticalAlignment="Center" />
                        </StackPanel>
                     </Button>
                     <Button Style="{StaticResource compactOutlinedButtonStyle}"
                             Command="{Binding Commands[ExportKeyCommand]}"
                             ToolTip="{Binding ExportKeyTooltip}"
                             ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                           <fa:FontAwesome Icon="Solid_FileExport" Style="{StaticResource buttonIconStyle}" />
                           <TextBlock Text="Export" VerticalAlignment="Center" />
                        </StackPanel>
                     </Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                     <Button Style="{StaticResource compactOutlinedButtonStyle}" Margin="0,0,8,0"
                             Command="{Binding Commands[CopyPublicKeyCommand]}"
                             ToolTip="Copy the public key (PEM) to the clipboard, for the launcher">
                        <StackPanel Orientation="Horizontal">
                           <fa:FontAwesome Icon="Regular_Copy" Style="{StaticResource buttonIconStyle}" />
                           <TextBlock Text="Copy public key" VerticalAlignment="Center" />
                        </StackPanel>
                     </Button>
                     <Button Style="{StaticResource compactOutlinedButtonStyle}"
                             Command="{Binding Commands[ExportPublicKeyCommand]}"
                             ToolTip="Save the public key (PEM) to a file, for the launcher">
                        <StackPanel Orientation="Horizontal">
                           <fa:FontAwesome Icon="Solid_Download" Style="{StaticResource buttonIconStyle}" />
                           <TextBlock Text="Export public key" VerticalAlignment="Center" />
                        </StackPanel>
                     </Button>
                  </StackPanel>
               </StackPanel>
            </Grid>
            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsFileSource, Converter={StaticResource boolToVisibility}}">
               <Button HorizontalAlignment="Left" Style="{StaticResource textDangerButtonStyle}" Content="Remove key file" Command="{Binding Commands[RemoveKeyFileCommand]}"/>
               <TextBlock Text="Password" Style="{StaticResource fieldLabelStyle}" Margin="2,8,0,6"/>
               <StackPanel Orientation="Horizontal">
                  <RadioButton GroupName="keyPassword" Style="{StaticResource segmentStyle}" Content="Ask once per session" IsChecked="{Binding IsSeparatePassword}"/>
                  <RadioButton GroupName="keyPassword" Style="{StaticResource segmentStyle}" Content="Save as plain text in profile.json" IsChecked="{Binding IsPlaintextPassword}"/>
               </StackPanel>
               <TextBlock Text="Anyone who can read or copy this profile folder can sign releases." Style="{StaticResource warningNoteStyle}" Visibility="{Binding IsPlaintextPassword, Converter={StaticResource boolToVisibility}}"/>
               <TextBlock Text="{Binding PasswordCaption}" Style="{StaticResource noteStyle}"/>
               <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource compactOutlinedButtonStyle}" Content="Set password..." Command="{Binding Commands[SetPasswordCommand]}" Visibility="{Binding IsPlaintextPassword, Converter={StaticResource boolToVisibility}}"/>
               <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource compactOutlinedButtonStyle}" Content="Forget remembered password" Command="{Binding Commands[ForgetPasswordCommand]}" Visibility="{Binding IsSeparatePassword, Converter={StaticResource boolToVisibility}}"/>
            </StackPanel>
         </StackPanel>
      </Border>

      <!-- ==== actions ==== -->
      <StackPanel Grid.Row="3"
                  Margin="0,22,0,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
         <Button Style="{StaticResource answerButtonStyle}"
                 MinWidth="88"
                 IsCancel="True"
                 Content="Cancel" />
         <Button Style="{StaticResource confirmAnswerButtonStyle}"
                 Margin="8,0,0,0"
                 MinWidth="88"
                 IsDefault="True"
                 Command="{Binding Commands[SaveCommand]}"
                 Content="Save" />
      </StackPanel>
   </Grid>
   </ScrollViewer>
</windows:EmWindow>
