<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.BusinessTaskStatusDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                    xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                    xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                    mc:Ignorable="d"
                    Title="Task Status"
                    Width="520"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">

   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <Style x:Key="plateTintStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Opacity" Value="0.18" />
            <Setter Property="Background" Value="{DynamicResource themeAccentBrush}" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding Item.Status}" Value="Succeeded">
                  <Setter Property="Background" Value="{StaticResource successBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Item.Status}" Value="Failed">
                  <Setter Property="Background" Value="{StaticResource dangerBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <Style x:Key="plateIconStyle" TargetType="fa:FontAwesome">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource themeAccentBrush}" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding Item.Status}" Value="Running">
                  <Setter Property="Spin" Value="True" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Item.Status}" Value="Succeeded">
                  <Setter Property="Foreground" Value="{StaticResource successBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Item.Status}" Value="Failed">
                  <Setter Property="Foreground" Value="{StaticResource dangerBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>
      </ResourceDictionary>
   </windows:EmWindow.Resources>

   <windows:EmWindow.DataContext>
      <local:BusinessTaskStatusDialogVm />
   </windows:EmWindow.DataContext>

   <Grid Margin="22,4,22,22">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ==== banner ==== -->
      <Grid Grid.Row="0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>

         <Grid Width="42" Height="42" VerticalAlignment="Center">
            <Border Style="{StaticResource plateTintStyle}" />
            <fa:FontAwesome Icon="{Binding Item.StatusIcon}" Style="{StaticResource plateIconStyle}" />
         </Grid>

         <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Item.Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Item.Title}" />
            <TextBlock Text="{Binding Item.StatusCaption}"
                       Margin="0,4,0,0"
                       FontSize="12.5"
                       Opacity="0.75" />
         </StackPanel>
      </Grid>

      <!-- ==== detail ==== -->
      <Border Grid.Row="1" Margin="0,18,0,0" Padding="18,16" Style="{StaticResource cardStyle}">
         <StackPanel>
            <Grid>
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
               </Grid.ColumnDefinitions>

               <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="STARTED" Style="{StaticResource metaLabelStyle}" />
                  <TextBlock Text="{Binding Item.StartedCaption}" Style="{StaticResource metaValueStyle}" />
               </StackPanel>
               <StackPanel Grid.Column="1">
                  <TextBlock Text="FINISHED" Style="{StaticResource metaLabelStyle}" />
                  <TextBlock Text="{Binding Item.FinishedCaption}" Style="{StaticResource metaValueStyle}" />
               </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding Item.IsAlive, Converter={StaticResource boolToVisibility}}">
               <ProgressBar Style="{StaticResource hairlineProgressStyle}"
                            Value="{Binding Item.Percent, Mode=OneWay}"
                            IsIndeterminate="{Binding Item.IsIndeterminate, Mode=OneWay}" />
               <TextBlock Margin="0,6,0,0"
                          FontSize="12.5"
                          Opacity="0.75"
                          TextWrapping="Wrap"
                          Text="{Binding Item.Caption}" />
            </StackPanel>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding Item.IsFailed, Converter={StaticResource boolToVisibility}}">
               <TextBlock Text="ERROR" Margin="0,0,0,8" Style="{StaticResource sectionCaptionStyle}" />
               <Border CornerRadius="10"
                       Padding="12,10"
                       Background="{StaticResource dangerChipBrush}"
                       BorderBrush="{StaticResource dangerBrush}"
                       BorderThickness="1">
                  <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                     <TextBox Text="{Binding Item.ErrorMessage, Mode=OneWay}"
                              IsReadOnly="True"
                              TextWrapping="Wrap"
                              BorderThickness="0"
                              Background="Transparent"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                              FontFamily="Consolas"
                              FontSize="12" />
                  </ScrollViewer>
               </Border>
            </StackPanel>

            <TextBlock Margin="0,16,0,0"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Text="{Binding StateMessage}"
                       Visibility="{Binding HasStateMessage, Converter={StaticResource boolToVisibility}}" />
         </StackPanel>
      </Border>

      <!-- ==== actions ==== -->
      <Grid Grid.Row="2" Margin="0,22,0,0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>

         <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button Style="{StaticResource dangerOutlinedButtonStyle}"
                    Visibility="{Binding Item.CanCancel, Converter={StaticResource boolToVisibility}}"
                    Command="{Binding Commands[CancelTaskCommand]}">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_Xmark" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Cancel Task" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
            <Button Style="{StaticResource textDangerButtonStyle}"
                    Visibility="{Binding Item.CanClear, Converter={StaticResource boolToVisibility}}"
                    Command="{Binding Commands[ClearTaskCommand]}">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_Broom" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Clear" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
         </StackPanel>

         <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource outlinedButtonStyle}"
                    MinWidth="96"
                    IsCancel="True"
                    Content="Close" />
            <Button Style="{StaticResource filledButtonStyle}"
                    Margin="10,0,0,0"
                    Visibility="{Binding Item.CanDownload, Converter={StaticResource boolToVisibility}}"
                    Command="{Binding Commands[DownloadResultCommand]}">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_Download" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Download" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
            <Button Style="{StaticResource filledButtonStyle}"
                    Margin="10,0,0,0"
                    Visibility="{Binding Item.CanOpen, Converter={StaticResource boolToVisibility}}"
                    Command="{Binding Commands[OpenResultCommand]}">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_FolderOpen" Style="{StaticResource buttonIconStyle}" />
                  <TextBlock Text="Open" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
         </StackPanel>
      </Grid>
   </Grid>
</windows:EmWindow>
