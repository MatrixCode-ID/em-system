<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.ApprovalDecisionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
 Title="{Binding Title}" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner"
 ShowMinimizeButton="False" ShowMaximizeButton="False" ResizeMode="NoResize">
 <windows:EmWindow.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/></ResourceDictionary.MergedDictionaries>
 </ResourceDictionary></windows:EmWindow.Resources>
 <StackPanel Margin="24">
  <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,16" Opacity="0.65" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding NoteCaption}" Style="{StaticResource fieldLabelStyle}" Margin="0,0,0,6"/>
  <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource fieldBoxStyle}" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="1000"/>
  <TextBlock Text="{Binding Hint}" Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button Content="Cancel" IsCancel="True" Style="{StaticResource outlinedButtonStyle}" Margin="0,0,10,0"/>
   <Button Content="{Binding Action}" IsDefault="True" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[ConfirmCommand]}"/>
  </StackPanel>
 </StackPanel>
</windows:EmWindow>
