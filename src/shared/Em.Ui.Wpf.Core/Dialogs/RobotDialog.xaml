<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.RobotDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                    xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                    xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                    mc:Ignorable="d"
                    Title="{Binding Title}"
                    Width="480"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">

   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <Style x:Key="ownerResultStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                     <Border x:Name="row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ContentPresenter />
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource stateHoverBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource statePressedBrush}" /></Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <Style x:Key="ownerComboStyle" TargetType="ComboBox" BasedOn="{StaticResource fieldComboStyle}">
            <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ComboBox">
                     <Grid>
                        <ToggleButton Style="{StaticResource fieldComboToggleStyle}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="14,0,32,0" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True"
                               Focusable="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                           <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   Style="{StaticResource fieldPopupBorderStyle}"
                                   TextElement.Foreground="{DynamicResource themeWindowForegroundBrush}">
                              <StackPanel>
                                 <TextBox x:Name="ownerSearchBox" Margin="4" Style="{StaticResource fieldBoxStyle}"
                                          Tag="Search user account" Text="{Binding OwnerSearch, UpdateSourceTrigger=PropertyChanged}"
                                          PreviewKeyDown="OwnerSearchKeyDown" />
                                 <TextBlock Text="No matching users" Margin="12,4" Style="{StaticResource fieldHelpStyle}"
                                            Visibility="{Binding HasNoMatchingOwners, Converter={StaticResource boolToVisibility}}" />
                                 <ListBox x:Name="ownerResults" MaxHeight="260" ItemsSource="{Binding FilteredOwners}"
                                          Style="{StaticResource surfaceListBoxStyle}"
                                          ItemContainerStyle="{StaticResource ownerResultStyle}"
                                          BorderThickness="0" Foreground="{DynamicResource themeWindowForegroundBrush}"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseLeftButtonUp="OwnerResultClicked" PreviewKeyDown="OwnerResultsKeyDown">
                                    <ListBox.ItemTemplate>
                                       <DataTemplate><TextBlock Text="{Binding Account}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Account}" /></DataTemplate>
                                    </ListBox.ItemTemplate>
                                 </ListBox>
                              </StackPanel>
                           </Border>
                        </Popup>
                     </Grid>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>
         <Style x:Key="dateFieldFrameStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource surfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource outlineBrush}" />
         </Style>
      </ResourceDictionary>
   </windows:EmWindow.Resources>

   <windows:EmWindow.DataContext>
      <local:RobotDialogVm />
   </windows:EmWindow.DataContext>

   <Grid Margin="22,4,22,22">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ==== banner ==== -->
      <Grid Grid.Row="0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>

         <Grid Width="42" Height="42" VerticalAlignment="Center">
            <Border CornerRadius="12" Opacity="0.18" Background="{DynamicResource themeAccentBrush}" />
            <fa:FontAwesome Icon="{Binding Icon}"
                            FontSize="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource themeAccentBrush}" />
         </Grid>

         <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Caption}"
                       Margin="0,4,0,0"
                       FontSize="12.5"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
         </StackPanel>
      </Grid>

      <!-- ==== warning (regenerate) ==== -->
      <Border Grid.Row="1"
              Margin="0,16,0,0"
              Padding="12,10"
              CornerRadius="10"
              BorderThickness="1"
              Background="{StaticResource warningChipBrush}"
              BorderBrush="{StaticResource warningBrush}"
              Visibility="{Binding HasWarning, Converter={StaticResource boolToVisibility}}">
         <TextBlock Text="{Binding Warning}" FontSize="12.5" TextWrapping="Wrap" />
      </Border>

      <!-- ==== name ==== -->
      <StackPanel Grid.Row="2"
                  Margin="0,20,0,0"
                  Visibility="{Binding ShowName, Converter={StaticResource boolToVisibility}}">
         <TextBlock Text="{Binding NameLabel}" Style="{StaticResource fieldLabelStyle}" />
         <TextBox x:Name="nameBox"
                  Style="{StaticResource fieldBoxStyle}"
                  Tag="{Binding NamePlaceholder}"
                  Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                  IsReadOnly="{Binding IsNameReadOnly}"
                  IsEnabled="{Binding IsNameEditable}" />
         <TextBlock Text="{Binding NameError}"
                    Style="{StaticResource fieldHelpStyle}"
                    Foreground="{StaticResource dangerBrush}"
                    Opacity="1" />
         <TextBlock Text="{Binding NameHelp}" Style="{StaticResource fieldHelpStyle}" />
      </StackPanel>

      <!-- ==== description ==== -->
      <StackPanel Grid.Row="3"
                  Margin="0,14,0,0"
                  Visibility="{Binding ShowDescription, Converter={StaticResource boolToVisibility}}">
         <TextBlock Text="Description" Style="{StaticResource fieldLabelStyle}" />
         <TextBox Style="{StaticResource fieldBoxStyle}"
                  Height="84"
                  Padding="14,10"
                  VerticalContentAlignment="Top"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto"
                  Tag="Optional"
                  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
         <TextBlock Text="{Binding DescriptionError}"
                    Style="{StaticResource fieldHelpStyle}"
                    Foreground="{StaticResource dangerBrush}"
                    Opacity="1" />
      </StackPanel>

      <!-- ==== token expiry ==== -->
      <StackPanel Grid.Row="4" Margin="0,14,0,0">
         <StackPanel Margin="0,0,0,14" Visibility="{Binding ShowOwner, Converter={StaticResource boolToVisibility}}">
            <TextBlock Text="Owner account" Style="{StaticResource fieldLabelStyle}" />
            <ComboBox x:Name="ownerCombo" Style="{StaticResource ownerComboStyle}"
                      DropDownOpened="OwnerDropDownOpened"
                      ItemsSource="{Binding OwnerOptions}"
                      SelectedItem="{Binding SelectedOwner, Mode=TwoWay}">
               <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Account}" /></DataTemplate>
               </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Optional. Link to an active user account. Grant robot access through managers."
                       Style="{StaticResource fieldHelpStyle}" />
         </StackPanel>
         <TextBlock Text="Token expiry" Style="{StaticResource fieldLabelStyle}" />
         <ComboBox Style="{StaticResource fieldComboStyle}"
                   ItemsSource="{Binding ExpiryOptions}"
                   SelectedItem="{Binding SelectedExpiry}">
            <ComboBox.ItemTemplate>
               <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
               </DataTemplate>
            </ComboBox.ItemTemplate>
         </ComboBox>
         <Border Style="{StaticResource dateFieldFrameStyle}"
                 Margin="0,8,0,0"
                 Visibility="{Binding ShowCustomDate, Converter={StaticResource boolToVisibility}}">
            <DatePicker Style="{StaticResource inlineDatePickerStyle}"
                        SelectedDate="{Binding CustomDate}"
                        DisplayDateStart="{Binding EarliestDate, Mode=OneWay}"
                        Tag="Last day the token may be used" />
         </Border>
         <TextBlock Text="{Binding ExpiryError}"
                    Style="{StaticResource fieldHelpStyle}"
                    Foreground="{StaticResource dangerBrush}"
                    Opacity="1" />
         <TextBlock Text="After this day docker login with the token is refused. Leave it at No expiry for a token that never lapses."
                    Style="{StaticResource fieldHelpStyle}" />
      </StackPanel>

      <!-- ==== active ==== -->
      <Grid Grid.Row="5"
            Margin="0,14,0,0"
            Visibility="{Binding ShowActive, Converter={StaticResource boolToVisibility}}">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <StackPanel>
            <TextBlock Text="Active" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="A disabled robot cannot log in." Style="{StaticResource fieldHelpStyle}" />
         </StackPanel>
         <ToggleButton Grid.Column="1"
                       Style="{StaticResource switchStyle}"
                       IsChecked="{Binding IsActive}" />
      </Grid>

      <!-- ==== actions ==== -->
      <StackPanel Grid.Row="6"
                  Margin="0,22,0,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
         <Button Style="{StaticResource textButtonStyle}"
                 Margin="0,0,8,0"
                 IsCancel="True"
                 Content="Cancel" />
         <Button Style="{StaticResource filledButtonStyle}"
                 MinWidth="96"
                 IsDefault="True"
                 Command="{Binding Commands[OkCommand]}"
                 Content="{Binding OkCaption}" />
      </StackPanel>
   </Grid>
</windows:EmWindow>
