<UserControl x:Class="Em.Ui.Wpf.Dialogs.ReleaseAndroidSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs" xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls">
 <UserControl.DataContext><local:ReleaseAndroidSettingsVm/></UserControl.DataContext>
 <StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
   <TextBlock Text="Platform" Width="185" VerticalAlignment="Center"/>
   <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}" Style="{DynamicResource fieldComboStyle}" Width="160"/>
   <Button Content="Apply platform" Command="{Binding Commands[ChangePlatformCommand]}" Style="{DynamicResource outlinedButtonStyle}" Margin="8,0,0,0"/>
  </StackPanel>
  <StackPanel IsEnabled="{Binding IsAndroid}">
   <TextBlock Text="Android · APK arm64-v8a" Style="{DynamicResource typeLabelLargeStyle}"/>
   <TextBlock Text="Export this profile as a backup. Losing the keystore or manifest key prevents existing installations from accepting updates." TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="Application ID" ToolTip="Permanent lowercase reverse-domain package name. Locked after the first release."/>
   <TextBox Text="{Binding Android.ApplicationId}" Style="{DynamicResource fieldTextBoxStyle}"/>
   <TextBlock Text="APK file name" Margin="0,8,0,0" ToolTip="Lowercase .apk filename; empty derives it from app_id."/>
   <TextBox Text="{Binding Android.ApkFileName}" Style="{DynamicResource fieldTextBoxStyle}"/>
   <TextBlock Text="Minimum version code" Margin="0,8,0,0" ToolTip="0 means optional updates; otherwise 1 through the prepared versionCode."/>
   <controls:NumericBox Value="{Binding Android.MinVersionCode}" Minimum="0" Maximum="2100000000"/>
   <TextBlock Text="Android SDK" Margin="0,8,0,0"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Command="{Binding Commands[BrowseSdkCommand]}" Style="{DynamicResource outlinedButtonStyle}"/>
    <ComboBox ItemsSource="{Binding SdkCandidates}" IsEditable="True" Text="{Binding Sdk}" Style="{DynamicResource fieldComboStyle}"/></DockPanel>
   <TextBlock Text="Java SDK" Margin="0,8,0,0"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Command="{Binding Commands[BrowseJavaCommand]}" Style="{DynamicResource outlinedButtonStyle}"/>
    <ComboBox ItemsSource="{Binding JavaCandidates}" IsEditable="True" Text="{Binding Java}" Style="{DynamicResource fieldComboStyle}"/></DockPanel>
   <StackPanel Orientation="Horizontal" Margin="0,8">
    <Button Content="Check environment" Command="{Binding Commands[CheckCommand]}" Style="{DynamicResource outlinedButtonStyle}"/>
    <Button Content="Prepare Environment" Command="{Binding Commands[PrepareEnvironmentCommand]}" Style="{DynamicResource outlinedButtonStyle}" Margin="8,0,0,0"/>
   </StackPanel>
   <CheckBox Content="Set ANDROID_HOME and JAVA_HOME for this user" IsChecked="{Binding SetUserEnvironment}"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8"/>
   <StackPanel Orientation="Horizontal">
    <Button Content="Create keystore" Command="{Binding Commands[CreateKeystoreCommand]}" Style="{DynamicResource outlinedButtonStyle}"/>
    <Button Content="Import keystore" Command="{Binding Commands[ImportKeystoreCommand]}" Style="{DynamicResource outlinedButtonStyle}" Margin="8,0,0,0"/>
   </StackPanel>
   <TextBlock Text="{Binding Android.CertificateSha256}" TextWrapping="Wrap" Margin="0,8" ToolTip="Signing certificate SHA-256"/>
   <Expander Header="Show signing credentials" Margin="0,8">
    <StackPanel>
     <TextBlock Text="Key alias"/><TextBox Text="{Binding Android.KeystoreAlias}" Style="{DynamicResource fieldTextBoxStyle}"/>
     <TextBlock Text="Keystore password"/><DockPanel><Button DockPanel.Dock="Right" Content="Copy" Command="{Binding Commands[CopyStorePasswordCommand]}" ToolTip="Copy keystore password"/><TextBox Text="{Binding Android.KeystorePassword}" Style="{DynamicResource fieldTextBoxStyle}"/></DockPanel>
     <TextBlock Text="Key password"/><DockPanel><Button DockPanel.Dock="Right" Content="Copy" Command="{Binding Commands[CopyKeyPasswordCommand]}" ToolTip="Copy key password"/><TextBox Text="{Binding Android.KeyPassword}" Style="{DynamicResource fieldTextBoxStyle}"/></DockPanel>
    </StackPanel>
   </Expander>
  </StackPanel>
 </StackPanel>
</UserControl>
