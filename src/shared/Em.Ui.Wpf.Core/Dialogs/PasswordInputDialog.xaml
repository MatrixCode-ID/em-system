<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.PasswordInputDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                    xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                    xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                    mc:Ignorable="d"
                    Title="{Binding Title}"
                    Width="460"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner"
                    FocusManager.FocusedElement="{Binding ElementName=passwordBox}">

   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
   </windows:EmWindow.Resources>

   <windows:EmWindow.DataContext>
      <local:PasswordInputDialogVm />
   </windows:EmWindow.DataContext>

   <Grid Margin="22,4,22,22">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ==== banner ==== -->
      <Grid Grid.Row="0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>

         <Grid Width="42" Height="42" VerticalAlignment="Center">
            <Border CornerRadius="12" Opacity="0.18" Background="{DynamicResource themeAccentBrush}" />
            <fa:FontAwesome Icon="{Binding Icon}"
                            FontSize="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource themeAccentBrush}" />
         </Grid>

         <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Caption}"
                       Margin="0,4,0,0"
                       FontSize="12.5"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
         </StackPanel>
      </Grid>

      <!-- ==== fields ==== -->
      <StackPanel Grid.Row="1" Margin="0,20,0,0">
         <TextBlock Text="Password" Style="{StaticResource fieldLabelStyle}" />
         <PasswordBox x:Name="passwordBox"
                      Style="{StaticResource fieldPasswordStyle}"
                      PasswordChanged="PasswordBox_PasswordChanged" />
      </StackPanel>

      <StackPanel Grid.Row="2"
                  Margin="0,14,0,0"
                  Visibility="{Binding RequireConfirmation, Converter={StaticResource boolToVisibility}}">
         <TextBlock Text="Repeat password" Style="{StaticResource fieldLabelStyle}" />
         <PasswordBox Style="{StaticResource fieldPasswordStyle}"
                      PasswordChanged="ConfirmationBox_PasswordChanged" />
         <TextBlock Text="{Binding ConfirmationHint}"
                    Style="{StaticResource fieldHelpStyle}"
                    Foreground="{StaticResource dangerBrush}"
                    Opacity="1" />
      </StackPanel>

      <StackPanel Grid.Row="3"
                  Margin="0,14,0,0"
                  Visibility="{Binding ShowExportable, Converter={StaticResource boolToVisibility}}">
         <CheckBox Style="{StaticResource checkBoxStyle}"
                   IsChecked="{Binding Exportable}"
                   Content="Exportable" />
         <TextBlock Text="Allow this key to be exported again from this machine."
                    Margin="29,0,0,0"
                    Style="{StaticResource fieldHelpStyle}" />
      </StackPanel>

      <CheckBox Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource checkBoxStyle}"
                Visibility="{Binding ShowRemember, Converter={StaticResource boolToVisibility}}"
                IsChecked="{Binding Remember}" Content="Remember on this PC (encrypted for this Windows user)" />
      <!-- ==== actions ==== -->
      <StackPanel Grid.Row="5"
                  Margin="0,22,0,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
         <Button Style="{StaticResource answerButtonStyle}"
                 MinWidth="88"
                 IsCancel="True"
                 Content="Cancel" />
         <Button Style="{StaticResource confirmAnswerButtonStyle}"
                 Margin="8,0,0,0"
                 MinWidth="88"
                 IsDefault="True"
                 Command="{Binding Commands[OkCommand]}"
                 Content="{Binding OkCaption}" />
      </StackPanel>
   </Grid>
</windows:EmWindow>
