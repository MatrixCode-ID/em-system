<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.AddProductChildrenDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                  xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                  xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                  Title="Add children" Width="680" Height="680" MinWidth="560" MinHeight="480"
                  ShowMinimizeButton="False" ShowMaximizeButton="False" WindowStartupLocation="CenterOwner">
   <windows:EmWindow.DataContext><local:AddProductChildrenDialogVm/></windows:EmWindow.DataContext>
   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/>
         </ResourceDictionary.MergedDictionaries>
         <BooleanToVisibilityConverter x:Key="boolVisibility"/>
      </ResourceDictionary>
   </windows:EmWindow.Resources>
   <Grid Margin="22,12,22,22">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="2*" MinHeight="110"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="3*" MinHeight="120"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
         <TextBlock Text="{Binding Intro}" Style="{StaticResource fieldHelpStyle}" TextWrapping="Wrap"/>
         <TextBlock Text="Parent" Style="{StaticResource fieldLabelStyle}" Margin="0,12,0,0"/>
         <TextBox x:Name="parentBox" Style="{StaticResource fieldBoxStyle}" Text="{Binding ParentCaption, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" AutomationProperties.Name="Parent"/>
         <TextBlock Text="Children (code, name)" Style="{StaticResource fieldLabelStyle}" Margin="0,12,0,0"/>
      </StackPanel>
      <TextBox x:Name="linesBox" Grid.Row="1" Style="{StaticResource fieldBoxStyle}" Text="{Binding Lines, UpdateSourceTrigger=PropertyChanged}" Height="Auto" Padding="12,8" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="Children"/>
      <DockPanel Grid.Row="2" Margin="0,10,0,0">
         <Button DockPanel.Dock="Right" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[PreviewCommand]}" ToolTip="Check the lines against the codes already used in this tenant">
            <StackPanel Orientation="Horizontal">
               <fa:FontAwesome Icon="Solid_ListCheck" Style="{StaticResource buttonIconStyle}"/>
               <TextBlock Text="Preview" VerticalAlignment="Center"/>
            </StackPanel>
         </Button>
         <TextBlock Text="{Binding Status}" Style="{StaticResource fieldHelpStyle}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
      <Border Grid.Row="3" Style="{StaticResource cardStyle}" Padding="0" Margin="0,10,0,0">
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="previewList" ItemsSource="{Binding Items}" Focusable="False">
               <ItemsControl.ItemTemplate>
                  <DataTemplate>
                     <Grid>
                        <Grid Margin="18,10">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="28"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                           </Grid.ColumnDefinitions>
                           <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" AutomationProperties.Name="{Binding Code}"/>
                           <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Code}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                           </StackPanel>
                           <Border Grid.Column="2" Style="{StaticResource chipMutedStyle}" VerticalAlignment="Center" Visibility="{Binding HasMark, Converter={StaticResource boolVisibility}}">
                              <TextBlock Text="{Binding Mark}"/>
                           </Border>
                        </Grid>
                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource dividerBrush}"/>
                     </Grid>
                  </DataTemplate>
               </ItemsControl.ItemTemplate>
            </ItemsControl>
         </ScrollViewer>
      </Border>
      <DockPanel Grid.Row="4" Margin="0,14,0,0">
         <Button DockPanel.Dock="Right" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[AddCommand]}" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
               <fa:FontAwesome Icon="Solid_Plus" Style="{StaticResource buttonIconStyle}"/>
               <TextBlock Text="{Binding AddCaption}" VerticalAlignment="Center"/>
            </StackPanel>
         </Button>
         <Button DockPanel.Dock="Right" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[CancelCommand]}" Content="Cancel"/>
         <TextBlock Text="{Binding SelectionCaption}" Style="{StaticResource fieldHelpStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
   </Grid>
</windows:EmWindow>
