<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.ContactPickerDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                  xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                  xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls"
                  xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                  xmlns:shared="clr-namespace:Em.Shared;assembly=Em.Libs"
                  Title="Search contact" Width="820" Height="580" MinWidth="640" MinHeight="400"
                  ShowMinimizeButton="False" ShowMaximizeButton="False" WindowStartupLocation="CenterOwner">
   <windows:EmWindow.DataContext><local:ContactPickerDialogVm/></windows:EmWindow.DataContext>
   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/></ResourceDictionary.MergedDictionaries>
         <BooleanToVisibilityConverter x:Key="boolVisibility"/>
         <Style x:Key="contactRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource themeWindowForegroundBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                     <Grid>
                        <Border x:Name="state" Background="Transparent"/>
                        <Border x:Name="selected" Width="3" HorizontalAlignment="Left" Background="{DynamicResource themeAccentBrush}" Visibility="Collapsed"/>
                        <ContentPresenter/>
                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource dividerBrush}"/>
                     </Grid>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="state" Property="Background" Value="{StaticResource stateHoverBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="state" Property="Background" Value="{StaticResource statePressedBrush}"/><Setter TargetName="selected" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>
      </ResourceDictionary>
   </windows:EmWindow.Resources>
   <Grid Margin="22,12,22,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid IsEnabled="{Binding IsNotBusy}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="contactSearch" Style="{StaticResource fieldBoxStyle}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Contact name or username" Height="38" Margin="0,0,8,0" AutomationProperties.Name="Contact name or username">
            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Commands[SearchCommand]}"/></TextBox.InputBindings>
         </TextBox>
         <Button Grid.Column="1" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[SearchCommand]}"><StackPanel Orientation="Horizontal"><fa:FontAwesome Icon="Solid_MagnifyingGlass" Style="{StaticResource buttonIconStyle}"/><TextBlock Text="Search" VerticalAlignment="Center"/></StackPanel></Button>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,10,0,10">
         <TextBlock Text="Search by contact name or linked username. Select a contact to use in the current operation." Style="{StaticResource fieldHelpStyle}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Status}" Style="{StaticResource fieldHelpStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <Border Grid.Row="2" Style="{StaticResource cardStyle}" Padding="0">
         <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
               <TextBlock Text="CONTACT" Style="{StaticResource sectionCaptionStyle}"/><TextBlock Grid.Column="1" Text="USERNAME" Style="{StaticResource sectionCaptionStyle}"/><TextBlock Grid.Column="2" Text="STATUS CONTACT" Style="{StaticResource sectionCaptionStyle}"/>
            </Grid>
            <ListBox Grid.Row="1" x:Name="contactResults" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource surfaceListBoxStyle}" ItemContainerStyle="{StaticResource contactRowStyle}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
               <ListBox.ItemTemplate>
                  <DataTemplate>
                     <Grid Margin="18,12" Background="Transparent">
                        <Grid.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.Commands[ChooseCommand], RelativeSource={RelativeSource AncestorType={x:Type windows:EmWindow}}}"/></Grid.InputBindings>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Contact.FullName}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Contact.FullName}"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Contact.UserAccounts}" Margin="0,0,10,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <StackPanel Grid.Column="2">
                           <TextBlock x:Name="contactStatus"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Active"/><Style.Triggers><DataTrigger Binding="{Binding Contact.ContactState}" Value="{x:Static shared:ContactState.Inactive}"><Setter Property="Text" Value="Inactive"/></DataTrigger><DataTrigger Binding="{Binding Contact.ContactState}" Value="{x:Static shared:ContactState.Deleted}"><Setter Property="Text" Value="Deleted"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                           <TextBlock Text="{Binding BlockReason}" TextWrapping="Wrap" Opacity="0.6" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding BlockReason}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </StackPanel>
                     </Grid>
                  </DataTemplate>
               </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="No matching contacts. Try another name or username." Margin="18,12" Style="{StaticResource fieldHelpStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource boolVisibility}}"/>
            <controls:WaitOverlay Grid.RowSpan="2" IsWaiting="{Binding InWaiting}" Caption="{Binding WaiterText}"/>
         </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="0,14,0,0">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Grid.ColumnSpan="2" Text="{Binding PageCaption}" Margin="0,0,0,10" FontSize="11" Opacity="0.6"/>
         <StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="Previous" Command="{Binding Commands[PreviousPageCommand]}" Style="{StaticResource outlinedButtonStyle}"/><Button Content="Next" Command="{Binding Commands[NextPageCommand]}" Style="{StaticResource outlinedButtonStyle}" Margin="8,0,0,0"/></StackPanel>
         <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" IsCancel="True" Style="{StaticResource outlinedButtonStyle}"/><Button Content="Choose contact" IsDefault="True" Command="{Binding Commands[ChooseCommand]}" Style="{StaticResource outlinedButtonStyle}" Margin="8,0,0,0"/></StackPanel>
      </Grid>
   </Grid>
</windows:EmWindow>
