<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.SwitchUserDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                    xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                    xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                    mc:Ignorable="d"
                    Title="Switch User"
                    Width="760"
                    Height="520"
                    MinWidth="640"
                    MinHeight="420"
                    ResizeMode="CanResize"
                    ShowMinimizeButton="False"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">

   <!--
      Debug only: pick the account the developer acts as. A banner, the search with its refresh
      button, a grid of account cards coloured by kind, and the actions under it.
   -->

   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary
               Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <!-- One card per account, laid out in a wrapping grid so more accounts fit. A card that
              cannot be picked keeps the surface and dims its content, so neither the disabled card
              nor a busy list ever turns system white. -->
         <Style x:Key="userCardStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="224" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            <Setter Property="ToolTip" Value="{Binding DisabledReason}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.IsEnabled" Value="{Binding HasDisabledReason}" />
            <Setter Property="Template">
               <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                     <Border x:Name="card"
                             Padding="12,12,12,10"
                             CornerRadius="12"
                             BorderThickness="1"
                             BorderBrush="{StaticResource outlineBrush}"
                             Background="{StaticResource surfaceBrush}">
                        <Border.InputBindings>
                           <MouseBinding MouseAction="LeftDoubleClick"
                                         Command="{Binding DataContext.Commands[SwitchCommand], RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Border.InputBindings>
                        <Grid>
                           <ContentPresenter x:Name="content" />
                           <!-- Picked card: an accent tick in the corner on top of the accent outline. -->
                           <fa:FontAwesome x:Name="tick"
                                           Icon="Solid_CircleCheck"
                                           FontSize="14"
                                           Margin="0,-4,-4,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource themeAccentBrush}" />
                        </Grid>
                     </Border>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="card" Property="Background" Value="{StaticResource stateHoverBrush}" />
                           <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource outlineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                           <Setter TargetName="card" Property="Background" Value="{StaticResource statePressedBrush}" />
                           <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource themeAccentBrush}" />
                           <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                           <Setter TargetName="card" Property="Background" Value="{StaticResource surfaceBrush}" />
                           <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource outlineBrush}" />
                           <Setter TargetName="content" Property="Opacity" Value="0.5" />
                           <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                     </ControlTemplate.Triggers>
                  </ControlTemplate>
               </Setter.Value>
            </Setter>
         </Style>

         <!-- The avatar plate takes the colour of the account kind: system accounts info,
              administrators warning, plain users success. -->
         <Style x:Key="avatarPlateStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource successChipBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource successBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource successBrush}" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding Kind}" Value="Admin">
                  <Setter Property="Background" Value="{StaticResource warningChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource warningBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Kind}" Value="System">
                  <Setter Property="Background" Value="{StaticResource infoChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource infoBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource infoBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <Style x:Key="avatarIconStyle" TargetType="fa:FontAwesome">
            <Setter Property="Icon" Value="Solid_User" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding Kind}" Value="Admin">
                  <Setter Property="Icon" Value="Solid_UserShield" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Kind}" Value="System">
                  <Setter Property="Icon" Value="Solid_UserSecret" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <Style x:Key="kindChipStyle" TargetType="Border" BasedOn="{StaticResource chipSuccessStyle}">
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="TextElement.FontSize" Value="9.5" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding Kind}" Value="Admin">
                  <Setter Property="Background" Value="{StaticResource warningChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource warningBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding Kind}" Value="System">
                  <Setter Property="Background" Value="{StaticResource infoChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource infoBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource infoBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>

         <!-- Active reads as nothing special; every other state is called out. -->
         <Style x:Key="stateChipStyle" TargetType="Border" BasedOn="{StaticResource chipMutedStyle}">
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="TextElement.FontSize" Value="9.5" />
            <Style.Triggers>
               <DataTrigger Binding="{Binding StateCaption}" Value="Pending">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Background" Value="{StaticResource warningChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource warningBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource warningBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding StateCaption}" Value="Suspended">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Background" Value="{StaticResource dangerChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource dangerBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource dangerBrush}" />
               </DataTrigger>
               <DataTrigger Binding="{Binding StateCaption}" Value="Deleted">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Background" Value="{StaticResource dangerChipBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource dangerBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource dangerBrush}" />
               </DataTrigger>
            </Style.Triggers>
         </Style>
      </ResourceDictionary>
   </windows:EmWindow.Resources>

   <windows:EmWindow.DataContext>
      <local:SwitchUserDialogVm />
   </windows:EmWindow.DataContext>

   <Grid Margin="22,4,22,22">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ==== banner ==== -->
      <Border Grid.Row="0"
              CornerRadius="14"
              Padding="18,16"
              Background="{StaticResource surfaceStrongBrush}"
              BorderBrush="{StaticResource outlineBrush}"
              BorderThickness="1">
         <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="42" Height="42" VerticalAlignment="Center">
               <Border CornerRadius="12" Opacity="0.18" Background="{DynamicResource themeAccentBrush}" />
               <fa:FontAwesome Icon="Solid_UserSecret"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource themeAccentBrush}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
               <TextBlock Text="Switch User" FontSize="16" FontWeight="SemiBold" />
               <TextBlock Text="Debug only. Act as another account without its password. The server applies that account's real permissions."
                          Margin="0,4,0,0"
                          FontSize="12.5"
                          Opacity="0.75"
                          TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource chipAccentStyle}" VerticalAlignment="Center"
                    ToolTip="The account in use now">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_User" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CurrentAccount}" VerticalAlignment="Center" />
               </StackPanel>
            </Border>
         </Grid>
      </Border>

      <!-- ==== search ==== -->
      <Grid Grid.Row="1" Margin="0,16,0,0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <Border Style="{StaticResource searchFieldStyle}">
            <Grid Margin="14,0">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
               </Grid.ColumnDefinitions>
               <fa:FontAwesome Icon="Solid_MagnifyingGlass" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
               <TextBox Grid.Column="1"
                        Margin="10,0,0,0"
                        Style="{StaticResource searchBoxStyle}"
                        Tag="Search account, name or e-mail"
                        AutomationProperties.Name="Search users"
                        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
         </Border>
         <!-- The list is dynamic, so it carries its own refresh button. -->
         <Button Grid.Column="1"
                 Margin="8,0,0,0"
                 Width="32" Height="32"
                 FontSize="12"
                 VerticalAlignment="Center"
                 Style="{StaticResource flatIconButtonStyle}"
                 Command="{Binding Commands[RefreshCommand]}"
                 ToolTip="Reload users"
                 AutomationProperties.Name="Reload users">
            <fa:FontAwesome Icon="Solid_RotateRight" />
         </Button>
      </Grid>

      <!-- ==== list ==== -->
      <Grid Grid.Row="2" Margin="0,12,0,0">
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
         </Grid.RowDefinitions>

         <!-- A row of its own above the cards: the two system accounts are still listed. -->
         <Grid Grid.Row="0" Margin="2,0,0,8"
               Visibility="{Binding HasError, Converter={StaticResource boolToVisibility}}">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource dangerBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Margin="8,0,0,0"
                    Style="{StaticResource textButtonStyle}"
                    Command="{Binding Commands[RefreshCommand]}"
                    Content="Try again" />
         </Grid>

         <ListBox Grid.Row="1"
                  BorderThickness="0"
                  Style="{StaticResource surfaceListBoxStyle}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ItemContainerStyle="{StaticResource userCardStyle}"
                  ItemsSource="{Binding VisibleRows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  IsEnabled="{Binding IsNotBusy}">
            <ListBox.ItemsPanel>
               <ItemsPanelTemplate>
                  <WrapPanel />
               </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
               <DataTemplate>
                  <StackPanel>
                     <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" VerticalAlignment="Center"
                                Style="{StaticResource avatarPlateStyle}">
                           <fa:FontAwesome FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource avatarIconStyle}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                           <TextBlock Text="{Binding Account}"
                                      FontSize="13.5"
                                      FontWeight="SemiBold"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding Account}" />
                           <TextBlock Margin="0,2,0,0"
                                      FontSize="11.5"
                                      Opacity="0.7"
                                      Text="{Binding FullName}"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding FullName}" />
                        </StackPanel>
                     </Grid>
                     <WrapPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource kindChipStyle}">
                           <TextBlock Text="{Binding Kind}" />
                        </Border>
                        <Border Style="{StaticResource stateChipStyle}">
                           <TextBlock Text="{Binding StateCaption}" />
                        </Border>
                        <Border Style="{StaticResource chipAccentStyle}" Padding="7,1" TextElement.FontSize="9.5"
                                Visibility="{Binding IsCurrent, Converter={StaticResource boolToVisibility}}">
                           <TextBlock Text="CURRENT" />
                        </Border>
                     </WrapPanel>
                  </StackPanel>
               </DataTemplate>
            </ListBox.ItemTemplate>
         </ListBox>

         <!-- Loading and an empty search answer take the cards' place. -->
         <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Orientation="Horizontal" IsHitTestVisible="False"
                     Visibility="{Binding IsLoading, Converter={StaticResource boolToVisibility}}">
            <fa:FontAwesome Icon="Solid_Spinner" Spin="True" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            <TextBlock Text="Loading users..." Margin="8,0,0,0" Opacity="0.6" VerticalAlignment="Center" />
         </StackPanel>

         <TextBlock Grid.Row="1" Text="No account matches the search"
                    Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsEmpty, Converter={StaticResource boolToVisibility}}" />
      </Grid>

      <!-- ==== actions ==== -->
      <StackPanel Grid.Row="3"
                  Margin="0,18,0,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
         <Button Style="{StaticResource filledButtonStyle}"
                 MinWidth="104"
                 Command="{Binding Commands[SwitchCommand]}">
            <StackPanel Orientation="Horizontal">
               <fa:FontAwesome Icon="Solid_UserSecret" Style="{StaticResource buttonIconStyle}" />
               <TextBlock Text="Switch" VerticalAlignment="Center" />
            </StackPanel>
         </Button>
         <Button Style="{StaticResource outlinedButtonStyle}"
                 Margin="8,0,0,0"
                 MinWidth="104"
                 IsCancel="True"
                 Content="Close" />
      </StackPanel>
   </Grid>
</windows:EmWindow>
