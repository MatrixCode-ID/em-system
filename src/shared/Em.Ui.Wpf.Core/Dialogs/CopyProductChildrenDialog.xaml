<windows:EmWindow x:Class="Em.Ui.Wpf.Dialogs.CopyProductChildrenDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:windows="clr-namespace:Em.Ui.Wpf.Windows"
                  xmlns:local="clr-namespace:Em.Ui.Wpf.Dialogs"
                  xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
                  Title="Copy children from" Width="760" Height="720" MinWidth="620" MinHeight="520"
                  ShowMinimizeButton="False" ShowMaximizeButton="False" WindowStartupLocation="CenterOwner">
   <windows:EmWindow.DataContext><local:CopyProductChildrenDialogVm/></windows:EmWindow.DataContext>
   <windows:EmWindow.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/>
         </ResourceDictionary.MergedDictionaries>
         <BooleanToVisibilityConverter x:Key="boolVisibility"/>
      </ResourceDictionary>
   </windows:EmWindow.Resources>
   <Grid Margin="22,12,22,22">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
         <TextBlock Text="{Binding Intro}" Style="{StaticResource fieldHelpStyle}" TextWrapping="Wrap"/>
         <TextBlock Text="Copy into" Style="{StaticResource fieldLabelStyle}" Margin="0,12,0,0"/>
         <TextBox x:Name="targetBox" Style="{StaticResource fieldBoxStyle}" Text="{Binding TargetCaption, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" AutomationProperties.Name="Copy into"/>
         <TextBlock Text="Source product" Style="{StaticResource fieldLabelStyle}" Margin="0,12,0,0"/>
         <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="2*"/>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="findBox" Style="{StaticResource fieldBoxStyle}" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" Tag="Code or name" IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="Find source product">
               <TextBox.InputBindings>
                  <KeyBinding Key="Return" Command="{Binding Commands[FindCommand]}"/>
               </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Margin="8,0" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[FindCommand]}" ToolTip="Find products that have children">
               <StackPanel Orientation="Horizontal">
                  <fa:FontAwesome Icon="Solid_MagnifyingGlass" Style="{StaticResource buttonIconStyle}"/>
                  <TextBlock Text="Find" VerticalAlignment="Center"/>
               </StackPanel>
            </Button>
            <ComboBox x:Name="sourcePicker" Grid.Column="2" Style="{StaticResource fieldComboStyle}" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source, Mode=TwoWay}" IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="Source product">
               <ComboBox.ItemTemplate>
                  <DataTemplate>
                     <StackPanel>
                        <TextBlock Text="{Binding cTenantProductName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"><Run Text="{Binding cTenantProductCode, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ccTenantProductChildCount, Mode=OneWay}"/><Run Text=" children"/></TextBlock>
                     </StackPanel>
                  </DataTemplate>
               </ComboBox.ItemTemplate>
            </ComboBox>
         </Grid>
         <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTip="The start of the source codes that is replaced. A code that does not start with it gets the new prefix in front.">
               <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Replace code prefix" Style="{StaticResource fieldLabelStyle}"/>
                  <fa:FontAwesome Style="{StaticResource fieldInfoIconStyle}"/>
               </StackPanel>
               <TextBox x:Name="oldPrefixBox" Style="{StaticResource fieldBoxStyle}" Text="{Binding OldPrefix, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" AutomationProperties.Name="Replace code prefix"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Background="Transparent" ToolTipService.ShowOnDisabled="True" ToolTip="What replaces the prefix in every copied code. Changing a prefix proposes every code again; a code can still be edited in its row.">
               <StackPanel Orientation="Horizontal">
                  <TextBlock Text="With" Style="{StaticResource fieldLabelStyle}"/>
                  <fa:FontAwesome Style="{StaticResource fieldInfoIconStyle}"/>
               </StackPanel>
               <TextBox x:Name="newPrefixBox" Style="{StaticResource fieldBoxStyle}" Text="{Binding NewPrefix, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" AutomationProperties.Name="New code prefix"/>
            </StackPanel>
         </Grid>
      </StackPanel>
      <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource fieldHelpStyle}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <Border Grid.Row="2" Style="{StaticResource cardStyle}" Padding="0" Margin="0,10,0,0">
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="childList" ItemsSource="{Binding Items}" Focusable="False">
               <ItemsControl.ItemTemplate>
                  <DataTemplate>
                     <Grid>
                        <Grid Margin="18,8">
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="28"/>
                              <ColumnDefinition Width="3*"/>
                              <ColumnDefinition Width="2*" MinWidth="160"/>
                              <ColumnDefinition Width="90"/>
                           </Grid.ColumnDefinitions>
                           <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" AutomationProperties.Name="{Binding Source.cTenantProductName}"/>
                           <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                              <TextBlock Text="{Binding Source.cTenantProductName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Source.cTenantProductCode}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                           </StackPanel>
                           <TextBox Grid.Column="2" Style="{StaticResource fieldBoxStyle}" Text="{Binding Code, UpdateSourceTrigger=LostFocus}" MaxLength="50" ToolTip="Code of the copy" AutomationProperties.Name="Code of the copy"/>
                           <Border Grid.Column="3" Style="{StaticResource chipMutedStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding HasMark, Converter={StaticResource boolVisibility}}">
                              <TextBlock Text="{Binding Mark}"/>
                           </Border>
                        </Grid>
                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource dividerBrush}"/>
                     </Grid>
                  </DataTemplate>
               </ItemsControl.ItemTemplate>
            </ItemsControl>
         </ScrollViewer>
      </Border>
      <DockPanel Grid.Row="3" Margin="0,14,0,0">
         <Button DockPanel.Dock="Right" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[CopyCommand]}" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
               <fa:FontAwesome Icon="Solid_Copy" Style="{StaticResource buttonIconStyle}"/>
               <TextBlock Text="{Binding CopyCaption}" VerticalAlignment="Center"/>
            </StackPanel>
         </Button>
         <Button DockPanel.Dock="Right" Style="{StaticResource outlinedButtonStyle}" Command="{Binding Commands[CancelCommand]}" Content="Cancel"/>
         <TextBlock Text="{Binding SelectionCaption}" Style="{StaticResource fieldHelpStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
   </Grid>
</windows:EmWindow>
