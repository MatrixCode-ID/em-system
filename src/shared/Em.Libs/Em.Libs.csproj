<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- See doc/engine/build.md#xml-docs -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Em</RootNamespace>
        <Description>Shared types and utilities for Em System.</Description>
        <Title>Em System shared library</Title>
        <PackageTags>em-system;shared;contracts;argon2</PackageTags>
    </PropertyGroup>
    <ItemGroup>
      <Folder Include="Services\" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
      <PackageReference Include="Ulid" Version="1.4.1" />
    </ItemGroup>

</Project>
