<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- See doc/engine/build.md#xml-docs -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Em</RootNamespace>
        <Description>Shared types and utilities for Em System.</Description>
        <Title>Em System shared library</Title>
        <PackageTags>em-system;shared;contracts;argon2;qrcode;documents;spreadsheet;pdf;xlsx;docx</PackageTags>
    </PropertyGroup>
    <ItemGroup>
      <Folder Include="Services\" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
      <PackageReference Include="QRCoder" Version="1.8.1" />
      <PackageReference Include="Ulid" Version="1.4.1" />
    </ItemGroup>
    <!-- Controls (Grid, Sheet, Write), Editors, Editing and Documents are synced from MatrixGrid; see doc/engine/engine-documents.md#sync. -->
    <ItemGroup>
      <EmbeddedResource Include="Documents\Assets\NotoSans-Regular.ttf" LogicalName="Em.Documents.Assets.NotoSans-Regular.ttf" />
      <None Include="..\..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
      <None Include="..\..\..\licenses\*" Pack="true" PackagePath="licenses/" Visible="false" />
    </ItemGroup>

</Project>
