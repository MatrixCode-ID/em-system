<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Panel account: masuk dari kanan saat badge di bilah atas di-tap. Susunannya dari atas ke bawah
   adalah header akun, daftar navigasi statis, kartu server, lalu ganti tema - semuanya ikut scroll.
   Dua hal berdiri di luar scroll: tombol tutup di pojok kanan atas dan baris keluar di kaki panel.
   Keduanya jalan keluar, dan jalan keluar tidak boleh hilang dari layar hanya karena daftarnya
   sedang digulung.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Em.Ui.Maui.Navigations"
             xmlns:controls="clr-namespace:Em.Ui.Maui.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             HorizontalOptions="End"
             WidthRequest="304"
             IsVisible="False"
             x:Class="Em.Ui.Maui.Navigations.AccountPanel">

   <ContentView.BindingContext>
      <local:AccountPanelVm />
   </ContentView.BindingContext>

   <ContentView.Resources>
      <!-- Baris keluar yang sedang tidak boleh ditekan dipudarkan, bukan disembunyikan: yang perlu
           diketahui pembacanya adalah bahwa tombolnya ada tapi tidak berlaku sekarang. -->
      <Style x:Key="signOutRowStyle" TargetType="Border" BasedOn="{StaticResource accountPanelItemStyle}">
         <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSignOutEnabled}" Value="False">
               <Setter Property="Opacity" Value="0.4" />
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <!-- Baris navigasi statis yang sedang tidak boleh ditekan dipudarkan, bukan disembunyikan:
           tempatnya tetap terbaca, hanya jelas bahwa sekarang tidak berlaku. -->
      <Style x:Key="accountPanelItemRowStyle" TargetType="Border"
             BasedOn="{StaticResource accountPanelItemStyle}">
         <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="False">
               <Setter Property="Opacity" Value="0.4" />
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <!-- Satu baris navigasi statis. Seluruh bidangnya jadi target tap, bukan hanya teksnya. -->
      <DataTemplate x:Key="accountPanelItemTemplate">
         <VerticalStackLayout>
            <BoxView Style="{StaticResource dividerStyle}" Margin="16,0"
                     IsVisible="{Binding HasDividerAbove}" />
            <Border Style="{StaticResource accountPanelItemRowStyle}"
                    IsEnabled="{Binding IsEnabled}">
               <Border.GestureRecognizers>
                  <TapGestureRecognizer
                     Command="{Binding Path=BindingContext.Commands[OpenItemCommand],
                                       Source={RelativeSource AncestorType={x:Type local:AccountPanel}}}"
                     CommandParameter="{Binding .}" />
               </Border.GestureRecognizers>
               <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                  <controls:FontIcon Grid.Column="0" Glyph="{Binding Glyph}"
                                     Style="{StaticResource accountPanelItemIconStyle}" />
                  <Label Grid.Column="1" Text="{Binding Title}"
                         Style="{StaticResource accountPanelItemLabelStyle}" />
               </Grid>
            </Border>
         </VerticalStackLayout>
      </DataTemplate>

      <!-- Lingkaran luar titik radio. Warnanya mengikuti keadaan terpilih baris itu sendiri lewat
           DataTrigger, bukan disetel dari kode, supaya yang menggantinya tidak perlu tahu bagaimana
           sebuah baris digambar. -->
      <Style x:Key="connectionMarkStyle" TargetType="shapes:Ellipse">
         <Setter Property="WidthRequest" Value="18" />
         <Setter Property="HeightRequest" Value="18" />
         <Setter Property="StrokeThickness" Value="2" />
         <Setter Property="HorizontalOptions" Value="Center" />
         <Setter Property="VerticalOptions" Value="Center" />
         <Setter Property="Stroke"
                 Value="{AppThemeBinding Light={StaticResource outlineLight}, Dark={StaticResource outlineDark}}" />
         <Style.Triggers>
            <DataTrigger TargetType="shapes:Ellipse" Binding="{Binding IsChecked}" Value="True">
               <Setter Property="Stroke"
                       Value="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <!-- Satu baris pilihan server. Titik radionya digambar sendiri dari dua lingkaran, bukan memakai
           RadioButton: Content milik RadioButton MAUI hanya menerima teks, dan sebuah view yang
           dititipkan ke sana berakhir tergambar sebagai nama tipenya. Menggambarnya sendiri sekaligus
           membuat seluruh baris jadi target tap, bukan cuma titik kecil di ujung kiri. -->
      <DataTemplate x:Key="accountPanelConnectionTemplate">
         <Border Style="{StaticResource accountPanelItemStyle}">
            <Border.GestureRecognizers>
               <TapGestureRecognizer
                  Command="{Binding Path=BindingContext.Commands[SelectConnectionCommand],
                                    Source={RelativeSource AncestorType={x:Type local:AccountPanel}}}"
                  CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
               <Grid Grid.Column="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                  <shapes:Ellipse Style="{StaticResource connectionMarkStyle}" />
                  <shapes:Ellipse WidthRequest="10" HeightRequest="10" IsVisible="{Binding IsChecked}"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Fill="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
               </Grid>
               <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                  <Label Text="{Binding ProfileName}" Style="{StaticResource accountPanelItemLabelStyle}" />
                  <Label Text="{Binding Host}" Style="{StaticResource supportTextStyle}"
                         FontSize="11" LineBreakMode="TailTruncation" />
               </VerticalStackLayout>
            </Grid>
         </Border>
      </DataTemplate>
   </ContentView.Resources>

   <Border Style="{StaticResource accountPanelStyle}">
      <Grid RowDefinitions="Auto,*,Auto">

         <controls:IconButton Grid.Row="0" HorizontalOptions="End" Margin="0,8,8,0"
                              Glyph="{x:Static controls:FontIcons.Xmark}" IconSize="16"
                              WidthRequest="36" HeightRequest="36"
                              Command="{Binding Commands[CloseCommand]}"
                              TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />

         <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,4,0,12">

               <!-- Logo aplikasi. Tinggal di sini, bukan di layar home: home adalah daftar jalan
                    menuju layar lain, sementara identitas aplikasi - berikut akun, server, dan
                    temanya - seluruhnya berkumpul di panel ini. -->
               <Image Source="{Binding LogoImage}" HeightRequest="40" Aspect="AspectFit"
                      HorizontalOptions="Center" Margin="16,4,16,12" />

               <!-- ==== header akun ==== -->
               <Border Style="{StaticResource accountPanelCardStyle}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,14">
                     <Border Grid.Column="0" Style="{StaticResource avatarStyle}"
                             WidthRequest="44" HeightRequest="44">
                        <Label Text="{Binding Initials}" FontFamily="OpenSansSemibold" FontSize="16"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource onPrimaryContainerLight}, Dark={StaticResource onPrimaryContainerDark}}" />
                     </Border>

                     <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding FullName}" Style="{StaticResource titleTextStyle}"
                               LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="6">
                           <controls:FontIcon Glyph="{x:Static controls:FontIcons.Envelope}" IconSize="11"
                                              VerticalOptions="Center"
                                              TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
                           <Label Text="{Binding EmailAddress}" Style="{StaticResource supportTextStyle}"
                                  FontSize="11" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        </HorizontalStackLayout>
                     </VerticalStackLayout>
                  </Grid>
               </Border>

               <!-- ==== navigasi statis ==== -->
               <Border Style="{StaticResource accountPanelCardStyle}"
                       IsVisible="{Binding HasStaticItems}">
                  <VerticalStackLayout Padding="0,4"
                                       BindableLayout.ItemsSource="{Binding StaticItems}"
                                       BindableLayout.ItemTemplate="{StaticResource accountPanelItemTemplate}" />
               </Border>

               <!-- ==== server ==== -->
               <Border Style="{StaticResource accountPanelCardStyle}">
                  <VerticalStackLayout Padding="0,12" Spacing="10">
                     <HorizontalStackLayout Spacing="10" Margin="16,0">
                        <controls:FontIcon Glyph="{x:Static controls:FontIcons.Server}" IconSize="16"
                                           VerticalOptions="Center"
                                           TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
                        <Label Text="{Binding ConnectionStatus}" Style="{StaticResource supportTextStyle}"
                               VerticalOptions="Center" LineBreakMode="TailTruncation" />
                     </HorizontalStackLayout>

                     <VerticalStackLayout Spacing="10" IsVisible="{Binding HasConnectionChoice}">
                        <BoxView Style="{StaticResource dividerStyle}" Margin="16,0" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Connections}"
                                             BindableLayout.ItemTemplate="{StaticResource accountPanelConnectionTemplate}" />
                     </VerticalStackLayout>
                  </VerticalStackLayout>
               </Border>

               <!-- ==== ganti tema ==== -->
               <Border Style="{StaticResource accountPanelCardStyle}" IsVisible="{Binding IsThemeVisible}">
                  <Border Style="{StaticResource accountPanelItemStyle}">
                     <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Commands[ToggleThemeCommand]}" />
                     </Border.GestureRecognizers>
                     <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <controls:FontIcon Grid.Column="0" Glyph="{Binding ThemeGlyph}"
                                           Style="{StaticResource accountPanelItemIconStyle}" />
                        <Label Grid.Column="1" Text="{Binding ThemeCaption}"
                               Style="{StaticResource accountPanelItemLabelStyle}" />
                     </Grid>
                  </Border>
               </Border>
            </VerticalStackLayout>
         </ScrollView>

         <!-- ==== keluar ==== -->
         <VerticalStackLayout Grid.Row="2" Padding="0,0,0,12" IsVisible="{Binding CanSignOut}">
            <BoxView Style="{StaticResource dividerStyle}" Margin="16,0,16,6" />
            <Border Style="{StaticResource signOutRowStyle}" Margin="12,0"
                    IsEnabled="{Binding IsSignOutEnabled}">
               <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding Commands[SignOutCommand]}" />
               </Border.GestureRecognizers>
               <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                  <controls:FontIcon Grid.Column="0"
                                     Glyph="{x:Static controls:FontIcons.RightFromBracket}" IconSize="22"
                                     VerticalOptions="Center"
                                     TintColor="{AppThemeBinding Light={StaticResource errorLight}, Dark={StaticResource errorDark}}" />
                  <Label Grid.Column="1" Text="Sign out" FontFamily="OpenSansSemibold" FontSize="14"
                         VerticalOptions="Center"
                         TextColor="{AppThemeBinding Light={StaticResource errorLight}, Dark={StaticResource errorDark}}" />
               </Grid>
            </Border>
         </VerticalStackLayout>
      </Grid>
   </Border>
</ContentView>
