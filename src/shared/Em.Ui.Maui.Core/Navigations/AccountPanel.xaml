<?xml version="1.0" encoding="UTF-8" ?>
<!-- Account panel: enters from the right when the badge in the top bar is tapped. Its layout from top to
     bottom is the account header, the static navigation list, the server card, then the theme switch -
     all of which scroll. Two things stand outside the scroll: the close button at the top right and the
     sign-out row at the foot of the panel. Both are ways out, and a way out must not disappear from the
     screen just because the list is being scrolled. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Em.Ui.Maui.Navigations"
             xmlns:controls="clr-namespace:Em.Ui.Maui.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             HorizontalOptions="End"
             WidthRequest="304"
             IsVisible="False"
             x:Class="Em.Ui.Maui.Navigations.AccountPanel">

   <ContentView.BindingContext>
      <local:AccountPanelVm />
   </ContentView.BindingContext>

   <ContentView.Resources>
      <!-- A sign-out row that may not be pressed right now is faded, not hidden: what the reader needs to know
           is that the button exists but does not apply now. -->
      <Style x:Key="signOutRowStyle" TargetType="Border" BasedOn="{StaticResource accountPanelItemStyle}">
         <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSignOutEnabled}" Value="False">
               <Setter Property="Opacity" Value="0.4" />
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <!-- A static navigation row that may not be pressed right now is faded, not hidden: its place stays
           readable, and it is only clear that it does not apply now. -->
      <Style x:Key="accountPanelItemRowStyle" TargetType="Border"
             BasedOn="{StaticResource accountPanelItemStyle}">
         <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="False">
               <Setter Property="Opacity" Value="0.4" />
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <!-- One static navigation row. Its whole area is the tap target, not only its text. -->
      <DataTemplate x:Key="accountPanelItemTemplate">
         <Grid MinimumHeightRequest="56" IsEnabled="{Binding IsEnabled}">
          <Grid Padding="16,12" ColumnDefinitions="24,*,Auto" ColumnSpacing="12" InputTransparent="True" CascadeInputTransparent="True">
           <controls:FontIcon Glyph="{Binding Glyph}" IconSize="20" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" TintColor="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" />
           <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource bodyMediumTextStyle}" VerticalOptions="Center" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
           <controls:FontIcon Grid.Column="2" Glyph="{x:Static controls:FontIcons.ChevronRight}" IsVisible="{Binding CanNavigate}" IconSize="16" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
          </Grid>
          <Button SemanticProperties.Description="{Binding Title}" Style="{StaticResource textButtonStyle}" BackgroundColor="Transparent" Padding="0" HorizontalOptions="Fill" VerticalOptions="Fill"
          Command="{Binding Path=BindingContext.Commands[OpenItemCommand], Source={RelativeSource AncestorType={x:Type local:AccountPanel}}}" CommandParameter="{Binding .}" />
         </Grid>
      </DataTemplate>

      <!-- The outer circle of the radio dot. Its color follows the selected state of its own row through a
           DataTrigger, not set from code, so whoever changes it need not know how a row is drawn. -->
      <Style x:Key="connectionMarkStyle" TargetType="shapes:Ellipse">
         <Setter Property="WidthRequest" Value="18" />
         <Setter Property="HeightRequest" Value="18" />
         <Setter Property="StrokeThickness" Value="2" />
         <Setter Property="HorizontalOptions" Value="Center" />
         <Setter Property="VerticalOptions" Value="Center" />
         <Setter Property="Stroke"
                 Value="{AppThemeBinding Light={StaticResource outlineLight}, Dark={StaticResource outlineDark}}" />
         <Style.Triggers>
            <DataTrigger TargetType="shapes:Ellipse" Binding="{Binding IsChecked}" Value="True">
               <Setter Property="Stroke"
                       Value="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <!-- One server choice row. Its radio dot is drawn by itself from two circles, not with a RadioButton: the
           Content of a MAUI RadioButton only accepts text, and a view handed to it ends up drawn as its type
           name. Drawing it itself also makes the whole row the tap target, not just a small dot at the far left. -->
      <DataTemplate x:Key="accountPanelConnectionTemplate">
         <Button Text="{Binding AccessibleCaption}" Style="{StaticResource textButtonStyle}" LineBreakMode="WordWrap"
          SemanticProperties.Description="{Binding AccessibleCaption}"
          Command="{Binding Path=BindingContext.Commands[SelectConnectionCommand], Source={RelativeSource AncestorType={x:Type local:AccountPanel}}}" CommandParameter="{Binding .}" />
      </DataTemplate>
   </ContentView.Resources>

   <Border Style="{StaticResource accountPanelStyle}">
      <Grid RowDefinitions="Auto,*,Auto">

         <controls:IconButton Grid.Row="0" HorizontalOptions="End" Margin="0,8,8,0"
                              Glyph="{x:Static controls:FontIcons.Xmark}" IconSize="16"
                              MinimumWidthRequest="48" MinimumHeightRequest="48"
                              x:Name="CloseButton" Command="{Binding Commands[CloseCommand]}"
                              TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}"  SemanticProperties.Description="Close" />

         <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,4,0,12">

               <!-- The application logo. It lives here, not on the home screen: home is a list of ways to other
                    screens, while the application identity - together with the account, server, and theme - is all
                    gathered in this panel. -->
               <Image Source="{Binding LogoImage}" HeightRequest="64" WidthRequest="136" Aspect="AspectFit"
                      HorizontalOptions="Center" Margin="16,4,16,12" />

               <!-- ==== account header ==== -->
               <Border Style="{StaticResource accountPanelCardStyle}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,14">
                     <Border Grid.Column="0" Style="{StaticResource avatarStyle}"
                             WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 28" VerticalOptions="Center">
                        <Label Text="{Binding Initials}" FontFamily="OpenSansSemibold" FontSize="16"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource onPrimaryContainerLight}, Dark={StaticResource onPrimaryContainerDark}}" />
                     </Border>

                     <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding FullName}" Style="{StaticResource titleTextStyle}"
                               LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
                           <controls:FontIcon Glyph="{x:Static controls:FontIcons.Envelope}" IconSize="11"
                                              VerticalOptions="Center"
                                              TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
                           <Label Grid.Column="1" Text="{Binding DisplayEmail}" Style="{StaticResource supportTextStyle}"
                                  VerticalOptions="Center" LineBreakMode="WordWrap" />
                        </Grid>
                     </VerticalStackLayout>
                  </Grid>
               </Border>

               <!-- ==== navigasi statis ==== -->
               <Border Style="{StaticResource accountPanelCardStyle}"
                       IsVisible="{Binding HasStaticItems}">
                  <VerticalStackLayout Padding="0,4"
                                       BindableLayout.ItemsSource="{Binding StaticItems}"
                                       BindableLayout.ItemTemplate="{StaticResource accountPanelItemTemplate}" />
               </Border>

               <!-- ==== management ==== -->
               <Border Style="{StaticResource accountPanelCardStyle}"
                       IsVisible="{Binding HasManagementItems}">
                  <VerticalStackLayout Padding="0,4"
                                       BindableLayout.ItemsSource="{Binding ManagementItems}"
                                       BindableLayout.ItemTemplate="{StaticResource accountPanelItemTemplate}" />
               </Border>

               <!-- ==== server ==== -->
               <Border Style="{StaticResource accountPanelCardStyle}">
                  <VerticalStackLayout Padding="0,12" Spacing="10">
                     <Grid ColumnDefinitions="24,*" ColumnSpacing="12" Margin="16,0">
                        <controls:FontIcon Glyph="{x:Static controls:FontIcons.Server}" IconSize="16"
                                           VerticalOptions="Center"
                                           TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
                        <Label Grid.Column="1" Text="{Binding ConnectionStatus}" Style="{StaticResource supportTextStyle}"
                               VerticalOptions="Center" LineBreakMode="WordWrap" />
                     </Grid>

                     <VerticalStackLayout Spacing="10" IsVisible="{Binding HasConnectionChoice}">
                        <BoxView Style="{StaticResource dividerStyle}" Margin="16,0" />
                        <Grid MinimumHeightRequest="48">
                         <Grid Padding="16,8" ColumnDefinitions="24,*,Auto" ColumnSpacing="12" InputTransparent="True" CascadeInputTransparent="True">
                          <controls:FontIcon Glyph="{x:Static controls:FontIcons.WindowMaximize}" IconSize="20" VerticalOptions="Center" TintColor="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" AutomationProperties.IsInAccessibleTree="False" />
                          <Label Grid.Column="1" Text="{Binding SelectedConnectionCaption}" Style="{StaticResource bodyMediumTextStyle}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                          <controls:FontIcon Grid.Column="2" Glyph="{Binding ConnectionDisclosure}" IconSize="16" VerticalOptions="Center" TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" AutomationProperties.IsInAccessibleTree="False" />
                         </Grid>
                         <Button Style="{StaticResource textButtonStyle}" BackgroundColor="Transparent" Command="{Binding Commands[ToggleConnectionsCommand]}" SemanticProperties.Description="Choose connection profile" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding IsConnectionsExpanded}" BindableLayout.ItemsSource="{Binding Connections}"
                                             BindableLayout.ItemTemplate="{StaticResource accountPanelConnectionTemplate}" />
                     </VerticalStackLayout>
                  </VerticalStackLayout>
               </Border>

               <Border Style="{StaticResource accountPanelCardStyle}">
                  <Grid MinimumHeightRequest="64">
                   <Grid Padding="16,12" ColumnDefinitions="24,*" ColumnSpacing="12" InputTransparent="True" CascadeInputTransparent="True">
                    <controls:FontIcon Glyph="{x:Static controls:FontIcons.RotateRight}" IconSize="20" VerticalOptions="Center" TintColor="{AppThemeBinding Light={StaticResource secondaryLight}, Dark={StaticResource secondaryDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                     <Label Text="{Binding InstalledVersion}" Style="{StaticResource supportTextStyle}" AutomationProperties.IsInAccessibleTree="False" />
                     <Label Text="Check for updates" Style="{StaticResource bodyMediumTextStyle}" AutomationProperties.IsInAccessibleTree="False" />
                    </VerticalStackLayout>
                   </Grid>
                   <Button Command="{Binding Commands[CheckForUpdatesCommand]}" Style="{StaticResource textButtonStyle}" BackgroundColor="Transparent" SemanticProperties.Description="Check for updates" />
                  </Grid>
               </Border>
               <!-- ==== theme switch ==== -->
               <Border Style="{StaticResource accountPanelCardStyle}" IsVisible="{Binding IsThemeVisible}">
                  <VerticalStackLayout>
                   <Grid MinimumHeightRequest="56">
                    <Grid Padding="16,12" ColumnDefinitions="24,*,Auto" ColumnSpacing="12" InputTransparent="True" CascadeInputTransparent="True">
                     <controls:FontIcon Glyph="{x:Static controls:FontIcons.CircleHalfStroke}" IconSize="20" VerticalOptions="Center" TintColor="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" AutomationProperties.IsInAccessibleTree="False" />
                     <Label Grid.Column="1" Text="Switch theme" Style="{StaticResource bodyMediumTextStyle}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                     <controls:FontIcon Grid.Column="2" Glyph="{Binding ThemeDisclosure}" IconSize="16" VerticalOptions="Center" TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Grid>
                    <Button Style="{StaticResource textButtonStyle}" Command="{Binding Commands[ToggleThemeCommand]}" BackgroundColor="Transparent" SemanticProperties.Description="Choose light or dark theme" />
                   </Grid>
                   <VerticalStackLayout IsVisible="{Binding IsThemeExpanded}" Padding="0,0,0,8" Spacing="0">
                    <Grid MinimumHeightRequest="48">
                     <Grid Padding="16,8" ColumnDefinitions="24,*,24" ColumnSpacing="12" InputTransparent="True" CascadeInputTransparent="True">
                      <controls:FontIcon Glyph="{x:Static controls:FontIcons.Sun}" IconSize="20" VerticalOptions="Center" TintColor="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" AutomationProperties.IsInAccessibleTree="False" />
                      <Label Grid.Column="1" Text="Light" Style="{StaticResource bodyMediumTextStyle}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                      <controls:FontIcon Grid.Column="2" Glyph="{x:Static controls:FontIcons.Check}" IsVisible="{Binding IsLightThemeSelected}" IconSize="16" VerticalOptions="Center" TintColor="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" AutomationProperties.IsInAccessibleTree="False" />
                     </Grid>
                     <Button Style="{StaticResource textButtonStyle}" BackgroundColor="Transparent" Command="{Binding Commands[SelectThemeCommand]}" CommandParameter="Light" SemanticProperties.Description="{Binding LightThemeCaption}" />
                    </Grid>
                    <Grid MinimumHeightRequest="48">
                     <Grid Padding="16,8" ColumnDefinitions="24,*,24" ColumnSpacing="12" InputTransparent="True" CascadeInputTransparent="True">
                      <controls:FontIcon Glyph="{x:Static controls:FontIcons.Moon}" IconSize="20" VerticalOptions="Center" TintColor="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" AutomationProperties.IsInAccessibleTree="False" />
                      <Label Grid.Column="1" Text="Dark" Style="{StaticResource bodyMediumTextStyle}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                      <controls:FontIcon Grid.Column="2" Glyph="{x:Static controls:FontIcons.Check}" IsVisible="{Binding IsDarkThemeSelected}" IconSize="16" VerticalOptions="Center" TintColor="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" AutomationProperties.IsInAccessibleTree="False" />
                     </Grid>
                     <Button Style="{StaticResource textButtonStyle}" BackgroundColor="Transparent" Command="{Binding Commands[SelectThemeCommand]}" CommandParameter="Dark" SemanticProperties.Description="{Binding DarkThemeCaption}" />
                    </Grid>
                   </VerticalStackLayout>
                  </VerticalStackLayout>
               </Border>
            </VerticalStackLayout>
         </ScrollView>

         <!-- ==== sign out ==== -->
         <VerticalStackLayout Grid.Row="2" Padding="0,0,0,12" IsVisible="{Binding CanSignOut}">
            <BoxView Style="{StaticResource dividerStyle}" Margin="16,0,16,6" />
            <Button Text="Sign out" Style="{StaticResource textButtonStyle}" TextColor="{AppThemeBinding Light={StaticResource errorLight}, Dark={StaticResource errorDark}}" Command="{Binding Commands[SignOutCommand]}" ContentLayout="Left,12">
             <Button.ImageSource><FontImageSource FontFamily="{x:Static controls:FontIcons.FontFamily}" Glyph="{x:Static controls:FontIcons.RightFromBracket}" Size="20" Color="{AppThemeBinding Light={StaticResource errorLight}, Dark={StaticResource errorDark}}" /></Button.ImageSource>
            </Button>
         </VerticalStackLayout>
      </Grid>
   </Border>
</ContentView>
