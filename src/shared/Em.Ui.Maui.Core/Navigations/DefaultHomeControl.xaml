<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:local="clr-namespace:Em.Ui.Maui.Navigations" x:Class="Em.Ui.Maui.Navigations.DefaultHomeControl">
 <ContentView.BindingContext><local:DefaultHomeControlVm /></ContentView.BindingContext>
 <Grid Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
   <Entry Text="{Binding SearchText}" Placeholder="Search modules" MinimumHeightRequest="48" SemanticProperties.Description="Search modules by title, subtitle or group" />
   <Button Grid.Column="1" Text="Clear" Command="{Binding Commands[ClearSearchCommand]}" Style="{StaticResource textButtonStyle}" />
  </Grid>
  <VerticalStackLayout Grid.Row="1" Spacing="8">
   <Label Text="No modules available for this account." IsVisible="{Binding IsModuleListEmpty}" />
   <Label Text="No modules match your search. Clear the search to see all modules." IsVisible="{Binding HasNoResults}" />
  </VerticalStackLayout>
  <CollectionView Grid.Row="2" ItemsSource="{Binding VisibleRows}" SelectionMode="None">
   <CollectionView.ItemTemplate><DataTemplate>
    <VerticalStackLayout Spacing="4" Padding="0,4">
     <Label Text="{Binding Header}" IsVisible="{Binding IsHeader}" Style="{StaticResource titleMediumTextStyle}" SemanticProperties.HeadingLevel="Level2" />
     <Button Text="{Binding Menu.Title}" IsVisible="{Binding IsDestination}" Command="{Binding Menu.Commands[OpenCommand]}"
      SemanticProperties.Description="{Binding Menu.Title}" Style="{StaticResource tonalButtonStyle}" HorizontalOptions="Fill" />
     <Label Text="{Binding Menu.Subtitle}" IsVisible="{Binding Menu.HasSubtitle}" Style="{StaticResource bodyMediumTextStyle}" />
    </VerticalStackLayout>
   </DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
 </Grid>
</ContentView>
