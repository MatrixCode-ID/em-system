<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Em.Ui.Maui.Navigations"
             xmlns:controls="clr-namespace:Em.Ui.Maui.Controls"
             x:Class="Em.Ui.Maui.Navigations.DefaultHomeControl">

   <ContentView.BindingContext>
      <local:DefaultHomeControlVm />
   </ContentView.BindingContext>

   <ScrollView>
      <VerticalStackLayout Padding="20,20,20,32" Spacing="16">

         <!-- The search box. Only its shape for now - just like on the desktop client, it is not connected to
              anything yet. Its filter will be done later, when there are enough module screens to make it useful,
              and preferably on both clients at once. -->
         <Border Style="{StaticResource searchFieldStyle}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
               <controls:FontIcon Grid.Column="0" Glyph="{x:Static controls:FontIcons.MagnifyingGlass}"
                                  IconSize="14" VerticalOptions="Center" Opacity="0.6"
                                  TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
               <Entry Grid.Column="1" Placeholder="Search" FontSize="14" VerticalOptions="Center" />
            </Grid>
         </Border>

         <Border Style="{StaticResource outlinedCardStyle}" IsVisible="{Binding IsModuleListEmpty}">
            <VerticalStackLayout Spacing="8">
               <controls:FontIcon Glyph="{x:Static controls:FontIcons.TableCellsLarge}" IconSize="24"
                                  HorizontalOptions="Start"
                                  TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
               <Label Text="No module yet" Style="{StaticResource titleTextStyle}" />
               <Label Text="Screens registered by a module will appear here as shortcuts."
                      Style="{StaticResource supportTextStyle}" />
            </VerticalStackLayout>
         </Border>

         <!-- A screen without a MenuPath stands on top of the tree, not inside one of its groups. -->
         <VerticalStackLayout Spacing="10"
                              BindableLayout.ItemsSource="{Binding RootAppMenus}"
                              BindableLayout.ItemTemplate="{StaticResource navigationTileTemplate}" />

         <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding AppMenuGroups}">
            <BindableLayout.ItemTemplate>
               <DataTemplate>
                  <local:MenuGroupView />
               </DataTemplate>
            </BindableLayout.ItemTemplate>
         </VerticalStackLayout>
      </VerticalStackLayout>
   </ScrollView>
</ContentView>
