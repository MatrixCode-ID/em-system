<?xml version="1.0" encoding="UTF-8" ?>
<!-- One group in the home menu tree, together with all its content. A child group is drawn with the same
     control - the template below names itself - so the depth of the tree is decided by MenuPath, not by
     how many levels happen to have been written here. MAUI has no Expander, so what opens and closes is
     IsVisible on its content, with the chevron in the header as its marker. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Em.Ui.Maui.Navigations"
             xmlns:controls="clr-namespace:Em.Ui.Maui.Controls"
             x:Class="Em.Ui.Maui.Navigations.MenuGroupView">

   <VerticalStackLayout Spacing="8">

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" HeightRequest="36"
            Margin="{Binding Indent}">
         <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Commands[ToggleCommand]}" />
         </Grid.GestureRecognizers>
         <controls:FontIcon Grid.Column="0" Glyph="{Binding ChevronGlyph}" IconSize="12"
                            VerticalOptions="Center"
                            TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
         <Label Grid.Column="1" Text="{Binding Header}" Style="{StaticResource menuGroupHeaderStyle}" />
      </Grid>

      <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExpanded}" Margin="{Binding Indent}">

         <!-- This group's own cards first, then the groups nested below it - the same order in which its levels
              are read. -->
         <VerticalStackLayout Spacing="10"
                              BindableLayout.ItemsSource="{Binding Items}"
                              BindableLayout.ItemTemplate="{StaticResource navigationTileTemplate}" />

         <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Groups}">
            <BindableLayout.ItemTemplate>
               <DataTemplate>
                  <local:MenuGroupView />
               </DataTemplate>
            </BindableLayout.ItemTemplate>
         </VerticalStackLayout>
      </VerticalStackLayout>
   </VerticalStackLayout>
</ContentView>
