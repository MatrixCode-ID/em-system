<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Em.Ui.Maui.Navigations"
             xmlns:controls="clr-namespace:Em.Ui.Maui.Controls"
             x:Class="Em.Ui.Maui.Navigations.SpaNavigationHost">

   <ContentPage.BindingContext>
      <local:SpaNavigationHostVm />
   </ContentPage.BindingContext>

   <Grid>

      <!-- ==== page content ==== -->
      <Grid RowDefinitions="Auto,Auto,*">

         <!-- Top bar: back and home on the left, the title in the middle, reload and the account badge on the
              right. The forward button is deliberately not here - on Android there is no natural gesture for going
              forward, and a button without a companion gesture only adds clutter to a narrow bar. The path itself
              stays intact: CanGoForward and ForwardCommand are still alive in the view model, ready to be attached
              again if this host is used on MAUI desktop. -->
         <Grid Grid.Row="0"
               Style="{StaticResource appBarStyle}"
               ColumnDefinitions="Auto,Auto,*,Auto,Auto"
               IsVisible="{Binding IsToolbarVisible}">

            <controls:IconButton Grid.Column="0"
                                 Glyph="{x:Static controls:FontIcons.ArrowLeft}"
                                 IsVisible="{Binding IsBackVisible}"
                                 Command="{Binding Commands[LeadingCommand]}"
                                 TintColor="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" />

            <controls:IconButton Grid.Column="1"
                                 Glyph="{x:Static controls:FontIcons.House}"
                                 IsVisible="{Binding IsHomeVisible}"
                                 Command="{Binding Commands[HomeCommand]}"
                                 TintColor="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" />

            <VerticalStackLayout Grid.Column="2" Padding="8,0" Spacing="1" VerticalOptions="Center"
                                 IsVisible="{Binding IsTitleVisible}">
               <Label Text="{Binding Title}" Style="{StaticResource headlineTextStyle}"
                      FontSize="19" LineBreakMode="TailTruncation" />
               <Label Text="{Binding Subtitle}" Style="{StaticResource supportTextStyle}"
                      LineBreakMode="TailTruncation" IsVisible="{Binding HasSubtitle}" />
            </VerticalStackLayout>

            <controls:IconButton Grid.Column="3"
                                 Glyph="{x:Static controls:FontIcons.RotateRight}"
                                 IsVisible="{Binding IsReloadVisible}"
                                 Command="{Binding Commands[ReloadCommand]}"
                                 TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />

            <!-- The account badge, which opens the account panel. It is on every screen, not only home: it is the one
                 and only way to the account, server, theme, and sign-out once the side menu has been dropped. -->
            <Border Grid.Column="4" Style="{StaticResource accountBadgeStyle}"
                    IsVisible="{Binding IsUserVisible}">
               <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding Commands[AccountPanelCommand]}" />
               </Border.GestureRecognizers>
               <!-- Initials, not the same person silhouette for everyone: this badge tells whose account is signed in,
                    without having to spell out the whole name in a narrow bar. This is where a profile photo will later
                    be placed - the picture simply replaces this Label, and the Border is still what rounds it. -->
               <Label Text="{Binding AccountInitials}" FontFamily="OpenSansSemibold" FontSize="13"
                      HorizontalOptions="Center" VerticalOptions="Center"
                      TextColor="{AppThemeBinding Light={StaticResource onPrimaryContainerLight}, Dark={StaticResource onPrimaryContainerDark}}" />
            </Border>
         </Grid>

         <BoxView Grid.Row="1" Style="{StaticResource dividerStyle}" IsVisible="{Binding IsToolbarVisible}" />

         <ContentView Grid.Row="2" x:Name="BodyHost" />
      </Grid>

      <!-- ==== tirai ==== -->
      <BoxView x:Name="Scrim" Style="{StaticResource scrimStyle}" InputTransparent="True">
         <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Commands[CloseAccountPanelCommand]}" />
         </BoxView.GestureRecognizers>
      </BoxView>

      <!-- ==== panel account ==== -->
      <local:AccountPanel x:Name="AccountPanelView" />
   </Grid>
</ContentPage>
