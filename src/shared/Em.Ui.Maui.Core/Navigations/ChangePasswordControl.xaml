<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Em.Ui.Maui.Navigations"
             xmlns:controls="clr-namespace:Em.Ui.Maui.Controls"
             x:Class="Em.Ui.Maui.Navigations.ChangePasswordControl">

   <ContentView.BindingContext>
      <local:ChangePasswordControlVm />
   </ContentView.BindingContext>

   <ContentView.Resources>
      <DataTemplate x:Key="passwordRuleTemplate">
         <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2">
            <controls:FontIcon Grid.Column="0" Glyph="{Binding Glyph}" IconSize="12"
                               VerticalOptions="Center" TintColor="{Binding MarkColor}" />
            <Label Grid.Column="1" Text="{Binding Caption}" Style="{StaticResource supportTextStyle}"
                   FontSize="12" VerticalOptions="Center" />
         </Grid>
      </DataTemplate>
   </ContentView.Resources>

   <ScrollView>
      <VerticalStackLayout Padding="20,20,20,32" Spacing="16">

         <Border Style="{StaticResource cardStyle}">
            <VerticalStackLayout Spacing="16">

               <Label Text="CHANGE PASSWORD" Style="{StaticResource sectionCaptionStyle}" />

               <Label Text="{Binding AccountCaption}" Style="{StaticResource supportTextStyle}" />

               <VerticalStackLayout Spacing="6">
                  <Label Text="Current password" Style="{StaticResource labelTextStyle}" />
                  <Border Style="{StaticResource inputFieldStyle}">
                     <Entry Text="{Binding CurrentPassword}" IsPassword="True"
                            Placeholder="Current password" ReturnType="Next" />
                  </Border>
               </VerticalStackLayout>

               <VerticalStackLayout Spacing="6">
                  <Label Text="New password" Style="{StaticResource labelTextStyle}" />
                  <Border Style="{StaticResource inputFieldStyle}">
                     <Entry Text="{Binding NewPassword}" IsPassword="True"
                            Placeholder="New password" ReturnType="Next" />
                  </Border>
               </VerticalStackLayout>

               <VerticalStackLayout Spacing="6">
                  <Label Text="Confirm new password" Style="{StaticResource labelTextStyle}" />
                  <Border Style="{StaticResource inputFieldStyle}">
                     <Entry Text="{Binding ConfirmPassword}" IsPassword="True"
                            Placeholder="Repeat the new password" ReturnType="Go"
                            ReturnCommand="{Binding Commands[SaveCommand]}" />
                  </Border>
                  <Label Text="Both boxes must match." Style="{StaticResource errorTextStyle}"
                         FontSize="11" IsVisible="{Binding HasConfirmMismatch}" />
               </VerticalStackLayout>

               <VerticalStackLayout Spacing="8" IsVisible="{Binding HasRules}">
                  <ProgressBar Progress="{Binding Strength}"
                               ProgressColor="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
                  <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rules}"
                                       BindableLayout.ItemTemplate="{StaticResource passwordRuleTemplate}" />
               </VerticalStackLayout>

               <Button Text="Save" Style="{StaticResource filledButtonStyle}"
                       Command="{Binding Commands[SaveCommand]}" />

               <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasSaveError}">
                  <controls:FontIcon Glyph="{x:Static controls:FontIcons.Key}" IconSize="18"
                                     VerticalOptions="Start"
                                     TintColor="{AppThemeBinding Light={StaticResource errorLight}, Dark={StaticResource errorDark}}" />
                  <Label Text="{Binding SaveError}" Style="{StaticResource errorTextStyle}" />
               </HorizontalStackLayout>

               <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                  HorizontalOptions="Center" />
            </VerticalStackLayout>
         </Border>
      </VerticalStackLayout>
   </ScrollView>
</ContentView>
