<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:local="clr-namespace:Em.Ui.Maui.Navigations" xmlns:controls="clr-namespace:Em.Ui.Maui.Controls" x:Class="Em.Ui.Maui.Navigations.LoginControl">
 <ContentView.BindingContext><local:LoginControlVm /></ContentView.BindingContext>
 <ScrollView><VerticalStackLayout Padding="16,24" Spacing="24" MaximumWidthRequest="600" HorizontalOptions="Fill">
  <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
   <Image Source="{Binding LogoImage}" HeightRequest="64" Aspect="AspectFit" />
   <Label Text="{Binding BrandTitle}" Style="{StaticResource headlineSmallTextStyle}" SemanticProperties.HeadingLevel="Level1" />
   <Label Text="{Binding BrandTagline}" Style="{StaticResource bodyMediumTextStyle}" />
  </VerticalStackLayout>
  <controls:FeedbackView Message="{Binding SessionEndedNotice}" Kind="Info" />
  <VerticalStackLayout Spacing="16" IsEnabled="{Binding IsNotBusy}">
   <controls:MaterialField Label="API server" Text="{Binding ServerUrl}" IsReadOnly="{Binding IsServerLocked}" Error="{Binding ServerError}" />
   <controls:MaterialField Label="Account" Text="{Binding UserName}" Help="Enter your account name" Error="{Binding AccountError}" />
   <controls:MaterialField Label="Password" Text="{Binding Password}" IsPassword="True" Error="{Binding PasswordError}" />
   <Button Text="Sign in" Style="{StaticResource filledButtonStyle}" Command="{Binding Commands[SignInCommand]}" />
   <Button Text="Debug Sign In" Style="{StaticResource tonalButtonStyle}" Command="{Binding Commands[DebugSignInCommand]}" IsVisible="{Binding IsDebugSignInVisible}" />
   <Button Text="Cancel simulation · Return to SD" Style="{StaticResource tonalButtonStyle}" Command="{Binding Commands[ExitSimulationCommand]}" IsVisible="{Binding IsDebugSignInVisible}" SemanticProperties.Description="Cancel simulation and return to SYSTEM DEBUGGER" />
  </VerticalStackLayout>
  <controls:FeedbackView Message="{Binding SignInError}" Kind="Error" />
  <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
  <Button Text="Switch theme" Style="{StaticResource textButtonStyle}" Command="{Binding Commands[ToggleThemeCommand]}" />
  <Label Text="{Binding InstalledVersion}" Style="{StaticResource bodyMediumTextStyle}" HorizontalOptions="Center" />
  <Button Text="Check for updates" Style="{StaticResource tonalButtonStyle}" Command="{Binding Commands[CheckForUpdatesCommand]}" />
  <Label Text="{Binding BrandCopyright}" Style="{StaticResource bodyMediumTextStyle}" HorizontalOptions="Center" />
 </VerticalStackLayout></ScrollView>
</ContentView>
