<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Em.Ui.Maui.Navigations"
             xmlns:controls="clr-namespace:Em.Ui.Maui.Controls"
             x:Class="Em.Ui.Maui.Navigations.ApprovalViewer">

   <ContentView.BindingContext>
      <local:ApprovalViewerVm />
   </ContentView.BindingContext>

   <Grid RowDefinitions="*,Auto">

      <RefreshView Grid.Row="0" IsRefreshing="{Binding IsRefreshing}" Command="{Binding Commands[RefreshCommand]}">
         <ScrollView>
            <VerticalStackLayout Padding="16,12,16,24" Spacing="14">

               <HorizontalStackLayout Spacing="8">
                  <Button Text="Previous" Command="{Binding Commands[PreviousCommand]}" Style="{StaticResource tonalButtonStyle}"/>
                  <Button Text="Next" Command="{Binding Commands[NextCommand]}" Style="{StaticResource tonalButtonStyle}"/>
               </HorizontalStackLayout>
               <!-- ==== header ==== -->
               <Border Style="{StaticResource cardStyle}" Padding="16">
                  <VerticalStackLayout Spacing="8">
                     <Label Text="{Binding Caption}" Style="{StaticResource sectionCaptionStyle}" />
                     <Label Text="{Binding Summary}" Style="{StaticResource titleTextStyle}" />
                     <Label Text="{Binding SubSummary}" Style="{StaticResource supportTextStyle}"
                            IsVisible="{Binding HasSubSummary}" />
                     <FlexLayout Wrap="Wrap" AlignItems="Center">
                        <Border Style="{StaticResource accentChipStyle}" Margin="0,0,6,4">
                           <Label Text="{Binding Status}" Style="{StaticResource accentChipTextStyle}" />
                        </Border>
                        <Border Style="{StaticResource chipStyle}" Margin="0,0,6,4">
                           <Label Text="{Binding LevelText}" Style="{StaticResource chipTextStyle}" />
                        </Border>
                        <Label Text="{Binding RequestedText}" Style="{StaticResource supportTextStyle}"
                               VerticalOptions="Center" Margin="0,0,0,4" />
                     </FlexLayout>
                     <Button Text="View document (PDF)" Style="{StaticResource tonalButtonStyle}"
                             IsVisible="{Binding HasPreview}" Command="{Binding Commands[PreviewCommand]}" />
                  </VerticalStackLayout>
               </Border>

               <controls:FeedbackView Message="{Binding Error}" Kind="Error" />
               <controls:FeedbackView Message="{Binding Notice}" Kind="Info" />

               <!-- ==== module view ==== -->
               <ContentView Content="{Binding ModuleView}" IsVisible="{Binding HasModuleView}" />

               <!-- ==== data fields ==== -->
               <VerticalStackLayout Spacing="8" IsVisible="{Binding HasFields}">
                  <Label Text="PROPOSED CHANGES" Style="{StaticResource sectionCaptionStyle}" />
                  <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Fields}">
                     <BindableLayout.ItemTemplate>
                        <DataTemplate>
                           <Border Style="{StaticResource outlinedCardStyle}" Padding="12">
                              <VerticalStackLayout Spacing="2">
                                 <Label Text="{Binding Column}" Style="{StaticResource labelTextStyle}" FontAttributes="Bold" />
                                 <Label Text="{Binding Change}" Style="{StaticResource bodyTextStyle}" />
                                 <Label Text="{Binding ConflictText}" Style="{StaticResource errorTextStyle}"
                                        IsVisible="{Binding Conflict}" />
                              </VerticalStackLayout>
                           </Border>
                        </DataTemplate>
                     </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>
               </VerticalStackLayout>

               <!-- ==== signers ==== -->
               <VerticalStackLayout Spacing="8" IsVisible="{Binding HasSteps}">
                  <Label Text="SIGNERS" Style="{StaticResource sectionCaptionStyle}" />
                  <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Steps}">
                     <BindableLayout.ItemTemplate>
                        <DataTemplate>
                           <Border Style="{StaticResource actionCardStyle}" Padding="14">
                              <Border.Triggers>
                                 <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="Stroke"
                                            Value="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
                                 </DataTrigger>
                              </Border.Triggers>

                              <VerticalStackLayout Spacing="8">
                                 <Button Text="{Binding SelectionCaption}" Style="{StaticResource tonalButtonStyle}" Command="{Binding Commands[SelectCommand]}" />
                                 <controls:FontIcon Grid.RowSpan="2" Glyph="{Binding Glyph}" IconSize="20"
                                                    VerticalOptions="Start" Margin="0,2,0,0"
                                                    TintColor="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
                                 <Label Grid.Column="1" Text="{Binding Heading}" Style="{StaticResource titleTextStyle}"
                                        />
                                 <Border Grid.Column="2" Style="{StaticResource accentChipStyle}" IsVisible="{Binding IsMyTurn}">
                                    <Label Text="{Binding Status}" Style="{StaticResource accentChipTextStyle}" />
                                 </Border>
                                 <Border Grid.Column="2" Style="{StaticResource chipStyle}" IsVisible="{Binding IsNotMyTurn}">
                                    <Label Text="{Binding Status}" Style="{StaticResource chipTextStyle}" />
                                 </Border>
                                 <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SignerName}"
                                        Style="{StaticResource bodyLargeTextStyle}" />
                                 <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SignatureText}"
                                        Style="{StaticResource supportTextStyle}"
                                        IsVisible="{Binding HasSignature}" />
                                 <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DecisionNote}"
                                        Style="{StaticResource bodyTextStyle}" FontAttributes="Italic"
                                        IsVisible="{Binding HasNote}" />
                              </VerticalStackLayout>
                           </Border>
                        </DataTemplate>
                     </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>
               </VerticalStackLayout>

               <!-- ==== comments ==== -->
               <VerticalStackLayout Spacing="8">
                  <Label Text="COMMENTS" Style="{StaticResource sectionCaptionStyle}" />
                  <Label Text="No comment yet." Style="{StaticResource supportTextStyle}" IsVisible="{Binding HasNoComments}" />
                  <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Comments}">
                     <BindableLayout.ItemTemplate>
                        <DataTemplate>
                           <Border Style="{StaticResource outlinedCardStyle}" Padding="12">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                 <controls:FontIcon Grid.RowSpan="2" Glyph="{Binding Glyph}" IconSize="14"
                                                    VerticalOptions="Start" Margin="0,3,0,0" Opacity="0.7"
                                                    TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
                                 <Label Grid.Column="1" Text="{Binding Header}" Style="{StaticResource supportTextStyle}" />
                                 <Label Grid.Row="1" Grid.Column="1" Text="{Binding Text}" Style="{StaticResource bodyTextStyle}"
                                        IsVisible="{Binding HasText}" />
                              </Grid>
                           </Border>
                        </DataTemplate>
                     </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>
                  <Border Style="{StaticResource inputFieldStyle}">
                     <Editor Text="{Binding Comment}" Placeholder="Write a comment" AutoSize="TextChanges"
                             MinimumHeightRequest="48" />
                  </Border>
                  <Button Text="Send comment" Style="{StaticResource outlinedButtonStyle}" HorizontalOptions="End"
                          Command="{Binding Commands[CommentCommand]}" />
               </VerticalStackLayout>
            </VerticalStackLayout>
         </ScrollView>
      </RefreshView>

      <!-- ==== action bar ==== -->
      <Border Grid.Row="1" StrokeThickness="0" Padding="16,10,16,14" IsVisible="{Binding CanDecide}"
              BackgroundColor="{AppThemeBinding Light={StaticResource surfaceContainerLight}, Dark={StaticResource surfaceContainerDark}}">
         <VerticalStackLayout Spacing="8">
            <Label Text="{Binding DecisionCaption}" Style="{StaticResource bodyLargeTextStyle}" />
            <VerticalStackLayout Spacing="8">
               <Button Grid.Column="0" Text="Reject" Style="{StaticResource outlinedButtonStyle}"
                       Command="{Binding Commands[RejectCommand]}" />
               <Button Grid.Column="1" Text="{Binding ApproveText}" Style="{StaticResource filledButtonStyle}"
                       Command="{Binding Commands[ApproveCommand]}" />
            </VerticalStackLayout>
         </VerticalStackLayout>
      </Border>

      <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                         HorizontalOptions="Center" VerticalOptions="Center" />
   </Grid>
</ContentView>
