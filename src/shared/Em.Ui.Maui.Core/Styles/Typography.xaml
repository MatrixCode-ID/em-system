<?xml version="1.0" encoding="UTF-8" ?>
<!-- The Material 3 type scale, trimmed to the levels this application really uses. The style names follow
     the names of the levels in Material, not where they are used, so one level does not change its name
     every time it is used on a different screen.

     The text color is not named here except for levels that are always calmer; the others inherit the
     color from their base style. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styles="clr-namespace:Em.Ui.Maui.Styles">

   <!-- Palette is merged again here, not just once in MaterialDesign.xaml: a StaticResource inside a
        ResourceDictionary file only sees the content of that file and the dictionaries merged into it - a
        dictionary standing beside it is not visible. -->
   <ResourceDictionary.MergedDictionaries>
      <styles:Palette />
   </ResourceDictionary.MergedDictionaries>

   <Style x:Key="bodyTextStyle" TargetType="Label">
      <Setter Property="FontFamily" Value="OpenSansRegular" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" />
   </Style>

   <Style x:Key="displayTextStyle" TargetType="Label" BasedOn="{StaticResource bodyTextStyle}">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="28" />
   </Style>

   <Style x:Key="headlineTextStyle" TargetType="Label" BasedOn="{StaticResource bodyTextStyle}">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="22" />
   </Style>

   <Style x:Key="titleTextStyle" TargetType="Label" BasedOn="{StaticResource bodyTextStyle}">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="16" />
   </Style>

   <Style x:Key="labelTextStyle" TargetType="Label" BasedOn="{StaticResource bodyTextStyle}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
   </Style>

   <!-- The head of a section: small, bold, and letter-spaced so it reads as a group marker, not as a content
        row. -->
   <Style x:Key="sectionCaptionStyle" TargetType="Label" BasedOn="{StaticResource labelTextStyle}">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CharacterSpacing" Value="1.2" />
   </Style>

   <!-- A caption that goes with the row above it; deliberately calmer than its content itself. -->
   <Style x:Key="supportTextStyle" TargetType="Label" BasedOn="{StaticResource labelTextStyle}">
      <Setter Property="FontSize" Value="12.5" />
   </Style>

   <Style x:Key="errorTextStyle" TargetType="Label" BasedOn="{StaticResource labelTextStyle}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource errorLight}, Dark={StaticResource errorDark}}" />
   </Style>
</ResourceDictionary>
