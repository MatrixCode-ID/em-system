<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Skala huruf Material 3, dipangkas ke tingkat yang benar-benar dipakai aplikasi ini. Nama style-nya
   mengikuti nama tingkatannya di Material, bukan tempat pemakaiannya, supaya satu tingkat tidak
   berganti nama setiap kali ia dipakai di layar yang berbeda.

   Warna teks tidak disebut di sini kecuali untuk tingkat yang memang selalu lebih tenang; sisanya
   mewarisi warna dari style dasarnya.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styles="clr-namespace:Em.Ui.Maui.Styles">

   <!-- Palette digabungkan lagi di sini, bukan cukup sekali di MaterialDesign.xaml: StaticResource di
        dalam sebuah berkas ResourceDictionary hanya melihat isi berkas itu sendiri dan kamus yang
        digabungkan di dalamnya - kamus yang berdiri berdampingan dengannya tidak terlihat. -->
   <ResourceDictionary.MergedDictionaries>
      <styles:Palette />
   </ResourceDictionary.MergedDictionaries>

   <Style x:Key="bodyTextStyle" TargetType="Label">
      <Setter Property="FontFamily" Value="OpenSansRegular" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" />
   </Style>

   <Style x:Key="displayTextStyle" TargetType="Label" BasedOn="{StaticResource bodyTextStyle}">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="28" />
   </Style>

   <Style x:Key="headlineTextStyle" TargetType="Label" BasedOn="{StaticResource bodyTextStyle}">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="22" />
   </Style>

   <Style x:Key="titleTextStyle" TargetType="Label" BasedOn="{StaticResource bodyTextStyle}">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="16" />
   </Style>

   <Style x:Key="labelTextStyle" TargetType="Label" BasedOn="{StaticResource bodyTextStyle}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
   </Style>

   <!-- Kepala sebuah bagian: huruf kecil, tebal, dan diberi jarak antar huruf supaya ia terbaca
        sebagai penanda kelompok, bukan sebagai baris isi. -->
   <Style x:Key="sectionCaptionStyle" TargetType="Label" BasedOn="{StaticResource labelTextStyle}">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CharacterSpacing" Value="1.2" />
   </Style>

   <!-- Keterangan yang menyertai baris di atasnya; sengaja lebih tenang daripada isinya sendiri. -->
   <Style x:Key="supportTextStyle" TargetType="Label" BasedOn="{StaticResource labelTextStyle}">
      <Setter Property="FontSize" Value="12.5" />
   </Style>

   <Style x:Key="errorTextStyle" TargetType="Label" BasedOn="{StaticResource labelTextStyle}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource errorLight}, Dark={StaticResource errorDark}}" />
   </Style>
</ResourceDictionary>
