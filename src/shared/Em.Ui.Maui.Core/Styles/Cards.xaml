<?xml version="1.0" encoding="UTF-8" ?>
<!-- Cards and dividers. Cards here are of the "filled" kind - they stand on the page through their own
     surface, not through a shadow. A shadow is deliberately not used at all: in the dark theme it is
     almost invisible, so the same screen would read differently in the two themes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styles="clr-namespace:Em.Ui.Maui.Styles"
                    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

   <!-- Palette is merged again here, not just once in MaterialDesign.xaml: a StaticResource inside a
        ResourceDictionary file only sees the content of that file and the dictionaries merged into it - a
        dictionary standing beside it is not visible. -->
   <ResourceDictionary.MergedDictionaries>
      <styles:Palette />
   </ResourceDictionary.MergedDictionaries>

   <Style x:Key="cardStyle" TargetType="Border">
      <Setter Property="Padding" Value="20" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource surfaceContainerLowLight}, Dark={StaticResource surfaceContainerLowDark}}" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="16" />
      </Setter>
   </Style>

   <!-- A card whose content can be pressed; its radius is larger so it reads as a single touchable whole,
        not just a surface holding text. -->
   <Style x:Key="actionCardStyle" TargetType="Border" BasedOn="{StaticResource cardStyle}">
      <Setter Property="Padding" Value="16" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource surfaceContainerLight}, Dark={StaticResource surfaceContainerDark}}" />
   </Style>

   <!-- An outlined card, for content that must not draw more attention than its neighbors. -->
   <Style x:Key="outlinedCardStyle" TargetType="Border" BasedOn="{StaticResource cardStyle}">
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Stroke"
              Value="{AppThemeBinding Light={StaticResource outlineVariantLight}, Dark={StaticResource outlineVariantDark}}" />
   </Style>

   <Style x:Key="dividerStyle" TargetType="BoxView">
      <Setter Property="HeightRequest" Value="1" />
      <Setter Property="Color"
              Value="{AppThemeBinding Light={StaticResource outlineVariantLight}, Dark={StaticResource outlineVariantDark}}" />
   </Style>

   <!-- A small rounded label for a status, sitting inside a card row. -->
   <Style x:Key="chipStyle" TargetType="Border">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="HorizontalOptions" Value="Start" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource secondaryContainerLight}, Dark={StaticResource secondaryContainerDark}}" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="8" />
      </Setter>
   </Style>

   <!-- The chip of something that asks for the user's attention, e.g. a step waiting for their signature. -->
   <Style x:Key="accentChipStyle" TargetType="Border" BasedOn="{StaticResource chipStyle}">
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource primaryContainerLight}, Dark={StaticResource primaryContainerDark}}" />
   </Style>

   <Style x:Key="chipTextStyle" TargetType="Label">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSecondaryContainerLight}, Dark={StaticResource onSecondaryContainerDark}}" />
   </Style>

   <!-- A small count bubble on the top-right corner of an icon button, e.g. the work waiting for the user. -->
   <Style x:Key="countBadgeStyle" TargetType="Border">
      <Setter Property="HeightRequest" Value="18" />
      <Setter Property="MinimumWidthRequest" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="0,6,2,0" />
      <Setter Property="HorizontalOptions" Value="End" />
      <Setter Property="VerticalOptions" Value="Start" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource errorLight}, Dark={StaticResource errorDark}}" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="9" />
      </Setter>
   </Style>

   <Style x:Key="countBadgeTextStyle" TargetType="Label">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextColor" Value="White" />
      <Setter Property="HorizontalOptions" Value="Center" />
      <Setter Property="VerticalOptions" Value="Center" />
   </Style>

   <!-- A circle holding initials, standing in for a photo that does not exist. -->
   <Style x:Key="avatarStyle" TargetType="Border">
      <Setter Property="WidthRequest" Value="44" />
      <Setter Property="HeightRequest" Value="44" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource primaryContainerLight}, Dark={StaticResource primaryContainerDark}}" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="22" />
      </Setter>
   </Style>
</ResourceDictionary>
