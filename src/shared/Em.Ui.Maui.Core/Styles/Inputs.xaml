<?xml version="1.0" encoding="UTF-8" ?>
<!-- Input fields. Their form follows the Material "filled" text field: one calm surface with rounded
     corners on top, no border, so a row of fields reads as a list rather than a set of boxes.

     Fields here are wrapped in a Border with the inputFieldStyle style, and the Entry/Picker inside it are
     left without a surface of their own - that is why both are implicit styles: set once, every field
     inside its wrapper follows right away. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styles="clr-namespace:Em.Ui.Maui.Styles"
                    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

   <!-- Palette is merged again here, not just once in MaterialDesign.xaml: a StaticResource inside a
        ResourceDictionary file only sees the content of that file and the dictionaries merged into it - a
        dictionary standing beside it is not visible. -->
   <ResourceDictionary.MergedDictionaries>
      <styles:Palette />
   </ResourceDictionary.MergedDictionaries>

   <Style x:Key="inputFieldStyle" TargetType="Border">
      <Setter Property="Padding" Value="14,2" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource surfaceContainerHighLight}, Dark={StaticResource surfaceContainerHighDark}}" />
      <Setter Property="Stroke"
              Value="{AppThemeBinding Light={StaticResource outlineVariantLight}, Dark={StaticResource outlineVariantDark}}" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="12" />
      </Setter>
   </Style>

   <Style TargetType="Entry">
      <Setter Property="FontFamily" Value="OpenSansRegular" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" />
      <Setter Property="PlaceholderColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
   </Style>

   <Style TargetType="Picker">
      <Setter Property="FontFamily" Value="OpenSansRegular" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceLight}, Dark={StaticResource onSurfaceDark}}" />
      <Setter Property="TitleColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
   </Style>

   <Style TargetType="CheckBox">
      <Setter Property="Color"
              Value="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
   </Style>

   <Style TargetType="ActivityIndicator">
      <Setter Property="Color"
              Value="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
   </Style>
</ResourceDictionary>
