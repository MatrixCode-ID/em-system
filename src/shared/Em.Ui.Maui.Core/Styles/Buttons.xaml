<?xml version="1.0" encoding="UTF-8" ?>
<!-- The Material 3 button variants. All are full pills (height 48, radius 24) and use one font size; what
     tells them apart is only how loudly each demands attention - and every screen may only have one filled
     button. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styles="clr-namespace:Em.Ui.Maui.Styles">

   <!-- Palette is merged again here, not just once in MaterialDesign.xaml: a StaticResource inside a
        ResourceDictionary file only sees the content of that file and the dictionaries merged into it - a
        dictionary standing beside it is not visible. -->
   <ResourceDictionary.MergedDictionaries>
      <styles:Palette />
   </ResourceDictionary.MergedDictionaries>

   <Style x:Key="buttonBaseStyle" TargetType="Button">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HeightRequest" Value="48" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="VisualStateManager.VisualStateGroups">
         <VisualStateGroupList>
            <VisualStateGroup x:Name="CommonStates">
               <VisualState x:Name="Normal">
                  <VisualState.Setters>
                     <Setter Property="Opacity" Value="1" />
                  </VisualState.Setters>
               </VisualState>
               <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                     <Setter Property="Opacity" Value="0.75" />
                  </VisualState.Setters>
               </VisualState>
               <!-- A button that may not be pressed is dimmed, not recolored: one and the same rule looks good in both
                    themes. -->
               <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                     <Setter Property="Opacity" Value="0.38" />
                  </VisualState.Setters>
               </VisualState>
            </VisualStateGroup>
         </VisualStateGroupList>
      </Setter>
   </Style>

   <!-- The main action of the screen, only one per screen. -->
   <Style x:Key="filledButtonStyle" TargetType="Button" BasedOn="{StaticResource buttonBaseStyle}">
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onPrimaryLight}, Dark={StaticResource onPrimaryDark}}" />
   </Style>

   <!-- An important action beside the main action. -->
   <Style x:Key="tonalButtonStyle" TargetType="Button" BasedOn="{StaticResource buttonBaseStyle}">
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource secondaryContainerLight}, Dark={StaticResource secondaryContainerDark}}" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSecondaryContainerLight}, Dark={StaticResource onSecondaryContainerDark}}" />
   </Style>

   <!-- A second action that still needs to be seen as a button. -->
   <Style x:Key="outlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource buttonBaseStyle}">
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="BorderWidth" Value="1" />
      <Setter Property="BorderColor"
              Value="{AppThemeBinding Light={StaticResource outlineLight}, Dark={StaticResource outlineDark}}" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
   </Style>

   <!-- The lightest action; it carries no surface of its own at all. -->
   <Style x:Key="textButtonStyle" TargetType="Button" BasedOn="{StaticResource buttonBaseStyle}">
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
   </Style>
</ResourceDictionary>
