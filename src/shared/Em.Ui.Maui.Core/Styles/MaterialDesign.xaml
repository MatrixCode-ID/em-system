<?xml version="1.0" encoding="UTF-8" ?>
<!-- The one and only entry to the whole design language of this MAUI application. Its user only needs to
     name this file once in App.xaml; never copy the palette or styles into the file of each screen - add
     to one of the files below, and every screen follows right away.

     The order is binding: Palette first because every file after it names colors from there. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styles="clr-namespace:Em.Ui.Maui.Styles"
                    x:Class="Em.Ui.Maui.Styles.MaterialDesign">

   <ResourceDictionary.MergedDictionaries>
      <styles:Palette />
      <ResourceDictionary Source="/Styles/Typography.xaml" />
      <ResourceDictionary Source="/Styles/Buttons.xaml" />
      <ResourceDictionary Source="/Styles/Cards.xaml" />
      <ResourceDictionary Source="/Styles/Inputs.xaml" />
      <ResourceDictionary Source="/Styles/Navigation.xaml" />
   </ResourceDictionary.MergedDictionaries>

   <!-- The background of every page, set once here so no screen forgets to name it and ends up white in the
        dark theme. -->
   <Style TargetType="Page" ApplyToDerivedTypes="True">
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource surfaceLight}, Dark={StaticResource surfaceDark}}" />
   </Style>

   <Style TargetType="Label" ApplyToDerivedTypes="True" BasedOn="{StaticResource bodyTextStyle}" />
</ResourceDictionary>
