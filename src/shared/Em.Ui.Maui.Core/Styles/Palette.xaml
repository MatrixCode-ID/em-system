<?xml version="1.0" encoding="UTF-8" ?>
<!-- The Material 3 color roles, derived from the EM brand color: blue #0F6CBD as the primary color and
     teal #087B78 as the companion color.

     Every role has a pair of keys, ending in Light and Dark. A dark theme color is not a darker version
     of the light one but its counterpart: what is the fill color in the light theme becomes the text color
     on that fill in the dark theme - Material flips the two so the contrast stays the same.

     Its user names both at once through AppThemeBinding, e.g.
     Value="{AppThemeBinding Light={StaticResource surfaceLight}, Dark={StaticResource surfaceDark}}",
     so one markup serves both themes and switching theme requires nothing to be redrawn.

     The values here are the standard Em palette (LightTheme/DarkTheme in Em.Ui.Core). When this
     dictionary is created, Palette.xaml.cs overwrites them with the themes installed by the application
     through BrandingInfo, so other files only need to merge <styles:Palette /> and never copy its values
     themselves. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Em.Ui.Maui.Styles.Palette">

   <!-- The primary color: the single most important action on a screen, and the marker of the active choice. -->
   <Color x:Key="primaryLight">#0F6CBD</Color>
   <Color x:Key="primaryDark">#A6C8FF</Color>
   <Color x:Key="onPrimaryLight">#FFFFFF</Color>
   <Color x:Key="onPrimaryDark">#00315F</Color>
   <Color x:Key="primaryContainerLight">#D6E3FF</Color>
   <Color x:Key="primaryContainerDark">#004787</Color>
   <Color x:Key="onPrimaryContainerLight">#001B3C</Color>
   <Color x:Key="onPrimaryContainerDark">#D6E3FF</Color>

   <!-- The companion color: a marker that goes along with the primary, e.g. the selected area in the side
        menu. -->
   <Color x:Key="secondaryLight">#00696B</Color>
   <Color x:Key="secondaryDark">#4CDADB</Color>
   <Color x:Key="onSecondaryLight">#FFFFFF</Color>
   <Color x:Key="onSecondaryDark">#003738</Color>
   <Color x:Key="secondaryContainerLight">#BEEBEB</Color>
   <Color x:Key="secondaryContainerDark">#004F50</Color>
   <Color x:Key="onSecondaryContainerLight">#002020</Color>
   <Color x:Key="onSecondaryContainerDark">#6FF7F8</Color>

   <!-- Surfaces: the page background and everything that stands on it. -->
   <Color x:Key="surfaceLight">#FAF9FD</Color>
   <Color x:Key="surfaceDark">#111418</Color>
   <Color x:Key="onSurfaceLight">#1A1C1E</Color>
   <Color x:Key="onSurfaceDark">#E2E2E6</Color>
   <Color x:Key="onSurfaceVariantLight">#43474E</Color>
   <Color x:Key="onSurfaceVariantDark">#C3C6CF</Color>

   <!-- Layered surfaces: the higher its number, the closer it is to the reader's eye. -->
   <Color x:Key="surfaceContainerLowLight">#F4F3F7</Color>
   <Color x:Key="surfaceContainerLowDark">#191C20</Color>
   <Color x:Key="surfaceContainerLight">#EEEDF1</Color>
   <Color x:Key="surfaceContainerDark">#1D2024</Color>
   <Color x:Key="surfaceContainerHighLight">#E8E7EC</Color>
   <Color x:Key="surfaceContainerHighDark">#272A2F</Color>

   <!-- Lines: the border of cards and input fields. A variant for a calmer divider line. -->
   <Color x:Key="outlineLight">#73777F</Color>
   <Color x:Key="outlineDark">#8D9199</Color>
   <Color x:Key="outlineVariantLight">#C3C6CF</Color>
   <Color x:Key="outlineVariantDark">#43474E</Color>

   <!-- Errors, and the dark curtain behind an open side menu. -->
   <Color x:Key="errorLight">#BA1A1A</Color>
   <Color x:Key="errorDark">#FFB4AB</Color>
   <Color x:Key="errorContainerLight">#FFDAD6</Color>
   <Color x:Key="errorContainerDark">#93000A</Color>
   <Color x:Key="onErrorContainerLight">#410002</Color>
   <Color x:Key="onErrorContainerDark">#FFDAD6</Color>
   <Color x:Key="scrimColor">#000000</Color>

   <!-- The brand panel color, used by the side menu header and the login screen. -->
   <Color x:Key="brandLight">#0F6CBD</Color>
   <Color x:Key="brandDark">#12283D</Color>
</ResourceDictionary>
