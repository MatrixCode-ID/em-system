<?xml version="1.0" encoding="UTF-8" ?>
<!-- The parts of the navigation frame: the top bar, the account panel entering from the right, and the
     rows inside it.

     The account panel has no row that is "currently open": each of its rows is an action that is run and
     then done, not a marker of a place. So no style here changes its look according to a selected state. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styles="clr-namespace:Em.Ui.Maui.Styles"
                    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
                    xmlns:controls="clr-namespace:Em.Ui.Maui.Controls">

   <!-- Palette is merged again here, not just once in MaterialDesign.xaml: a StaticResource inside a
        ResourceDictionary file only sees the content of that file and the dictionaries merged into it - a
        dictionary standing beside it is not visible. -->
   <ResourceDictionary.MergedDictionaries>
      <styles:Palette />
      <ResourceDictionary Source="/Styles/Typography.xaml" />
      <ResourceDictionary Source="/Styles/Cards.xaml" />
   </ResourceDictionary.MergedDictionaries>

   <!-- The top bar: height 64, the same color as the page, and separated from the content only by one thin
        line. -->
   <Style x:Key="appBarStyle" TargetType="Grid">
      <Setter Property="HeightRequest" Value="64" />
      <Setter Property="ColumnSpacing" Value="4" />
      <Setter Property="Padding" Value="4,0,8,0" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource surfaceLight}, Dark={StaticResource surfaceDark}}" />
   </Style>

   <!-- The account badge at the right end of the top bar, which opens the account panel. Fully round and the
        same color as the primary surface, so it reads as a user photo even though its content is only an
        icon for now. -->
   <Style x:Key="accountBadgeStyle" TargetType="Border">
      <Setter Property="WidthRequest" Value="36" />
      <Setter Property="HeightRequest" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource primaryContainerLight}, Dark={StaticResource primaryContainerDark}}" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="18" />
      </Setter>
   </Style>

   <!-- The account panel. It enters from the right, so its rounded corners are only on the left side - its
        right side sticks to the screen edge and a curve there would never be seen. -->
   <Style x:Key="accountPanelStyle" TargetType="Border">
      <Setter Property="WidthRequest" Value="304" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="HorizontalOptions" Value="End" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource surfaceContainerLowLight}, Dark={StaticResource surfaceContainerLowDark}}" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="16,0,16,0" />
      </Setter>
   </Style>

   <!-- A card inside the account panel: one calm surface that groups rows of the same kind. -->
   <Style x:Key="accountPanelCardStyle" TargetType="Border">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="12,6" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource surfaceContainerHighLight}, Dark={StaticResource surfaceContainerHighDark}}" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="16" />
      </Setter>
   </Style>

   <!-- One panel row: a touch area 56 high shaped as a full pill, following the Material 3 selection marker.
        It has no selected state at all - not one row in the account panel represents the screen that is
        open; all are actions that are run and then done. -->
   <Style x:Key="accountPanelItemStyle" TargetType="Border">
      <Setter Property="HeightRequest" Value="56" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="28" />
      </Setter>
   </Style>

   <Style x:Key="accountPanelItemLabelStyle" TargetType="Label">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="LineBreakMode" Value="TailTruncation" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
   </Style>

   <Style x:Key="accountPanelItemIconStyle" TargetType="controls:FontIcon">
      <Setter Property="IconSize" Value="22" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="TintColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
   </Style>

   <!-- One screen card in the home menu. It lives in the shared file, not in the home screen, because the
        menu tree draws it from two places: the list of screens without a group, and the content of each
        group, which may be as deep as anything. Its open command is carried by the item itself, so this
        template does not need to look up anyone's view model above it - and that is why it can be used
        anywhere. -->
   <DataTemplate x:Key="navigationTileTemplate">
      <Border Style="{StaticResource actionCardStyle}">
         <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Commands[OpenCommand]}" />
         </Border.GestureRecognizers>
         <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <controls:FontIcon Grid.Column="0"
                               Glyph="{x:Static controls:FontIcons.WindowMaximize}" IconSize="22"
                               VerticalOptions="Center"
                               TintColor="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
               <Label Text="{Binding Title}" Style="{StaticResource titleTextStyle}" FontSize="15" />
               <Label Text="{Binding Subtitle}" Style="{StaticResource supportTextStyle}"
                      IsVisible="{Binding HasSubtitle}" />
            </VerticalStackLayout>
            <controls:FontIcon Grid.Column="2"
                               Glyph="{x:Static controls:FontIcons.ArrowRight}" IconSize="18"
                               VerticalOptions="Center" Opacity="0.55"
                               TintColor="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
         </Grid>
      </Border>
   </DataTemplate>

   <!-- The header of a menu group. Its whole row is the tap target, and the chevron on its left tells whether
        its content is open. The top groups use the primary color so the first level reads as a big divider,
        not as one more row. -->
   <Style x:Key="menuGroupHeaderStyle" TargetType="Label">
      <Setter Property="FontFamily" Value="OpenSansSemibold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="LineBreakMode" Value="TailTruncation" />
      <Setter Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource onSurfaceVariantLight}, Dark={StaticResource onSurfaceVariantDark}}" />
      <Style.Triggers>
         <DataTrigger TargetType="Label" Binding="{Binding Level}" Value="1">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource primaryLight}, Dark={StaticResource primaryDark}}" />
         </DataTrigger>
      </Style.Triggers>
   </Style>

   <!-- The search box at the head of the home screen. Its shape is a full pill, following the desktop client. -->
   <Style x:Key="searchFieldStyle" TargetType="Border">
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="HeightRequest" Value="46" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="BackgroundColor"
              Value="{AppThemeBinding Light={StaticResource surfaceContainerLight}, Dark={StaticResource surfaceContainerDark}}" />
      <Setter Property="Stroke"
              Value="{AppThemeBinding Light={StaticResource outlineVariantLight}, Dark={StaticResource outlineVariantDark}}" />
      <Setter Property="StrokeShape">
         <shapes:RoundRectangle CornerRadius="23" />
      </Setter>
   </Style>

   <!-- The dark curtain behind an open account panel. Its opacity is animated from code, so only its color is
        set here - and it starts from not visible at all. -->
   <Style x:Key="scrimStyle" TargetType="BoxView">
      <Setter Property="Color" Value="{StaticResource scrimColor}" />
      <Setter Property="Opacity" Value="0" />
   </Style>
</ResourceDictionary>
