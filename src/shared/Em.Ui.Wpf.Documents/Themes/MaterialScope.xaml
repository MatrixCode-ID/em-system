<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Material.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button" BasedOn="{StaticResource Material.Button}" />
  <Style TargetType="TextBox" BasedOn="{StaticResource Material.Field}" />
  <Style TargetType="ComboBox" BasedOn="{StaticResource Material.ComboBox}" />
  <Style TargetType="CheckBox" BasedOn="{StaticResource Material.CheckBox}" />
  <Style TargetType="TabControl" BasedOn="{StaticResource Material.Tabs}" />
  <Style TargetType="TabItem" BasedOn="{StaticResource Material.TabItem}" />
</ResourceDictionary>
