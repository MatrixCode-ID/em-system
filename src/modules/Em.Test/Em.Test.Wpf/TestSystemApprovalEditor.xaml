<UserControl x:Class="Em.Test.Wpf.TestSystemApprovalEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel Margin="16">
  <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Title}" FontSize="16" Margin="0,8" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding Amount, StringFormat=Amount: {0:N2}}" Margin="0,0,0,16"/>
  <TextBlock Text="QA input" Style="{StaticResource sectionCaptionStyle}"/>
  <CheckBox Content="Passed" IsChecked="{Binding Passed}" Margin="0,8" IsEnabled="{Binding CanEditQa}"/>
  <TextBlock Text="QA remarks" Style="{StaticResource fieldLabelStyle}"/>
  <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource fieldBoxStyle}" Margin="0,6,0,0" IsReadOnly="{Binding QaReadOnly}"/>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </StackPanel>
</UserControl>
