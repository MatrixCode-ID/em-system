<UserControl x:Class="Em.Test.Wpf.TestHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Em.Test.Wpf"
             xmlns:controls="clr-namespace:Em.Ui.Wpf.Controls;assembly=Em.Ui.Wpf.Core"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200">
   <UserControl.DataContext>
      <local:TestHomeVm />
   </UserControl.DataContext>

   <UserControl.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/Em.Test.Wpf;component/TestStyles.xaml" />
         </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
   </UserControl.Resources>

   <Grid>
      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="200" />
            <RowDefinition Height="2*" MinHeight="160" />
         </Grid.RowDefinitions>

         <!-- ==== launcher ==== -->
         <Border Grid.Row="0" Margin="22,12,22,0" Style="{StaticResource cardStyle}" Padding="20,14,12,6">
            <StackPanel>
               <TextBlock Text="OPEN" Style="{StaticResource sectionCaptionStyle}" Margin="0,0,0,10" />
               <WrapPanel>
                  <Button Style="{StaticResource testPrimaryButtonStyle}" Content="Items"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="test.items" />
                  <Button Style="{StaticResource testPrimaryButtonStyle}" Content="Documents"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="test.docs" />
                  <Button Style="{StaticResource testPrimaryButtonStyle}" Content="Tasks &amp; CDN"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="test.tasks" />
                  <Button Style="{StaticResource testPrimaryButtonStyle}" Content="UI Lab"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="test.ui" />
                  <Border Width="1" Margin="4,2,12,10" Background="{StaticResource dividerBrush}" />
                  <Button Style="{StaticResource testButtonStyle}" Content="Approval Manager"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="approval" />
                  <Button Style="{StaticResource testButtonStyle}" Content="Business Tasks"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="admin.tasks" />
                  <Button Style="{StaticResource testButtonStyle}" Content="CDN"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="admin.cdn" />
                  <Button Style="{StaticResource testButtonStyle}" Content="Users"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="admin.users" />
                  <Button Style="{StaticResource testButtonStyle}" Content="Roles"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="admin.roles" />
                  <Button Style="{StaticResource testButtonStyle}" Content="Containers"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="admin.container" />
                  <Button Style="{StaticResource testButtonStyle}" Content="Release"
                          Command="{Binding Commands[OpenCommand]}" CommandParameter="admin.release" />
               </WrapPanel>
            </StackPanel>
         </Border>

         <!-- ==== tests ==== -->
         <TabControl Grid.Row="1" Style="{StaticResource materialTabControlStyle}">

            <TabItem Header="Self-test">
               <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,14,22,0">
                  <StackPanel>
                     <Border Style="{StaticResource testGroupStyle}">
                        <StackPanel>
                           <TextBlock Text="SELF-TEST" Style="{StaticResource sectionCaptionStyle}" />
                           <TextBlock Margin="0,6,0,12"
                                      Style="{StaticResource fieldHelpStyle}"
                                      TextWrapping="Wrap"
                                      Text="Runs every probe against the server with a known expected outcome, and reports PASS or FAIL for each. Expectations follow who you are: an administrator is expected to pass the claim and admin checks, anyone else to be refused with 403." />
                           <StackPanel Orientation="Horizontal">
                              <Button Style="{StaticResource testPrimaryButtonStyle}"
                                      Command="{Binding Commands[RunSelfTestCommand]}">
                                 <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesome Icon="Solid_CirclePlay" Style="{StaticResource buttonIconStyle}" />
                                    <TextBlock Text="Run self-test" VerticalAlignment="Center" />
                                 </StackPanel>
                              </Button>
                              <TextBlock Text="{Binding SelfTestSummary}" Margin="8,0,0,8" VerticalAlignment="Center"
                                         FontWeight="SemiBold" />
                           </StackPanel>
                        </StackPanel>
                     </Border>
                  </StackPanel>
               </ScrollViewer>
            </TabItem>

            <TabItem Header="Session &amp; claims">
               <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,14,22,0">
                  <StackPanel>
                     <Border Style="{StaticResource testGroupStyle}">
                        <StackPanel>
                           <TextBlock Text="WHO AM I" Style="{StaticResource sectionCaptionStyle}" />
                           <TextBlock Margin="0,6,0,12"
                                      Style="{StaticResource fieldHelpStyle}"
                                      TextWrapping="Wrap"
                                      Text="Compares what the client believes about the signed-in user with what the server sees for the same request. The two lists of claims must match." />
                           <Button Style="{StaticResource testButtonStyle}" HorizontalAlignment="Left"
                                   Content="Read client and server view"
                                   Command="{Binding Commands[ReadSessionCommand]}" />
                           <TextBlock Text="{Binding ClientSummary}" Style="{StaticResource testResultTextStyle}" />
                           <TextBlock Text="{Binding ServerSummary}" Style="{StaticResource testResultTextStyle}"
                                      Margin="0,10,0,0" />
                        </StackPanel>
                     </Border>

                     <Border Style="{StaticResource testGroupStyle}">
                        <StackPanel>
                           <TextBlock Text="CLAIM GATES" Style="{StaticResource sectionCaptionStyle}" />
                           <TextBlock Margin="0,6,0,12"
                                      Style="{StaticResource fieldHelpStyle}"
                                      TextWrapping="Wrap"
                                      Text="Each button calls an action guarded differently. Give a non-admin user the claims one by one in Role Manager and watch the answers change." />
                           <WrapPanel>
                              <Button Style="{StaticResource testButtonStyle}" Content="Needs 'Run Probes' claim"
                                      Command="{Binding Commands[ClaimGatedCommand]}" />
                              <Button Style="{StaticResource testButtonStyle}" Content="Admin only"
                                      Command="{Binding Commands[AdminOnlyCommand]}" />
                              <Button Style="{StaticResource testButtonStyle}" Content="Self or admin (myself)"
                                      Command="{Binding Commands[SelfOrAdminSelfCommand]}" />
                              <Button Style="{StaticResource testButtonStyle}" Content="Self or admin (someone else)"
                                      Command="{Binding Commands[SelfOrAdminOtherCommand]}" />
                           </WrapPanel>
                        </StackPanel>
                     </Border>
                  </StackPanel>
               </ScrollViewer>
            </TabItem>

            <TabItem Header="Actions">
               <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,14,22,0">
                  <StackPanel>
                     <Border Style="{StaticResource testGroupStyle}">
                        <StackPanel>
                           <TextBlock Text="PARAMETER BINDING" Style="{StaticResource sectionCaptionStyle}" />
                           <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                              <TextBlock Text="Text" Style="{StaticResource testFieldLabelStyle}" />
                              <TextBox Width="200" Style="{StaticResource fieldBoxStyle}"
                                       Text="{Binding EchoText, UpdateSourceTrigger=PropertyChanged}" />
                              <TextBlock Text="Number" Margin="16,0,8,0" Style="{StaticResource testFieldLabelStyle}" />
                              <controls:NumericBox Width="110" Style="{StaticResource fieldNumericBoxStyle}"
                                                   Minimum="-1000000" Maximum="1000000"
                                                   Value="{Binding EchoNumber}" />
                           </StackPanel>
                           <WrapPanel>
                              <Button Style="{StaticResource testButtonStyle}" Content="Public ping (no claim)"
                                      Command="{Binding Commands[PublicPingCommand]}" />
                              <Button Style="{StaticResource testButtonStyle}" Content="Ping"
                                      Command="{Binding Commands[PingCommand]}" />
                              <Button Style="{StaticResource testButtonStyle}" Content="GET simple parameters"
                                      Command="{Binding Commands[EchoSimpleCommand]}" />
                              <Button Style="{StaticResource testButtonStyle}" Content="GET JSON parameter"
                                      Command="{Binding Commands[EchoJsonCommand]}" />
                              <Button Style="{StaticResource testButtonStyle}" Content="POST body"
                                      Command="{Binding Commands[EchoPostCommand]}" />
                           </WrapPanel>
                        </StackPanel>
                     </Border>

                     <Border Style="{StaticResource testGroupStyle}">
                        <StackPanel>
                           <TextBlock Text="FAILURES AND TIME LIMITS" Style="{StaticResource sectionCaptionStyle}" />
                           <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                              <TextBlock Text="Status" Style="{StaticResource testFieldLabelStyle}" />
                              <ComboBox Width="120" Style="{StaticResource fieldComboStyle}"
                                        ItemsSource="{Binding FailStatuses}"
                                        SelectedItem="{Binding FailStatus}" />
                              <Button Style="{StaticResource testButtonStyle}" Margin="8,0,0,0"
                                      Content="Raise it"
                                      Command="{Binding Commands[FailCommand]}" />
                              <TextBlock Text="0 = an unplanned exception (the caller must see a plain 500)"
                                         Margin="8,0,0,0" VerticalAlignment="Center"
                                         Style="{StaticResource fieldHelpStyle}" />
                           </StackPanel>
                           <StackPanel Orientation="Horizontal">
                              <TextBlock Text="Wait (s)" Style="{StaticResource testFieldLabelStyle}" />
                              <controls:NumericBox Width="90" Style="{StaticResource fieldNumericBoxStyle}"
                                                   Minimum="0" Maximum="60" Value="{Binding SlowSeconds}" />
                              <Button Style="{StaticResource testButtonStyle}" Margin="12,0,8,8"
                                      Content="Slow (server limit 5s)"
                                      Command="{Binding Commands[SlowCommand]}" />
                              <Button Style="{StaticResource testButtonStyle}"
                                      Content="Slow (no server limit)"
                                      Command="{Binding Commands[SlowUnlimitedCommand]}" />
                           </StackPanel>
                        </StackPanel>
                     </Border>

                     <Border Style="{StaticResource testGroupStyle}">
                        <StackPanel>
                           <TextBlock Text="STREAMS" Style="{StaticResource sectionCaptionStyle}" />
                           <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                              <TextBlock Text="Size (KB)" Style="{StaticResource testFieldLabelStyle}" />
                              <controls:NumericBox Width="120" Style="{StaticResource fieldNumericBoxStyle}"
                                                   Minimum="1" Maximum="51200" Increment="256"
                                                   Value="{Binding StreamKb}" />
                              <Button Style="{StaticResource testButtonStyle}" Margin="12,0,8,8"
                                      Content="Upload and compare SHA-256"
                                      Command="{Binding Commands[UploadCommand]}" />
                              <Button Style="{StaticResource testButtonStyle}"
                                      Content="Download and verify bytes"
                                      Command="{Binding Commands[DownloadCommand]}" />
                           </StackPanel>
                        </StackPanel>
                     </Border>
                  </StackPanel>
               </ScrollViewer>
            </TabItem>
         </TabControl>

         <!-- ==== results ==== -->
         <local:TestLogPanel Grid.Row="2" Margin="22,8,22,22" Entries="{Binding Entries}" />
      </Grid>

      <controls:WaitOverlay IsWaiting="{Binding InWaiting}" Caption="{Binding WaiterText}" />
   </Grid>
</UserControl>
