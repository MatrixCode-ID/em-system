<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <!-- The shared design language of the engine, plus the few styles the test screens repeat. -->
   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="pack://application:,,,/Em.Ui.Wpf.Core;component/Styles/MaterialDesign.xaml" />
   </ResourceDictionary.MergedDictionaries>

   <Style x:Key="testButtonStyle" TargetType="Button" BasedOn="{StaticResource outlinedButtonStyle}">
      <Setter Property="Margin" Value="0,0,8,8" />
   </Style>

   <Style x:Key="testPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource filledButtonStyle}">
      <Setter Property="Margin" Value="0,0,8,8" />
   </Style>

   <Style x:Key="testDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource dangerOutlinedButtonStyle}">
      <Setter Property="Margin" Value="0,0,8,8" />
   </Style>

   <!-- A titled group of controls inside a tab. -->
   <Style x:Key="testGroupStyle" TargetType="Border" BasedOn="{StaticResource cardStyle}">
      <Setter Property="Padding" Value="20,14" />
      <Setter Property="Margin" Value="0,0,0,14" />
   </Style>

   <Style x:Key="testFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource fieldLabelStyle}">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
   </Style>

   <Style x:Key="testResultTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.9" />
   </Style>
</ResourceDictionary>
