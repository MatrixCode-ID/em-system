<Project>
  <PropertyGroup>
    <!-- See doc/engine/build.md#artefacts-path -->
    <ArtefactsPath Condition="'$(ArtefactsPath)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '.artefacts', 'em-system'))</ArtefactsPath>
    <ArtefactsPath>$([MSBuild]::EnsureTrailingSlash('$(ArtefactsPath)'))</ArtefactsPath>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Matrix Code</Authors>
    <Company>Matrix Code</Company>
    <!-- See doc/engine/build.md#package-id -->
    <PackageId>$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '^Em\.', 'EmSys.'))</PackageId>
    <PackageProjectUrl>https://github.com/MatrixCode-ID/em-system</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MatrixCode-ID/em-system</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Matrix Code</Copyright>
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- See doc/engine/build.md#package-metadata -->
    <PackageReleaseNotes Condition="'$(EmReleaseNotesFile)' != '' and Exists('$(EmReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(EmReleaseNotesFile)'))</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)doc/assets/logo/Logo-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
  <!-- Resizetizer pin works around MAUIR0001; see doc/engine/build.md#resizetizer-pin -->
  <ItemGroup Condition="'$(UseMaui)' == 'true'">
    <PackageReference Include="Microsoft.Maui.Resizetizer" Version="10.0.100" PrivateAssets="all" NoWarn="NU1605" />
  </ItemGroup>
</Project>
