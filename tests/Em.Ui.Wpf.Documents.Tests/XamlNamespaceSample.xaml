<UserControl x:Class="Em.Ui.Wpf.Documents.Tests.XamlNamespaceSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emg="https://MatrixCode/wpf/grid"
             xmlns:eme="https://MatrixCode/wpf/editors"
             xmlns:ems="https://MatrixCode/wpf/sheet"
             xmlns:emw="https://MatrixCode/wpf/writer"
             xmlns:emp="https://MatrixCode/wpf/printing"
             xmlns:grid="clr-namespace:Em.Grid;assembly=Em.Libs">
    <!-- Compiled by the XAML markup compiler, so it checks the XAML namespaces as a consumer project sees them.
         Engine types from Em.Libs use clr-namespace; the URIs map only the WPF assembly. -->
    <StackPanel>
        <emg:MatrixGrid x:Name="Orders" AutoGenerateColumns="False" ShowGroupPanel="True">
            <emg:MatrixGrid.Columns>
                <grid:GridColumn Key="Customer" Header="Customer" Kind="Text" Width="160" />
                <grid:GridColumn Key="Units" Header="Units" Kind="Number" />
            </emg:MatrixGrid.Columns>
        </emg:MatrixGrid>
        <eme:TextEditor x:Name="Note" />
        <ems:MatrixSheet x:Name="Sheet" ShowToolbar="False" />
        <emw:MatrixWriter x:Name="Writer" ShowToolbar="False" />
        <emp:PagePresenter x:Name="Preview" />
    </StackPanel>
</UserControl>
