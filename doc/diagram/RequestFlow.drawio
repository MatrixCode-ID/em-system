        </mxCell>
        <mxCell id="p4_n27" value="Setiap rotasi refresh  -&amp;gt;  ApiClient.SessionChanged&lt;br&gt;-&amp;gt;  EmApp.StoreSession()  -&amp;gt;  timpa refresh token tersimpan&lt;br&gt;Tanpa ini, restart berikutnya memakai token mati." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
