  <diagram id="p4" name="4. Siklus sesi di client">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1520" math="0" shadow="0">
      <root>
        <mxCell id="p4_0" />
        <mxCell id="1" parent="p4_0" />
        <mxCell id="p4_n1" value="&lt;b&gt;MASUK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#eeeeee;strokeColor=none;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="300" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p4_n2" value="Startup: MainWindow.OnLoaded&lt;br&gt;Vm.LoadConnections()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_n3" value="RememberSignIn menyala DAN RememberedProfileName ada?" style="rhombus;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4_n4" value="EmApp.TryRestoreSessionAsync(profile)&lt;br&gt;SessionStorage.Load  -&amp;gt;  PostGetMeta_RefreshToken&lt;br&gt;(action publik - token itu sendiri buktinya)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="400" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p4_n5" value="Berhasil?" style="rhombus;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="326" width="400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p4_n6" value="SessionStorage.Clear(profile)&lt;br&gt;Layar login, nama akun terisi,&lt;br&gt;TANPA pesan merah - sesi kedaluwarsa&lt;br&gt;bukan kesalahan user" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="400" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p4_n7" value="Layar login: LoginControl.SignInCommand" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="50" width="400" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4_n8" value="PostGetMeta_SignIn(cUserAccount, password)&lt;br&gt;401  -&amp;gt;  &quot;Incorrect username or password.&quot;&lt;br&gt;(satu pesan untuk semua sebab)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="400" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p4_n9" value="RememberedUserName + RememberedProfileName&lt;br&gt;disimpan hanya kalau &quot;keep me signed in&quot; menyala" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="220" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p4_n10" value="EmApp.BeginSessionAsync(token, remember)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="310" y="520" width="440" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4_n11" value="1.  ApiClient.SetSession(token)&lt;br&gt;2.  Kosongkan Connection.DebugToken  (nilainya disimpan)&lt;br&gt;3.  Muat ActiveUser - admin: objek sintetis;&lt;br&gt;     selain itu User.GetUser_ByIdAsync(cUserId)&lt;br&gt;4.  Langganan SessionChanged / SessionEnded&lt;br&gt;5.  remember  -&amp;gt;  SessionStorage.Save (DPAPI, per profil)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="310" y="594" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_n12" value="Gagal di langkah 3  -&amp;gt;  BATALKAN SEMUA:&lt;br&gt;DebugToken dikembalikan, ClearSession,&lt;br&gt;storage dibersihkan, exception naik.&lt;br&gt;Setengah masuk lebih buruk daripada gagal masuk." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="780" y="604" width="300" height="82" as="geometry" />
        </mxCell>
