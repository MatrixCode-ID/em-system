          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_n39" value="Dua sebab berakhirnya sesi sengaja melewati jalan yang sama persis, supaya tidak ada cabang tampilan yang terlewat.&lt;br&gt;Tab yang sedang terbuka TIDAK ditutup di fase ini - workspace hanya tersembunyi." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
