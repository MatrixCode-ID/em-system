        </mxCell>
        <mxCell id="p4_n30" value="User tekan Sign out&lt;br&gt;MainWindowVm.PerformLogoff&lt;br&gt;EndSessionAsync(notifyServer: true)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="400" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p4_n31" value="Refresh gagal  -&amp;gt;  ApiClient.SessionEnded&lt;br&gt;dimarshal ke Dispatcher lebih dulu&lt;br&gt;EndSessionAsync(false, SessionExpiredNotice)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="580" y="900" width="400" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p4_n32" value="EmApp.EndSessionAsync&lt;br&gt;lepas langganan SessionChanged / SessionEnded&lt;br&gt;PostMeta_SignOut()  -  gagal? DIABAIKAN&lt;br&gt;ClearSession + SessionStorage.Clear(profil)&lt;br&gt;DebugToken dikembalikan ke koneksi&lt;br&gt;SetActiveUser(null)  -&amp;gt;  ActiveUserChanged&lt;br&gt;picu EmApp.SessionEnded(Reason)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="310" y="1006" width="440" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p4_n33" value="MainWindow:  Dispatcher.Invoke&lt;br&gt;Vm.SessionEndedNotice = e.Reason&lt;br&gt;Vm.IsSignedIn = false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="310" y="1154" width="440" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p4_n34" value="SyncLoginHost  -&amp;gt;  LoginControl dibangun ULANG&lt;br&gt;Reason terisi  -&amp;gt;  strip kuning (bukan merah)&lt;br&gt;Reason null (user sendiri yang keluar)  -&amp;gt;  tanpa strip" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
