        <mxCell id="p4_n26" value="&lt;b&gt;SELAMA BERJALAN&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontSize=11;fillColor=#eeeeee;strokeColor=none;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
